{{ ansible_managed | comment }}
# The runner reaches its account's podman through the socket; its jobs never get it, as its configuration says.
[Unit]
Description=Forgejo's runner, its jobs in the runner account's containers
StartLimitIntervalSec=0
After=forgejo-runner-proxy.service
# Stopped with the proxy whenever it ends, not only when it is stopped: its namespace goes with it.
BindsTo=forgejo-runner-proxy.service
PartOf=forgejo-runner-proxy.service

[Container]
Image={{ __forge_runner_image }}
ContainerName=forgejo-runner
PidsLimit={{ forge_runner_pids_limit }}
Memory={{ forge_runner_memory }}
PodmanArgs=--cpus={{ forge_runner_cpus }}
UserNS=keep-id:uid=1000,gid=1000
Network=container:forgejo-runner-proxy
Volume=%h/runner:/data
Volume=%t/podman/podman.sock:/run/podman/podman.sock
Environment=DOCKER_HOST=unix:///run/podman/podman.sock
Exec=/bin/forgejo-runner daemon --config /data/config.yml

[Service]
Restart=always
RestartSec=10

[Install]
# Started again with the proxy, since a stop through BindsTo= is not one Restart= answers.
WantedBy=default.target forgejo-runner-proxy.service
