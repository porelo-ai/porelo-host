{{ ansible_managed | comment }}
[Unit]
Description=Forward HTTPS to the rootless forge
# A socket restart must also replace an active proxy after its destination changes.
PartOf=porelo-forge-https.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd {{ forge_address }}:{{ forge_http_port }}
DynamicUser=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
