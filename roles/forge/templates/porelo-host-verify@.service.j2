{{ ansible_managed | comment }}
[Unit]
Description=The host's judgement of one push to its forge

[Service]
# The host program reads the forge hook's one request and answers it on the same connection.
ExecStart=/usr/sbin/porelo-host judge-push
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Ten seconds past the hook's own wait, so the hook always gives up first and the pusher reads why.
TimeoutStartSec={{ (300 * __porelo_host_limits.services | float) | round(6) | round(0, 'ceil') | int + 10 }}
RuntimeMaxSec={{ (300 * __porelo_host_limits.services | float) | round(6) | round(0, 'ceil') | int + 10 }}
