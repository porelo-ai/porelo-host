{{ ansible_managed | comment }}
log:
  level: info
runner:
  file: /data/.runner
  capacity: {{ forge_runner_capacity }}
  labels: {{ forge_runner_labels | to_json }}
# The runner, proxy and jobs share loopback; no cache port is published on the host.
cache:
  enabled: true
  dir: /data/cache
  host: 127.0.0.1
  port: {{ forge_runner_cache_port }}
  proxy_port: {{ forge_runner_cache_proxy_port }}
container:
  network: container:forgejo-runner-proxy
  # Jobs get no socket of the runner's podman, so a job cannot start containers beside itself.
  docker_host: "-"
  # Jobs share the proxy's namespace; its own /etc/hosts would be theirs to rewrite for the next job.
  # Their own is root's file, which a job's root cannot write even through a volume of its own.
  # Where the host has a VM pool, its file is read-only: what porelo-machines --pool reads.
  options: >-
    --cpus={{ forge_job_cpus }} --memory={{ forge_job_memory }} --pids-limit={{ forge_job_pids_limit }}
    --env=OMP_NUM_THREADS={{ forge_job_omp_num_threads }}
    --volume={{ __forge_runner_jdk_dir }}:{{ __forge_runner_jdk_job_dir }}:ro
    --env=JAVA_HOME_25_X64={{ __forge_runner_jdk_job_dir }}
    --volume={{ __forge_runner_job_hosts }}:/etc/hosts:ro
{% if porelo_host_vm_pool is defined %}
    --volume=/etc/porelo-host/pool:/etc/porelo-host/pool:ro
{% endif %}
  valid_volumes: {{ ([__forge_runner_jdk_dir, __forge_runner_job_hosts]
    + (['/etc/porelo-host/pool'] if porelo_host_vm_pool is defined else [])) | to_json }}
