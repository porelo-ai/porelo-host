{{ ansible_managed | comment }}
[Unit]
Description=The host's forge git gate

[Socket]
ListenStream=/run/porelo-forge/git.sock
# Git has no Unix-socket transport: the same token-only gate on loopback, never Forgejo itself.
ListenStream=127.0.0.1:{{ forge_git_port }}
Accept=yes
SocketUser={{ forge_account }}
SocketGroup=porelo-people
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
# A burst of connections must not stop the socket for good: systemd's trigger limit would fail it, RemoveOnStop
# deletes the path, and every request through the window's forward is then empty, as the forge page once was.
TriggerLimitIntervalSec=0
# One process each: a browser's pages and polls, and every request of the runner's jobs, fit in this many at once.
MaxConnections=256

[Install]
WantedBy=sockets.target
