{{ ansible_managed | comment }}
[Unit]
Description=The host's forge git connection

[Service]
User={{ forge_account }}
Group={{ forge_account }}
ExecStart=/usr/local/libexec/porelo-forge-gate --git --upstream {{ __forge_socket }}
PrivateTmp=true
ProtectSystem=strict
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
StandardOutput=null
StandardError=journal
