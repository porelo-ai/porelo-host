{{ ansible_managed | comment }}
# keep-id maps the account to the image's user, so the certificate files the account owns are readable inside.
[Unit]
Description=Forgejo, the host's forge with its registry
StartLimitIntervalSec=0

[Container]
Image={{ __forge_image }}
ContainerName=forgejo
UserNS=keep-id:uid=1000,gid=1000
PublishPort={{ forge_address }}:{{ forge_http_port }}:3000
PublishPort={{ forge_address }}:{{ forge_ssh_port }}:2222
Volume=forgejo-data:/var/lib/gitea
Volume=forgejo-config:/etc/gitea
Volume=%h/tls:/tls:ro
Environment=FORGEJO__security__INSTALL_LOCK=true
Environment=FORGEJO__database__DB_TYPE=sqlite3
Environment=FORGEJO__service__DISABLE_REGISTRATION=true
Environment=FORGEJO__actions__ENABLED=true
Environment=FORGEJO__server__PROTOCOL=https
Environment=FORGEJO__server__CERT_FILE=/tls/forge.pem
Environment=FORGEJO__server__KEY_FILE=/tls/forge.key
Environment=FORGEJO__server__DOMAIN={{ forge_name }}
Environment=FORGEJO__server__ROOT_URL=https://{{ forge_name }}:{{ forge_http_port }}/
Environment=FORGEJO__server__SSH_PORT={{ forge_ssh_port }}
Environment=FORGEJO__migrations__ALLOW_LOCALNETWORKS={{ forge_migrations_allow_local | string | lower }}
# The system's CAs and the host's in one bundle, for Forgejo itself and for the git it runs.
Environment=SSL_CERT_FILE=/tls/ca-bundle.pem
Environment=GIT_SSL_CAINFO=/tls/ca-bundle.pem

[Service]
# After a boot the VPN may come up after the unit; it tries again until its address is there.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
