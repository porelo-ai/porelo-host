def valid_lock_details(lines):
    """A locked person's record ends in why and since when, in that order, each at most once."""
    if lines and lines[0] in ("reason=membership", "reason=key"):
        lines = lines[1:]
    if lines and re.fullmatch(r"locked_on=\d{4}-\d{2}-\d{2}", lines[0]):
        lines = lines[1:]
    return not lines


def read_person(user, path):
    """Read and validate one trusted person record."""
    trusted(path, private=True)
    try:
        with open(path, encoding="utf-8") as stream:
            lines = stream.read().splitlines()
    except UnicodeError:
        refuse(f"{path} is not UTF-8", 69)
    pending = bool(lines and lines[-1] == "lock=pending")
    if pending:
        lines = lines[:-1]
    members, previous = [], None
    index = 0
    while index < len(lines) and lines[index].startswith("member="):
        member = lines[index][7:]
        order = member_key(member)
        if previous is not None and order <= previous:
            refuse(f"the record for {user} is malformed", 65)
        members.append(member)
        previous = order
        index += 1
    if (
        len(lines) < index + 3
        or lines[index] not in ("locked=false", "locked=true")
        or not lines[index + 1].startswith("ssh=")
        or not lines[index + 2].startswith("expires=")
        or not valid_lock_details(lines[index + 3 :])
    ):
        refuse(f"the record for {user} is malformed", 65)
    signing_key(lines[index + 1][4:], "person card key", 65)
    return members, lines[index] == "locked=true", pending, lines[index + 1 :]


def format_person(members, locked, pending, card):
    """Serialize a person's record in canonical membership order."""
    ordered = sorted(set(members), key=member_key)
    return (
        "".join(f"member={item}\n" for item in ordered)
        + f"locked={'true' if locked else 'false'}\n"
        + "".join(f"{line}\n" for line in card)
        + ("lock=pending\n" if pending else "")
    )


def stage_file(destination, prefix, content):
    """Write and sync one private staging file beside its destination before publication."""
    descriptor = temporary = None
    try:
        with writing(destination):
            descriptor, temporary = tempfile.mkstemp(prefix=prefix, dir=os.path.dirname(destination))
            output = os.fdopen(descriptor, "w", encoding="utf-8")
            descriptor = None
            with output:
                os.fchmod(output.fileno(), 0o600)
                output.write(content)
                output.flush()
                os.fsync(output.fileno())
        return temporary
    except BaseException:
        if temporary is not None:
            with writing(temporary):
                if descriptor is not None:
                    os.close(descriptor)
                if os.path.lexists(temporary):
                    os.unlink(temporary)
        raise


def forge_home(account):
    """The forge account's own home, for podman: root's HOME and working directory are not the account's."""
    try:
        home = pwd.getpwnam(account).pw_dir
    except KeyError:
        refuse(f"the forge's account {account} is not known, or is root", 69)
    if not home.startswith("/") or home == "/" or os.path.normpath(home) != home:
        refuse(f"the forge's account {account} has no usable absolute home", 69)
    return home


def forge_command(account, *arguments):
    """Run the forge admin CLI without putting its captured credentials into an argument or file."""
    return forge_exec(account, "forgejo", "admin", "user", *arguments)


def forge_exec(account, *arguments, given=None):
    """Run a container command with the forge account's fixed environment and user manager."""
    uid = subprocess.run(
        ["/usr/bin/id", "-u", account],
        capture_output=True,
        text=True,
        check=False,
        env=SAFE_ENV,
        timeout=10,
    )
    number = uid.stdout.strip()
    if uid.returncode or not re.fullmatch(r"[1-9][0-9]*", number):
        refuse(f"the forge's account {account} is not known, or is root", 69)
    # Podman keeps to the systemd cgroup manager only through the account's bus; crun fails without it.
    try:
        bus = stat.S_ISSOCK(os.lstat(f"{RUN_USER}/{number}/bus").st_mode)
    except OSError:
        bus = False
    if not bus:
        refuse(f"the user manager of {account} has no session bus at /run/user/{number}/bus", 69)
    home = forge_home(account)
    return subprocess.run(
        [
            "/usr/sbin/runuser",
            "-u",
            account,
            "--",
            "/usr/bin/env",
            "-C",
            "/",
            f"HOME={home}",
            f"XDG_RUNTIME_DIR=/run/user/{number}",
            f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{number}/bus",
            "/usr/bin/podman",
            "exec",
            *(["-i"] if given is not None else []),
            "forgejo",
            *arguments,
        ],
        capture_output=True,
        text=True,
        check=False,
        cwd="/",
        env=SAFE_ENV,
        stdin=subprocess.DEVNULL if given is None else given,
        timeout=60,
    )


def token(account, username, scopes):
    """Make a scoped token with a unique nonsecret name, never exposing CLI output on failure."""
    made = forge_command(
        account,
        "generate-access-token",
        "--username",
        username,
        "--token-name",
        "porelo-host-project-" + secrets.token_hex(16),
        "--scopes",
        scopes,
        "--raw",
    )
    value = made.stdout.strip()
    if made.returncode or not re.fullmatch(r"[0-9a-f]{40}", value):
        refuse(f"Forgejo made no token for {username} (exit {made.returncode})", 69)
    return value


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Keep a credential from following a forge redirect."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class UnixConnection(http.client.HTTPConnection):
    """Reach only the forge account's private socket."""

    def __init__(self, path, **kwargs):
        super().__init__("localhost", **kwargs)
        self.path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.path)


class UnixHandler(urllib.request.HTTPHandler):
    """Use HTTP framing without a TCP listener or proxy."""

    def __init__(self, path):
        super().__init__()
        self.path = str(path)

    def http_open(self, request):
        return self.do_open(lambda host, **kwargs: UnixConnection(self.path, **kwargs), request)


class Forge:
    """The host forge's API, reached only on the account's private socket."""

    def __init__(self, values, authenticate=True):
        self.account = setting(values, "account", r"[a-z_][a-z0-9_-]{0,31}")
        try:
            uid = pwd.getpwnam(self.account).pw_uid
        except KeyError:
            refuse("the forge account is missing", 69)
        self.opener = urllib.request.build_opener(
            urllib.request.ProxyHandler({}),
            UnixHandler(f"/run/user/{uid}/porelo-forge/http.sock"),
            NoRedirect(),
        )
        self.base = "http://localhost/api/v1"
        if authenticate:
            self.token = token(
                self.account,
                ADMIN,
                "write:admin,write:organization,read:user,write:repository,write:package",
            )

    def answers(self):
        """Say whether anything answers on the socket, asking without the token a stopped forge cannot make."""
        try:
            with self.opener.open(urllib.request.Request(self.base + "/version", method="GET"), timeout=30):
                return True
        except urllib.error.HTTPError as error:
            error.close()
            return True
        except (urllib.error.URLError, OSError, http.client.HTTPException):
            return False

    def request(self, method, path, body=None, expected=(200,)):
        """Return validated JSON, or only the HTTP code in an error; never repeat a remote body."""
        request = urllib.request.Request(
            self.base + path,
            data=json.dumps(body).encode() if body is not None else None,
            method=method,
            headers={"Authorization": "token " + self.token, "Content-Type": "application/json"},
        )
        try:
            with self.opener.open(request, timeout=30) as answer:
                status, data = answer.status, answer.read()
        except urllib.error.HTTPError as error:
            status, data = error.code, b""
            error.close()
        except (urllib.error.URLError, OSError, http.client.HTTPException) as error:
            refuse(f"the forge did not answer {method} {path}: {type(error).__name__}", 69)
        if status not in expected:
            # A forge that fails in itself is missing; one that answers otherwise says no.
            refuse(f"the forge answered HTTP {status} for {method} {path}", 69 if status >= 500 else 65)
        if status == 404 or (not data and method != "GET"):
            return None
        try:
            result = json.loads(data)
        except (ValueError, UnicodeError):
            refuse(f"the forge sent invalid JSON for {method} {path}")
        if result is None:
            refuse(f"the forge sent no identity or list for {method} {path}")
        return result

    def listing(self, path):
        """Read every page, stopping on a repeated page instead of trusting an incomplete reference set."""
        result, seen = [], set()
        for page in range(1, 101):
            items = self.request("GET", f"{path}?limit=50&page={page}")
            if not isinstance(items, list) or any(not isinstance(item, dict) for item in items):
                refuse(f"the forge sent no list for {path}")
            if not items:
                return result
            digest = json.dumps(items, sort_keys=True)
            if digest in seen:
                refuse(f"the forge repeated a page for {path}")
            seen.add(digest)
            result.extend(items)
        refuse(f"the forge did not finish listing {path} in 100 pages")


def make_organization_settings(forge, project):
    """Give a new organization its teams, then the Actions variables and placeholder secrets its workflows read."""
    for team in TEAMS:
        forge.request(
            "POST",
            f"/orgs/{project}/teams",
            {
                "name": team["name"],
                "permission": "write",
                "units": list(team["units"]),
                "units_map": team["units"],
                "includes_all_repositories": True,
                "can_create_org_repo": False,
            },
            (201,),
        )
    path = os.path.join(ETC, "forge", "organization.json")
    trusted(path)
    with open(path, encoding="utf-8") as stream:
        settings = json.load(stream)
    for name, value in settings["variables"].items():
        forge.request(
            "POST",
            f"/orgs/{project}/actions/variables/{name}",
            {"value": value.replace("{project}", project)},
            (201, 204),
        )
    for name in settings["placeholder_secrets"]:
        forge.request("PUT", f"/orgs/{project}/actions/secrets/{name}", {"data": "porelo-host-placeholder"}, (201, 204))


def protect_repository(forge, project, name):
    """A migrated repository's main takes no direct push, and a reviewed pull request reaches it by fast-forward."""
    route = f"/repos/{project}/{name}"
    forge.request("PATCH", route, MERGE_STYLE, (200,))
    if forge.request("GET", f"{route}/branch_protections/main", expected=(200, 404)) is None:
        forge.request("POST", f"{route}/branch_protections", MAIN_PROTECTION, (201,))


def add(forge, project, admin, key, record, person, person_content):
    """Validate all existing identities before making one organization and an isolated package publisher."""
    publisher = "porelo-publisher-" + project
    for kind, path in (
        ("organization", f"/orgs/{project}"),
        ("user", f"/users/{project}"),
        ("publisher", f"/users/{publisher}"),
    ):
        if forge.request("GET", path, expected=(200, 404)) is not None:
            refuse(f"the forge already has {kind} {path.rsplit('/', 1)[1]}")
    if forge.request("GET", f"/users/{admin}", expected=(200, 404)) is None:
        refuse(f"the forge has no admin login {admin}")
    for name in ("projects", "people"):
        with writing(os.path.join(ETC, name)):
            os.makedirs(os.path.join(ETC, name), mode=0o700, exist_ok=True)
    with writing(record):
        descriptor, temporary = tempfile.mkstemp(prefix=f".{project}-", dir=os.path.dirname(record))
    person_temporary = None
    organization_made = publisher_made = False
    try:
        person_temporary = stage_file(person, f".{admin}-", person_content)
        # The forge's own administrator owns it, as Forgejo keeps a last owner: the project's admin can always leave.
        forge.request("POST", f"/admin/users/{ADMIN}/orgs", {"username": project, "visibility": "private"}, (201,))
        organization_made = True
        owners = [team for team in forge.listing(f"/orgs/{project}/teams") if team.get("name") == "Owners"]
        if len(owners) != 1 or type(owners[0].get("id")) is not int or owners[0]["id"] <= 0:
            refuse(f"the forge has no unique Owners team for {project}")
        forge.request("PUT", f"/teams/{owners[0]['id']}/members/{admin}", expected=(204,))
        make_organization_settings(forge, project)
        made = forge_command(
            forge.account,
            "create",
            "--username",
            publisher,
            "--email",
            f"{publisher}@porelo.invalid",
            "--random-password",
            "--must-change-password=false",
        )
        if made.returncode:
            refuse(f"Forgejo made no publisher {publisher} (exit {made.returncode})", 69)
        publisher_made = True
        team = forge.request(
            "POST",
            f"/orgs/{project}/teams",
            {
                "name": "publishers",
                "permission": "write",
                "units": ["repo.packages"],
                "units_map": {"repo.packages": "write"},
                "includes_all_repositories": False,
                "can_create_org_repo": False,
            },
            (201,),
        )
        if not isinstance(team, dict) or type(team.get("id")) is not int or team["id"] <= 0:
            refuse(f"the forge returned no valid publishers team for {project}")
        forge.request("PUT", f"/teams/{team['id']}/members/{publisher}", expected=(204,))
        secret = token(forge.account, publisher, "write:package")
        forge.request("PUT", f"/orgs/{project}/actions/secrets/PORELO_PUBLISHER_TOKEN", {"data": secret}, (201, 204))
        # A build resolves with this one, so only the step that deploys holds the publisher's.
        secret = token(forge.account, publisher, "read:package")
        forge.request(
            "PUT", f"/orgs/{project}/actions/secrets/PORELO_PACKAGES_READ_TOKEN", {"data": secret}, (201, 204)
        )
        if os.path.lexists(POOL_RUN_KEY):
            trusted(POOL_RUN_KEY, private=True)
            with open(POOL_RUN_KEY, encoding="utf-8") as stream:
                secret = stream.read()
            forge.request("PUT", f"/orgs/{project}/actions/secrets/{POOL_SECRET}", {"data": secret}, (201, 204))
        with writing(record):
            output = os.fdopen(descriptor, "w", encoding="utf-8")
            descriptor = None
            with output:
                os.fchmod(output.fileno(), 0o600)
                output.write(f"admin={admin}\nsigned_by={key}\npublisher={publisher}\n")
                output.flush()
                os.fsync(output.fileno())
            # A link publishes the complete file atomically without replacing another writer's pinned key.
            try:
                os.link(temporary, record)
            except FileExistsError:
                refuse(f"{record} exists")
        try:
            with writing(person):
                os.replace(person_temporary, person)
        except BaseException:
            with writing(record):
                os.unlink(record)
            raise
    except (Refusal, OSError, subprocess.SubprocessError, KeyboardInterrupt) as error:
        left = []
        for made, kind, name, path in (
            (organization_made, "organization", project, f"/orgs/{project}"),
            (publisher_made, "publisher", publisher, f"/admin/users/{publisher}"),
        ):
            if made:
                try:
                    forge.request("DELETE", path, expected=(204,))
                except (Refusal, OSError, subprocess.SubprocessError):
                    left.append(f"{kind} {name}")
        if left:
            cause = str(error) if isinstance(error, Refusal) else type(error).__name__
            code = error.code if isinstance(error, Refusal) else 64 if isinstance(error, KeyboardInterrupt) else 69
            refuse(f"{cause}; cleanup left {', '.join(left)}", code)
        raise
    finally:
        if person_temporary is not None:
            with writing(person_temporary):
                if os.path.lexists(person_temporary):
                    os.unlink(person_temporary)
        with writing(temporary):
            if descriptor is not None:
                os.close(descriptor)
            if os.path.lexists(temporary):
                os.unlink(temporary)
    with writing("standard output"):
        print(
            json.dumps(
                dict(project=project, admin=admin, organization=project, publisher=publisher), separators=(",", ":")
            ),
            flush=True,
        )


def registered_publisher(project, record):
    """Validate the complete registration before obtaining a credential."""
    values = {}
    allowed = {"admin", "signed_by", "publisher", "removing"}
    try:
        with open(record, encoding="utf-8") as lines:
            for line in lines:
                key, separator, value = line.rstrip("\n").partition("=")
                if not separator:
                    refuse(f"{record} has a malformed or duplicate setting", 65)
                if key in allowed and key not in values:
                    values[key] = value
                else:
                    refuse(f"{record} has a malformed or duplicate setting", 65)
    except UnicodeError:
        refuse(f"{record} is not UTF-8", 65)
    if "removing" in values and values["removing"] != "true":
        refuse(f"{record} has a malformed removal state", 65)
    setting(values, "admin", PERSON_PATTERN, record, 65)
    signing_key(values.get("signed_by", ""), f"{record} signed_by signing key", 65)
    publisher = setting(values, "publisher", re.escape("porelo-publisher-" + project), record, 65)
    return publisher


def central_forge_token():
    """The central forge's token: asked at a terminal, or the one line of a pipe, as the interface gives it."""
    if sys.stdin.isatty():
        given = getpass.getpass("Token for the central forge (not shown): ")
    else:
        given = sys.stdin.read(4097)
        if given.endswith("\n"):
            given = given[:-1]
    if not given or len(given) > 4096 or "\n" in given or "\r" in given:
        refuse("no valid central forge token was given", 64)
    return given


def people_after_removal(project):
    """Validate every person record before forge deletion and collect records losing this project."""
    people_dir = os.path.join(ETC, "people")
    affected = []
    if not os.path.lexists(people_dir):
        return affected
    trusted_directory(people_dir, private=True)
    for entry_name in sorted(os.listdir(people_dir)):
        if entry_name == "purged":
            trusted(os.path.join(people_dir, entry_name), private=True)
            continue
        if not entry_name.endswith(".conf") or not re.fullmatch(PERSON_PATTERN, entry_name[:-5]):
            refuse("the people directory holds an unknown record", 65)
        user = entry_name[:-5]
        person_path = os.path.join(people_dir, entry_name)
        members, locked, pending, card = read_person(user, person_path)
        remaining = [item for item in members if item == "host-admin" or item.split(" ", 1)[0] != project]
        if remaining != members:
            affected.append((user, person_path, format_person(remaining, locked, pending, card)))
    return affected


def remove(forge, project, record, publisher, affected):
    """Check every repository without pushing anything, then delete the forge identities and update records."""
    with open(record, encoding="utf-8") as stream:
        record_content = stream.read()
    started = "removing=true" in record_content.splitlines()
    present = {}
    for kind, path in (("organization", f"/orgs/{project}"), ("publisher", f"/users/{publisher}")):
        present[kind] = forge.request("GET", path, expected=(200, 404)) is not None
        if not present[kind] and not started:
            refuse(f"the forge has no {kind} for registered project {project}")
    repositories = forge.listing(f"/orgs/{project}/repos") if present["organization"] else []
    packages = forge.listing(f"/packages/{project}") if present["organization"] else []
    package_paths = []
    for package in packages:
        parts = [package.get(key) for key in ("type", "name", "version")]
        if any(
            not isinstance(part, str)
            or not part
            or part in (".", "..")
            or any(ord(char) < 32 or ord(char) == 127 for char in part)
            for part in parts
        ):
            refuse(f"the forge returned an invalid package identity for {project}")
        path = f"/packages/{project}/" + "/".join(urllib.parse.quote(part, safe="") for part in parts)
        if path in package_paths:
            refuse(f"the forge returned a duplicate package identity for {project}")
        package_paths.append(path)
    names = []
    for repository in repositories:
        name = repository.get("name")
        if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", name) or name in names:
            refuse(f"the forge returned an invalid or duplicate repository name for {project}")
        names.append(name)
    if names and (os.path.lexists(os.path.join(ETC, "organization", "read", "projects", project, "repositories.json"))
                  or "--lock-fd" in sys.argv):
        check_read_keys(forge, project, repositories)
    elif names:
        trusted(PUSH)
        central_token = central_forge_token()
        checked = subprocess.run(
            [PUSH, "--check", project, *names],
            env=SAFE_ENV,
            check=False,
            timeout=600,
            input=central_token + "\n",
            capture_output=True,
            text=True,
        )
        if checked.returncode:
            code = {65: 65, 73: 73, 75: 64, 130: 64, 143: 64}.get(checked.returncode, 69)
            refuse(
                f"{project} has unpushed or unverifiable commits in {', '.join(names)}; "
                f"gathered push check exited {checked.returncode}",
                code,
            )
    publications = [os.path.join(ETC, "projects", project + ".people.json")]
    publications.extend(os.path.join(ETC, "signers", project + suffix) for suffix in (".json", ".allowed"))
    for path in publications:
        trusted_directory(os.path.dirname(path), missing=True)
        if os.path.lexists(path):
            trusted(path)
    arrivals = os.path.join(ARRIVALS, project)
    recorded = []
    if os.path.lexists(ARRIVALS):
        trusted_directory(arrivals, private=True, missing=True)
        if os.path.lexists(arrivals):
            for name in sorted(os.listdir(arrivals)):
                trusted(os.path.join(arrivals, name), private=True)
                recorded.append(os.path.join(arrivals, name))
    read_key_paths(project)
    staged = []
    try:
        for user, person_path, content in affected:
            staged.append((person_path, stage_file(person_path, f".{user}-", content)))
        if not started:
            temporary = stage_file(record, f".{project}-removing-", record_content + "removing=true\n")
            try:
                with writing(record):
                    os.replace(temporary, record)
            finally:
                if os.path.lexists(temporary):
                    os.unlink(temporary)
        for name in names:
            forge.request("DELETE", f"/repos/{project}/{name}", expected=(204,))
        for path in package_paths:
            forge.request("DELETE", path, expected=(204,))
        if present["organization"]:
            forge.request("DELETE", f"/orgs/{project}", expected=(204,))
        if present["publisher"]:
            forge.request("DELETE", f"/admin/users/{publisher}", expected=(204,))
        for path in (f"/orgs/{project}", f"/users/{publisher}"):
            if forge.request("GET", path, expected=(200, 404)) is not None:
                refuse(f"the forge still holds an identity for {project}; keeping its record")
        for person_path, temporary in staged:
            with writing(person_path):
                os.replace(temporary, person_path)
        for path in publications:
            with writing(path):
                if os.path.lexists(path):
                    os.unlink(path)
        # A project brought again under this name starts its verdicts anew, and its history is listed again.
        for path in recorded:
            with writing(path):
                os.unlink(path)
        if os.path.lexists(arrivals):
            with writing(arrivals):
                os.rmdir(arrivals)
        drop_read_keys(project)
        with writing(record):
            os.unlink(record)
    finally:
        for _, temporary in staged:
            with writing(temporary):
                if os.path.lexists(temporary):
                    os.unlink(temporary)


def admitted(admin, person):
    """Under the lock, the admin must still hold a membership and not be locked out or purged."""
    if not os.path.lexists(person):
        refuse(f"{admin} is no person on this host", 65)
    members, locked, pending, card = read_person(admin, person)
    if locked or pending:
        refuse(f"{admin} is locked on this host", 65)
    if not members:
        refuse(f"{admin} holds no membership on this host", 65)
    return members, locked, pending, card


def named_in_organization(project, admin):
    """Under the lock, the organization state porelo-host-person applied must name the project for this unrevoked admin."""
    path = os.path.join(ETC, "organization", "applied.json")
    # Members pass through this directory to their project's file; what must stay root's alone is this file.
    trusted_directory(os.path.dirname(path), missing=True)
    if not os.path.lexists(path):
        refuse(f"the host's organization names no project {project} for {admin}; none is applied yet", 65)
    trusted(path, private=True)
    try:
        with open(path, encoding="utf-8") as stream:
            applied = json.load(stream)
    except (UnicodeError, ValueError):
        refuse(f"{path} holds no valid applied organization", 65)
    projects = applied.get("projects") if isinstance(applied, dict) else None
    revoked = applied.get("revoked") if isinstance(applied, dict) else None
    if (
        not isinstance(projects, list)
        or not isinstance(revoked, list)
        or not all(isinstance(item, str) for item in revoked)
    ):
        refuse(f"{path} holds no valid applied organization", 65)
    if admin in revoked:
        refuse(f"{admin} is revoked in the host's organization and registers no project", 65)
    named = [item for item in projects if isinstance(item, dict) and item.get("project") == project]
    members = [member for item in named for member in item.get("members", []) if isinstance(member, dict)]
    if not any(member.get("login") == admin and member.get("role") == "admin" for member in members):
        refuse(f"the host's organization names no project {project} for {admin}", 65)


def central_address(value):
    """Normalize only a forge repository's credential-free HTTPS or git SSH address."""
    name = r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}"
    host = r"[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?"
    match = re.fullmatch(rf"git@(?P<host>{host}):(?P<owner>{name})/(?P<repo>{name})", value)
    if match:
        server, owner, repository = match.group("host", "owner", "repo")
        origin, port = "https://" + server, None
    else:
        parsed = urllib.parse.urlsplit(value)
        match = re.fullmatch(rf"/(?P<owner>{name})/(?P<repo>{name})/?", parsed.path)
        if (parsed.scheme not in ("https", "ssh") or not parsed.hostname or not re.fullmatch(host, parsed.hostname)
                or not match or parsed.query or parsed.fragment or parsed.password
                or parsed.username != ("git" if parsed.scheme == "ssh" else None)):
            refuse("the project names no credential-free forge repository address", 65)
        server, owner, repository = parsed.hostname, *match.group("owner", "repo")
        port = parsed.port if parsed.scheme == "ssh" else None
        origin = "https://" + (parsed.netloc if parsed.scheme == "https" else server)
    repository = repository.removesuffix(".git")
    if not repository or repository.lower() in (".", "..", "repositories.json") or owner in (".", ".."):
        refuse("the project names no forge repository", 65)
    ssh = f"ssh://git@{server}{':' + str(port) if port else ''}/{owner}/{repository}.git"
    return origin, owner, repository, f"{origin}/{owner}/{repository}.git", ssh


class Central:
    """Use one in-memory credential only at the organization forge, refusing every redirect."""

    def __init__(self, credential, origin):
        self.credential = credential
        self.base = "https://api.github.com" if origin == "https://github.com" else origin + "/api/v1"
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())

    def request(self, method, path, body=None, expected=(200,)):
        """Suppress bodies and exception messages that could repeat the request's credential."""
        request = urllib.request.Request(self.base + path, method=method,
                                        data=None if body is None else json.dumps(body).encode(),
                                        headers={"Authorization": "token " + self.credential,
                                                 "Content-Type": "application/json"})
        try:
            with self.opener.open(request, timeout=30) as answer:
                status, data = answer.status, answer.read(1024 * 1024 + 1)
        except urllib.error.HTTPError as error:
            status, data = error.code, b""
            error.close()
        except (OSError, urllib.error.URLError, http.client.HTTPException):
            refuse("the central forge did not answer the deploy-key request", 69)
        if status not in expected or len(data) > 1024 * 1024:
            refuse(f"the central forge refused the deploy-key request (HTTP {status})", 69)
        try:
            return json.loads(data) if data else None
        except (ValueError, UnicodeError):
            refuse("the central forge answered malformed deploy-key JSON", 69)


def project_read_directory(project):
    """Keep each project's private read keys separate from member-readable project publications."""
    path = os.path.join(ETC, "organization", "read", "projects", project)
    parts = [os.path.join(ETC, "organization", "read"), os.path.dirname(path), path]
    for part in parts:
        trusted_directory(os.path.dirname(part))
        if not os.path.lexists(part):
            return path
        trusted_directory(part, private=True)
    return path


def project_manifest(project):
    """Read the keys and exact central addresses made for this project, never a member's config."""
    directory = project_read_directory(project)
    path = os.path.join(directory, "repositories.json")
    if not os.path.lexists(path):
        return directory, []
    trusted(path, private=True)
    try:
        with open(path, encoding="utf-8") as stream:
            entries = json.load(stream)
    except (ValueError, UnicodeError):
        refuse("the project's read-key manifest does not read", 65)
    if not isinstance(entries, list):
        refuse("the project's read-key manifest is malformed", 65)
    names = set()
    for item in entries:
        if (not isinstance(item, dict) or not isinstance(item.get("name"), str)
                or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}", item["name"])
                or item["name"] in names or not isinstance(item.get("address"), str)
                or type(item.get("key_id")) is not int or item["key_id"] < 0
                or not isinstance(item.get("title", ""), str)):
            refuse("the project's read-key manifest is malformed", 65)
        central_address(item["address"])
        names.add(item["name"])
    return directory, entries


def write_manifest(directory, entries):
    """Publish only nonsecret retry data, before any remote mutation needs recovery."""
    destination = os.path.join(directory, "repositories.json")
    temporary = stage_file(destination, ".repositories-", json.dumps(entries) + "\n")
    try:
        with writing(destination):
            os.replace(temporary, destination)
    finally:
        if os.path.lexists(temporary):
            os.unlink(temporary)


def project_git(arguments, *, environment=None, timeout=120):
    """Run read-only Git without global configuration, prompts or inherited credentials."""
    env = dict(SAFE_ENV, GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_SYSTEM="/dev/null", GIT_TERMINAL_PROMPT="0")
    env.update(environment or {})
    result = subprocess.run(["/usr/bin/git", "-c", "core.hooksPath=/dev/null", *arguments],
                            env=env, cwd="/", stdin=subprocess.DEVNULL, capture_output=True, text=True,
                            check=False, timeout=timeout)
    if result.returncode:
        refuse(f"the project read-only Git command failed (exit {result.returncode})", 69)
    return result.stdout


def read_key_ssh(directory, item):
    """The SSH command reaching the central forge with the repository's read key and the pinned host keys."""
    key = os.path.join(directory, item["name"].lower())
    known = os.path.join(ETC, "organization", "known_hosts")
    trusted(key, private=True)
    trusted(known, private=True)
    # All paths have passed the root-owned path checks; quote each for Git's SSH command parser.
    return " ".join(shlex.quote(word) for word in [
        "/usr/bin/ssh", "-F", "/dev/null", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "ConnectTimeout=10",
        "-o", "IdentityAgent=none", "-o", "StrictHostKeyChecking=yes", "-o", "UpdateHostKeys=no",
        "-o", "GlobalKnownHostsFile=/dev/null", "-o", "UserKnownHostsFile=" + known, "-i", key,
    ])


def central_commits(directory, item):
    """Fetch every central ref with the repository's read key and the pinned SSH host keys."""
    command = read_key_ssh(directory, item)
    with tempfile.TemporaryDirectory(prefix="porelo-project-read-") as scratch:
        path = os.path.join(scratch, "central.git")
        project_git(["clone", "--mirror", "--", central_address(item["address"])[4], path],
                    environment={"GIT_SSH_COMMAND": command})
        text = project_git(["--git-dir=" + path, "rev-list", "--all"])
    return commit_set(text)


def central_main(directory, item):
    """Ask the central forge for its main alone, bounded in time, as this runs at every follow and clones nothing."""
    text = project_git(["ls-remote", "--", central_address(item["address"])[4], "refs/heads/main"],
                       environment={"GIT_SSH_COMMAND": read_key_ssh(directory, item)}, timeout=CENTRAL_ASK_SECONDS)
    if not text.strip():
        return None
    commit = text.split("\t", 1)[0]
    if not re.fullmatch(COMMIT_PATTERN, commit):
        refuse("the central forge answered an invalid main", 69)
    return commit


def give_copy(path, account):
    """Hand a copy to the forge's account alone, which already holds the project's work, for Porelo to read as it."""
    owner = pwd.getpwnam(account)
    for folder, _folders, names in os.walk(path):
        os.chown(folder, owner.pw_uid, owner.pw_gid, follow_symlinks=False)
        for entry in names:
            os.chown(os.path.join(folder, entry), owner.pw_uid, owner.pw_gid, follow_symlinks=False)


def project_copy(project, address, known):
    """A bare copy of a repository's main that an isolated Porelo can read, or none if main is still the commit known."""
    _origin, _owner, name, wanted, _ssh = central_address(address)
    directory, entries = project_manifest(project)
    item = next((entry for entry in entries if entry["name"] == name), None)
    if item is None or item["key_id"] <= 0:
        refuse(f"the project has no read key for {name}", 69)
    if central_address(item["address"])[3] != wanted:
        refuse("the project's recorded central address differs", 65)
    trusted_directory(PROJECT_COPIES, missing=True)
    os.makedirs(PROJECT_COPIES, mode=0o711, exist_ok=True)
    os.chmod(PROJECT_COPIES, 0o711)
    for left in os.listdir(PROJECT_COPIES):
        shutil.rmtree(os.path.join(PROJECT_COPIES, left), ignore_errors=True)
    commit = central_main(directory, item)
    if commit is None:
        refuse(f"the central forge holds no main of {name}", 69)
    if commit == known:
        return {"commit": commit, "copy": None}
    secret = os.path.join(PROJECT_COPIES, secrets.token_hex(16))
    os.mkdir(secret, 0o700)
    path = os.path.join(secret, "central.git")
    project_git(["clone", "--bare", "--single-branch", "--branch", "main", "--",
                 central_address(item["address"])[4], path],
                environment={"GIT_SSH_COMMAND": read_key_ssh(directory, item)}, timeout=CENTRAL_ASK_SECONDS)
    give_copy(secret, setting(read_values(CONF), "account", r"[a-z_][a-z0-9_-]{0,31}"))
    return {"commit": commit, "copy": path}


# In Forgejo's container, on the repository's own folder: no hook or branch rule stands in the way, as main stays closed
# to any push, and the push judge sees nothing here. So main moves only forward. Where a task works in the repository it
# reaches `signed`: the newest change of project.yml in the commit Porelo verified, and only if the tree changes in
# nothing but that file, as other work takes the judged way, a person's pull request from central/main. Where no task
# works it reaches `tip`, the commit itself, unless something on the host would run part of it: a workflow, which the
# post-receive below starts, or a snippet file the project's images build from. Forgejo's own post-receive then
# tells its database. Each exit is one answer of ADVANCE_ANSWERS or a refusal; a temporary ref holds the commit while it
# is compared, and goes with the bundle.
ADVANCE_SCRIPT = r"""
umask 077
dir=$1
commit=$2
owner=$3
name=$4
reach=$5
bundle="$dir/porelo-advance.bundle"
git() { command git --git-dir="$dir" "$@"; }
clean() { rm -f "$bundle" && git update-ref -d refs/porelo/central; }
done_with() { clean || exit 69; exit "$1"; }
trap 'clean; exit 69' HUP INT TERM
above() {
    git merge-base --is-ancestor "$1" "$2"
    case $? in
        0) return 0 ;;
        1) return 1 ;;
        *) done_with 69 ;;
    esac
}
cat >"$bundle" || done_with 69
git fetch -q --no-tags "$bundle" "+refs/heads/main:refs/porelo/central" || done_with 69
[ "$(git rev-parse --verify --quiet 'refs/porelo/central^{commit}')" = "$commit" ] || done_with 65
# The commit Porelo judges the file by: the newer of its last change and the last commit signing it anew, on main's
# first-parent line, as Porelo's own reading of the project file takes it.
signed=$(git log -1 --first-parent --format=%H refs/porelo/central -- project.yml)
[ -n "$signed" ] || done_with 65
# Each trailer unfolded on a line of its own, its whole value compared, so neither a folded line nor a second word
# reads as the file signed anew.
trailers=$(git log --first-parent --format='commit %H%n%(trailers:key=Porelo-Signs-Anew,valueonly,unfold)' \
    refs/porelo/central) || done_with 69
anew=$(printf '%s\n' "$trailers" | awk '
    /^commit [0-9a-f]+$/ { hash = $2; next }
    $0 == "project.yml" && hash != "" { print hash; exit }
') || done_with 69
if [ -n "$anew" ] && [ "$anew" != "$signed" ] && above "$signed" "$anew" && above "$anew" "$commit"; then
    signed=$anew
fi
[ "$(git rev-parse --verify --quiet "$signed:project.yml")" = "$(git rev-parse --verify --quiet "$commit:project.yml")" ] \
    || done_with 65
local=$(git rev-parse --verify --quiet 'refs/heads/main^{commit}')
[ -n "$local" ] || done_with 69
if [ "$reach" = tip ]; then
    file=$(git show "$commit:project.yml") || done_with 69
    workflows=$(git ls-tree --name-only "$commit" -- .forgejo/workflows .gitea/workflows .github/workflows) || done_with 69
    case $file in
        *snippet_file*) reach=signed ;;
        *) [ -z "$workflows" ] || reach=signed ;;
    esac
fi
target=$signed
[ "$reach" != tip ] || target=$commit
[ "$local" != "$target" ] || done_with 0
if above "$local" "$target"; then
    if [ "$reach" != tip ]; then
        changed=$(git diff --name-only --no-renames "$local" "$target") || done_with 69
        case $changed in
            "" | project.yml) ;;
            *) done_with 13 ;;
        esac
    fi
    git update-ref refs/heads/main "$target" "$local" || done_with 69
    # The forge's first user is its admin, which the role makes before any other.
    (cd "$dir" && printf '%s %s refs/heads/main\n' "$local" "$target" | env SSH_ORIGINAL_COMMAND=internal \
        GITEA_REPO_USER_NAME="$owner" GITEA_REPO_NAME="$name" GITEA_REPO_IS_WIKI=false GITEA_PUSHER_NAME=porelo-admin \
        GITEA_PUSHER_ID=1 GITEA_PR_ID=0 forgejo hook post-receive >/dev/null 2>&1) || done_with 14
    done_with 10
fi
if above "$target" "$local"; then
    done_with 11
fi
done_with 12
"""
ADVANCE_ANSWERS = {
    0: "up-to-date",
    10: "moved",
    11: "ahead",
    12: "diverged",
    13: "other-changes",
    14: "moved-unseen",
}


def bundle_copy(account, path, output):
    """Have the copy's owner write its main into a file root opened, so root follows no path of theirs."""
    result = subprocess.run(
        ["/usr/sbin/runuser", "-u", account, "--", "/usr/bin/env", "-C", "/", "/usr/bin/git", f"--git-dir={path}",
         "bundle", "create", "-", "refs/heads/main"],
        stdout=output,
        stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL,
        check=False,
        cwd="/",
        env=SAFE_ENV,
        timeout=60,
    )
    if result.returncode:
        refuse("the verified copy could not be read", 69)


def project_advance(project, name, commit, path, reach):
    """Bring a repository's main on the host's forge up to the commit Porelo verified in the copy, and only forward."""
    directory, entries = project_manifest(project)
    item = next((entry for entry in entries if entry["name"] == name), None)
    if item is None or item["key_id"] <= 0:
        refuse(f"the project has no read key for {name}", 69)
    account = setting(read_values(CONF), "account", r"[a-z_][a-z0-9_-]{0,31}")
    with tempfile.TemporaryFile() as bundle:
        bundle_copy(account, path, bundle)
        bundle.seek(0)
        result = forge_exec(account, "sh", "-c", ADVANCE_SCRIPT, "advance",
                            "/var/lib/gitea/git/repositories/" + project + "/" + name.lower() + ".git", commit,
                            project, name.lower(), reach, given=bundle)
    if result.returncode == 65:
        refuse("the copy no longer holds the commit Porelo verified", 65)
    if result.returncode not in ADVANCE_ANSWERS:
        refuse(f"the local forge could not bring {name} up to the commit verified", 69)
    return {"state": ADVANCE_ANSWERS[result.returncode]}


def repository_state(account, project, name, directory, item):
    """Tell one repository's local main against the central forge's; what cannot be told never reads as up to date."""
    if item["key_id"] <= 0:
        return {"state": "cannot-say", "why": "no-read-key"}
    try:
        central = central_main(directory, item)
    except (Refusal, OSError, subprocess.TimeoutExpired):
        return {"state": "cannot-say", "why": "unreachable"}
    if central is None:
        return {"state": "cannot-say", "why": "no-central-main"}
    try:
        found = forge_read(account, project, name, "rev-parse", "--verify", "--quiet", "refs/heads/main^{commit}")
        if found.returncode:
            return {"state": "cannot-say", "why": "local"}
        if found.stdout.strip() == central:
            return {"state": "up-to-date"}
        # Unknown here or on another line alike: a push of this main would be refused.
        if forge_read(account, project, name, "merge-base", "--is-ancestor", central, "refs/heads/main").returncode:
            return {"state": "moved-on"}
        counted = forge_read(account, project, name, "rev-list", "--count", f"{central}..refs/heads/main")
        if counted.returncode or not counted.stdout.strip().isdecimal():
            return {"state": "cannot-say", "why": "local"}
    except (Refusal, OSError, subprocess.TimeoutExpired):
        return {"state": "cannot-say", "why": "local"}
    return {"state": "ahead", "commits": int(counted.stdout)}


def central_state(account, project):
    """Each repository's main against the central forge; as this runs at every follow it makes the forge no token."""
    directory, entries = project_manifest(project)
    answers = [{"repository": item["name"], **repository_state(account, project, item["name"], directory, item)}
               for item in entries]
    known = {item["name"].lower() for item in entries}
    answers.extend({"repository": name, "state": "cannot-say", "why": "no-read-key"}
                   for name in forge_repositories(account, project) if name not in known)
    return {"project": project, "repositories": answers}


def commit_set(text):
    """Reject incomplete or malformed Git answers before deciding that work is safe to delete."""
    lines = text.splitlines()
    if any(not re.fullmatch(COMMIT_PATTERN, line) for line in lines):
        refuse("Git answered an invalid commit set", 69)
    return set(lines)


def check_read_keys(forge, project, repositories):
    """Compare every local ref with central reachability, using no central write token."""
    directory, entries = project_manifest(project)
    by_name = {entry["name"]: entry for entry in entries}
    missing = {}
    for repository in repositories:
        name = repository["name"]
        item = by_name.get(name)
        if item is None or repository.get("original_url") != central_address(item["address"])[3] or item["key_id"] <= 0:
            refuse(f"{project}/{name} has no confirmed read key for its central address", 69)
        local = forge_git(forge.account, project, name)
        unpushed = sorted(commit_set(local) - central_commits(directory, item))
        if unpushed:
            missing[name] = unpushed
    if missing:
        error = Refusal(f"{project} has unpushed commits in " + ", ".join(missing), 65)
        error.unpushed = missing
        raise error


def forge_read(account, project, repository, *arguments):
    """Ask one repository inside Forgejo's container, answering Git's exit and output as they are."""
    return forge_exec(account, "git",
                      "--git-dir=/var/lib/gitea/git/repositories/" + project + "/" + repository.lower() + ".git",
                      *arguments)


def forge_repositories(account, project):
    """The names of a project's repositories in Forgejo's own folder, as the API would take a new token to ask."""
    result = forge_exec(account, "ls", "/var/lib/gitea/git/repositories/" + project)
    if result.returncode:
        refuse(f"the local forge could not list the repositories of {project}", 69)
    names = [line.removesuffix(".git") for line in result.stdout.splitlines()]
    if any(not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", name) for name in names):
        refuse(f"the local forge holds an invalid repository name for {project}", 69)
    return names


def forge_git(account, project, repository):
    """Read all local refs inside Forgejo's container, without giving root a forge-owned path."""
    result = forge_exec(account, "git",
                        "--git-dir=/var/lib/gitea/git/repositories/" + project + "/" + repository.lower() + ".git",
                        "rev-list", "--all")
    if result.returncode:
        refuse(f"the local forge could not list all commits of {project}/{repository}", 69)
    return result.stdout


def replace_own_keys(central, route, stale):
    """Delete this host's earlier key for this project, whose private half left with the project."""
    for value in stale:
        if value.get("read_only") is not True or type(value.get("id")) is not int or value["id"] <= 0:
            refuse("the central forge holds a key with write access under this host's title; keeping it", 65)
    for value in stale:
        central.request("DELETE", f"{route}/{value['id']}", expected=(204,))


def left_at_central(project):
    """What removal cannot delete without a central token: a read key under the title it was made with."""
    return [
        {"address": item["address"], "title": item.get("title", "porelo-host-" + project)}
        for item in project_manifest(project)[1]
        if item["key_id"] > 0
    ]


def migrate(forge, project, supplied):
    """Migrate the state's project repository once, with a central token used only in memory."""
    try:
        request = json.loads(supplied)
    except (ValueError, UnicodeError):
        refuse("migration requires a JSON request on standard input", 64)
    if (not isinstance(request, dict) or set(request) != {"address", "token"}
            or not isinstance(request["address"], str) or not isinstance(request["token"], str)
            or not re.fullmatch(r"[!-~]{1,4096}", request["token"])):
        refuse("migration requires an address and one printable token on standard input", 64)
    origin, owner, name, address, _ssh = central_address(request["address"])
    settings = os.path.join(ETC, "organization", "organization.yml")
    trusted(settings, private=True)
    with open(settings, encoding="utf-8") as stream:
        text = stream.read()
    # Porelo has already accepted these adapter settings; refuse spellings this helper cannot bind to one origin.
    matches = re.findall(r"^\s+repository:\s*(['\"]?)([^\s'\"]+)\1\s*$", text, re.MULTILINE)
    if len(matches) != 1 or central_address(matches[0][1])[0] != origin:
        refuse("migration's central forge differs from the organization's forge or its settings do not read", 65)
    directory, entries = project_manifest(project)
    for path in (os.path.dirname(directory), directory):
        trusted_directory(path, private=True, missing=True)
        os.makedirs(path, mode=0o700, exist_ok=True)
    item = next((entry for entry in entries if entry["name"] == name), None)
    if item is None:
        item = {"name": name, "address": request["address"], "key_id": 0}
        entries.append(item)
        write_manifest(directory, entries)
    elif central_address(item["address"])[3] != address:
        refuse("the project's recorded central address differs; keeping the existing repository", 65)
    key = os.path.join(directory, name.lower())
    if not os.path.lexists(key):
        made = subprocess.run(["/usr/bin/ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "", "-f", key],
                              env=SAFE_ENV, stdin=subprocess.DEVNULL, capture_output=True, check=False, timeout=30)
        if made.returncode:
            refuse("the project's read key could not be made", 69)
    trusted(key, private=True)
    if not os.path.lexists(key + ".pub"):
        derived = subprocess.run(["/usr/bin/ssh-keygen", "-y", "-P", "", "-f", key],
                                 env=SAFE_ENV, stdin=subprocess.DEVNULL, capture_output=True,
                                 text=True, check=False, timeout=30)
        if derived.returncode:
            refuse("the project's public read key could not be recovered", 69)
        public = signing_key(derived.stdout.strip(), code=65)
        temporary = stage_file(key + ".pub", ".repositories-", public + "\n")
        try:
            with writing(key + ".pub"):
                os.replace(temporary, key + ".pub")
        finally:
            if os.path.lexists(temporary):
                os.unlink(temporary)
    trusted(key + ".pub")
    with open(key + ".pub", encoding="utf-8") as stream:
        public = signing_key(stream.read().strip(), code=65)
    central = Central(request["token"], origin)
    route = f"/repos/{owner}/{name}/keys"
    if item["key_id"] == 0:
        title = f"porelo host {setting(read_values(CONF), 'host', HOST_PATTERN)} project {project}"
        existing, stale = [], []
        seen = set()
        for page in range(1, 101):
            keys = central.request("GET", route + f"?page={page}&per_page=50&limit=50")
            if not isinstance(keys, list) or any(not isinstance(value, dict) for value in keys):
                refuse("the central forge answered malformed deploy keys", 69)
            if not keys:
                break
            digest = json.dumps(keys, sort_keys=True)
            if digest in seen:
                refuse("the central forge repeated a deploy-key page", 69)
            seen.add(digest)
            existing.extend(value for value in keys if value.get("key") == public)
            stale.extend(value for value in keys if value.get("title") == title and value.get("key") != public)
        else:
            refuse("the central forge did not finish listing deploy keys", 69)
        replace_own_keys(central, route, stale)
        made = existing[0] if len(existing) == 1 else central.request("POST", route, {
            "title": title, "key": public, "read_only": True,
        }, expected=(201,)) if not existing else None
        if (not isinstance(made, dict) or type(made.get("id")) is not int or made["id"] <= 0
                or made.get("read_only") is not True or made.get("key") != public):
            refuse("the central forge confirmed no matching read-only deploy key", 69)
        item["key_id"] = made["id"]
        item["title"] = made["title"] if isinstance(made.get("title"), str) else title
        write_manifest(directory, entries)
    local = forge.request("GET", f"/repos/{project}/{name}", expected=(200, 404))
    if local is None:
        forge.request("POST", "/repos/migrate", {
            "clone_addr": address, "repo_name": name, "repo_owner": project, "service": "git",
            "mirror": False, "private": True, "auth_username": "x-access-token", "auth_password": request["token"],
        }, expected=(201,))
        local = forge.request("GET", f"/repos/{project}/{name}")
    if not isinstance(local, dict) or local.get("original_url") != address:
        refuse("the local forge has no migration from the project's central address", 69)
    protect_repository(forge, project, name)


def read_key_paths(project):
    """Refuse unknown read-directory entries before any destructive operation."""
    directory, entries = project_manifest(project)
    if not os.path.lexists(directory):
        return directory, []
    expected = {"repositories.json"} | {item["name"].lower() + suffix for item in entries for suffix in ("", ".pub")}
    paths = []
    for name in os.listdir(directory):
        if name not in expected and not name.startswith(".repositories-"):
            refuse("the project's read directory holds an unknown file; keeping it", 73)
        path = os.path.join(directory, name)
        trusted(path)
        paths.append(path)
    return directory, paths


def drop_read_keys(project):
    """Remove exactly this project's local read credentials after every forge deletion has succeeded."""
    directory, paths = read_key_paths(project)
    if not os.path.lexists(directory):
        return
    for path in sorted(paths, key=lambda item: os.path.basename(item) == "repositories.json"):
        os.unlink(path)
    os.rmdir(directory)


def inherited_lock(descriptor):
    """Require the inherited open file to be the trusted configuration, then take its shared open description's lock."""
    try:
        status = os.fstat(descriptor)
        expected = os.stat(CONF, follow_symlinks=False)
        if (status.st_dev, status.st_ino) != (expected.st_dev, expected.st_ino):
            refuse("the inherited project lock is not forge.conf", 65)
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (OSError, ValueError):
        refuse("the inherited project lock is unavailable", 69)


def pool_projects():
    """Name every project of the host from its records, which every organization here has."""
    directory = os.path.join(ETC, "projects")
    trusted_directory(directory, private=True, missing=True)
    if not os.path.lexists(directory):
        return []
    names = sorted(name.removesuffix(".conf") for name in os.listdir(directory) if name.endswith(".conf"))
    for name in names:
        if not re.fullmatch(PROJECT_PATTERN, name):
            refuse("the project records hold an invalid name", 65)
    return names


def pool_key_held(forge, project):
    """Say whether an organization holds the run key; Forgejo names a secret and never gives it back."""
    return any(item.get("name") == POOL_SECRET for item in forge.listing(f"/orgs/{project}/actions/secrets"))


def pool_key_send(forge):
    """Give the key to each organization lacking it, and to all when it changed, marking that only at the end."""
    trusted(POOL_RUN_KEY, private=True)
    with open(POOL_RUN_KEY, encoding="utf-8") as stream:
        secret = stream.read()
    digest = hashlib.sha256(secret.encode()).hexdigest()
    sent = POOL_RUN_KEY + ".sent"
    known = None
    if os.path.lexists(sent):
        trusted(sent, private=True)
        with open(sent, encoding="utf-8") as stream:
            known = stream.read().strip()
    changed = []
    for project in pool_projects():
        if digest != known or not pool_key_held(forge, project):
            forge.request("PUT", f"/orgs/{project}/actions/secrets/{POOL_SECRET}", {"data": secret}, (201, 204))
            changed.append(project)
    if digest != known:
        descriptor, staged = tempfile.mkstemp(dir=os.path.dirname(sent), prefix=".run-key.sent.")
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            os.fchmod(output.fileno(), 0o600)
            output.write(digest + "\n")
        os.replace(staged, sent)
    return changed


def pool_key_withdraw(forge):
    """Take the run key from every organization holding it, and nothing else."""
    changed = []
    for project in pool_projects():
        if pool_key_held(forge, project):
            forge.request("DELETE", f"/orgs/{project}/actions/secrets/{POOL_SECRET}", expected=(204,))
            changed.append(project)
    return changed


def pool_key_gone(values):
    """Say whether down has no forge left to ask: the jobs a key could reach went with it."""
    try:
        pwd.getpwnam(setting(values, "account", r"[a-z_][a-z0-9_-]{0,31}"))
    except KeyError:
        return True
    return not Forge(values, authenticate=False).answers()


def run_pool_key(direction, lock_fd):
    """Send or withdraw the run key under the one lock, answering which projects changed."""
    if direction not in ("send", "withdraw"):
        refuse("usage: pool-key send | pool-key withdraw", 64)
    changed = []
    if direction == "send" or os.path.lexists(CONF):
        trusted(CONF)
        with open(CONF, encoding="utf-8") as lock:
            if lock_fd is None:
                fcntl.flock(lock, fcntl.LOCK_EX)
            else:
                inherited_lock(lock_fd)
            values = read_values(CONF)
            if direction == "send":
                changed = pool_key_send(Forge(values))
            elif not pool_key_gone(values):
                changed = pool_key_withdraw(Forge(values))
    with writing("standard output"):
        print(json.dumps({"changed": changed}, separators=(",", ":")), flush=True)


def run():
    """Check root before the call or filesystem, then hold one lock through all preflight and mutation."""
    if os.geteuid() != 0:
        refuse("runs only as root", 69)
    os.umask(0o077)
    os.environ.clear()
    os.environ.update(SAFE_ENV)
    arguments = sys.argv[1:]
    lock_fd = None
    if len(arguments) >= 2 and arguments[-2] == "--lock-fd":
        if not re.fullmatch(r"[0-9]{1,8}", arguments[-1]):
            refuse("the inherited lock descriptor is invalid", 64)
        lock_fd = int(arguments[-1])
        arguments = arguments[:-2]
    if arguments[:1] == ["pool-key"]:
        run_pool_key(arguments[1] if len(arguments) == 2 else "", lock_fd)
        return
    if len(arguments) == 5 and arguments[0] == "add" and arguments[3] == "--signed-by":
        action, project, admin, _, key = arguments
    elif len(arguments) == 2 and arguments[0] in ("remove", "migrate", "central-state"):
        action, project = arguments
        admin = key = None
    elif len(arguments) == 4 and arguments[0] == "project-copy":
        action, project, copied, known = arguments
        admin = key = None
        if known != "-" and not re.fullmatch(COMMIT_PATTERN, known):
            refuse("project-copy takes a known commit or -", 64)
    elif len(arguments) == 6 and arguments[0] == "project-advance":
        action, project, named, commit, copied, reach = arguments
        admin = key = None
        if (not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}", named) or not re.fullmatch(COMMIT_PATTERN, commit)
                or not re.fullmatch(re.escape(PROJECT_COPIES) + r"/[0-9a-f]{32}/central\.git", copied)
                or reach not in ("signed", "tip")):
            refuse("project-advance takes a repository's name, a commit, a copy of this helper's and signed or tip", 64)
    else:
        refuse('usage: add <project> <admin> --signed-by "ssh-ed25519 <base64>" | remove <project> | central-state <project>', 64)
    if not re.fullmatch(PROJECT_PATTERN, project):
        refuse("project must be 1 to 40 lowercase letters, digits or internal hyphens", 64)
    if action == "add":
        if not re.fullmatch(PERSON_PATTERN, admin):
            refuse("admin must be a registered person's user name", 64)
        signing_key(key)
    record = os.path.join(ETC, "projects", project + ".conf")
    if action == "add" and os.path.lexists(record):
        refuse(f"{record} exists")
    if action != "add" and not os.path.lexists(record):
        refuse(f"unknown project {project}")
    for name in ("projects", "people"):
        trusted_directory(os.path.join(ETC, name), private=True, missing=True)
    if action == "add":
        person = os.path.join(ETC, "people", admin + ".conf")
        # The records say no: an admin must have been admitted as a person first.
        if not os.path.lexists(person):
            refuse(f"{admin} is no person on this host", 65)
        trusted(person, private=True)
    else:
        trusted(record, private=True)
    trusted(CONF)
    with open(CONF, encoding="utf-8") as lock:
        if lock_fd is None:
            fcntl.flock(lock, fcntl.LOCK_EX)
        else:
            inherited_lock(lock_fd)
        if action == "add" and os.path.lexists(record):
            refuse(f"{record} exists")
        if action != "add" and not os.path.lexists(record):
            refuse(f"unknown project {project}")
        if action == "add":
            members, locked, pending, card = admitted(admin, person)
            named_in_organization(project, admin)
            person_content = format_person([*members, f"{project} project-admin"], locked, pending, card)
            affected = None
            publisher = None
        elif action in ("central-state", "project-copy", "project-advance"):
            publisher = affected = person_content = None
        else:
            publisher = registered_publisher(project, record)
            affected = people_after_removal(project)
            person_content = None
        left = left_at_central(project) if action == "remove" else []
        if action == "central-state":
            account = setting(read_values(CONF), "account", r"[a-z_][a-z0-9_-]{0,31}")
            with writing("standard output"):
                print(json.dumps(central_state(account, project), separators=(",", ":")), flush=True)
            return
        if action == "project-copy":
            with writing("standard output"):
                print(json.dumps(project_copy(project, copied, known), separators=(",", ":")), flush=True)
            return
        if action == "project-advance":
            with writing("standard output"):
                print(json.dumps(project_advance(project, named, commit, copied, reach), separators=(",", ":")), flush=True)
            return
        forge = Forge(read_values(CONF))
        if action == "add":
            add(forge, project, admin, key, record, person, person_content)
        elif action == "migrate":
            migrate(forge, project, sys.stdin.read(16385))
        else:
            remove(forge, project, record, publisher, affected)
    if action == "remove":
        with writing("standard output"):
            answer = dict(project=project, removed=True)
            if left:
                answer["left_at_central"] = left
            print(json.dumps(answer, separators=(",", ":")), flush=True)


def main():
    """Keep unexpected dependency errors and interrupts free of credentials and tracebacks."""
    try:
        run()
    except Refusal as error:
        failure = error
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        failure = Refusal(f"dependency or file read failed: {type(error).__name__}", 69)
    except KeyboardInterrupt:
        failure = Refusal("input interrupted", 64)
    except EOFError:
        failure = Refusal("no central forge token was given", 64)
    else:
        return
    try:
        if "--lock-fd" in sys.argv and sys.argv[1:2] == ["remove"] and failure.code == 65:
            project = sys.argv[2]
            print(json.dumps({"project": project, "unpushed": getattr(failure, "unpushed", {})}), flush=True)
        print(f"porelo-host-project: {failure}", file=sys.stderr, flush=True)
    except OSError:
        sys.exit(73)
    sys.exit(failure.code)


if __name__ == "__main__":
    main()
