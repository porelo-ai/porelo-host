#!/usr/bin/python3 -I
"""Register a forge organization and its package publisher, or remove it after checking the central forge.

Tokens stay in this process and the forge. The publisher's generated password is discarded by Forgejo's CLI,
and its package token goes directly to the organization's Actions secret over the private socket.
"""

import base64
import binascii
import fcntl
import getpass
import http.client
import pwd
import json
import os
import re
import secrets
import socket
import stat
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from contextlib import contextmanager

ETC = "/etc/porelo-host"
CONF = "/etc/porelo-host/forge.conf"
PUSH = "/usr/local/sbin/porelo-host-push"
PERSON = "/usr/local/sbin/porelo-host-person"
ROOT_UID = 0
TRUST_ANCHOR = "/"
PROJECT_PATTERN = r"[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?"
PERSON_PATTERN = r"[a-z][a-z0-9-]{0,30}"
COMMIT_PATTERN = r"[0-9a-f]{40}([0-9a-f]{24})?"
ED25519_HEADER = b"\x00\x00\x00\x0bssh-ed25519\x00\x00\x00\x20"
SAFE_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}


class Refusal(Exception):
    """A diagnostic safe to show without a request body or command output."""

    def __init__(self, message, code=65):
        super().__init__(message)
        self.code = code


def refuse(message, code=65):
    """Stop with a diagnostic that contains no credential."""
    raise Refusal(message, code)


def signing_key(value, source="signing key", code=64):
    """Require one comment-free canonical SSH Ed25519 key, retaining exactly the supplied spelling."""
    try:
        algorithm, encoded = value.split(" ", 1)
        wire = base64.b64decode(encoded, validate=True)
    except (ValueError, binascii.Error):
        refuse(f"{source} must be one canonical ssh-ed25519 signing key without a comment", code)
    if (
        algorithm != "ssh-ed25519"
        or len(wire) != 51
        or not wire.startswith(ED25519_HEADER)
        or base64.b64encode(wire).decode("ascii") != encoded
    ):
        refuse(f"{source} must be one canonical ssh-ed25519 signing key without a comment", code)
    return value


@contextmanager
def writing(destination):
    """Keep write failures distinct from unavailable dependencies, without showing data being written."""
    try:
        yield
    except OSError as error:
        refuse(f"cannot write {destination}: {type(error).__name__}", 73)


def trusted_directory(path, private=False, missing=False):
    """Check the entire path without following links; missing record directories are checked before creation."""
    if path == TRUST_ANCHOR:
        return
    trusted_directory(os.path.dirname(path))
    try:
        status = os.lstat(path)
    except FileNotFoundError:
        if missing:
            return
        refuse(f"{path} is missing; run up first", 69)
    mask = 0o077 if private else 0o022
    if not stat.S_ISDIR(status.st_mode) or status.st_uid != ROOT_UID or status.st_mode & mask:
        refuse(f"{path} is not a directory root's alone {'to read' if private else 'to write'}", 69)
    if private and stat.S_IMODE(status.st_mode) != 0o700:
        refuse(f"{path} must have mode 0700", 69)


def trusted(path, private=False):
    """Require a plain file owned by root, with no untrusted writable parent."""
    trusted_directory(os.path.dirname(path))
    try:
        status = os.lstat(path)
    except FileNotFoundError:
        refuse(f"{path} is missing; no registered record or forge settings", 69)
    mask = 0o077 if private else 0o022
    if not stat.S_ISREG(status.st_mode) or status.st_uid != ROOT_UID or status.st_mode & mask:
        refuse(f"{path} is not a plain file root's alone {'to read' if private else 'to write'}", 69)
    return status


def read_values(path, code=69):
    """Read exactly one value for each key, refusing ambiguous configuration."""
    values = {}
    try:
        with open(path, encoding="utf-8") as lines:
            for line in lines:
                key, separator, value = line.rstrip("\n").partition("=")
                if not separator or key in values:
                    refuse(f"{path} has a malformed or duplicate setting", code)
                values[key] = value
    except UnicodeError:
        refuse(f"{path} is not UTF-8", code)
    return values


def setting(values, key, pattern, path=CONF, code=69):
    """Require a configured value of the expected shape before using it in a command or URL."""
    value = values.get(key, "")
    if not re.fullmatch(pattern, value):
        refuse(f"{path} names no valid {key}", code)
    return value


def member_key(value):
    """Return the canonical sort key for one membership value, refusing unknown shapes."""
    if value == "hand":
        return (0, "", 0)
    parts = value.split(" ")
    if len(parts) == 2 and re.fullmatch(PROJECT_PATTERN, parts[0]) and parts[1] in ("project-admin", "developer"):
        return (1, parts[0], 0 if parts[1] == "project-admin" else 1)
    refuse("a person record holds an invalid membership", 65)


def read_person(user, path):
    """Read and validate one trusted person record, accepting the legacy role-based shape."""
    trusted(path, private=True)
    try:
        with open(path, encoding="utf-8") as stream:
            lines = stream.read().splitlines()
    except UnicodeError:
        refuse(f"{path} is not UTF-8", 69)
    if (
        len(lines) >= 4
        and lines[0] == "role=project-admin"
        and lines[1] == "projects="
        and lines[2] in ("locked=false", "locked=true")
        and all(line.startswith("laptop=") and len(line) > 7 for line in lines[3:])
    ):
        return ["hand"], lines[2] == "locked=true", lines[3:]
    members, previous = [], None
    index = 0
    while index < len(lines) and lines[index].startswith("member="):
        member = lines[index][7:]
        order = member_key(member)
        if previous is not None and order <= previous:
            refuse(f"the record for {user} is malformed", 65)
        members.append(member)
        previous = order
        index += 1
    if (
        len(lines) < index + 2
        or lines[index] not in ("locked=false", "locked=true")
        or any(not line.startswith("laptop=") or len(line) <= 7 for line in lines[index + 1 :])
    ):
        refuse(f"the record for {user} is malformed", 65)
    return members, lines[index] == "locked=true", lines[index + 1 :]


def format_person(members, locked, laptops):
    """Serialize a person's record in canonical membership order."""
    ordered = sorted(set(members), key=member_key)
    return (
        "".join(f"member={item}\n" for item in ordered)
        + f"locked={'true' if locked else 'false'}\n"
        + "".join(f"{line}\n" for line in laptops)
    )


def stage_file(destination, prefix, content):
    """Write and sync one private staging file beside its destination before publication."""
    descriptor = temporary = None
    try:
        with writing(destination):
            descriptor, temporary = tempfile.mkstemp(prefix=prefix, dir=os.path.dirname(destination))
            output = os.fdopen(descriptor, "w", encoding="utf-8")
            descriptor = None
            with output:
                os.fchmod(output.fileno(), 0o600)
                output.write(content)
                output.flush()
                os.fsync(output.fileno())
        return temporary
    except BaseException:
        if temporary is not None:
            with writing(temporary):
                if descriptor is not None:
                    os.close(descriptor)
                if os.path.lexists(temporary):
                    os.unlink(temporary)
        raise


def forge_command(account, *arguments):
    """Run the forge CLI with a fixed environment and no input, capturing all output in memory."""
    uid = subprocess.run(
        ["/usr/bin/id", "-u", account],
        capture_output=True,
        text=True,
        check=False,
        env=SAFE_ENV,
        timeout=10,
    )
    number = uid.stdout.strip()
    if uid.returncode or not re.fullmatch(r"[1-9][0-9]*", number):
        refuse(f"the forge's account {account} is not known, or is root", 69)
    return subprocess.run(
        [
            "/usr/sbin/runuser",
            "-u",
            account,
            "--",
            "/usr/bin/env",
            f"XDG_RUNTIME_DIR=/run/user/{number}",
            "/usr/bin/podman",
            "exec",
            "forgejo",
            "forgejo",
            "admin",
            "user",
            *arguments,
        ],
        capture_output=True,
        text=True,
        check=False,
        cwd="/",
        env=SAFE_ENV,
        stdin=subprocess.DEVNULL,
        timeout=60,
    )


def token(account, username, scopes):
    """Make a scoped token with a unique nonsecret name, never exposing CLI output on failure."""
    made = forge_command(
        account,
        "generate-access-token",
        "--username",
        username,
        "--token-name",
        "porelo-host-project-" + secrets.token_hex(16),
        "--scopes",
        scopes,
        "--raw",
    )
    value = made.stdout.strip()
    if made.returncode or not re.fullmatch(r"[0-9a-f]{40}", value):
        refuse(f"Forgejo made no token for {username} (exit {made.returncode})", 69)
    return value


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Keep a credential from following a forge redirect."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class UnixConnection(http.client.HTTPConnection):
    """Reach only the forge account's private socket."""

    def __init__(self, path, **kwargs):
        super().__init__("localhost", **kwargs)
        self.path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.path)


class UnixHandler(urllib.request.HTTPHandler):
    """Use HTTP framing without a TCP listener or proxy."""

    def __init__(self, path):
        super().__init__()
        self.path = str(path)

    def http_open(self, request):
        return self.do_open(lambda host, **kwargs: UnixConnection(self.path, **kwargs), request)


class Forge:
    """The host forge's API, reached only on the account's private socket."""

    def __init__(self, values):
        self.account = setting(values, "account", r"[a-z_][a-z0-9_-]{0,31}")
        try:
            uid = pwd.getpwnam(self.account).pw_uid
        except KeyError:
            refuse("the forge account is missing", 69)
        self.opener = urllib.request.build_opener(
            urllib.request.ProxyHandler({}),
            UnixHandler(f"/run/user/{uid}/porelo-forge/http.sock"),
            NoRedirect(),
        )
        self.base = "http://localhost/api/v1"
        self.token = token(
            self.account,
            "porelo-admin",
            "write:admin,write:organization,read:user,write:repository,write:package",
        )

    def request(self, method, path, body=None, expected=(200,)):
        """Return validated JSON, or only the HTTP code in an error; never repeat a remote body."""
        request = urllib.request.Request(
            self.base + path,
            data=json.dumps(body).encode() if body is not None else None,
            method=method,
            headers={"Authorization": "token " + self.token, "Content-Type": "application/json"},
        )
        try:
            with self.opener.open(request, timeout=30) as answer:
                status, data = answer.status, answer.read()
        except urllib.error.HTTPError as error:
            status, data = error.code, b""
            error.close()
        except (urllib.error.URLError, OSError, http.client.HTTPException) as error:
            refuse(f"the forge did not answer {method} {path}: {type(error).__name__}", 69)
        if status not in expected:
            # A forge that fails in itself is missing; one that answers otherwise says no.
            refuse(f"the forge answered HTTP {status} for {method} {path}", 69 if status >= 500 else 65)
        if status == 404 or (not data and method != "GET"):
            return None
        try:
            result = json.loads(data)
        except (ValueError, UnicodeError):
            refuse(f"the forge sent invalid JSON for {method} {path}")
        if result is None:
            refuse(f"the forge sent no identity or list for {method} {path}")
        return result

    def listing(self, path):
        """Read every page, stopping on a repeated page instead of trusting an incomplete reference set."""
        result, seen = [], set()
        for page in range(1, 101):
            items = self.request("GET", f"{path}?limit=50&page={page}")
            if not isinstance(items, list) or any(not isinstance(item, dict) for item in items):
                refuse(f"the forge sent no list for {path}")
            if not items:
                return result
            digest = json.dumps(items, sort_keys=True)
            if digest in seen:
                refuse(f"the forge repeated a page for {path}")
            seen.add(digest)
            result.extend(items)
        refuse(f"the forge did not finish listing {path} in 100 pages")


def add(forge, project, admin, key, record, person, person_content):
    """Validate all existing identities before making one organization and an isolated package publisher."""
    publisher = "porelo-publisher-" + project
    for kind, path in (
        ("organization", f"/orgs/{project}"),
        ("user", f"/users/{project}"),
        ("publisher", f"/users/{publisher}"),
    ):
        if forge.request("GET", path, expected=(200, 404)) is not None:
            refuse(f"the forge already has {kind} {path.rsplit('/', 1)[1]}")
    if forge.request("GET", f"/users/{admin}", expected=(200, 404)) is None:
        refuse(f"the forge has no admin login {admin}")
    for name in ("projects", "people"):
        with writing(os.path.join(ETC, name)):
            os.makedirs(os.path.join(ETC, name), mode=0o700, exist_ok=True)
    with writing(record):
        descriptor, temporary = tempfile.mkstemp(prefix=f".{project}-", dir=os.path.dirname(record))
    person_temporary = None
    organization_made = publisher_made = False
    try:
        person_temporary = stage_file(person, f".{admin}-", person_content)
        forge.request("POST", f"/admin/users/{admin}/orgs", {"username": project, "visibility": "private"}, (201,))
        organization_made = True
        owners = [team for team in forge.listing(f"/orgs/{project}/teams") if team.get("name") == "Owners"]
        if len(owners) != 1 or type(owners[0].get("id")) is not int or owners[0]["id"] <= 0:
            refuse(f"the forge has no unique Owners team for {project}")
        forge.request("PUT", f"/teams/{owners[0]['id']}/members/{admin}", expected=(204,))
        made = forge_command(
            forge.account,
            "create",
            "--username",
            publisher,
            "--email",
            f"{publisher}@porelo.invalid",
            "--random-password",
            "--must-change-password=false",
        )
        if made.returncode:
            refuse(f"Forgejo made no publisher {publisher} (exit {made.returncode})", 69)
        publisher_made = True
        team = forge.request(
            "POST",
            f"/orgs/{project}/teams",
            {
                "name": "publishers",
                "permission": "write",
                "units": ["repo.packages"],
                "units_map": {"repo.packages": "write"},
                "includes_all_repositories": False,
                "can_create_org_repo": False,
            },
            (201,),
        )
        if not isinstance(team, dict) or type(team.get("id")) is not int or team["id"] <= 0:
            refuse(f"the forge returned no valid publishers team for {project}")
        forge.request("PUT", f"/teams/{team['id']}/members/{publisher}", expected=(204,))
        secret = token(forge.account, publisher, "write:package")
        forge.request("PUT", f"/orgs/{project}/actions/secrets/PORELO_PUBLISHER_TOKEN", {"data": secret}, (201, 204))
        with writing(record):
            output = os.fdopen(descriptor, "w", encoding="utf-8")
            descriptor = None
            with output:
                os.fchmod(output.fileno(), 0o600)
                output.write(f"admin={admin}\nsigned_by={key}\npublisher={publisher}\n")
                output.flush()
                os.fsync(output.fileno())
            # A link publishes the complete file atomically without replacing another writer's pinned key.
            try:
                os.link(temporary, record)
            except FileExistsError:
                refuse(f"{record} exists")
        try:
            with writing(person):
                os.replace(person_temporary, person)
        except BaseException:
            with writing(record):
                os.unlink(record)
            raise
    except (Refusal, OSError, subprocess.SubprocessError, KeyboardInterrupt) as error:
        left = []
        for made, kind, name, path in (
            (organization_made, "organization", project, f"/orgs/{project}"),
            (publisher_made, "publisher", publisher, f"/admin/users/{publisher}"),
        ):
            if made:
                try:
                    forge.request("DELETE", path, expected=(204,))
                except (Refusal, OSError, subprocess.SubprocessError):
                    left.append(f"{kind} {name}")
        if left:
            cause = str(error) if isinstance(error, Refusal) else type(error).__name__
            code = error.code if isinstance(error, Refusal) else 64 if isinstance(error, KeyboardInterrupt) else 69
            refuse(f"{cause}; cleanup left {', '.join(left)}", code)
        raise
    finally:
        if person_temporary is not None:
            with writing(person_temporary):
                if os.path.lexists(person_temporary):
                    os.unlink(person_temporary)
        with writing(temporary):
            if descriptor is not None:
                os.close(descriptor)
            if os.path.lexists(temporary):
                os.unlink(temporary)
    with writing("standard output"):
        print(
            json.dumps(
                dict(project=project, admin=admin, organization=project, publisher=publisher), separators=(",", ":")
            ),
            flush=True,
        )


def registered_publisher(project, record):
    """Validate the complete record, including any recorded sync commits and signers, before obtaining a credential."""
    values, signers = {}, []
    allowed = {"admin", "signed_by", "publisher", "commit", "access_commit"}
    try:
        with open(record, encoding="utf-8") as lines:
            for line in lines:
                key, separator, value = line.rstrip("\n").partition("=")
                if not separator:
                    refuse(f"{record} has a malformed or duplicate setting", 65)
                if key == "signer":
                    signing_key(value, f"{record} signer signing key", 65)
                    if value in signers:
                        refuse(f"{record} repeats a signer signing key", 65)
                    signers.append(value)
                elif key in allowed and key not in values:
                    values[key] = value
                else:
                    refuse(f"{record} has a malformed or duplicate setting", 65)
    except UnicodeError:
        refuse(f"{record} is not UTF-8", 65)
    setting(values, "admin", PERSON_PATTERN, record, 65)
    signing_key(values.get("signed_by", ""), f"{record} signed_by signing key", 65)
    publisher = setting(values, "publisher", re.escape("porelo-publisher-" + project), record, 65)
    synced = ("commit" in values, "access_commit" in values, bool(signers))
    if any(synced):
        if not all(synced):
            refuse(f"{record} has an incomplete sync state", 65)
        setting(values, "commit", COMMIT_PATTERN, record, 65)
        setting(values, "access_commit", COMMIT_PATTERN, record, 65)
    return publisher


def central_forge_token():
    """The central forge's token: asked at a terminal, or the one line of a pipe, as the interface gives it."""
    if sys.stdin.isatty():
        given = getpass.getpass("Token for the central forge (not shown): ")
    else:
        given = sys.stdin.read(4097)
        if given.endswith("\n"):
            given = given[:-1]
    if not given or len(given) > 4096 or "\n" in given or "\r" in given:
        refuse("no valid central forge token was given", 64)
    return given


def people_after_removal(project):
    """Validate every person record before forge deletion and collect records losing this project."""
    people_dir = os.path.join(ETC, "people")
    affected = []
    to_lock = []
    if not os.path.lexists(people_dir):
        return affected, to_lock
    trusted_directory(people_dir, private=True)
    for entry_name in sorted(os.listdir(people_dir)):
        if not entry_name.endswith(".conf") or not re.fullmatch(PERSON_PATTERN, entry_name[:-5]):
            refuse("the people directory holds an unknown record", 65)
        user = entry_name[:-5]
        person_path = os.path.join(people_dir, entry_name)
        members, locked, laptops = read_person(user, person_path)
        remaining = [item for item in members if item == "hand" or item.split(" ", 1)[0] != project]
        if remaining != members:
            affected.append((user, person_path, format_person(remaining, locked, laptops)))
            if not remaining and not locked:
                to_lock.append(user)
    if to_lock:
        trusted(PERSON)
    return affected, to_lock


def lock_people(project, users):
    """Lock each person left with no membership after releasing forge.conf's lock."""
    failed = []
    code = 69
    for user in users:
        locked = subprocess.run(
            [PERSON, "lock", user],
            env=SAFE_ENV,
            check=False,
            cwd="/",
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=120,
        )
        try:
            answer = json.loads(locked.stdout) if not locked.returncode else None
        except ValueError:
            answer = None
        if locked.returncode or answer != {"person": user, "locked": True}:
            if not failed and locked.returncode in (65, 69, 73):
                code = locked.returncode
            failed.append(user)
    if failed:
        refuse(f"removed {project}, but could not lock {', '.join(failed)}", code)


def remove(forge, project, record, publisher, affected):
    """Check every repository without pushing anything, then delete the forge identities and update records."""
    for kind, path in (("organization", f"/orgs/{project}"), ("publisher", f"/users/{publisher}")):
        if forge.request("GET", path, expected=(200, 404)) is None:
            refuse(f"the forge has no {kind} for registered project {project}")
    repositories = forge.listing(f"/orgs/{project}/repos")
    packages = forge.listing(f"/packages/{project}")
    package_paths = []
    for package in packages:
        parts = [package.get(key) for key in ("type", "name", "version")]
        if any(
            not isinstance(part, str)
            or not part
            or part in (".", "..")
            or any(ord(char) < 32 or ord(char) == 127 for char in part)
            for part in parts
        ):
            refuse(f"the forge returned an invalid package identity for {project}")
        path = f"/packages/{project}/" + "/".join(urllib.parse.quote(part, safe="") for part in parts)
        if path in package_paths:
            refuse(f"the forge returned a duplicate package identity for {project}")
        package_paths.append(path)
    names = []
    for repository in repositories:
        name = repository.get("name")
        if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", name) or name in names:
            refuse(f"the forge returned an invalid or duplicate repository name for {project}")
        names.append(name)
    if names:
        trusted(PUSH)
        central_token = central_forge_token()
        checked = subprocess.run(
            [PUSH, "--check", project, *names],
            env=SAFE_ENV,
            check=False,
            timeout=600,
            input=central_token + "\n",
            capture_output=True,
            text=True,
        )
        if checked.returncode:
            code = {65: 65, 73: 73, 75: 64, 130: 64, 143: 64}.get(checked.returncode, 69)
            refuse(
                f"{project} has unpushed or unverifiable commits in {', '.join(names)}; "
                f"gathered push check exited {checked.returncode}",
                code,
            )
    admins = os.path.join(ETC, "matrix", project + ".admins")
    trusted_directory(os.path.dirname(admins), missing=True)
    if os.path.lexists(admins):
        trusted(admins)
    staged = []
    try:
        for user, person_path, content in affected:
            staged.append((person_path, stage_file(person_path, f".{user}-", content)))
        for name in names:
            forge.request("DELETE", f"/repos/{project}/{name}", expected=(204,))
        for path in package_paths:
            forge.request("DELETE", path, expected=(204,))
        forge.request("DELETE", f"/orgs/{project}", expected=(204,))
        forge.request("DELETE", f"/admin/users/{publisher}", expected=(204,))
        for path in (f"/orgs/{project}", f"/users/{publisher}"):
            if forge.request("GET", path, expected=(200, 404)) is not None:
                refuse(f"the forge still holds an identity for {project}; keeping its record")
        for person_path, temporary in staged:
            with writing(person_path):
                os.replace(temporary, person_path)
        with writing(admins):
            if os.path.lexists(admins):
                os.unlink(admins)
        with writing(record):
            os.unlink(record)
    finally:
        for _, temporary in staged:
            with writing(temporary):
                if os.path.lexists(temporary):
                    os.unlink(temporary)


def admitted(admin, person):
    """Under the lock, the admin must still hold a membership and not be locked out or purged."""
    if not os.path.lexists(person):
        refuse(f"{admin} is no person on this host", 65)
    members, locked, laptops = read_person(admin, person)
    if locked:
        refuse(f"{admin} is locked on this host", 65)
    if not members:
        refuse(f"{admin} holds no membership on this host", 65)
    return members, locked, laptops


def run():
    """Check root before the call or filesystem, then hold one lock through all preflight and mutation."""
    if os.geteuid() != 0:
        refuse("runs only as root", 69)
    os.umask(0o077)
    os.environ.clear()
    os.environ.update(SAFE_ENV)
    arguments = sys.argv[1:]
    if len(arguments) == 5 and arguments[0] == "add" and arguments[3] == "--signed-by":
        action, project, admin, _, key = arguments
    elif len(arguments) == 2 and arguments[0] == "remove":
        action, project = arguments
        admin = key = None
    else:
        refuse('usage: add <project> <admin> --signed-by "ssh-ed25519 <base64>" | remove <project>', 64)
    if not re.fullmatch(PROJECT_PATTERN, project):
        refuse("project must be 1 to 40 lowercase letters, digits or internal hyphens", 64)
    if action == "add":
        if not re.fullmatch(PERSON_PATTERN, admin):
            refuse("admin must be a registered person's user name", 64)
        signing_key(key)
    record = os.path.join(ETC, "projects", project + ".conf")
    if action == "add" and os.path.lexists(record):
        refuse(f"{record} exists")
    if action == "remove" and not os.path.lexists(record):
        refuse(f"unknown project {project}")
    for name in ("projects", "people"):
        trusted_directory(os.path.join(ETC, name), private=True, missing=True)
    if action == "add":
        person = os.path.join(ETC, "people", admin + ".conf")
        # The records say no: an admin must have been admitted as a person first.
        if not os.path.lexists(person):
            refuse(f"{admin} is no person on this host", 65)
        trusted(person, private=True)
    else:
        trusted(record, private=True)
    trusted(CONF)
    to_lock = []
    with open(CONF, encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if action == "add" and os.path.lexists(record):
            refuse(f"{record} exists")
        if action == "remove" and not os.path.lexists(record):
            refuse(f"unknown project {project}")
        if action == "add":
            members, locked, laptops = admitted(admin, person)
            person_content = format_person([*members, f"{project} project-admin"], locked, laptops)
            affected = None
            publisher = None
        else:
            publisher = registered_publisher(project, record)
            affected, to_lock = people_after_removal(project)
            person_content = None
        forge = Forge(read_values(CONF))
        if action == "add":
            add(forge, project, admin, key, record, person, person_content)
        else:
            remove(forge, project, record, publisher, affected)
    if action == "remove":
        lock_people(project, to_lock)
        with writing("standard output"):
            print(json.dumps(dict(project=project, removed=True, locked=to_lock), separators=(",", ":")), flush=True)


def main():
    """Keep unexpected dependency errors and interrupts free of credentials and tracebacks."""
    try:
        run()
    except Refusal as error:
        failure = error
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        failure = Refusal(f"dependency or file read failed: {type(error).__name__}", 69)
    except KeyboardInterrupt:
        failure = Refusal("input interrupted", 64)
    except EOFError:
        failure = Refusal("no central forge token was given", 64)
    else:
        return
    try:
        print(f"porelo-host-project: {failure}", file=sys.stderr, flush=True)
    except OSError:
        sys.exit(73)
    sys.exit(failure.code)


if __name__ == "__main__":
    main()
