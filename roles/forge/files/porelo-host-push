#!/usr/bin/env -S -i PATH=/usr/sbin:/usr/bin SUDO_UID=${SUDO_UID} SUDO_USER=${SUDO_USER} /bin/bash --noprofile --norc
# shellcheck shell=bash
# The gathered push, run by a project developer in their own account on the host: each repository's approved
# local main goes to the central forge with a plain push. A central forge that moved refuses it, and its commits reach
# the local forge as central/main. With --check, root compares every local ref of a project against Forgejo's migrated
# original_url before project removal, writing neither forge. With --migrate, the project admin's bring stop has
# Forgejo migrate the repositories the bring listed and the forge lacks; with --pull, central main reaches the local
# forge as central/main. The central token is read from standard input every time and kept in memory alone. Git reaches
# the host's forge on 127.0.0.1:<git_port>, the token-only gate git.sock has, with the person's own forge token.
# The line above empties the environment before bash starts: it takes no PATH, HOME, git, proxy or shell setting from
# its caller.
set -euo pipefail
export LC_ALL=C
cd / || exit 1

forge_conf=/etc/porelo-host/forge.conf
local_socket=/run/porelo-forge/git.sock
person_helper=/usr/local/sbin/porelo-host-person
central_ca_conf=/etc/porelo-host/forge/central-ca.conf
default_central_ca=/etc/ssl/certs/ca-certificates.crt
ca_owner=0
project_pattern='^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$'
name_pattern='^[A-Za-z0-9][A-Za-z0-9._-]*$'
url_pattern='^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/[^[:space:]?#@]+$'

fail() {
    printf 'porelo-host-push: %s\n' "$1" >&2
    exit "${2:-1}"
}

# An authority root trusts is a regular file of root's that nobody else can write.
trusted() {
    local owner mode
    [ -f "$1" ] && [ -r "$1" ] || return 1
    read -r owner mode < <(stat -L -c '%u %a' -- "$1") || return 1
    [ "$owner" = "$ca_owner" ] && [ $((8#$mode & 8#022)) = 0 ]
}

# A setting file of root's must be a plain file, not a symbolic link, writable by root alone.
trusted_plain() {
    local owner mode
    [ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] || return 1
    read -r owner mode < <(stat -c '%u %a' -- "$1") || return 1
    [ "$owner" = "$ca_owner" ] && [ $((8#$mode & 8#022)) = 0 ]
}

forge_conf_value() {
    local key=$1 pattern=$2 line value=
    trusted_plain "$forge_conf" || fail "$forge_conf is not a plain file only root can change" 69
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in "$key="*) value=${line#"$key="} ;; esac
    done < "$forge_conf"
    [[ $value =~ $pattern ]] || fail "$forge_conf names no valid $key" 69
    printf '%s' "$value"
}

caller_uid=$(id -u) || fail "cannot read the calling account id" 69
mode=push
case "${1-}" in --migrate | --pull) mode=${1#--} && shift ;; esac
checking=
project_owner=
if [ "$mode" = push ] && [ "${1-}" = --check ]; then
    [ "$caller_uid" = 0 ] && [ -z "${SUDO_USER:-}" ] && [ -z "${SUDO_UID:-}" ] \
        || fail "--check runs only as root without sudo" 77
    [ "$#" -ge 3 ] || fail "--check needs an organization and its repository names" 64
    checking=yes
    project_owner=$2
    [[ $project_owner =~ $project_pattern ]] || fail "--check needs a valid project organization" 64
    shift 2
else
    [ "$caller_uid" != 0 ] || fail "push, --pull and --migrate run in the person's own account" 77
    [ "$#" -ge 1 ] || fail "name the project, and optionally the repositories to push" 64
    project_owner=$1
    [[ $project_owner =~ $project_pattern ]] || fail "'$project_owner' is not a project name" 64
    shift
    [ "$mode" != migrate ] || [ "$#" -eq 0 ] || fail "--migrate takes the project alone" 64
fi

git_port=$(forge_conf_value git_port '^[1-9][0-9]{0,4}$') || exit $?
[ "$git_port" -le 65535 ] || fail "$forge_conf names no valid git_port" 69
local_forge="http://127.0.0.1:$git_port"

owner=
central_ca=
local_token=
targets=()
declare -A central_url=()

if [ -z "$checking" ]; then
    passwd_line=$(getent passwd "$caller_uid") || fail "account $caller_uid is not in getent passwd" 69
    IFS=: read -r caller_user _ passwd_uid _ _ caller_home _ <<< "$passwd_line"
    [ "$passwd_uid" = "$caller_uid" ] && [ -n "$caller_user" ] \
        && [[ $caller_home == /* ]] && [ "$caller_home" != / ] \
        || fail "getent passwd gave no home directory for account $caller_uid" 69

    push_dir="$caller_home/.config/porelo-host/push"
    # The bring's list of repositories still to migrate has the push config's form, under a name of its own.
    conf="$push_dir/$project_owner.conf"
    [ "$mode" != migrate ] || conf="$push_dir/$project_owner.migrate"
    for dir in "$caller_home" "$caller_home/.config" "$caller_home/.config/porelo-host"; do
        [ ! -L "$dir" ] || fail "$dir is a symbolic link, not a directory of $caller_user's" 66
        [ -e "$dir" ] || fail "$conf does not exist ($dir is missing)" 66
        [ -d "$dir" ] || fail "$dir is not a directory" 66
        read -r dir_owner dir_mode < <(stat -c '%u %a' -- "$dir") || fail "$dir could not be checked" 66
        [ "$dir_owner" = "$caller_uid" ] \
            || fail "$dir is owned by uid $dir_owner, not $caller_user ($caller_uid)" 66
        [ $((8#$dir_mode & 8#022)) = 0 ] \
            || fail "$dir has mode 0$dir_mode, writable beyond $caller_user" 66
    done
    [ ! -L "$push_dir" ] || fail "$push_dir is a symbolic link, not a 0700 directory of $caller_user's" 66
    [ -e "$push_dir" ] || fail "$conf does not exist ($push_dir is missing)" 66
    [ -d "$push_dir" ] || fail "$push_dir is not a directory" 66
    read -r dir_owner dir_mode < <(stat -c '%u %a' -- "$push_dir") || fail "$push_dir could not be checked" 66
    [ "$dir_owner" = "$caller_uid" ] \
        || fail "$push_dir is owned by uid $dir_owner, not $caller_user ($caller_uid)" 66
    [ "$dir_mode" = 700 ] || fail "$push_dir has mode 0$dir_mode, expected 0700" 66

    [ ! -L "$conf" ] || fail "$conf is a symbolic link, not a plain 0600 file of $caller_user's" 66
    [ -e "$conf" ] || fail "$conf does not exist" 66
    [ -f "$conf" ] || fail "$conf is not a plain file" 66
    read -r conf_owner conf_mode < <(stat -c '%u %a' -- "$conf") || fail "$conf could not be checked" 66
    [ "$conf_owner" = "$caller_uid" ] \
        || fail "$conf is owned by uid $conf_owner, not $caller_user ($caller_uid)" 66
    [ "$conf_mode" = 600 ] || fail "$conf has mode 0$conf_mode, expected 0600" 66
    [ -r "$conf" ] || fail "$conf is not readable" 66

    # Descriptor checks bind validation to the bytes read, even when the caller renames paths.
    config_reader='
import os
import stat
import sys

home, uid, name = sys.argv[1], int(sys.argv[2]), sys.argv[3]
fd = None
try:
    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    for part, mode in ((None, None), (".config", None), ("porelo-host", None), ("push", 0o700)):
        if part is not None:
            next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        info = os.fstat(fd)
        if info.st_uid != uid or stat.S_IMODE(info.st_mode) & 0o022:
            raise ValueError("directory ownership or permissions changed")
        if mode is not None and stat.S_IMODE(info.st_mode) != mode:
            raise ValueError("push directory must have mode 0700")
    next_fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
    os.close(fd)
    fd = next_fd
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode):
        raise ValueError("not a plain file")
    if info.st_uid != uid:
        raise ValueError("file ownership changed")
    if stat.S_IMODE(info.st_mode) != 0o600:
        raise ValueError("file must have mode 0600")
    data = bytearray()
    while len(data) <= 65536:
        chunk = os.read(fd, 65537 - len(data))
        if not chunk:
            break
        data.extend(chunk)
    if len(data) > 65536:
        raise ValueError("exceeds 64 KiB")
    if b"\x00" in data:
        raise ValueError("contains NUL bytes")
    sys.stdout.buffer.write(data)
except (OSError, ValueError) as error:
    sys.exit("porelo-host-push: caller config is not a plain file with trusted permissions: " + str(error))
finally:
    if fd is not None:
        os.close(fd)
'
    config_data=$(timeout 10 python3 -I -c "$config_reader" "$caller_home" "$caller_uid" "${conf##*/}" < /dev/null) \
        || fail "$conf could not be read" 66
    configured_local=
    config_repos=()
    while read -r key first second extra; do
        case "$key" in
            local)
                [ -z "${second:-}" ] && [ "${first:-}" = "$local_forge" ] \
                    || fail "$conf names no matching local forge" 65
                configured_local=yes
                ;;
            owner)
                [ -z "${second:-}" ] || fail "$conf gives extra words on owner" 65
                owner=${first:-}
                ;;
            central-ca)
                [ -z "${second:-}" ] && [[ ${first:-} =~ ^/[^[:space:]]+$ ]] \
                    || fail "$conf names no single absolute central-ca path" 65
                central_ca=$first
                ;;
            repository)
                [[ ${first:-} =~ $name_pattern ]] \
                    || fail "$conf names '${first:-}', which is not a repository name" 65
                [ -z "${extra:-}" ] && [[ ${second:-} =~ $url_pattern ]] \
                    || fail "$conf gives no valid https:// address for '$first'" 65
                [ -z "${central_url[$first]:-}" ] || fail "$conf names repository '$first' twice" 65
                config_repos+=("$first")
                central_url[$first]=$second
                ;;
            '' | '#'*) ;;
            *) fail "$conf names '$key', which this command does not read" 65 ;;
        esac
    done <<< "$config_data"
    [ -n "$configured_local" ] && [ -n "$owner" ] && [ -n "$central_ca" ] \
        || fail "$conf names no local forge, owner or central CA" 65
    [ "$owner" = "$project_owner" ] || fail "$conf is for project '$owner', not '$project_owner'" 65
    [ "${#config_repos[@]}" -gt 0 ] || fail "$conf names no repositories to push" 65
    trusted "$central_ca" || fail "the central forge's CA $central_ca is not a file only root can change" 66

    if [ "$#" -eq 0 ]; then
        targets=("${config_repos[@]}")
    else
        declare -A named=()
        for name in "$@"; do
            [[ $name =~ $name_pattern ]] || fail "'$name' is not a repository name" 64
            [ -n "${central_url[$name]:-}" ] \
                || fail "the config for $project_owner holds no repository '$name'; it holds: ${config_repos[*]}" 64
            [ -z "${named[$name]:-}" ] || fail "'$name' is named twice" 64
            named[$name]=1
            targets+=("$name")
        done
    fi

    # The host refuses a locked person or one no project holds; the forge then bounds the token to what they reach.
    local_token=$(sudo -n "$person_helper" forge-token < /dev/null 2>/dev/null) \
        || fail "the person's forge token could not be made" 69
    [ -n "$local_token" ] || fail "the person's forge token is empty" 69
else
    declare -A named=()
    for name in "$@"; do
        [[ $name =~ $name_pattern ]] || fail "'$name' is not a repository name" 64
        [ -z "${named[$name]:-}" ] || fail "'$name' is named twice" 64
        named[$name]=1
        targets+=("$name")
    done

    forge_account=$(forge_conf_value account '^[a-z_][a-z0-9_-]{0,31}$') || exit $?
    owner=$project_owner

    if [ -e "$central_ca_conf" ] || [ -L "$central_ca_conf" ]; then
        trusted_plain "$central_ca_conf" \
            || fail "$central_ca_conf is not a plain file only root can change" 66
        extra_ca_line=
        {
            IFS= read -r central_ca || true
            IFS= read -r extra_ca_line || true
        } < "$central_ca_conf"
        [ -z "$extra_ca_line" ] && [[ $central_ca =~ ^/[^[:space:]]+$ ]] \
            || fail "$central_ca_conf names no single absolute CA path" 65
    else
        central_ca=$default_central_ca
    fi
    trusted "$central_ca" || fail "the central forge's CA $central_ca is not a file only root can change" 66

    forge_passwd=$(getent passwd "$forge_account") \
        || fail "the forge's account $forge_account is not in getent passwd" 69
    IFS=: read -r _ _ forge_uid _ _ forge_home _ <<< "$forge_passwd"
    [[ $forge_uid =~ ^[1-9][0-9]*$ ]] && [[ $forge_home == /* ]] && [ "$forge_home" != / ] \
        || fail "the forge's account $forge_account has no unprivileged home" 69
    admin_token_file="$forge_home/.config/porelo-forge/api.token"
    # The forge's account reads its own token, so a file it put in that token's place is never read with root's rights.
    # Neither the terminal nor the central token reaches its stdin, and a pipe put there cannot wait forever.
    local_token=$(timeout 10 runuser -u "$forge_account" -- cat -- "$admin_token_file" < /dev/null) \
        || fail "$admin_token_file could not be read" 66
    [ -n "$local_token" ] || fail "$admin_token_file is empty" 66
fi

[[ $local_token != *$'\r'* && $local_token != *$'\n'* ]] || fail "invalid local forge token" 69

printf 'Token for the central forge (not shown): ' >&2
central_token=
IFS= read -rs central_token || [ -n "$central_token" ] || fail "no token was given" 75
printf '\n' >&2
[ -n "$central_token" ] || fail "no token was given" 75

basic() {
    printf 'Authorization: Basic %s' "$(printf 'x-access-token:%s' "$1" | base64 -w0)"
}
local_header=$(basic "$local_token")
central_header=$(basic "$central_token")

# Every form a token takes here is cut out of what git says before it is shown.
redact() {
    local text=$1 secret
    for secret in "$local_header" "$central_header" "${local_header#Authorization: Basic }" \
        "${central_header#Authorization: Basic }" "$local_token" "$central_token"; do
        text=${text//"$secret"/<redacted>}
    done
    printf '%s' "$text"
}

# The token reaches git through its environment alone, never on a redirect to another host; the central forge is trusted
# by its own authority only, so the host's CA can never stand in for it. The host's forge is plain HTTP on loopback.
git_as() {
    local header=$1 ca=$2
    shift 2
    [ -z "$ca" ] || export GIT_SSL_CAINFO="$ca"
    GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=http.extraHeader GIT_CONFIG_VALUE_0="$header" \
        GIT_CONFIG_KEY_1=http.followRedirects GIT_CONFIG_VALUE_1=false exec setsid git "$@"
}
as_local() { git_as "$local_header" "" "$@"; }
as_central() { git_as "$central_header" "$central_ca" "$@"; }

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
umask 077
work=$(mktemp -d) && [ -d "$work" ] || fail "no temporary directory could be made" 73
active_pid=
clean_up() {
    trap "" INT TERM HUP
    local pid=${active_pid:-${TRANSFER_PID:-}}
    if [ -n "$pid" ]; then
        kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
        local timer_pid
        sleep 3 &
        timer_pid=$!
        wait -n "$pid" "$timer_pid" 2>/dev/null || true
        kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
        kill "$timer_pid" 2>/dev/null || true
        wait "$timer_pid" 2>/dev/null || true
    fi
    rm -rf "$work"
    if [ -e "$work" ]; then
        printf 'porelo-host-push: left %s behind\n' "$work" >&2
        [ -z "$checking" ] || exit 73
        exit 1
    fi
}
trap clean_up EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Waiting on a background command lets the outer shell handle a signal while git is still running.
capture_git() {
    local status=0 transfer_pid output_fd input_fd chunk
    # The startup handshake keeps Bash from reaping the coproc before its descriptors are duplicated.
    coproc TRANSFER { IFS= read -r _ && "$@" 2>&1; }
    transfer_pid=${TRANSFER_PID:-}
    exec {output_fd}<&"${TRANSFER[0]}" {input_fd}>&"${TRANSFER[1]}"
    active_pid=$transfer_pid
    # EPIPE must fail the transfer without delivering SIGPIPE to this shell.
    if ! (trap "" PIPE; printf 'ready\n' >&"$input_fd"); then
        printf 'porelo-host-push: could not start Git\n' >&2
        status=1
    fi
    exec {input_fd}>&-
    said=
    while IFS= read -r -d "" chunk <&"$output_fd"; do
        said+=$chunk
    done
    said+=$chunk
    exec {output_fd}<&-
    wait "$transfer_pid" || status=$?
    active_pid=
    said=${said%$'\n'}
    return "$status"
}

if [ -n "$checking" ]; then
    declare -A repo_seen=()
    declare -A page_seen=()
    page_file="$work/repos-page.json"
    finished=
    for ((page = 1; page <= 100; page++)); do
        http_code=$(curl -sS --max-time 30 --noproxy '*' --unix-socket "$local_socket" \
            -H @<(printf 'Authorization: token %s\n' "$local_token") \
            -o "$page_file" -w '%{http_code}' \
            "http://localhost/api/v1/orgs/$owner/repos?limit=50&page=$page") \
            || fail "the forge did not answer /api/v1/orgs/$owner/repos" 69
        [ "$http_code" = 200 ] \
            || fail "the forge answered HTTP $http_code for /api/v1/orgs/$owner/repos" 69
        parsed=$(python3 -I -c '
import hashlib, json, sys
data = json.load(open(sys.argv[1], encoding="utf-8"))
if not isinstance(data, list) or any(not isinstance(item, dict) for item in data):
    sys.exit(2)
if not data:
    print("EMPTY")
    sys.exit(0)
digest = hashlib.sha256(json.dumps(data, sort_keys=True).encode("utf-8")).hexdigest()
print("DIGEST\t" + digest)
for item in data:
    name = item.get("name")
    url = item.get("original_url") or ""
    if not isinstance(name, str) or not isinstance(url, str) or any(c in name + url for c in "\t\r\n"):
        sys.exit(2)
    print("REPO\t" + name + "\t" + url)
' "$page_file" 2>/dev/null) || fail "the forge sent invalid JSON for /api/v1/orgs/$owner/repos" 69
        if [ "$parsed" = EMPTY ]; then
            finished=yes
            break
        fi
        while IFS=$'\t' read -r tag first second; do
            case "$tag" in
                DIGEST)
                    [ -z "${page_seen[$first]:-}" ] \
                        || fail "the forge repeated a page for /api/v1/orgs/$owner/repos" 69
                    page_seen[$first]=1
                    ;;
                REPO)
                    repo_seen[$first]=1
                    central_url[$first]=$second
                    ;;
            esac
        done <<< "$parsed"
    done
    [ -n "$finished" ] || fail "the forge did not finish listing /api/v1/orgs/$owner/repos in 100 pages" 69
    rm -f -- "$page_file"
    for name in "${targets[@]}"; do
        [ -n "${repo_seen[$name]:-}" ] || fail "$name: the forge holds no such repository in $owner" 69
        [[ ${central_url[$name]:-} =~ $url_pattern ]] \
            || fail "$name: the forge holds no central https:// original_url from migration" 69
    done
fi

# Forgejo's own message on a refusal; its answers never repeat a request's body, and redact cuts any token out.
answer="$work/answer.json"
api() {
    curl -sS --max-time 120 --noproxy '*' --unix-socket "$local_socket" -H 'Content-Type: application/json' \
        -H @<(printf 'Authorization: token %s\n' "$local_token") -o "$answer" -w '%{http_code}' "$@"
}
said() {
    python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1])).get("message", ""))' "$answer" 2> /dev/null \
        || true
}

# The token reaches the request body on a pipe, never an argument: Forgejo clones with it once and keeps it nowhere.
if [ "$mode" = migrate ]; then
    for name in "${targets[@]}"; do
        http_code=$(api "http://localhost/api/v1/repos/$owner/$name") || fail "$name: the forge did not answer" 69
        case "$http_code" in
            200) printf '%s: already on the forge\n' "$name" && continue ;;
            404) ;;
            *) fail "$name: the forge answered HTTP $http_code" 69 ;;
        esac
        http_code=$(printf '%s' "$central_token" | python3 -I -c '
import json, sys
print(json.dumps({"clone_addr": sys.argv[1], "repo_name": sys.argv[2], "repo_owner": sys.argv[3], "service": "git",
                  "mirror": False, "private": True, "auth_token": sys.stdin.read()}))
' "${central_url[$name]}" "$name" "$owner" | api -X POST --data @- "http://localhost/api/v1/repos/migrate") \
            || fail "$name: the forge did not answer the migration" 69
        [ "$http_code" = 201 ] || fail "$name: the forge answered HTTP $http_code: $(redact "$(said)")" 65
        printf '%s: migrated\n' "$name"
    done
    # Nothing is left to migrate, so the bring run again finds every repository and writes the push config.
    rm -f -- "$conf" || fail "$conf could not be removed" 73
    exit 0
fi

# Main is protected on the local forge, so central main arrives beside it and reaches it by a pull request.
if [ "$mode" = pull ]; then
    for name in "${targets[@]}"; do
        repo="$work/$name"
        local_url="$local_forge/$owner/$name.git"
        if ! capture_git as_local clone --quiet --branch main --single-branch "$local_url" "$repo"; then
            fail "$name: local main could not be read from $local_url: $(redact "$said")"
        fi
        if ! capture_git as_central -C "$repo" fetch --quiet "${central_url[$name]}" main; then
            fail "$name: central main could not be read: $(redact "$said")"
        fi
        if [ "$(git -C "$repo" rev-parse HEAD)" = "$(git -C "$repo" rev-parse FETCH_HEAD)" ]; then
            printf '%s: local main is central main\n' "$name"
            continue
        fi
        if git -C "$repo" merge-base --is-ancestor FETCH_HEAD HEAD; then
            printf '%s: local main is ahead of central main; the gathered push sends it\n' "$name"
            continue
        fi
        # central/main only ever mirrors central main, so it follows it even where central main was rewritten.
        if ! capture_git as_local -C "$repo" push --quiet "$local_url" +FETCH_HEAD:refs/heads/central/main; then
            fail "$name: central main could not be brought to the local forge: $(redact "$said")"
        fi
        if git -C "$repo" merge-base --is-ancestor HEAD FETCH_HEAD; then
            ahead=$(git -C "$repo" rev-list --count HEAD..FETCH_HEAD)
            printf '%s: central main is %s commit%s ahead; it is on the local forge as central/main, %s\n' \
                "$name" "$ahead" "$([ "$ahead" = 1 ] || printf s)" 'for a pull request'
        else
            printf '%s: central main and local main went apart; central/main on the local forge is merged in a task\n' \
                "$name"
        fi
    done
    exit 0
fi

pushed=()
for name in "${targets[@]}"; do
    repo="$work/$name"
    local_url="$local_forge/$owner/$name.git"
    central=${central_url[$name]}
    if [ -n "$checking" ]; then
        # A deletion must keep every commit, including task branches and tags; neither forge is written here.
        if ! capture_git as_local clone --quiet --mirror "$local_url" "$repo"; then
            fail "$name: local refs could not be read: $(redact "$said")" 69
        fi
        refs=$(git -C "$repo" for-each-ref --format='%(objectname)') \
            || fail "$name: local refs could not be enumerated" 69
        local_refs=()
        [ -z "$refs" ] || mapfile -t local_refs <<< "$refs"
        if ! capture_git as_central -C "$repo" fetch --quiet --no-tags "$central" \
            '+refs/*:refs/porelo-central/*'; then
            fail "$name: central refs could not be read: $(redact "$said")" 69
        fi
        refs=$(git -C "$repo" for-each-ref --format='%(objectname)' refs/porelo-central/) \
            || fail "$name: central refs could not be enumerated" 69
        central_refs=()
        [ -z "$refs" ] || mapfile -t central_refs <<< "$refs"
        if [ "${#local_refs[@]}" -gt 0 ]; then
            missing=$(git -C "$repo" rev-list "${local_refs[@]}" --not "${central_refs[@]}") \
                || fail "$name: local and central commits could not be compared" 69
            [ -z "$missing" ] || fail "$name: unpushed commits remain on the local forge" 65
        fi
        continue
    fi
    if ! capture_git as_local clone --quiet --branch main --single-branch "$local_url" "$repo"; then
        fail "$name: local main could not be read from $local_url: $(redact "$said")"
    fi
    printf '%s: pushing local main %s to %s\n' "$name" "$(git -C "$repo" rev-parse --short HEAD)" "$central"
    if capture_git as_central -C "$repo" push --porcelain "$central" main:main; then
        printf '%s: taken\n' "$name"
        pushed+=("$name")
        continue
    fi
    left=("${targets[@]:$((${#pushed[@]} + 1))}")
    if ! [[ $said =~ \[rejected\] ]] || ! [[ $said =~ (fetch\ first|non-fast-forward) ]]; then
        fail "$name: the push failed; not pushed: ${left[*]:-none}. Git said: $(redact "$said")"
    fi
    if ! capture_git as_central -C "$repo" fetch --quiet "$central" main; then
        fail "$name: refused, and central main could not be read: $(redact "$said")"
    fi
    missing=$(git -C "$repo" log --oneline main..FETCH_HEAD)
    if ! capture_git as_local -C "$repo" push --quiet "$local_url" FETCH_HEAD:refs/heads/central/main; then
        fail "$name: refused, and central main could not be brought to the local forge: $(redact "$said")"
    fi
    printf '%s: refused, since the central forge holds commits local main lacks:\n%s\n' "$name" "$missing" >&2
    printf '%s: they are on the local forge as the branch central/main; merge it in a task, approve it, push again.\n' \
        "$name" >&2
    fail "$name: not pushed; not pushed either: ${left[*]:-none}"
done
[ -z "$checking" ] || exit 0
printf 'pushed: %s\n' "${pushed[*]}"
