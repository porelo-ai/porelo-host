#!/usr/bin/python3
"""Pass socket-activated HTTP requests to the account's private Forgejo socket."""

import argparse
import grp
import http.client
import posixpath
import pwd
import re
import socket
import struct
from http.server import BaseHTTPRequestHandler
from urllib.parse import unquote, urlsplit


# The host's forge settings, where the forge role writes the name and the port the person's browser uses.
FORGE_CONF = "/etc/porelo-host/forge.conf"

HOP_HEADERS = {"connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te", "trailer",
               "transfer-encoding", "upgrade"}


def runner_route(target):
    """Forgejo authenticates its runners' own protocol itself, by their registration and runner tokens."""
    path = urlsplit(target).path
    return (target.startswith("/api/actions/") and "%" not in path and
            posixpath.normpath(path) == path and not path.endswith("/"))


class UnixConnection(http.client.HTTPConnection):
    def __init__(self, path):
        super().__init__("localhost", timeout=60)
        self.path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.path)


def peer_login(uid):
    try:
        person = pwd.getpwuid(uid)
        people = grp.getgrnam("porelo-people")
        if (uid < 1000 or person.pw_shell not in ("/bin/bash", "/bin/sh", "/bin/zsh", "/usr/bin/bash", "/usr/bin/zsh")
                or not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", person.pw_name)
                or (person.pw_gid != people.gr_gid and person.pw_name not in people.gr_mem)):
            return None
        return person.pw_name
    except KeyError:
        return None


def route_parts(target):
    """The path's segments as Forgejo's router splits them: on a plain slash, each segment then decoded."""
    return [unquote(segment) for segment in urlsplit(target).path.split("/")[1:]]


def unsafe_path(target):
    """A path Forgejo could read otherwise than the gate: a dot or empty segment, also behind an encoded slash, a bad
    escape, a decoded control character, or an encoded slash beside a character a path does not hold raw, for which
    Go drops the path as sent and decodes every encoded slash."""
    raw = urlsplit(target).path
    if re.search(r"%(?![0-9A-Fa-f]{2})", raw) or (re.search(r"%2[fF]", raw) and
                                                  re.search(r"[^A-Za-z0-9\-._~!$&'()*+,;=:@/%]", raw)):
        return True
    parts = route_parts(target)
    if "" in parts[:-1] or any(re.search(r"[\x00-\x1f\x7f]", part) for part in parts):
        return True
    for part in parts:
        pieces = part.split("/")
        if any(piece in (".", "..") for piece in pieces) or (len(pieces) > 1 and "" in pieces):
            return True
    return False


def route(target):
    """The decoded path in lower case, without a trailing slash; an encoded slash stays inside its one segment."""
    return "/" + "/".join(part.replace("/", "%2f") for part in route_parts(target)).rstrip("/").lower()


# Every forge credential is made by the host, by Forgejo's CLI or its own socket: no caller gets a token, a grant, a
# runner's registration or a password through any of the gate's sockets.
MINTING = re.compile(
    r"/(login/oauth|user/recover_account|user/settings|admin/users|admin/actions/runners|api/v1/users/[^/]+/tokens"
    r"|api/v1/(orgs/[^/]+|repos/[^/]+/[^/]+|user|admin)/actions/runners|api/v1/admin/runners"
    r"|(org/[^/]+|[^/]+/[^/]+)/settings/actions/runners)(/.*)?",
    re.DOTALL,
)
# Forgejo signs these in by the gate's X-WEBAUTH-USER even with ENABLE_REVERSE_PROXY_AUTHENTICATION_API=false, so
# web.sock passes them only with a token and challenges a client for one, as the links under ROOT_URL lead clients
# there. user/ is no owner: its avatars are the browser's.
SIGNED_IN_ONLY_BY_TOKEN = re.compile(
    r"/(v2|api/packages)(/.*)?|/(?!user/)[^/]+/[^/]+/(info/refs|git-upload-pack|git-receive-pack|info/lfs(/.*)?|head"
    r"|objects/(info|pack|[0-9a-f]{2})(/.*)?)",
    re.DOTALL,
)

# These turn a token into a signed 24-hour one Forgejo keeps no record of, which a revocation does not end.
TOKEN_EXCHANGE = re.compile(r"/v2/token(/.*)?|/api/packages/[^/]+/conan/v[12]/users/authenticate", re.DOTALL)


def blocked_route(target, method, mode):
    """A route the gate refuses in this mode before any upstream request."""
    path = route(target)
    if MINTING.fullmatch(path) or path in {"/user/forgot_password", "/user/reset_password", "/user/change_password"}:
        return True
    if (method not in ("GET", "HEAD", "OPTIONS") and
            (path == "/api/v1/user" or path == "/api/v1/admin/users" or path.startswith("/api/v1/admin/users/"))):
        return True
    if mode != "runner" and (path == "/api/actions" or path.startswith("/api/actions/")):
        return True
    return TOKEN_EXCHANGE.fullmatch(path) is not None


def own_hosts():
    """The Host values of the forge's own site, as the person's browser sends them; none when the settings cannot say."""
    try:
        with open(FORGE_CONF, encoding="utf-8", newline="") as conf:
            lines = conf.read().split("\n")
    except (OSError, UnicodeDecodeError):
        return set()
    # As the role writes it, or not at all: one key=value a line, each key once.
    values = {}
    for line in lines[:-1] if lines[-1] == "" else lines:
        key, equals, value = line.partition("=")
        if not equals or not re.fullmatch(r"[a-z_]+", key) or key in values or re.search(r"\s", value):
            return set()
        values[key] = value
    name, port = values.get("name", ""), values.get("port", "")
    if not re.fullmatch(r"[a-z0-9]([a-z0-9.-]*[a-z0-9])?", name) or not re.fullmatch(r"[1-9][0-9]{0,4}", port):
        return set()
    return {f"{name}:{port}", f"127.0.0.1:{port}"}


def foreign_request(headers, method):
    """A request another site made in the person's browser: by a name of its own that resolves to loopback, or, for one
    that changes something, from a page of another origin."""
    hosts = headers.get_all("Host", [])
    if len(hosts) != 1 or hosts[0].lower() not in own_hosts():
        return True
    if method in ("GET", "HEAD"):
        return False
    # A browser sends both on every cross-site request that changes something; a client with a token sends neither.
    origins = headers.get_all("Origin", [])
    sites = headers.get_all("Sec-Fetch-Site", [])
    return (len(origins) > 1 or len(sites) > 1 or
            (origins and origins[0].lower() != "http://" + hosts[0].lower()) or
            (sites and sites[0].strip().lower() not in ("same-origin", "none")))


class RequestBody:
    def __init__(self, stream, length, chunked=False):
        self.stream = stream
        self.remaining = length
        self.chunked = chunked
        self.finished = False

    def read(self, size=8192):
        if self.finished:
            return b""
        if self.chunked and self.remaining == 0:
            line = self.stream.readline(128)
            if not re.fullmatch(rb"[0-9a-fA-F]{1,16}\r\n", line):
                raise ValueError("invalid chunk size")
            self.remaining = int(line, 16)
            if self.remaining == 0:
                if self.stream.read(2) != b"\r\n":
                    raise ValueError("trailers are not supported")
                self.finished = True
                return b""
        data = self.stream.read(min(size, self.remaining))
        if not data and self.remaining:
            raise ValueError("incomplete body")
        self.remaining -= len(data)
        if self.remaining == 0:
            if self.chunked:
                if self.stream.read(2) != b"\r\n":
                    raise ValueError("invalid chunk ending")
            else:
                self.finished = True
        return data


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        # Paths and HTTP parser errors can contain credentials.
        pass

    def reply(self, status, challenge=False):
        self.send_response_only(status)
        if challenge:
            self.send_header("WWW-Authenticate", "Basic")
        self.send_header("Content-Length", "0")
        self.send_header("Connection", "close")
        self.end_headers()

    def send_error(self, code, message=None, explain=None):
        self.close_connection = True
        self.reply(code)

    def handle_expect_100(self):
        # Authentication and route checks must precede a body upload.
        return True

    def forward(self):
        self.close_connection = True
        login = peer_login(self.server.uid) if self.server.mode == "web" else None
        if self.server.mode == "web" and login is None:
            self.reply(403)
            return
        if self.server.mode == "web" and foreign_request(self.headers, self.command):
            self.reply(403)
            return
        if unsafe_path(self.path):
            self.reply(400)
            return
        if blocked_route(self.path, self.command, self.server.mode):
            self.reply(403)
            return
        authorizations = self.headers.get_all("Authorization", [])
        if self.server.mode == "web" and not authorizations and SIGNED_IN_ONLY_BY_TOKEN.fullmatch(route(self.path)):
            # A browser sends Sec-Fetch-* on a localhost origin; a challenge would prompt it for a password there.
            if any(key.lower().startswith("sec-fetch-") for key in self.headers.keys()):
                self.reply(403)
            else:
                self.reply(401, challenge=True)
            return
        if len(authorizations) > 1:
            self.reply(400)
            return
        tokens = self.server.mode in ("git", "runner")
        if tokens and not authorizations and not (self.server.mode == "runner" and runner_route(self.path)):
            self.reply(401, challenge=True)
            return
        # A job's artifact and cache calls carry its own token as Bearer; only the runner's socket takes those.
        schemes = "Basic|token|Bearer" if self.server.mode == "runner" else "Basic|token"
        if tokens and authorizations and not re.fullmatch(rf"(?i:{schemes}) [A-Za-z0-9+/=_\-.]+", authorizations[0]):
            self.reply(401, challenge=True)
            return
        lengths = self.headers.get_all("Content-Length", [])
        transfers = self.headers.get_all("Transfer-Encoding", [])
        chunked = transfers == ["chunked"]
        if ((transfers and (not chunked or lengths)) or len(lengths) > 1 or
                (lengths and not re.fullmatch(r"[0-9]{1,12}", lengths[0])) or
                not self.path.startswith("/") or self.path.startswith("//") or "#" in self.path):
            self.reply(400)
            return
        if self.headers.get("Expect", "").lower() == "100-continue":
            self.send_response_only(100)
            self.end_headers()
        omitted = HOP_HEADERS | {item.strip().lower() for item in self.headers.get("Connection", "").split(",")}
        if "authorization" in omitted:
            self.reply(400)
            return
        headers = {key: value for key, value in self.headers.items()
                   if key.lower() not in omitted and not key.lower().startswith("x-webauth-")
                   and key.lower() not in {"host", "expect"}
                   and not (tokens and key.lower() == "cookie")}
        headers["Host"] = "localhost"
        headers["Connection"] = "close"
        if not chunked:
            headers["Content-Length"] = lengths[0] if lengths else "0"
        if self.server.mode == "web" and not authorizations:
            headers["X-WEBAUTH-USER"] = login
        upstream = self.server.upstream()
        try:
            body = RequestBody(self.rfile, int(lengths[0]) if lengths else 0, chunked)
            upstream.request(self.command, self.path, body, headers, encode_chunked=chunked)
            response = upstream.getresponse()
        except (OSError, ValueError, http.client.HTTPException):
            upstream.close()
            self.reply(502)
            return
        try:
            self.send_response_only(response.status)
            for key, value in response.getheaders():
                if key.lower() not in HOP_HEADERS:
                    self.send_header(key, value)
            self.send_header("Connection", "close")
            self.end_headers()
            if self.command != "HEAD":
                while data := response.read(65536):
                    self.wfile.write(data)
        finally:
            upstream.close()

    do_GET = forward
    do_HEAD = forward
    do_POST = forward
    do_PUT = forward
    do_PATCH = forward
    do_DELETE = forward
    do_OPTIONS = forward


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument("--web", action="store_true")
    modes.add_argument("--git", action="store_true")
    modes.add_argument("--runner", action="store_true")
    parser.add_argument("--upstream", required=True)
    args = parser.parse_args()
    # Accept=yes hands one connected descriptor to each process, with no listening socket to inherit.
    with socket.socket(fileno=3) as connection:
        connection.settimeout(60)
        mode = "web" if args.web else "runner" if args.runner else "git"
        # Only git mode is also on loopback TCP, where the token is the bound and no peer uid is read.
        if connection.family != socket.AF_UNIX and mode != "git":
            raise SystemExit(f"porelo-forge-gate: {mode} mode serves a Unix socket alone")
        uid = None
        if connection.family == socket.AF_UNIX:
            _, uid, _ = struct.unpack("3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                                 struct.calcsize("3i")))
        server = argparse.Namespace(mode=mode, uid=uid,
                                    upstream=lambda: UnixConnection(args.upstream))
        try:
            Handler(connection, ("local", 0), server)
        except (OSError, ValueError, http.client.HTTPException):
            raise SystemExit("porelo-forge-gate: connection failed") from None


if __name__ == "__main__":
    main()
