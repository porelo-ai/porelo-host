#!/usr/bin/python3 -I
"""Sets the person's lasting password on the host's forge from standard input, run as root over the admin's ssh.

The password lives only in this process: it is read from standard input, sent once in a request body over TLS to the
forge's admin API, and in no file, argument, environment or log. The admin token the request needs is made for this
call with Forgejo's own command line and kept only in memory; that command line deletes no token, so it stays unused
in Forgejo's store, as a hash, until the forge goes with down.
Through sudo, only the caller's unlocked, root-owned person record authorizes their own login; direct root uses
the configured person.
"""

import datetime
import json
import os
import re
import ssl
import stat
import subprocess
import sys
import urllib.error
import urllib.request

CONF = "/etc/porelo-host/forge.conf"
CA = "/etc/porelo-host/forge/ca.pem"
ADMIN = "porelo-admin"
PEOPLE = "/etc/porelo-host/people"


def refuse(message, code=64):
    """Ends with the code and a message naming what was found, never the password."""
    print(f"porelo-host-forge-password: {message}", file=sys.stderr)
    sys.exit(code)


def setting(values, key, pattern):
    """A value of root's own configuration, checked against its pattern."""
    value = values.get(key, "")
    if not re.fullmatch(pattern, value):
        refuse(f"{CONF} names no valid {key}", 69)
    return value


def trusted(path):
    """Refuses unless the path and the directories above it are root's alone to write, and the path a plain file."""
    directory = os.path.dirname(path)
    while directory != "/":
        try:
            status = os.lstat(directory)
        except OSError:
            refuse(f"{directory} is missing; run up first", 69)
        if not stat.S_ISDIR(status.st_mode) or status.st_uid != 0 or status.st_mode & 0o022:
            refuse(f"{directory} is not a directory root's alone to write", 69)
        directory = os.path.dirname(directory)
    try:
        status = os.lstat(path)
    except OSError:
        refuse(f"{path} is missing; run up first", 69)
    if not stat.S_ISREG(status.st_mode) or status.st_uid != 0 or status.st_mode & 0o022:
        refuse(f"{path} is not a plain file root's alone to write", 69)


def port(value):
    """A TCP port, 1 to 65535."""
    if int(value) > 65535:
        refuse(f"{CONF} names no valid port", 69)
    return value


def sudo_person():
    """Select an admitted sudo caller before the caller's environment is cleared."""
    user, uid = os.environ.get("SUDO_USER"), os.environ.get("SUDO_UID")
    if user is None or uid == "0":
        return None
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,30}", user) or not re.fullmatch(r"[1-9][0-9]{0,9}", uid or ""):
        refuse("sudo names no valid person", 65)
    path = f"{PEOPLE}/{user}.conf"
    trusted(path)
    try:
        with open(path, encoding="utf-8") as stream:
            states = [line.rstrip("\n") for line in stream if line.startswith("locked=")]
    except (OSError, UnicodeError):
        refuse("cannot read the person's admission record", 69)
    if states != ["locked=false"]:
        refuse("the person is not recorded unlocked", 65)
    return user


def configuration(person=None):
    """The forge's address, port, person and account, from the file the forge role writes, root's alone to write."""
    trusted(CONF)
    values = {}
    with open(CONF, encoding="utf-8") as lines:
        for line in lines:
            key, _, value = line.rstrip("\n").partition("=")
            if key == "person" and person is not None:
                continue
            values[key] = value
    return (
        setting(values, "address", r"[0-9]{1,3}(\.[0-9]{1,3}){3}"),
        port(setting(values, "port", r"[1-9][0-9]{0,4}")),
        person if person is not None else setting(values, "person", r"[a-z][a-z0-9-]{0,30}"),
        setting(values, "account", r"[a-z_][a-z0-9_-]{0,31}"),
    )


def password():
    """One line from standard input, the newline taken off; nothing else may follow."""
    data = sys.stdin.buffer.read(4097)
    if len(data) > 4096:
        refuse("the password is longer than 4096 bytes")
    try:
        text = data.decode("utf-8", errors="strict")
    except UnicodeDecodeError:
        refuse("standard input is not UTF-8")
    if text.endswith("\n"):
        text = text[:-1]
    if not text or "\n" in text or "\r" in text:
        refuse("standard input must hold the password as one line")
    return text


def admin_token(account):
    """A write:admin token of the forge's admin, made by Forgejo's command line in its container, kept in memory."""
    name = "porelo-host-password-" + datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    uid = subprocess.run(["id", "-u", account], capture_output=True, text=True, check=False).stdout.strip()
    if not uid.isdigit() or uid == "0":
        refuse(f"the forge's account {account} is not known, or is root", 69)
    made = subprocess.run(
        [
            "runuser",
            "-u",
            account,
            "--",
            "env",
            f"XDG_RUNTIME_DIR=/run/user/{uid}",
            "podman",
            "exec",
            "forgejo",
            "forgejo",
            "admin",
            "user",
            "generate-access-token",
            "--username",
            ADMIN,
            "--token-name",
            name,
            "--scopes",
            "write:admin",
            "--raw",
        ],
        capture_output=True,
        text=True,
        check=False,
        cwd="/",
    )
    token = made.stdout.strip()
    if made.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}", token):
        refuse(f"Forgejo made no admin token (exit {made.returncode})", 69)
    return token


def set_password(address, port, person, token, secret):
    """PATCH the person's account with the password and no change asked at the next sign-in."""
    body = json.dumps({"login_name": person, "source_id": 0, "password": secret, "must_change_password": False})
    request = urllib.request.Request(
        f"https://{address}:{port}/api/v1/admin/users/{person}",
        data=body.encode("utf-8"),
        method="PATCH",
        headers={"Authorization": f"token {token}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, context=ssl.create_default_context(cafile=CA), timeout=30) as answer:
            return answer.status
    except urllib.error.HTTPError as error:
        return error.code
    except (urllib.error.URLError, OSError) as error:
        refuse(f"the forge did not answer: {type(error).__name__}", 69)


def main():
    """Checks the call, reads the password, sets it, and says only how it ended."""
    if len(sys.argv) != 1:
        refuse("takes no arguments; the password comes on standard input")
    if os.geteuid() != 0:
        refuse("runs only as root")
    person = sudo_person()
    # Nothing of the caller's search path or locale decides what runs.
    os.environ.clear()
    os.environ.update(PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", LC_ALL="C")
    address, port, person, account = configuration(person)
    trusted(CA)
    secret = password()
    status = set_password(address, port, person, admin_token(account), secret)
    if status != 200:
        refuse(f"the forge answered {status} setting {person}'s password", 65)
    print(f"{person}'s password is set; sign in at the forge with it.")


if __name__ == "__main__":
    main()
