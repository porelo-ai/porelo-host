#!/bin/sh
# Each push to the host's forge, judged by the host after Forgejo's own pre-receive hook: the hook's lines, the
# repository and its quarantine go to the host's socket, whose answer is shown to the pusher. No answer refuses it.
set -u
answer=$(
    {
        printf 'repository %s\nquarantine %s\nobjects %s\nalternates %s\n\n' "$(pwd -P)" "${GIT_QUARANTINE_PATH-}" \
            "${GIT_OBJECT_DIRECTORY-}" "${GIT_ALTERNATE_OBJECT_DIRECTORIES-}"
        cat
    } | curl -sS --max-time 300 --unix-socket /run/porelo-verify/verify.sock --data-binary @- \
        -H 'Content-Type: text/plain' -w '%{http_code}' http://localhost/verify 2>/dev/null
) || answer="porelo: the host could not judge this push
000"
# The status is the answer's last three characters, after the body the host ends with a newline.
code=${answer#"${answer%???}"}
printf '%s' "${answer%???}" >&2
[ "$code" = 200 ]
