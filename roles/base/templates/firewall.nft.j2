#!/usr/sbin/nft -f
{{ ansible_managed | comment }}
# Only SSH is reachable on the public interfaces.
table inet porelo_host
delete table inet porelo_host
table inet porelo_host {
    chain input {
        type filter hook input priority filter; policy accept;
        iifname != { {{ __base_public | map('to_json') | join(', ') }} } accept
        ct state established,related accept
        ct state invalid drop
        meta l4proto { icmp, ipv6-icmp } accept
        tcp dport 22 accept
        drop
    }
}
