[Unit]
Description=Porelo Matrix client gate socket

[Socket]
ListenStream=/run/porelo-matrix/client.sock
Accept=yes
SocketUser={{ matrix_account }}
SocketGroup=porelo-people
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
# A burst of connections must not stop the socket for good: systemd's trigger limit would fail it, RemoveOnStop
# deletes the path, and every request through the window's forward is then empty, as the forge page once was.
TriggerLimitIntervalSec=0
# One process each, under a guard no real load reaches; without the line, systemd would refuse past 64.
MaxConnections=4096

[Install]
WantedBy=sockets.target
