#!/usr/sbin/nft -f
{{ ansible_managed | comment }}
# On the public interfaces only ssh and the VPN's port; everything else the host offers, only through the VPN.
table inet porelo_host
delete table inet porelo_host
table inet porelo_host {
    chain input {
        type filter hook input priority filter; policy accept;
        iifname != { {{ __vpn_public | map('to_json') | join(', ') }} } accept
        ct state established,related accept
        ct state invalid drop
        meta l4proto { icmp, ipv6-icmp } accept
        tcp dport {{ vpn_ssh_port }} accept
        udp dport {{ vpn_port }} accept
        drop
    }
}
