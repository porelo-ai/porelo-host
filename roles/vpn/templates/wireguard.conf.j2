{{ ansible_managed | comment }}
[Interface]
Address = {{ vpn_address }}
ListenPort = {{ vpn_port }}
PostUp = wg set %i private-key {{ vpn_private_key_path }}
# Each admitted person's laptops, written by porelo-host-person, come back with the interface after a reboot.
PostUp = for peers in /etc/wireguard/porelo-host-peers/*.conf; do [ -f "$peers" ] && wg addconf %i "$peers"; done; true
{% for peer in vpn_peers %}

[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips }}
{% endfor %}
