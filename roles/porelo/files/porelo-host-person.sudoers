# Each helper checks SUDO_USER against root's records; sync accepts only sync <project> by that project's admin,
# and registry, in its bare form alone, only the pinned host admin.
%porelo-people ALL=(root) NOPASSWD: /usr/local/sbin/porelo-host-person sync *
%porelo-people ALL=(root) NOPASSWD: /usr/local/sbin/porelo-host-person registry
