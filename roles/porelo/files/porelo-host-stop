#!/bin/bash
# The person's step at up's stop, run in their terminal on the host: each passphrase asked again in place until it is
# done or cancelled, so a typo never costs a whole up run. The vault reads the secrets.
# With --stdin, run as root by the desktop's pipeline from the person's secrets file: one line per secret, each
# checked before any is used, then each decoded on a pipe straight into what uses it; nothing is asked.
set -u

stdin_stop_conf=/etc/porelo-host/stop.conf
stdin_vpn_conf=/etc/porelo-host/vpn.conf
# The forge role's tasks read the token from here; the tmpfs keeps it from outliving a reboot.
stdin_central_token=/run/porelo-host/forge-central.token
stdin_forge_conf=/etc/porelo-host/forge.conf
# Where up's request leaves the forge's key and request, and where its signed certificate and the CA's wait.
stdin_forge_dir=/etc/porelo-host/forge
stdin_max_lines=256
# The registration token of the homeserver the project's room is on, in Porelo's account, where the signed project file
# names it; the account's own, written as the account.
stdin_matrix_token=.config/porelo/matrix/host-registration-token

stdin_refuse() {
    printf '%s\n' "porelo-host-stop: $1" >&2
    exit "${2:-64}"
}

# A value of root's own configuration, refused where another account could have written it.
stdin_conf_value() {
    local file=$1 key=$2 pattern=$3 owner_mode line value=
    [ -f "$file" ] && [ ! -L "$file" ] || stdin_refuse "$file is missing; run up first" 69
    owner_mode=$(stat -c '%u %a' -- "$file") || stdin_refuse "cannot read $file" 69
    case "$owner_mode" in
        '0 '[0-7][0145][0145]|'0 '[0-7][0-7][0145][0145]) ;;
        *) stdin_refuse "$file is not root's alone to write ($owner_mode)" 69 ;;
    esac
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in "$key="*) value=${line#"$key="} ;; esac
    done < "$file"
    [[ $value =~ $pattern ]] || stdin_refuse "$file names no valid $key" 69
    printf '%s' "$value"
}

# Runs as the account, with nothing of root's environment, from a directory the account can enter.
stdin_as_account() {
    (cd / && runuser -u "$stdin_account" -- env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$stdin_home" \
        XDG_RUNTIME_DIR=/run/user/"$stdin_uid" LANG=C.UTF-8 "$@")
}

stdin_decode() {
    printf '%s' "$1" | base64 -d
}

# Written beside the target and moved over it, so a reader never sees a half-written key; only into a directory of
# root's alone, and never through a link or into a directory standing where the file belongs. The value is base64, or
# with a third argument the path of a file to copy, and a fourth its mode, 0600 by default.
stdin_write_root_file() {
    local value=$1 target=$2 source=${3-} mode=${4:-0600} dir tmp owner_mode
    stdin_check_target "$target"
    dir=$(dirname -- "$target")
    if [ ! -e "$dir" ] && [ ! -L "$dir" ]; then
        install -d -m 0700 -o root -g root -- "$dir" || stdin_refuse "cannot make $dir" 73
    fi
    [ -d "$dir" ] && [ ! -L "$dir" ] || stdin_refuse "$dir is no directory" 73
    owner_mode=$(stat -c '%u %a' -- "$dir") || stdin_refuse "cannot read $dir" 73
    case "$owner_mode" in
        '0 '[0-7][0145][0145]|'0 '[0-7][0-7][0145][0145]) ;;
        *) stdin_refuse "$dir is not root's alone to write ($owner_mode)" 73 ;;
    esac
    if [ -L "$target" ] || { [ -e "$target" ] && [ ! -f "$target" ]; }; then
        stdin_refuse "$target is no plain file" 73
    fi
    tmp=$(umask 077 && mktemp -- "$dir/.porelo-host-stop.XXXXXX") || stdin_refuse "cannot write in $dir" 73
    if [ -n "$source" ]; then
        cat -- "$source" > "$tmp" || { rm -f -- "$tmp"; stdin_refuse "cannot write $target" 73; }
    elif ! stdin_decode "$value" > "$tmp"; then
        rm -f -- "$tmp"; stdin_refuse "cannot write $target" 73
    fi
    if ! chmod "$mode" -- "$tmp" || ! mv -fT -- "$tmp" "$target"; then
        rm -f -- "$tmp"
        stdin_refuse "cannot write $target" 73
    fi
}

# The forge's certificate, signed on the desktop, is taken only as the answer to the waiting request: two PEM blocks,
# the certificate then the CA's, every check made before anything is written, each refusal naming the check.
# The names a certificate's subjectAltName carries, one per line, exactly as openssl prints each.
stdin_cert_names() {
    openssl x509 -noout -ext subjectAltName -in "$1" 2> /dev/null | tail -n +2 | tr ',' '\n' | sed 's/^ *//; s/ *$//'
}

# A file to be written must not stand as a link or anything but a plain file of root's alone, nor lie in a directory
# anybody but root can write; checked for every target before anything is written.
stdin_check_target() {
    local dir owner_mode
    dir=$(dirname -- "$1")
    if [ -e "$dir" ] || [ -L "$dir" ]; then
        [ -d "$dir" ] && [ ! -L "$dir" ] || stdin_refuse "$dir is no directory" 73
        owner_mode=$(stat -c '%u %a' -- "$dir") || stdin_refuse "cannot read $dir" 73
        case "$owner_mode" in
            '0 '[0-7][0145][0145]|'0 '[0-7][0-7][0145][0145]) ;;
            *) stdin_refuse "$dir is not root's alone to write ($owner_mode)" 73 ;;
        esac
    fi
    if [ -L "$1" ] || { [ -e "$1" ] && [ ! -f "$1" ]; }; then
        stdin_refuse "$1 is no plain file" 73
    fi
    if [ -e "$1" ]; then
        owner_mode=$(stat -c '%u %a' -- "$1") || stdin_refuse "cannot read $1" 73
        case "$owner_mode" in
            '0 '[0-7][0145][0145]|'0 '[0-7][0-7][0145][0145]) ;;
            *) stdin_refuse "$1 is not root's alone to write ($owner_mode)" 73 ;;
        esac
    fi
}

# The token is the account's own: checked as one line of graphic ASCII characters (no space, no NUL), then written as
# the account into its home, each directory entered on its own and never through a link, beside its name and moved over
# it, so the token is never half written and never lands outside the account's own directories.
stdin_check_matrix_token() {
    # Command substitution would drop a NUL byte silently, so a token holding one is refused before it is read.
    [ "$(stdin_decode "$1" | wc -c)" = "$(stdin_decode "$1" | tr -d '\0' | wc -c)" ] \
        || stdin_refuse 'matrix-token: the token holds a NUL byte'
    stdin_token=$(stdin_decode "$1" && printf x) || stdin_refuse 'matrix-token: the token cannot be read'
    stdin_token=${stdin_token%x}
    stdin_token=${stdin_token%$'\n'}
    [[ $stdin_token =~ ^[!-~]{1,1024}$ ]] \
        || stdin_refuse 'matrix-token: the token must be one line of 1 to 1024 graphic ASCII characters'
}

# Run as the account, with "check" before any need is used and "write" after; the token comes on standard input.
stdin_matrix_token_as_account() {
    # shellcheck disable=SC2016 # the script expands in the account's own shell, not here
    stdin_as_account sh -c '
        set -eu
        case $HOME in /?*) ;; *) echo "the home $HOME is no absolute path" >&2; exit 73 ;; esac
        [ -d "$HOME" ] && [ ! -L "$HOME" ] || { echo "the home $HOME is no directory" >&2; exit 73; }
        cd -P -- "$HOME"
        home=$PWD
        umask 077
        for d in .config porelo matrix; do
            [ ! -L "$d" ] || { echo "$PWD/$d is a link" >&2; exit 73; }
            if [ ! -e "$d" ]; then
                [ -O . ] && [ -w . ] || { echo "$PWD is not the account'"'"'s to write" >&2; exit 73; }
                [ "$1" = write ] || exit 0
                mkdir -- "$d"
            fi
            [ -d "$d" ] || { echo "$PWD/$d is no directory" >&2; exit 73; }
            cd -P -- "$d"
        done
        [ "$PWD" = "$home/.config/porelo/matrix" ] || { echo "cannot enter $home/.config/porelo/matrix" >&2; exit 73; }
        [ -O . ] && [ -O .. ] && [ -w . ] || { echo "$PWD is not the account'"'"'s to write" >&2; exit 73; }
        f=host-registration-token
        [ ! -L "$f" ] && { [ ! -e "$f" ] || [ -f "$f" ]; } || { echo "$PWD/$f is no plain file" >&2; exit 73; }
        [ "$1" = write ] || exit 0
        chmod 0700 . ..
        t=$(mktemp .host-registration-token.XXXXXX)
        trap '\''rm -f -- "$t"'\'' EXIT HUP INT TERM
        cat > "$t"
        chmod 0600 "$t"
        mv -fT -- "$t" "$f"
        trap - EXIT HUP INT TERM' matrix-token "$1"
}

stdin_check_forge_certificate() {
    local address name net key_pub cert_pub names constraints existing given_ca
    address=$(stdin_conf_value "$stdin_forge_conf" address '^[0-9]{1,3}(\.[0-9]{1,3}){3}$') || exit $?
    name=$(stdin_conf_value "$stdin_forge_conf" name '^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$') || exit $?
    net=${address%.*}.0
    [ -f "$stdin_forge_dir/forge.key" ] && [ ! -L "$stdin_forge_dir/forge.key" ] \
        || stdin_refuse 'forge-certificate: no request waits for a certificate; run up first' 69
    [ "$(stat -c '%u %a' -- "$stdin_forge_dir/forge.key")" = '0 600' ] \
        || stdin_refuse "forge-certificate: $stdin_forge_dir/forge.key is not root's alone" 69
    stdin_check_target "$stdin_forge_dir/forge.pem"
    stdin_check_target "$stdin_forge_dir/ca.pem"
    stdin_decode "$1" > "$stdin_work/both.pem"
    awk -v out="$stdin_work" '
        /^-----BEGIN CERTIFICATE-----$/ { n++; inside = 1 }
        inside { print > (out "/" (n == 1 ? "forge.pem" : n == 2 ? "ca.pem" : "extra.pem")) }
        /^-----END CERTIFICATE-----$/ { inside = 0 }
        END { print n + 0 > (out "/count") }' "$stdin_work/both.pem"
    [ "$(cat "$stdin_work/count")" = 2 ] \
        || stdin_refuse 'forge-certificate: the line must hold two certificates, the forge'"'"'s then the CA'"'"'s'
    # Each public key read on its own, so a key or certificate that cannot be read never compares equal to another.
    key_pub=$(openssl pkey -pubout -in "$stdin_forge_dir/forge.key" 2> /dev/null) && [ -n "$key_pub" ] \
        || stdin_refuse 'forge-certificate: the waiting key cannot be read' 69
    cert_pub=$(openssl x509 -noout -pubkey -in "$stdin_work/forge.pem" 2> /dev/null) && [ -n "$cert_pub" ] \
        || stdin_refuse 'forge-certificate: the certificate cannot be read'
    [ "$cert_pub" = "$key_pub" ] || stdin_refuse 'forge-certificate: the certificate is for another key'
    openssl x509 -noout -ext basicConstraints -in "$stdin_work/forge.pem" 2> /dev/null | grep -qx ' *CA:FALSE' \
        || stdin_refuse 'forge-certificate: the forge'"'"'s certificate is no leaf certificate'
    openssl x509 -noout -ext basicConstraints -in "$stdin_work/ca.pem" 2> /dev/null | grep -q '^ *CA:TRUE' \
        || stdin_refuse 'forge-certificate: the second certificate is no CA'
    openssl verify -CAfile "$stdin_work/ca.pem" "$stdin_work/forge.pem" > /dev/null 2>&1 \
        || stdin_refuse 'forge-certificate: the certificate does not verify under the CA given'
    names=$(stdin_cert_names "$stdin_work/forge.pem")
    if ! grep -qxF "IP Address:$address" <<< "$names" || ! grep -qxF "DNS:$name" <<< "$names"; then
        stdin_refuse "forge-certificate: the certificate does not name $address and $name"
    fi
    openssl x509 -checkend 2592000 -noout -in "$stdin_work/forge.pem" > /dev/null \
        || stdin_refuse 'forge-certificate: the certificate ends within 30 days'
    # The CA is held to the forge's names and the VPN's network, and nothing more.
    constraints=$(openssl x509 -noout -ext nameConstraints -in "$stdin_work/ca.pem" 2> /dev/null \
        | sed 's/^ *//; s/ *$//')
    [ "$constraints" = "X509v3 Name Constraints: critical
Permitted:
DNS:porelo.internal
IP:$net/255.255.255.0" ] \
        || stdin_refuse "forge-certificate: the CA is not held to porelo.internal and $net/24 alone, critically"
    if [ -e "$stdin_forge_dir/ca.pem" ]; then
        existing=$(openssl x509 -noout -fingerprint -sha256 -in "$stdin_forge_dir/ca.pem" 2> /dev/null) \
            && [ -n "$existing" ] || stdin_refuse "forge-certificate: $stdin_forge_dir/ca.pem cannot be read" 69
        given_ca=$(openssl x509 -noout -fingerprint -sha256 -in "$stdin_work/ca.pem" 2> /dev/null)
        [ "$existing" = "$given_ca" ] \
            || stdin_refuse "forge-certificate: the CA is not the one in $stdin_forge_dir/ca.pem"
    fi
}

stdin_stop() {
    local -A named=() given=()
    local -a key_names=()
    local need line count=0 rest name value
    [ "$#" -gt 0 ] || stdin_refuse 'at least one need is required: vault-new, vault, keys, wireguard,'\
' forge-central-token, forge-certificate, matrix-token'
    for need in "$@"; do
        case "$need" in
            vault-new|vault|keys|wireguard|forge-central-token|forge-certificate|matrix-token) ;;
            drive) stdin_refuse 'drive is no need of the host any more' ;;
            *) stdin_refuse "unknown need or option: $need" ;;
        esac
        [ -z "${named[$need]+x}" ] || stdin_refuse "need named twice: $need"
        named[$need]=1
    done
    if [ -n "${named[vault-new]+x}" ] && [ -n "${named[vault]+x}" ]; then
        stdin_refuse 'vault-new and vault exclude each other'
    fi
    # Run as root by sudo: nothing of the caller's search path or locale decides what runs or what a pattern matches.
    # Set after the needs are read with builtins alone, so a wrong call refuses before any command is looked up.
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
    [ "$(id -u)" = 0 ] || stdin_refuse '--stdin runs only as root'
    require_command base64
    require_command runuser

    # Every line is checked before any is used, so a bad line never leaves half the needs done.
    while IFS= read -r line || [ -n "$line" ]; do
        count=$((count + 1))
        [ "$count" -le "$stdin_max_lines" ] || stdin_refuse "more than $stdin_max_lines lines"
        need=${line%% *}
        rest=${line#* }
        [ "$rest" != "$line" ] || stdin_refuse "line $count holds no value"
        name=
        case "$need" in
            key)
                [ -n "${named[keys]+x}" ] || stdin_refuse "line $count gives a key, but keys is not named"
                name=${rest%% *}
                value=${rest#* }
                [ "$value" != "$rest" ] || stdin_refuse "line $count holds no value"
                [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || stdin_refuse "line $count names no valid key"
                ;;
            vault-new|vault|wireguard|forge-central-token|forge-certificate|matrix-token)
                [ -n "${named[$need]+x}" ] || stdin_refuse "line $count gives $need, which is not named"
                value=$rest
                ;;
            *) stdin_refuse "line $count gives an unknown need" ;;
        esac
        # The value is never echoed: a refusal names the line and the need alone.
        if ! [[ $value =~ ^[A-Za-z0-9+/]+={0,2}$ ]] || [ $(( ${#value} % 4 )) != 0 ] \
            || ! stdin_decode "$value" > /dev/null 2>&1; then
            stdin_refuse "line $count holds no base64 value"
        fi
        [ -z "${given["$need $name"]+x}" ] || stdin_refuse "line $count gives ${name:-$need} a second time"
        given["$need $name"]=$value
        [ "$need" != key ] || key_names+=("$name")
    done
    for need in vault-new vault wireguard forge-central-token forge-certificate matrix-token; do
        if [ -n "${named[$need]+x}" ] && [ -z "${given["$need "]+x}" ]; then
            stdin_refuse "no line gives $need"
        fi
    done
    # A new vault's machine may have no keys; keys named alone are given because a key is missing.
    if [ -n "${named[keys]+x}" ] && [ -z "${named[vault-new]+x}" ] && [ "${#key_names[@]}" = 0 ]; then
        stdin_refuse 'no line gives keys'
    fi

    if [ -n "${named[vault-new]+x}" ] || [ -n "${named[vault]+x}" ] || [ -n "${named[keys]+x}" ] \
        || [ -n "${named[matrix-token]+x}" ]; then
        stdin_account=$(stdin_conf_value "$stdin_stop_conf" account '^[a-z_][a-z0-9_-]{0,31}$') || exit $?
        local entry
        entry=$(getent passwd "$stdin_account") || stdin_refuse "the account $stdin_account is not known" 69
        IFS=: read -r _ _ stdin_uid _ _ stdin_home _ <<< "$entry"
        [ "$stdin_uid" != 0 ] || stdin_refuse "$stdin_stop_conf names root, not Porelo's account" 69
    fi
    if [ -n "${named[vault-new]+x}" ] || [ -n "${named[vault]+x}" ] || [ -n "${named[keys]+x}" ]; then
        require_command porelo
    fi
    if [ -n "${named[wireguard]+x}" ]; then
        stdin_key_path=$(stdin_conf_value "$stdin_vpn_conf" key '^/[A-Za-z0-9._/-]+$') || exit $?
        case "$stdin_key_path/" in */../*|*/./*|*//*) stdin_refuse "$stdin_vpn_conf names no valid key" 69 ;; esac
        stdin_check_target "$stdin_key_path"
    fi
    if [ -n "${named[forge-central-token]+x}" ]; then
        stdin_check_target "$stdin_central_token"
    fi
    if [ -n "${named[matrix-token]+x}" ]; then
        stdin_check_matrix_token "${given["matrix-token "]}"
        stdin_matrix_token_as_account check < /dev/null \
            || stdin_refuse "matrix-token: cannot write $stdin_home/$stdin_matrix_token" 73
    fi
    if [ -n "${named[forge-certificate]+x}" ]; then
        require_command openssl
        stdin_work=$(umask 077 && mktemp -d) || stdin_refuse 'cannot make a working directory' 73
        trap 'rm -rf -- "$stdin_work"' EXIT
        stdin_check_forge_certificate "${given["forge-certificate "]}"
    fi

    if [ -n "${named[vault-new]+x}" ]; then
        stdin_decode "${given["vault-new "]}" | stdin_as_account porelo vault init --passphrase-stdin \
            || stdin_refuse 'porelo vault init refused vault-new' 65
    fi
    if [ -n "${named[vault]+x}" ]; then
        stdin_decode "${given["vault "]}" | stdin_as_account porelo vault unlock --passphrase-stdin \
            || stdin_refuse 'porelo vault unlock refused vault' 65
    fi
    for name in "${key_names[@]}"; do
        stdin_decode "${given["key $name"]}" | stdin_as_account porelo vault put "$name" > /dev/null \
            || stdin_refuse "porelo vault put refused the key $name" 65
    done
    if [ -n "${named[wireguard]+x}" ]; then
        stdin_write_root_file "${given["wireguard "]}" "$stdin_key_path"
    fi
    if [ -n "${named[forge-central-token]+x}" ]; then
        stdin_write_root_file "${given["forge-central-token "]}" "$stdin_central_token"
    fi
    if [ -n "${named[forge-certificate]+x}" ]; then
        stdin_write_root_file '' "$stdin_forge_dir/ca.pem" "$stdin_work/ca.pem" 0644
        stdin_write_root_file '' "$stdin_forge_dir/forge.pem" "$stdin_work/forge.pem" 0644
    fi
    if [ -n "${named[matrix-token]+x}" ]; then
        printf '%s' "$stdin_token" | stdin_matrix_token_as_account write \
            || stdin_refuse "matrix-token: cannot write $stdin_home/$stdin_matrix_token" 73
    fi
    printf '%s\n' "The host's stop is done; run up again."
    exit 0
}

cancel() {
    printf '\n%s\n' 'Cancelled; the host waits at this stop. Running up again comes back here.'
    exit 75
}

wrong_call() {
    printf '%s\n' "porelo-host-stop: $1" >&2
    exit 64
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf '%s\n' "porelo-host-stop: $1 is not found on PATH" >&2
        exit 69
    }
}

try_again() {
    printf 'Try again? [Y/n] '
    IFS= read -r answer || cancel
    case "$answer" in n|N) cancel ;; esac
}

if [ "${1-}" = --stdin ]; then
    shift
    stdin_stop "$@"
fi
# The forge's waiting request, no secret, for the desktop to sign.
if [ "${1-}" = --request ]; then
    [ "$#" = 1 ] || wrong_call '--request takes nothing more'
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
    [ -f "$stdin_forge_dir/forge.csr" ] && [ ! -L "$stdin_forge_dir/forge.csr" ] || {
        printf '%s\n' 'porelo-host-stop: no request waits for the forge'"'"'s certificate' >&2
        exit 65
    }
    cat -- "$stdin_forge_dir/forge.csr" || exit 69
    exit 0
fi

trap cancel INT
vault_new=false
vault=false

while [ "$#" -gt 0 ]; do
    case "$1" in
        drive) wrong_call 'drive is no need of the host any more' ;;
        vault-new) "$vault_new" && wrong_call 'need named twice: vault-new'; vault_new=true; shift ;;
        vault) "$vault" && wrong_call 'need named twice: vault'; vault=true; shift ;;
        *) wrong_call "unknown need or option: $1" ;;
    esac
done

if ! "$vault_new" && ! "$vault"; then
    wrong_call 'at least one need is required: vault-new, vault'
fi
if "$vault_new" && "$vault"; then
    wrong_call 'vault-new and vault exclude each other'
fi

require_command porelo
if [ "${XDG_RUNTIME_DIR+x}" != x ]; then
    require_command id
    account_id=$(id -u) || {
        printf '%s\n' 'porelo-host-stop: cannot read the account id' >&2
        exit 69
    }
    export XDG_RUNTIME_DIR=/run/user/"$account_id"
fi

if "$vault_new"; then
    until porelo vault init; do
        try_again
    done
fi
if "$vault"; then
    until porelo vault unlock; do
        try_again
    done
fi

printf '%s\n' "The host's stop is done; close this terminal, and setup goes on."
exit 0
