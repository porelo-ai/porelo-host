#!/bin/bash
# The person's step at up's stop, run in their terminal on the host: each passphrase asked again in place until it is
# done or cancelled, so a typo never costs a whole up run. The vault reads the secrets.
# With --stdin, run in the person's account from their secrets file: one line per secret, each checked before any is
# used, then each decoded on a pipe straight into what uses it; nothing is asked.
set -u

stdin_max_lines=256

stdin_refuse() {
    printf '%s\n' "porelo-host-stop: $1" >&2
    exit "${2:-64}"
}

stdin_decode() {
    printf '%s' "$1" | base64 -d
}


# The host takes no secret as root any more: SSH replaced the VPN's key, and the forge's gate the certificates.
stdin_stop() {
    stdin_refuse 'the host takes no secret as root any more; give each need in your own account' 64
}

# --stdin run by a person, not root: their own needs into their own account, from the host admin's desktop or their own
# act. Nothing here runs as anyone else, so the caller's search path stays; each line is still checked before any is
# used, and no value is ever echoed.

own_stop() {
    local -A named=() given=()
    local -a key_names=()
    local need line count=0 rest name value project
    local -a waiting=()
    [ "$#" -gt 0 ] || stdin_refuse 'at least one need is required: vault-new, vault, keys, forge-central-token'
    for need in "$@"; do
        case "$need" in
            vault-new|vault|keys|forge-central-token) ;;
            # A person's forge token is made at each bring and join, a task's at its start: none waits for a stop.
            wireguard|forge-certificate|identities) stdin_refuse "$need is no need of the host any more" ;;
            drive) stdin_refuse 'drive is no need of the host any more' ;;
            *) stdin_refuse "unknown need or option: $need" ;;
        esac
        [ -z "${named[$need]+x}" ] || stdin_refuse "need named twice: $need"
        named[$need]=1
    done
    if [ -n "${named[vault-new]+x}" ] && [ -n "${named[vault]+x}" ]; then
        stdin_refuse 'vault-new and vault exclude each other'
    fi
    [ ! -t 0 ] || stdin_refuse '--stdin reads its lines from a pipe, not a terminal'
    export LC_ALL=C

    while IFS= read -r line || [ -n "$line" ]; do
        count=$((count + 1))
        [ "$count" -le "$stdin_max_lines" ] || stdin_refuse "more than $stdin_max_lines lines"
        need=${line%% *}
        rest=${line#* }
        [ "$rest" != "$line" ] || stdin_refuse "line $count holds no value"
        name=
        case "$need" in
            key)
                [ -n "${named[keys]+x}" ] || stdin_refuse "line $count gives a key, but keys is not named"
                name=${rest%% *}
                value=${rest#* }
                [ "$value" != "$rest" ] || stdin_refuse "line $count holds no value"
                [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || stdin_refuse "line $count names no valid key"
                ;;
            vault-new|vault|forge-central-token)
                [ -n "${named[$need]+x}" ] || stdin_refuse "line $count gives $need, which is not named"
                value=$rest
                ;;
            *) stdin_refuse "line $count gives $need, which is not named here" ;;
        esac
        if ! [[ $value =~ ^[A-Za-z0-9+/]+={0,2}$ ]] || [ $(( ${#value} % 4 )) != 0 ] \
            || ! stdin_decode "$value" > /dev/null 2>&1; then
            stdin_refuse "line $count holds no base64 value"
        fi
        [ -z "${given["$need $name"]+x}" ] || stdin_refuse "line $count gives ${name:-$need} a second time"
        given["$need $name"]=$value
        [ "$need" != key ] || key_names+=("$name")
    done
    for need in vault-new vault forge-central-token; do
        if [ -n "${named[$need]+x}" ] && [ -z "${given["$need "]+x}" ]; then
            stdin_refuse "no line gives $need"
        fi
    done
    if [ -n "${named[keys]+x}" ] && [ -z "${named[vault-new]+x}" ] && [ "${#key_names[@]}" = 0 ]; then
        stdin_refuse 'no line gives keys'
    fi

    # The bring that waits left its list of repositories to migrate; porelo-host-push checks it again before use.
    if [ -n "${named[forge-central-token]+x}" ]; then
        shopt -s nullglob
        waiting=("${HOME-}"/.config/porelo-host/push/*.migrate)
        shopt -u nullglob
        [ "${#waiting[@]}" = 1 ] || stdin_refuse 'no single bring waits for the central token; run the bring again' 69
        project=${waiting[0]##*/}
        project=${project%.migrate}
        require_command porelo-host-push
    fi
    if [ -n "${named[vault-new]+x}" ] || [ -n "${named[vault]+x}" ] || [ -n "${named[keys]+x}" ]; then
        require_command porelo
        export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$EUID}
    fi

    if [ -n "${named[vault-new]+x}" ]; then
        stdin_decode "${given["vault-new "]}" | porelo vault init --passphrase-stdin \
            || stdin_refuse 'porelo vault init refused vault-new' 65
    fi
    if [ -n "${named[vault]+x}" ]; then
        stdin_decode "${given["vault "]}" | porelo vault unlock --passphrase-stdin \
            || stdin_refuse 'porelo vault unlock refused vault' 65
    fi
    for name in "${key_names[@]}"; do
        stdin_decode "${given["key $name"]}" | porelo vault put "$name" > /dev/null \
            || stdin_refuse "porelo vault put refused the key $name" 65
    done
    # Used once, on a pipe: the token is in no file, and the bring run again finds the repositories there.
    if [ -n "${named[forge-central-token]+x}" ]; then
        if ! stdin_decode "${given["forge-central-token "]}" | porelo-host-push --migrate "$project"; then
            stdin_refuse "the migration of $project stopped; porelo-host-push said why above" 65
        fi
    fi
    printf '%s\n' "Your stop is done."
    exit 0
}

cancel() {
    printf '\n%s\n' 'Cancelled; the host waits at this stop. Running up again comes back here.'
    exit 75
}

wrong_call() {
    printf '%s\n' "porelo-host-stop: $1" >&2
    exit 64
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf '%s\n' "porelo-host-stop: $1 is not found on PATH" >&2
        exit 69
    }
}

try_again() {
    printf 'Try again? [Y/n] '
    IFS= read -r answer || cancel
    case "$answer" in n|N) cancel ;; esac
}

if [ "${1-}" = --stdin ]; then
    shift
    if [ "$EUID" = 0 ]; then
        stdin_stop "$@"
    fi
    own_stop "$@"
fi

trap cancel INT
vault_new=false
vault=false

while [ "$#" -gt 0 ]; do
    case "$1" in
        drive) wrong_call 'drive is no need of the host any more' ;;
        vault-new) "$vault_new" && wrong_call 'need named twice: vault-new'; vault_new=true; shift ;;
        vault) "$vault" && wrong_call 'need named twice: vault'; vault=true; shift ;;
        *) wrong_call "unknown need or option: $1" ;;
    esac
done

if ! "$vault_new" && ! "$vault"; then
    wrong_call 'at least one need is required: vault-new, vault'
fi
if "$vault_new" && "$vault"; then
    wrong_call 'vault-new and vault exclude each other'
fi

require_command porelo
if [ "${XDG_RUNTIME_DIR+x}" != x ]; then
    require_command id
    account_id=$(id -u) || {
        printf '%s\n' 'porelo-host-stop: cannot read the account id' >&2
        exit 69
    }
    export XDG_RUNTIME_DIR=/run/user/"$account_id"
fi

if "$vault_new"; then
    until porelo vault init; do
        try_again
    done
fi
if "$vault"; then
    until porelo vault unlock; do
        try_again
    done
fi

printf '%s\n' "The host's stop is done; close this terminal, and setup goes on."
exit 0
