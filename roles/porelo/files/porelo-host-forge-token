#!/bin/bash
set -u

case "$#:${1-}" in
    0:|1:--if-forge) ;;
    *) printf '%s\n' 'porelo-host-forge-token: usage: porelo-host-forge-token [--if-forge]' >&2; exit 64 ;;
esac

forge_conf=/etc/porelo-host/forge.conf
person_helper=/usr/local/sbin/porelo-host-person
forge_token_lib=/usr/local/share/porelo-host-forge-token.sh
helper_owner=0
local_token=

# The helper runs with the person's open vault, so only a file and directory root alone can change are read.
root_alone() {
    local owner mode
    read -r owner mode < <(stat -c '%u %a' -- "$1") || return 1
    [ "$owner" = "$helper_owner" ] && [[ $mode =~ ^[0-7]{3,4}$ ]] && [ $((8#$mode & 8#022)) = 0 ]
}
if ! { [ -f "$forge_token_lib" ] && [ ! -L "$forge_token_lib" ] && [ ! -L "${forge_token_lib%/*}" ] \
    && root_alone "$forge_token_lib" && root_alone "${forge_token_lib%/*}"; }; then
    printf '%s\n' 'porelo-host-forge-token: the shared forge token helper is not a file root alone can change' >&2
    exit 69
fi
# shellcheck source=roles/porelo/files/porelo-host-forge-token.sh
source "$forge_token_lib" || {
    printf '%s\n' 'porelo-host-forge-token: the shared forge token helper could not be loaded' >&2
    exit 69
}

if [ "${1-}" = --if-forge ] && [ ! -e "$forge_conf" ] && [ ! -L "$forge_conf" ]; then
    exit 0
fi

export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$EUID}
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}
status=0
refresh_person_forge_token "$forge_conf" "$person_helper" "$@" || status=$?
if [ "$status" = 65 ]; then
    printf '%s\n' "porelo-host-forge-token: the vault refused the person's forge token; unlock it and retry" >&2
fi
exit "$status"
