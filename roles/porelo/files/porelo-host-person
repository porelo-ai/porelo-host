def text_keys(applied):
    """The keys of a state's host admins, one line each, as an authorized keys file."""
    return "".join(f'{admin["key"]}\n' for admin in applied["admins"])


class Refusal(Exception):
    """A safe diagnostic and the interface's exit code."""

    def __init__(self, message, code=64, told=None):
        """Keep the interface exit code with the diagnostic, and the exit a person is told where a helper's differs."""
        super().__init__(message)
        self.code = code
        self.told = code if told is None else told

    def shown(self):
        """The diagnostic as status and the journal give it."""
        return f"{self} (exit {self.told})"


def refuse(message, code=64):
    """Stop without echoing the input or a command's potentially sensitive output."""
    raise Refusal(message, code)


def helper_words(stderr, supplied):
    """The project helper's own refusal, or None: its last line alone, as anything before it may repeat a credential."""
    lines = stderr.splitlines()
    if not lines or not lines[-1].startswith(HELPER_PREFIX):
        return None
    words = "".join(char if char.isprintable() else " " for char in lines[-1][len(HELPER_PREFIX) :])
    token = (supplied or {}).get("token")
    if token and token in "".join(char for char in lines[-1] if char.isprintable()):
        return None
    return words[:HELPER_WORDS_LIMIT].strip() or None


def run_command(arguments, input=None, timeout=60, pass_fds=()):
    """The only system command runner; no shell or inherited input/output."""
    return subprocess.run(
        arguments,
        stdin=subprocess.DEVNULL if input is None else None,
        input=input,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        check=False,
        cwd="/",
        env=ENV,
        timeout=timeout,
        pass_fds=pass_fds,
    )


def valid_ssh_key(ssh):
    """Return True when ssh is one canonical ssh-ed25519 public key without a comment."""
    if not isinstance(ssh, str):
        return False
    parts = ssh.split(" ")
    if len(parts) != 2 or parts[0] != "ssh-ed25519":
        return False
    try:
        blob = base64.b64decode(parts[1], validate=True)
    except (ValueError, binascii.Error):
        return False
    return (
        len(blob) == 51
        and blob[:19] == b"\x00\x00\x00\x0bssh-ed25519\x00\x00\x00\x20"
        and base64.b64encode(blob).decode() == parts[1]
    )


def fingerprint(ssh):
    """The SHA256 fingerprint ssh-keygen shows for a valid key, as Porelo's verify takes it."""
    blob = base64.b64decode(ssh.split(" ", 1)[1])
    return "SHA256:" + base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("=")


def shown(value, index):
    """A name from the organization fit for a diagnostic, or the entry's position where it is none."""
    return value if isinstance(value, str) and re.fullmatch(SHOWN, value) else f"#{index}"


def certificate_line(data):
    """One ssh-ed25519 certificate line from bounded stdin, its comment dropped; nothing else is read."""
    if not data or len(data) > MAX_CERTIFICATE:
        refuse(f"the task certificate is empty or longer than {MAX_CERTIFICATE} bytes", 64)
    try:
        text = data.decode("ascii").removesuffix("\n")
    except UnicodeDecodeError:
        refuse("the task certificate is not ASCII", 64)
    fields = text.split(" ")
    if not re.fullmatch(r"[ -~]+", text) or len(fields) not in (2, 3) or fields[0] != CERTIFICATE:
        refuse(f"standard input holds no single {CERTIFICATE} line", 64)
    try:
        base64.b64decode(fields[1], validate=True)
    except (ValueError, binascii.Error):
        refuse(f"standard input holds no single {CERTIFICATE} line", 64)
    return fields[0] + " " + fields[1]


def certificate_time(value):
    """A time ssh-keygen -L showed under TZ=UTC, or None."""
    try:
        return datetime.datetime.strptime(value, TIME).replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        return None


def read_certificate(text):
    """The fields of ssh-keygen -L's answer, each header once and in its order, or None for any other shape.

    A header repeated, missing or out of order is refused, so text inside a key ID or principal cannot pass for one.
    """
    fields, principals, current = {}, [], None
    for line in text.splitlines()[1:]:
        if line.startswith(" " * 16):
            if current is None:
                return None
            if current == "Principals":
                principals.append(line[16:])
            continue
        match = re.fullmatch(r" {8}([A-Za-z ]+): ?(.*)", line)
        if match is None or match[1] in fields or match[1] not in HEADERS:
            return None
        fields[match[1]] = match[2]
        current = match[1]
    if tuple(fields) != HEADERS:
        return None
    public = re.fullmatch(r"ED25519-CERT (" + FINGERPRINT + ")", fields["Public key"])
    signer = re.fullmatch(r"ED25519 (" + FINGERPRINT + r") \(using ssh-ed25519\)", fields["Signing CA"])
    key_id = re.fullmatch(r'"(.*)"', fields["Key ID"])
    span = re.fullmatch(r"(?:from (\S+) to|before) (\S+)", fields["Valid"])
    if public is None or signer is None or key_id is None or span is None:
        return None
    after = certificate_time(span[1]) if span[1] is not None else None
    before = certificate_time(span[2])
    if before is None or (span[1] is not None and after is None):
        return None
    return {
        "type": fields["Type"],
        "fingerprint": public[1],
        "signed_by": signer[1],
        "key_id": key_id[1],
        "principals": [] if fields["Principals"] == "(none)" else principals,
        "valid_after": after,
        "valid_before": before,
    }


def stamp(moment):
    """A UTC time as the record keeps it."""
    return None if moment is None else moment.strftime(TIME) + "Z"


def only_transports_kept(answer):
    """Whether a forced vault clear's JSON answer left nothing unremoved but accounts a transport keeps elsewhere."""
    try:
        cleared = json.loads(answer)
        kept = [item for item in cleared["items"] if item["status"] == "NOT_REMOVED"]
        return (
            cleared["refused"] is False
            and bool(kept)
            and all(item["kind"] in ("transport", "conversation") or item.get("transport") for item in kept)
        )
    except (ValueError, TypeError, KeyError, AttributeError):
        return False


def member_key(value, code=65):
    """Return the canonical sort key for one membership value, refusing unknown shapes."""
    if value == HOST_ADMIN:
        return (0, "", 0)
    parts = value.split(" ")
    if len(parts) == 2 and re.fullmatch(PROJECT, parts[0]) and parts[1] in ("project-admin", "developer"):
        return (1, parts[0], 0 if parts[1] == "project-admin" else 1)
    refuse("a record holds an invalid membership", code)


class UnixConnection(http.client.HTTPConnection):
    """Reach only the forge account's private socket."""

    def __init__(self, path, **kwargs):
        super().__init__("localhost", **kwargs)
        self.path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.path)


class UnixHandler(urllib.request.HTTPHandler):
    """Use HTTP framing without a TCP listener or proxy."""

    def __init__(self, path):
        super().__init__()
        self.path = str(path)

    def http_open(self, request):
        return self.do_open(lambda host, **kwargs: UnixConnection(self.path, **kwargs), request)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Keep an admin credential from following an API redirect to another address."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        """Let the API caller refuse the redirect without forwarding its header."""
        return None


class Host:
    """Root's paths and system operations, with no production configuration overrides."""

    def __init__(self):
        """Use root's fixed paths, the real identity and the single system command runner."""
        self.root = Path("/")
        self.euid = os.geteuid()
        self.sudo_user = None
        self.owner, self.group = 0, 0
        self.runner = run_command
        self.accounts = None
        self.groups = None
        self.commands = None
        self.now = lambda: datetime.datetime.now(datetime.timezone.utc)
        self.hooks = {
            name: getattr(self, name)
            for name in ("forge_admit", "forge_lock", "matrix_expel_revoke", "forge_drop_tokens")
        }

    def path(self, name):
        """An absolute host path, rooted elsewhere only through the import-only test hook."""
        return self.root / name.lstrip("/")

    def check(self, path, code=69, required=False, directory=False, mode=None):
        """Reject links, wrong owners and writable ancestors before reading or changing a path."""
        if path != self.root:
            self.check(path.parent, code, directory=True)
        try:
            status = path.lstat()
        except FileNotFoundError:
            if required:
                refuse(f"{path} is missing; prepare the host first", code)
            return
        except OSError:
            refuse(f"cannot inspect {path}", code)
        correct_type = stat.S_ISDIR(status.st_mode) if directory else stat.S_ISREG(status.st_mode)
        if (
            not correct_type
            or status.st_uid != self.owner
            or status.st_mode & 0o022
            or (mode is not None and stat.S_IMODE(status.st_mode) != mode)
        ):
            refuse(f"{path} is not a {'directory' if directory else 'plain file'} of root's alone", code)

    def read(self, path):
        """Read trusted UTF-8 without exposing bad content in the error."""
        self.check(path, required=True)
        try:
            return path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            refuse(f"cannot read {path}", 69)

    def setting(self, name, key):
        """Read one unambiguous setting from root's own configuration."""
        values = [
            line.partition("=")[2] for line in self.read(self.path(name)).splitlines() if line.startswith(key + "=")
        ]
        if len(values) != 1:
            refuse(f"{name} names no single valid {key}", 69)
        return values[0]


    def records(self):
        """Read canonical card records; unsupported or unsafe records stop every change."""
        directory = self.path("/etc/porelo-host/people")
        self.check(directory, directory=True, mode=0o700)
        records = {}
        if not directory.exists():
            return records
        for path in sorted(directory.iterdir()):
            if path.name == "purged":
                self.purged()
                continue
            if not path.name.endswith(".conf") or not re.fullmatch(USER, path.stem):
                refuse("the people directory holds an unknown record", 65)
            self.check(path, required=True, mode=0o600)
            lines = self.read(path).splitlines()
            pending = bool(lines and lines[-1] == "lock=pending")
            if pending:
                lines.pop()
            locked_on = None
            if lines and lines[-1].startswith("locked_on="):
                locked_on = lines.pop()[10:]
                try:
                    if datetime.date.fromisoformat(locked_on).isoformat() != locked_on:
                        raise ValueError()
                except ValueError:
                    refuse("the person record holds an invalid lock day", 65)
            members, previous, index = [], None, 0
            while index < len(lines) and lines[index].startswith("member="):
                member = lines[index][7:]
                order = member_key(member, 65)
                if previous is not None and order <= previous:
                    refuse(f"the record for {path.stem} has unordered memberships", 65)
                members.append(member)
                previous, index = order, index + 1
            if (len(lines) not in (index + 3, index + 4) or lines[index] not in ("locked=false", "locked=true")
                    or not lines[index + 1].startswith("ssh=") or not lines[index + 2].startswith("expires=")):
                refuse(f"the record for {path.stem} is malformed or unsupported", 65)
            if len(lines) == index + 4 and lines[index + 3] not in ("reason=membership", "reason=key"):
                refuse("the person record holds an invalid lock reason", 65)
            key, expires = lines[index + 1][4:], lines[index + 2][8:] or None
            if not valid_ssh_key(key):
                refuse(f"the record for {path.stem} has no valid card key", 65)
            self.card_expiry(expires)
            records[path.stem] = {"members": members, "locked": lines[index] == "locked=true",
                                  "ssh": key, "expires": expires,
                                  "reason": lines[index + 3][7:] if len(lines) == index + 4 else "",
                                  **({"locked_on": locked_on} if locked_on else {}),
                                  **({"lock": "pending"} if pending else {})}
        return records

    def purged(self):
        """Read the permanent refusal list without allowing an unsafe replacement."""
        path = self.path("/etc/porelo-host/people/purged")
        self.check(path, mode=0o600)
        if not path.exists():
            return set()
        names = self.read(path).splitlines()
        if any(not re.fullmatch(USER, name) for name in names) or len(set(names)) != len(names):
            refuse("the purged login list is malformed", 65)
        return set(names)

    def card_expiry(self, value):
        """Normalize a verified card expiry to OpenSSH's UTC syntax before changing access."""
        if value is None:
            return None
        if not isinstance(value, str):
            refuse("invalid card expiry", 65)
        try:
            if re.fullmatch(r"[0-9]{14}Z", value):
                moment = datetime.datetime.strptime(value, "%Y%m%d%H%M%SZ").replace(tzinfo=datetime.timezone.utc)
            else:
                moment = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
                if moment.tzinfo is None:
                    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", value):
                        raise ValueError()
                    moment = moment.replace(tzinfo=datetime.timezone.utc)
            return moment.astimezone(datetime.timezone.utc).strftime("%Y%m%d%H%M%SZ")
        except ValueError:
            refuse("invalid card expiry", 65)

    def key_revoked(self, key):
        """Ask OpenSSH about this current key alone; a broken or missing KRL fails closed."""
        krl = self.path("/etc/ssh/porelo-revoked.krl")
        self.check(krl, required=True)
        self.require(["ssh-keygen"])
        with tempfile.TemporaryDirectory(prefix="porelo-key-") as directory:
            path = Path(directory) / "key.pub"
            path.write_text(key + "\n", encoding="utf-8")
            path.chmod(0o600)
            result = self.command(["ssh-keygen", "-Q", "-f", str(krl), str(path)], accepted=(0, 1))
            if result.returncode == 0:
                return False
            if "REVOKED" not in result.stdout:
                refuse("OpenSSH could not query the host KRL", 69)
            return True


    def available(self, program):
        """Find a command only on the fixed path, refusing executable paths writable by another account."""
        if self.commands is not None:
            return program in self.commands
        found = shutil.which(program, path=ENV["PATH"])
        if found is None:
            return False
        self.check(Path(os.path.realpath(found)), required=True)
        return True

    def require(self, programs):
        """Resolve every required dependency before any write or command."""
        for program in programs:
            if not self.available(program):
                refuse(f"{program} is missing from the fixed PATH", 69)

    def command(self, arguments, required=True, input=None, accepted=(0,)):
        """Report only the program and exit status; never relay stdout, stderr or key arguments."""
        try:
            result = self.runner(arguments) if input is None else self.runner(arguments, input=input)
            if result.returncode in accepted:
                return result
            message = f"{arguments[0]} failed (exit {result.returncode})"
        except (OSError, subprocess.TimeoutExpired, UnicodeError) as error:
            message = f"{arguments[0]} failed to complete ({type(error).__name__})"
        if required:
            refuse(message, 69)
        print(f"porelo-host-person: task stop for the person failed: {message}; lock continues", file=sys.stderr)
        return False

    def account(self, user):
        """Resolve a non-root service or person account without trusting caller-supplied IDs or homes."""
        try:
            entry = pwd.getpwnam(user)
        except KeyError:
            refuse("a required service or person account is missing", 69)
        home = entry.pw_dir
        if entry.pw_uid == 0 or not home.startswith("/") or str(Path(home)) != home or ".." in Path(home).parts:
            refuse("a required account is root or has no usable absolute home", 69)
        return entry

    def porelo(self, user, *arguments):
        """Porelo as the person, with their own user manager's runtime, which rootless podman needs."""
        return [*self.switched(user, self.uid(user), self.account(user).pw_dir), "porelo", *arguments]

    @staticmethod
    def switched(user, uid, home):
        """Start as the account in `/` with its own HOME: root's directory, which podman cannot enter, is no account's."""
        runtime = f"/run/user/{uid}"
        return [
            "runuser", "-u", user, "--", "env", "-C", "/", f"HOME={home}", f"XDG_RUNTIME_DIR={runtime}",
            f"DBUS_SESSION_BUS_ADDRESS=unix:path={runtime}/bus",
        ]

    def uid_min(self):
        """The first UID of a person's account, as useradd takes it from /etc/login.defs."""
        path = self.path("/etc/login.defs")
        if not path.exists():
            return 1000
        for line in self.read(path).splitlines():
            fields = line.split()
            if len(fields) == 2 and fields[0] == "UID_MIN" and re.fullmatch(r"[0-9]{1,10}", fields[1]):
                return int(fields[1])
        return 1000

    def uid(self, user):
        """The person's uid, from the accounts this call read."""
        return self.accounts[user] if self.accounts is not None else pwd.getpwnam(user).pw_uid

    def as_account(self, user, arguments, **kwargs):
        """Pass credentials on stdin only, with a fixed runtime, the account's own home and its user manager's bus."""
        self.require(["runuser", "env"])
        entry = self.account(user)
        runtime = f"/run/user/{entry.pw_uid}"
        if arguments[:1] == ["podman"]:
            self.session_bus(user, runtime)
        return self.command([*self.switched(user, entry.pw_uid, entry.pw_dir), *arguments], **kwargs)

    def session_bus(self, user, runtime):
        """Podman keeps to the systemd cgroup manager only through the account's bus; crun fails without it."""
        try:
            if stat.S_ISSOCK(self.path(runtime + "/bus").lstat().st_mode):
                return
        except OSError:
            pass
        refuse(f"the user manager of {user} has no session bus at {runtime}/bus", 69)

    def forge_configuration(self, user):
        """An absent/empty account switches the forge off; agents= names a 6j host's agent identities, for lock."""
        path = self.path("/etc/porelo-host/forge.conf")
        self.check(path)
        if not path.exists():
            return None
        accounts = [line[8:] for line in self.read(path).splitlines() if line.startswith("account=")]
        if not accounts or accounts == [""]:
            return None
        if len(accounts) != 1 or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", accounts[0]):
            refuse("forge.conf names no single valid account", 69)
        agents = [line[7:] for line in self.read(path).splitlines() if line.startswith("agents=")]
        if len(agents) > 1:
            refuse("forge.conf names no valid agent list", 69)
        agents = agents[0].split(",") if agents and agents[0] else []
        if any(not re.fullmatch(USER, agent) for agent in agents):
            refuse("forge.conf names no valid agent list", 69)
        identities = [user, "porelo-" + user] + [agent + "-" + user for agent in agents]
        if len(set(identities)) != len(identities):
            refuse("forge.conf repeats an identity", 69)
        self.account(accounts[0])
        self.require(["runuser", "podman"])
        return accounts[0], identities

    def forge_command(self, account, arguments):
        """Run Forgejo's admin command as its rootless container account."""
        return self.as_account(account, ["podman", "exec", "forgejo", "forgejo", "admin", "user", *arguments])

    def forge_token(self, account, user, scopes, name=None):
        """Capture a generated token in memory without ever relaying the command's output."""
        result = self.forge_command(
            account,
            [
                "generate-access-token", "--username", user, "--token-name",
                name or "porelo-host-person-" + uuid.uuid4().hex, "--scopes", scopes, "--raw",
            ],
        )
        token = result.stdout.strip()
        if not re.fullmatch(r"[0-9a-f]{40}", token):
            refuse("Forgejo made no valid access token", 69)
        return token

    def forge_tokens_directory(self, user, private=True):
        """Refuse a linked delivery directory or one owned by another account."""
        directory = self.path(f"/run/porelo-host/people/{user}")
        self.check(directory.parent, 73, directory=True)
        try:
            status = directory.lstat()
        except FileNotFoundError:
            return directory
        try:
            uid = pwd.getpwnam(user).pw_uid
        except KeyError:
            if private:
                refuse("a required service or person account is missing", 69)
            uid = None
        if (
            not stat.S_ISDIR(status.st_mode)
            or (uid is not None and status.st_uid != self.account(user).pw_uid)
            or (private and stat.S_IMODE(status.st_mode) != 0o700)
        ):
            refuse("the forge token delivery directory is not a private directory of the person's", 73)
        return directory

    def remove_forge_tokens(self, user):
        """Remove only this person's delivery directory, never following links in its writable contents."""
        directory = self.forge_tokens_directory(user, private=False)
        if directory.exists():
            if not shutil.rmtree.avoids_symlink_attacks:
                refuse("safe removal of the forge token delivery directory is unavailable", 69)
            try:
                shutil.rmtree(directory)
            except OSError:
                refuse("cannot remove the person's forge token delivery directory; it remains for retry", 73)

    def forge_domain(self):
        """Validate the email domain before it reaches Forgejo's account creation command."""
        domain = self.setting("/etc/porelo-host/forge.conf", "name")
        if not re.fullmatch(r"[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?", domain):
            refuse("forge.conf names no valid name", 69)
        return domain

    def forge_endpoint(self):
        """Resolve the private API socket before revocation starts."""
        account = self.setting("/etc/porelo-host/forge.conf", "account")
        if not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", account):
            refuse("forge.conf names no valid account", 69)
        try:
            uid = pwd.getpwnam(account).pw_uid
        except KeyError:
            refuse("the forge account is missing", 69)
        return "http://localhost/api/v1/admin/users/", self.path(f"/run/user/{uid}/porelo-forge/http.sock")

    def prepare_services(self, user, verb):
        """Validate real hooks' settings, root paths and programs before changing host access."""
        forge = "forge_admit" if verb == "add" else "forge_lock"
        if self.hooks[forge] == getattr(self, forge):
            config = self.forge_configuration(user)
            if config is not None:
                if verb == "add":
                    self.forge_domain()
                else:
                    self.forge_endpoint()
        if verb != "add" and self.hooks["matrix_expel_revoke"] == self.matrix_expel_revoke:
            self.account("porelo-matrix")
            self.require(["runuser", "env", "cat", TRANSPORT])

    def forge_admit(self, user, card=None):
        """Make only missing identities, and no token: Forgejo keeps a token's hash alone, so forge-token makes it."""
        config = self.forge_configuration(user)
        if config is None:
            return
        # Porelo lends agents no forge identity of their own: the person's login and gate alone, whatever agents= names.
        account, identities = config[0], config[1][:2]
        domain = self.forge_domain()
        users = self.forge_users(account)
        for identity in identities:
            if identity in users:
                continue
            self.forge_command(
                account,
                ["create", "--username", identity, "--email", identity + "@" + domain,
                 "--random-password", "--must-change-password=false"],
            )

    def forge_users(self, account):
        """Read existing forge identities so legacy names never invent accounts during reconciliation."""
        lines = self.forge_command(account, ["list"]).stdout.splitlines()
        if not lines or not re.match(r"ID\s+Username\s+Email\b", lines[0]):
            refuse("Forgejo answered no valid user list", 69)
        users = set()
        for line in lines[1:]:
            fields = line.split()
            if len(fields) < 3 or not fields[0].isdigit():
                refuse("Forgejo answered no valid user list", 69)
            users.add(fields[1])
        return users

    @contextlib.contextmanager
    def forge_session(self, user, scopes=None):
        """One admin token for this call alone, deleted when it ends, so none outlives what it was made for: its
        own deletion goes through the admin API, so write:admin is in every one."""
        account = self.forge_configuration(user)[0]
        base, ca = self.forge_endpoint()
        opener = self.forge_opener(ca)
        name = "porelo-host-person-" + uuid.uuid4().hex
        token = self.forge_token(account, ADMIN, "write:admin" + (f",{scopes}" if scopes else ""), name)
        try:
            yield account, opener, base, token
        except BaseException:
            with contextlib.suppress(Refusal):
                self.forge_drop_named(opener, base, token, ADMIN, {name})
            raise
        self.forge_drop_named(opener, base, token, ADMIN, {name})

    def forge_tokens_of(self, opener, base, token, identity):
        """One login's complete token set, ID to name, read before any deletion shrinks a page."""
        tokens, page = {}, 1
        while True:
            rows = self.forge_api(opener, base, token, "GET", identity + f"/tokens?limit=50&page={page}", 200)
            if not isinstance(rows, list) or any(
                not isinstance(row, dict) or type(row.get("id")) is not int or row["id"] < 1 for row in rows
            ):
                refuse("Forgejo answered no valid access-token list", 69)
            if not rows:
                return tokens
            batch = {row["id"]: row.get("name") for row in rows}
            if batch.keys() & tokens.keys():
                refuse("Forgejo repeated a page of access tokens", 69)
            tokens.update(batch)
            page += 1

    def forge_drop_named(self, opener, base, token, identity, names=None):
        """Delete every token of one login, or those named in names; answer the names deleted."""
        dropped = []
        for identifier, name in sorted(self.forge_tokens_of(opener, base, token, identity).items()):
            if names is None or name in names:
                self.forge_api(opener, base, token, "DELETE", identity + f"/tokens/{identifier}", 204)
                dropped.append(name)
        return dropped

    def forge_drop_tokens(self, user, purge=False):
        """Delete every token of the person's forge users, and the users themselves at purge."""
        config = self.forge_configuration(user)
        if config is None:
            return
        errors = []
        with self.forge_session(user) as (account, opener, base, token):
            users = self.forge_users(account)
            for identity in config[1]:
                if identity not in users:
                    continue
                try:
                    self.forge_drop_named(opener, base, token, identity)
                    if purge:
                        self.forge_api(opener, base, token, "DELETE", identity, 204)
                except Refusal as error:
                    errors.append(error)
        if errors:
            refuse("; ".join(str(error) for error in errors), errors[0].code)

    def forge_api(self, opener, base, token, method, route, expected, body=None, not_found=None):
        """Refuse HTTP and socket failures without printing a header, credential or response body."""
        request = urllib.request.Request(
            base + route,
            method=method,
            data=None if body is None else json.dumps(body).encode(),
            headers={"Authorization": "token " + token, "Content-Type": "application/json"},
        )
        try:
            with opener.open(request, timeout=30) as answer:
                if answer.status != expected:
                    refuse(f"Forgejo admin API answered HTTP {answer.status} to {method} {route}", 69)
                return None if expected == 204 else json.load(answer)
        except urllib.error.HTTPError as error:
            if error.code == 404 and not_found is not None:
                refuse(not_found, 65)
            refuse(f"Forgejo admin API answered HTTP {error.code} to {method} {route}", 69)
        except (OSError, urllib.error.URLError, http.client.HTTPException, ValueError, UnicodeError):
            refuse("Forgejo admin API did not answer valid JSON on its private socket", 69)

    def forge_opener(self, endpoint):
        """Build a redirect-free opener for the forge's private socket."""
        return urllib.request.build_opener(
            urllib.request.ProxyHandler({}),
            NoRedirect(),
            UnixHandler(endpoint),
        )


    def forge_lock(self, user):
        """Prohibit all the person's logins and delete every token, the host's or not."""
        config = self.forge_configuration(user)
        errors = []
        try:
            self.remove_forge_tokens(user)
        except Refusal as error:
            errors.append(error)
        if config is None:
            if errors:
                raise errors[0]
            return
        with self.forge_session(user) as (account, opener, base, token):
            users = self.forge_users(account)
            for identity in config[1]:
                if identity not in users:
                    continue
                try:
                    self.forge_revoke_identity(opener, base, token, identity)
                except Refusal as error:
                    errors.append(error)
        if errors:
            refuse("; ".join(str(error) for error in errors), errors[0].code)

    def forge_revoke_identity(self, opener, base, token, identity):
        """Disable one login and enumerate its complete token set before any deletion shrinks a page."""
        self.forge_api(
            opener, base, token, "PATCH", identity, 200,
            {"login_name": identity, "source_id": 0, "prohibit_login": True},
        )
        self.forge_drop_named(opener, base, token, identity)

    def matrix_expel_revoke(self, user):
        """Deactivate the person's and tasks' accounts through the transport, its admin token on stdin alone."""
        try:
            pwd.getpwnam("porelo-matrix")
        except KeyError:
            # A host with no homeserver has nobody to expel from it.
            return
        self.require(["runuser", "env", "cat", TRANSPORT])
        secrets = json.dumps({"secrets": {"PORELO_MATRIX_ADMIN_TOKEN": self.matrix_admin_token()}})
        self.as_account("porelo-matrix", [TRANSPORT, "expel", user], input=secrets)

    def matrix_admin_token(self):
        """The homeserver administrator's token the gate's prepare keeps, read by its own account, never by root."""
        path = self.account("porelo-matrix").pw_dir + "/.config/porelo/matrix/gate/admin-token"
        try:
            token = self.as_account("porelo-matrix", ["cat", "--", path], input="").stdout
        except Refusal:
            refuse(f"the homeserver administrator's token could not be read from {path}", 69)
        if token.endswith("\n"):
            token = token[:-1]
        if not re.fullmatch(r"[\x21-\x7e]{1,4096}", token):
            refuse(f"{path} holds no homeserver administrator's token", 69)
        return token

    def targets(self, user):
        """Check all publication/removal paths without creating directories."""
        paths = [
            self.path(f"/etc/ssh/authorized_keys/{user}"),
            self.path(f"/etc/porelo-host/people/{user}.conf"),
        ]
        for path in paths:
            self.check(path, 73)
        self.check(self.path(f"/etc/tmpfiles.d/porelo-person-{user}.conf"), 73)
        self.forge_tokens_directory(user, private=False)
        return paths

    def write_authorized_key(self, user, key, expires=None):
        """Publish the verified organization's single card key; root's pinned key has no expiry."""
        if not isinstance(user, str) or not re.fullmatch(USER, user) or not valid_ssh_key(key):
            refuse("invalid SSH account or public key", 65)
        options = ""
        if expires is not None:
            if not isinstance(expires, str) or not re.fullmatch(r"[0-9]{14}Z", expires):
                refuse("invalid SSH expiry", 65)
            try:
                datetime.datetime.strptime(expires, "%Y%m%d%H%M%SZ")
            except ValueError:
                refuse("invalid SSH expiry", 65)
            options = f'expiry-time="{expires}" '
        path = self.path(f"/etc/ssh/authorized_keys/{user}")
        self.check(path, 73)
        self.write(path, options + key + "\n", 0o644)

    def write_krl(self, keys):
        """Atomically add host-wide revocations without losing any key already in the KRL."""
        if not isinstance(keys, list) or any(not valid_ssh_key(key) for key in keys):
            refuse("invalid SSH revocation keys", 65)
        target = self.path("/etc/ssh/porelo-revoked.krl")
        self.check(target, 73)
        self.require(["ssh-keygen"])
        self.directories(target.parent)
        with tempfile.TemporaryDirectory(prefix=".porelo-krl-", dir=target.parent) as directory:
            source, output = Path(directory) / "keys", Path(directory) / "revoked.krl"
            self.write(source, "".join(key + "\n" for key in keys), 0o600)
            update = []
            if target.exists():
                shutil.copyfile(target, output)
                update = ["-u"]
            self.command(["ssh-keygen", "-q", "-k", *update, "-f", str(output), str(source)])
            with output.open("rb") as stream:
                if stream.read(8) != b"SSHKRL\n\x00":
                    refuse("ssh-keygen produced no valid KRL", 69)
                os.fchown(stream.fileno(), self.owner, self.group)
                os.fchmod(stream.fileno(), 0o644)
                os.fsync(stream.fileno())
            os.replace(output, target)

    def apply_ssh_revocations(self, keys, users):
        """Apply verified host-wide KRL entries and end the affected accounts' existing tunnels."""
        if not isinstance(users, list) or any(
            not isinstance(user, str) or not re.fullmatch(USER, user) or user == "root" for user in users
        ):
            refuse("invalid SSH revocation accounts", 65)
        for user in users:
            if self.accounts is not None and user not in self.accounts:
                refuse("a revoked SSH account is missing", 65)
            self.uid(user)
        self.require(["loginctl", "systemctl"])
        self.write_krl(keys)
        errors = []
        for user in dict.fromkeys(users):
            try:
                self.end_sessions(user)
            except Refusal as error:
                errors.append(error)
        if errors:
            refuse("; ".join(str(error) for error in errors), errors[0].code)

    def admit_runtime(self, user):
        """Create a private return-socket directory, the link to the person's daemon and their persistent boot rule."""
        if not isinstance(user, str) or not re.fullmatch(USER, user):
            refuse("invalid SSH account", 65)
        entry = self.account(user)
        directory = self.forge_tokens_directory(user)
        rule = self.path(f"/etc/tmpfiles.d/porelo-person-{user}.conf")
        self.check(rule, 73)
        self.directories(directory.parent)
        changed = False
        if not directory.exists():
            directory.mkdir(mode=0o700)
            os.chown(directory, entry.pw_uid, entry.pw_gid)
            changed = True
        # A fixed name the person's tunnel forwards to, whatever uid the account has: porelod's own socket.
        daemon = f"/run/user/{entry.pw_uid}/porelo/porelod.sock"
        link = directory / "porelod.sock"
        if not os.path.lexists(link):
            try:
                os.symlink(daemon, link)
                changed = True
            except FileExistsError:
                pass  # The person put an entry of their own there meanwhile; it stays.
        content = (
            f"d /run/porelo-host/people/{user} 0700 {user} {user} -\n"
            f"L /run/porelo-host/people/{user}/porelod.sock - - - - {daemon}\n"
        )
        if not rule.exists() or self.read(rule) != content or stat.S_IMODE(rule.stat().st_mode) != 0o644:
            self.write(rule, content, 0o644)
            changed = True
        return changed

    def remove_runtime(self, user):
        """Remove the return socket and the daemon link without following links in the person's writable directory."""
        if not isinstance(user, str) or not re.fullmatch(USER, user):
            refuse("invalid SSH account", 65)
        rule = self.path(f"/etc/tmpfiles.d/porelo-person-{user}.conf")
        self.check(rule, 73)
        rule.unlink(missing_ok=True)
        self.remove_forge_tokens(user)

    def end_sessions(self, user):
        """End every SSH tunnel and wait for the user's manager to stop."""
        if not isinstance(user, str) or not re.fullmatch(USER, user) or user == "root":
            refuse("invalid SSH session account", 65)
        self.require(["loginctl", "systemctl"])
        errors = []
        for args, accepted in (
            (["loginctl", "terminate-user", user], (0, 1)),
            (["systemctl", "stop", f"user@{self.uid(user)}.service"], (0,)),
        ):
            try:
                self.command(args, accepted=accepted)
            except Refusal as error:
                errors.append(error)
        if errors:
            refuse("; ".join(str(error) for error in errors), errors[0].code)

    def directories(self, directory):
        """Create missing root directories privately; preserve safe existing directories."""
        if directory.exists():
            return
        self.directories(directory.parent)
        public = ("/etc/ssh/authorized_keys", "/run/porelo-host", "/run/porelo-host/people")
        mode = 0o755 if directory in map(self.path, public) else 0o700
        directory.mkdir(mode=mode)
        os.chown(directory, self.owner, self.group)
        directory.chmod(mode)

    def write(self, path, text, mode, owner=None, group=None):
        """Write beside the target, fsync and rename so no reader can see partial access or a record."""
        temporary = None
        try:
            self.directories(path.parent)
            fd, temporary = tempfile.mkstemp(prefix=".porelo-host-person.", dir=path.parent)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                os.fchown(
                    stream.fileno(), self.owner if owner is None else owner, self.group if group is None else group
                )
                os.fchmod(stream.fileno(), mode)
                stream.write(text)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, path)
        except OSError:
            refuse(f"cannot write {path}", 73)
        finally:
            if temporary is not None:
                Path(temporary).unlink(missing_ok=True)

    def record(self, user, record):
        """Publish canonical admission and revocation state."""
        members = sorted(set(record["members"]), key=lambda item: member_key(item, 65))
        text = "".join(f"member={item}\n" for item in members)
        text += "locked=" + str(record["locked"]).lower() + "\n"
        text += f'ssh={record["ssh"]}\nexpires={record.get("expires") or ""}\n'
        if record.get("reason"):
            text += f'reason={record["reason"]}\n'
        if record.get("locked_on"):
            text += f'locked_on={record["locked_on"]}\n'
        if record.get("lock") == "pending":
            text += "lock=pending\n"
        self.write(self.path(f"/etc/porelo-host/people/{user}.conf"), text, 0o600)

    def subids(self, kind):
        """Read all subordinate ranges, rejecting malformed ranges rather than overlapping them."""
        path = self.path("/etc/" + kind)
        rows = []
        for line in self.read(path).splitlines():
            fields = line.split(":")
            if (
                len(fields) != 3
                or not re.fullmatch(r"[a-zA-Z0-9_-]+", fields[0])
                or not re.fullmatch(r"[0-9]{1,10}", fields[1])
                or not re.fullmatch(r"[0-9]{1,10}", fields[2])
                or int(fields[2]) < 1
                or int(fields[1]) + int(fields[2]) > 4294967295
            ):
                refuse(f"{kind} holds a malformed subordinate ID range", 69)
            rows.append((fields[0], int(fields[1]), int(fields[2])))
        return rows

    def next_range(self, rows):
        """A free 65536-ID interval after the highest occupied ID, at least 100000."""
        start = max([100000] + [start + count for _, start, count in rows])
        if start + 65536 > 4294967295:
            refuse("there is no free subordinate ID range", 69)
        return f"{start}-{start + 65535}"

    def create_account(self, user):
        """Create the home and private primary group before enabling user services."""
        # useradd must not allocate its own defaults before the explicit, prevalidated ranges.
        self.command(
            ["useradd", "--create-home", "--user-group", "--shell", "/bin/bash", "--comment", GECOS,
             "--key", "SUB_UID_COUNT=0", "--key", "SUB_GID_COUNT=0", user]
        )

    def private_umask(self, user):
        """Give an account admitted before its GECOS named a umask the same one, without touching a fitting entry."""
        if getattr(self.account(user), "pw_gecos", None) != GECOS:
            self.command(["usermod", "--comment", GECOS, user])

    def start_daemon(self, user):
        """Start the person's porelod for good, so their tunnel reaches it before they ever run setup themselves.

        Not a refusal: the person's access stands, and 'porelo setup' in their own account starts it later.
        """
        try:
            self.require(["porelo", "systemctl", "runuser", "env"])
            uid = self.uid(user)
            # Linger starts the manager in the background; start it here and wait for it, then for its bus.
            self.command(["systemctl", "start", f"user@{uid}.service"])
            self.session_bus(user, f"/run/user/{uid}")
            # Nothing on stdin: setup makes no vault without a person at a terminal, and says so.
            self.command(self.porelo(user, "setup"), input="")
            self.command([*self.switched(user, uid, self.account(user).pw_dir), "systemctl", "--user", "is-active",
                          "--quiet", "porelod"])
        except Refusal as error:
            print(
                f"porelo-host-person: porelod of {user} is not running ({error}); 'porelo setup' as {user} starts it",
                file=sys.stderr,
            )
            return False
        return True

    def enable_linger(self, user):
        """Allow the person's own user services to survive sign-out."""
        self.command(["loginctl", "enable-linger", user])

    def subordinate_ids(self, user, uid_range=None, gid_range=None):
        """Give the person's rootless containers their own nonoverlapping ID ranges."""
        for kind, option, interval in (("subuid", "--add-subuids", uid_range),
                                       ("subgid", "--add-subgids", gid_range)):
            rows = self.subids(kind)
            if not any(name == user for name, _, _ in rows):
                self.command(["usermod", option, interval or self.next_range(rows), user])

    def join_groups(self, user, groups):
        """Limit password sudo to people, adding virtualization groups only where installed."""
        if "porelo-people" not in groups:
            self.require(["groupadd"])
            self.command(["groupadd", "--system", "porelo-people"])
            groups.add("porelo-people")
        names = [name for name in ("kvm", "libvirt") if name in groups] + ["porelo-people"]
        self.require(["usermod"])
        self.command(["usermod", "--append", "--groups", ",".join(names), user])

    def add(self, user, card, groups, uid_range, gid_range, members):
        """Apply validated admission in account, SSH, hook and record order.

        Once the account exists, a failure takes back what was given and records the person locked, so that purge
        can remove the account; unrecorded, every verb would refuse it as an account outside the people records.
        """
        self.create_account(user)
        try:
            self.grant(user, card, groups, uid_range, gid_range, members)
        except (Refusal, OSError) as error:
            record = {"members": [], "locked": False, **card}
            try:
                self.lock(user, record, False)
            except (Refusal, OSError):
                self.record(user, record)
            words = str(error) if isinstance(error, Refusal) else "cannot read or change the host's files"
            code = error.code if isinstance(error, Refusal) else 73
            state = "the account is locked" if record["locked"] else "local account removal failed; retry lock"
            refuse(f"{words}; {state}, and purge {user} removes it", code)

    def grant(self, user, card, groups, uid_range, gid_range, members):
        """Everything of an admission after the account, ending with the record that admits."""
        self.enable_linger(user)
        self.subordinate_ids(user, uid_range, gid_range)
        self.join_groups(user, groups)
        self.admit_runtime(user)
        self.write_authorized_key(user, card["ssh"], self.card_expiry(card.get("expires")))
        self.hooks["forge_admit"](user, card)
        self.record(user, {"members": list(members), "locked": False, **card})

    def lock(self, user, record, porelo):
        """Remove access independently; lock=pending means all revocation steps remain owed on retry."""
        try:
            uid = self.uid(user)
        except KeyError:
            uid = None
        errors = []

        def attempt(action):
            try:
                action()
            except Refusal as error:
                errors.append(error)
            except OSError:
                errors.append(Refusal("cannot read or change the host's files during revocation", 73))

        def local_command(args, accepted=(0,)):
            self.require([args[0]])
            self.command(args, accepted=accepted)

        def remove_key():
            authorized = self.path(f"/etc/ssh/authorized_keys/{user}")
            self.check(authorized, 73)
            authorized.unlink(missing_ok=True)

        # Persist intent before removing access; every retry repeats all revocation steps.
        record["lock"] = "pending"
        attempt(lambda: self.record(user, record))
        attempt(remove_key)
        attempt(lambda: local_command(["gpasswd", "--delete", user, "porelo-people"], (0, 3)))
        attempt(lambda: self.remove_runtime(user))
        if uid is not None:
            # logind may already have ended the session when linger is disabled.
            attempt(lambda: local_command(["loginctl", "terminate-user", user], (0, 1)))
            attempt(lambda: local_command(["systemctl", "stop", f"user@{uid}.service"]))
            attempt(lambda: local_command(["usermod", "--lock", "--expiredate", "1", user]))
        local_removed = not errors
        record["locked"] = local_removed
        attempt(lambda: self.record(user, record))

        attempt(lambda: self.hooks["forge_lock"](user))
        if porelo is not False and uid is not None and local_removed:
            def stop_tasks():
                if porelo is None and not self.available("porelo"):
                    return
                self.require(["runuser", "env", "porelo", "usermod", "systemctl"])
                # PAM requires an unexpired account; the password, keys and group access remain revoked.
                try:
                    self.command(["usermod", "--expiredate", "", user])
                    self.command(["systemctl", "start", f"user@{uid}.service"])
                    self.command(self.porelo(user, "task", "stop", "--all"))
                finally:
                    failures = len(errors)
                    attempt(lambda: local_command(["usermod", "--expiredate", "1", user]))
                    attempt(lambda: local_command(["systemctl", "stop", f"user@{uid}.service"]))
                    if len(errors) != failures:
                        record["locked"] = False
                        attempt(lambda: self.record(user, record))
            attempt(stop_tasks)
        if errors:
            refuse("; ".join(str(error) for error in errors), errors[0].code)
        record.pop("lock", None)
        try:
            self.record(user, record)
        except (Refusal, OSError):
            record["lock"] = "pending"
            raise

    def retry_locks(self, records):
        """Finish pending revocations before admitting or reconciling anyone; collect per-person failures."""
        errors = []
        for user, record in records.items():
            if record.get("lock") == "pending":
                try:
                    self.lock(user, record, None)
                except (Refusal, OSError) as error:
                    errors.append(Refusal(f"{user}: {error}", getattr(error, "code", 73)))
        return errors

    def clear_vault(self, user):
        """Porelo's lock-out order as the person: no task left that could hold a token, then the vault, no terminal.

        The lock expired the account, which PAM refuses to runuser and to the user manager the vault's runtime needs;
        only the expiry is lifted for this, the password stays locked and no key or peer lets anyone in. Any failure
        expires the account again, as the lock left it.
        """
        self.require(["usermod", "systemctl", "runuser", "env", "porelo"])
        record = self.records()[user]
        pending = record.get("lock") == "pending"
        record.update(lock="pending", locked=False)
        self.record(user, record)
        try:
            self.command(["usermod", "--expiredate", "", user])
            self.command(["systemctl", "start", f"user@{self.uid(user)}.service"])
            self.command(self.porelo(user, "task", "stop", "--all"))
            # Forced, Porelo still exits 1 for a transport's account kept elsewhere; as at down, only that may stay.
            cleared = self.command(self.porelo(user, "vault", "clear", "--yes", "--force", "--json"), accepted=(0, 1))
            if cleared.returncode != 0 and not only_transports_kept(cleared.stdout):
                refuse("porelo vault clear kept more than the accounts a transport keeps elsewhere", 69)
        finally:
            self.finish_cleanup(user)
        if not pending:
            record = self.records()[user]
            record.pop("lock", None)
            self.record(user, record)

    def finish_cleanup(self, user):
        """Try both safety restorations even when the first fails."""
        self.require(["usermod", "systemctl"])
        try:
            uid = self.uid(user)
        except KeyError:
            uid = None
        if uid is not None:
            try:
                self.command(["usermod", "--expiredate", "1", user])
            finally:
                self.command(["systemctl", "stop", f"user@{uid}.service"])
        record = self.records()[user]
        record["locked"] = True
        self.record(user, record)

    def purge(self, user, record, porelo, account_exists):
        """Lock before clearing the vault, deleting the account and releasing recorded IDs."""
        self.lock(user, record, porelo)
        record["lock"] = "pending"
        self.record(user, record)
        # At the purge alone: expel keeps the login taken for good, and a person locked may come back.
        self.hooks["matrix_expel_revoke"](user)
        self.hooks["forge_drop_tokens"](user, True)
        self.remove_runtime(user)
        if account_exists:
            deleted = False
            try:
                if porelo:
                    self.clear_vault(user)
                self.command(["loginctl", "disable-linger", user])
                # Without linger or a session logind may already have let the person go, and knows nobody to end.
                self.command(["loginctl", "terminate-user", user], accepted=(0, 1))
                # terminate-user returns before the manager ends; userdel refuses an account still running anything.
                self.command(["systemctl", "stop", f"user@{self.uid(user)}.service"])
                self.command(["userdel", "--remove", user])
                deleted = True
            finally:
                if not deleted:
                    self.finish_cleanup(user)
        for kind in ("subuid", "subgid"):
            path = self.path("/etc/" + kind)
            text = self.read(path)
            remaining = "".join(line for line in text.splitlines(keepends=True) if line.partition(":")[0] != user)
            if remaining != text:
                self.write(path, remaining, stat.S_IMODE(path.stat().st_mode))
        purged = self.purged() | {user}
        self.write(self.path("/etc/porelo-host/people/purged"), "".join(name + "\n" for name in sorted(purged)), 0o600)
        self.path(f"/etc/porelo-host/people/{user}.conf").unlink()

    def project_record(self, project):
        """Read and validate root's private project record."""
        directory = self.path("/etc/porelo-host/projects")
        self.check(directory, directory=True, mode=0o700)
        path = directory / f"{project}.conf"
        if not path.exists() and not path.is_symlink():
            refuse(f"project {project} is not registered on this host", 65)
        self.check(path, required=True, mode=0o600)
        values = {}
        allowed = {"admin", "signed_by", "publisher"}
        for line in self.read(path).splitlines():
            key, separator, value = line.partition("=")
            if not separator:
                refuse(f"{path} has a malformed or duplicate setting", 65)
            if key in allowed and key not in values:
                values[key] = value
            else:
                refuse(f"{path} has a malformed or duplicate setting", 65)
        admin = values.get("admin", "")
        signed_by = values.get("signed_by", "")
        publisher = values.get("publisher", "")
        if (
            not re.fullmatch(USER, admin)
            or not valid_ssh_key(signed_by)
            or publisher != "porelo-publisher-" + project
        ):
            refuse(f"{path} holds an invalid project registration", 65)
        return path, {
            "admin": admin,
            "signed_by": signed_by,
            "publisher": publisher,
        }

    def sync_directory(self, prefix):
        """A fresh private directory under /run/porelo-host/sync, after removing what a stopped sync left there."""
        sync_root = self.path("/run/porelo-host/sync")
        self.directories(sync_root)
        self.check(sync_root, 73, required=True, directory=True, mode=0o700)
        # Every call holds forge.conf's lock, so whatever is here was left by a sync stopped before its finally ran.
        try:
            for left in sync_root.iterdir():
                if stat.S_ISDIR(left.lstat().st_mode):
                    shutil.rmtree(left)
                else:
                    left.unlink()
        except OSError:
            refuse("cannot remove what an earlier sync left in /run/porelo-host/sync", 73)
        try:
            temp_dir = Path(tempfile.mkdtemp(prefix=f"{prefix}.", dir=sync_root))
            os.chown(temp_dir, self.owner, self.group)
            temp_dir.chmod(0o700)
        except OSError:
            refuse("cannot create a private sync directory under /run/porelo-host/sync", 73)
        return temp_dir

    def isolated_porelo(self, unit, staged, arguments, what, refused_words, input=None, network=False, state=None,
                        refused=None):
        """Run Porelo without a home, exposing credentials, network and kept state only to the operation that needs them."""
        command = [
            "systemd-run",
            "--pipe",
            "--wait",
            "--quiet",
            "--collect",
            f"--unit={unit}",
            "-p",
            "DynamicUser=yes",
            "-p",
            "PrivateNetwork=no" if network else "PrivateNetwork=yes",
            "-p",
            "ProtectHome=yes",
        ]
        if state is not None:
            command.extend(["-p", f"StateDirectory={state}", "-p", "StateDirectoryMode=0700",
                            "-p", f"Environment=XDG_STATE_HOME=/var/lib/{state}"])
        for name, path in staged.items():
            command.extend(["-p", f"LoadCredential={name}:{path}"])
        try:
            command = [*command, "porelo", *arguments]
            result = self.runner(command) if input is None else self.runner(command, input=input)
        except (OSError, subprocess.TimeoutExpired, UnicodeError) as error:
            refuse(f"systemd-run failed to complete ({type(error).__name__})", 69)
        if result.returncode != 0:
            lines = [
                line.strip().removeprefix("porelo: ") for line in (result.stderr or "").splitlines() if line.strip()
            ]
            words = "; ".join(lines)[:512] if lines else f"{refused_words} (exit {result.returncode})"
            if refused is not None and result.returncode == 65:
                refused(words)
            # Only 65 is Porelo refusing; a forge that hangs or a unit that fails says nothing about the state.
            refuse(words, 65 if result.returncode == 65 else 69)
        try:
            verified = json.loads(result.stdout)
        except (ValueError, UnicodeError):
            refuse(f"{what} answered no valid JSON", 69)
        if not isinstance(verified, dict):
            refuse(f"{what} answered no JSON object", 69)
        return verified

    def org_pin(self):
        """Read root's pin of the host admin: their login and the key that signed the host card."""
        pins = self.path("/etc/porelo-host/organization/pin")
        self.check(pins, mode=0o600)
        if pins.exists():
            entries = self.follow_pin()
            return pins, {"admin": entries[0][0], "key": entries[0][1]}
        path = self.path("/etc/porelo-host/organization/pin.conf")
        self.check(path.parent, directory=True, mode=0o700)
        if not path.exists() and not path.is_symlink():
            return path, None
        self.check(path, required=True, mode=0o600)
        lines = self.read(path).splitlines()
        if (
            len(lines) != 2
            or not lines[0].startswith("admin=")
            or not lines[1].startswith("key=")
            or not re.fullmatch(USER, lines[0][6:])
            or not valid_ssh_key(lines[1][4:])
        ):
            refuse(f"{path} holds no valid pinned host admin", 65)
        return path, {"admin": lines[0][6:], "key": lines[1][4:]}

    def applied_organization(self):
        """Read the organization state last applied, as the sync, the SSH keys and the persons read it."""
        path = self.path("/etc/porelo-host/organization/applied.json")
        self.check(path.parent, directory=True)
        if not path.exists() and not path.is_symlink():
            return path, None
        self.check(path, required=True, mode=0o600)
        try:
            applied = json.loads(self.read(path))
        except ValueError:
            applied = None
        if (
            not isinstance(applied, dict)
            or not isinstance(applied.get("commit"), str)
            or not re.fullmatch(COMMIT, applied["commit"])
            or not isinstance(applied.get("projects"), list)
            or not all(isinstance(item, dict) for item in applied["projects"])
            or not isinstance(applied.get("persons"), list)
            or not all(isinstance(item, dict) for item in applied["persons"])
            or not isinstance(applied.get("revoked"), list)
            or not all(isinstance(item, str) for item in applied["revoked"])
        ):
            refuse(f"{path} holds no valid applied organization", 65)
        return path, applied

    def follow_pin(self):
        """Read every pinned host admin key, including backup keys, without admitting malformed lines."""
        path = self.path("/etc/porelo-host/organization/pin")
        self.check(path, required=True, mode=0o600)
        entries = [line.split(" ", 1) for line in self.read(path).splitlines()]
        if not entries or any(len(row) != 2 or not re.fullmatch(USER, row[0]) or row[0] == "root"
                              or not valid_ssh_key(row[1]) for row in entries):
            refuse("the organization pin holds no valid host admin keys", 65)
        return entries

    def renew_pin(self, supplied):
        """Take the host admins' keys from root on the machine, the one way past a change no held key signed."""
        if len(supplied) > TOKEN_LIMIT:
            refuse("the pin is too long", 65)
        try:
            rows = [line.split(" ", 1) for line in supplied.decode("ascii").splitlines()]
        except UnicodeError:
            refuse("the pin is not lines of a login and a key", 65)
        if (not rows or any(len(row) != 2 or not re.fullmatch(USER, row[0]) or row[0] == "root"
                            or not valid_ssh_key(row[1]) for row in rows)
                or len({row[1] for row in rows}) != len(rows)):
            refuse("the pin takes one line of a login and a key for each host admin key", 65)
        if not self.path("/etc/porelo-host/organization/pin").exists():
            refuse("this host follows no organization", 65)
        self.write(self.path("/etc/porelo-host/organization/pin"), "".join(f"{login} {key}\n" for login, key in rows),
                   0o600)
        self.path(FOLLOW_REFUSED).unlink(missing_ok=True)
        return self.org_status()

    def follow_refused(self, words):
        """Keep what the organization's answer refused for the host admin, as the fetch's unit journal reaches nobody."""
        shown = "".join(char if char.isprintable() else " " for char in words)
        self.write(self.path(FOLLOW_REFUSED), json.dumps({"words": shown}) + "\n", 0o600)

    def follow_refusal(self):
        """What the last fetch refused, which says nothing of whether the host still belongs to the organization."""
        path = self.path(FOLLOW_REFUSED)
        self.check(path)
        return json.loads(self.read(path))["words"] if path.exists() else None

    def follow_state(self, answer, host, previous):
        """Validate the whole fetched contract before any mutation, retaining the fields existing consumers read."""
        revision = answer.get("revision")
        card = answer.get("host_card")
        if (not isinstance(revision, str) or not re.fullmatch(COMMIT, revision)
                or not isinstance(card, dict)
                or any(not isinstance(answer.get(field), list) for field in ("persons", "projects", "admins"))):
            refuse("porelo org fetch answered malformed revision, host card, persons, projects or admins", 65)
        if card.get("host") != host:
            refuse("porelo org fetch answered a host card for another host", 65)
        revisions = [] if previous is None else previous.get("revisions", [previous["commit"]])
        if previous and revision != previous["commit"] and revision in revisions:
            words = "refused-state: an older organization revision was served again"
            self.follow_refused(words)
            refuse(words, 65)
        persons, logins, keys = [], set(), set()
        records = self.records()
        accounts = self.account_ids()
        # A key names one person: whoever holds it keeps it.
        holders = {record["ssh"]: login for login, record in records.items()}
        holders.update({} if previous is None else {old["ssh"]: old["login"] for old in previous["persons"]})
        for person in answer["persons"]:
            if (not isinstance(person, dict) or not isinstance(person.get("login"), str)
                    or not re.fullmatch(USER, person["login"]) or person["login"] == "root"
                    or person["login"] in logins or not valid_ssh_key(person.get("key"))
                    or person["key"] in keys or type(person.get("revoked")) is not bool
                    or "expires" not in person):
                refuse("porelo org fetch answered a malformed or duplicate person", 65)
            self.card_expiry(person["expires"])
            login, uid = person["login"], accounts.get(person["login"])
            if holders.get(person["key"], login) != login or (
                    uid is not None and (uid < self.uid_min() or login not in records)):
                refuse(f"{login}: the organization's key or login belongs to another account", 65)
            logins.add(login)
            keys.add(person["key"])
            persons.append({**person, "ssh": person["key"]})
        admins, admin_keys = [], set()
        for admin in answer["admins"]:
            if (not isinstance(admin, dict) or not isinstance(admin.get("login"), str)
                    or admin["login"] not in logins
                    or not valid_ssh_key(admin.get("key")) or admin["key"] in admin_keys
                    or admin.get("fingerprint") != fingerprint(admin["key"])
                    or type(admin.get("backup")) is not bool):
                refuse("porelo org fetch answered malformed host admin keys", 65)
            admins.append(admin)
            admin_keys.add(admin["key"])
        if not admins:
            refuse("porelo org fetch answered no host admin keys", 65)
        projects, names, project_refusals = [], set(), {}
        old_projects = {} if previous is None else {
            item["project"]: item for item in previous["projects"]
        }
        duplicates = set()
        for item in answer["projects"]:
            name = item.get("project") if isinstance(item, dict) else None
            if isinstance(name, str) and re.fullmatch(PROJECT, name):
                if name in names:
                    duplicates.add(name)
                names.add(name)
        for project in answer["projects"]:
            name = project.get("project") if isinstance(project, dict) else None
            label = name if isinstance(name, str) and re.fullmatch(PROJECT, name) else "a project"
            try:
                project = self.follow_project_state(project, logins, duplicates)
            except Refusal as error:
                project_refusals[label] = str(error)
                print(f"porelo-host-person: {label}: {error}", file=sys.stderr)
                continue
            name = project["project"]
            address = project["address"]
            why = None
            if address is not None and not (isinstance(address, str) and CENTRAL_ADDRESS.fullmatch(address)):
                address, why = None, "the organization names an unusable address for this project"
                print(f"porelo-host-person: {name}: {why}", file=sys.stderr)
            projects.append({**project, "name": name, "address": address, "why": why,
                             "since": old_projects.get(name, {}).get("since") or self.now().date().isoformat()})
        revoked = set() if previous is None else set(previous["revoked"])

        held = {} if previous is None else {old["login"]: old["ssh"] for old in previous["persons"]}
        for login in sorted((revoked - logins) & set(held)):
            # Its last good card stays recorded, so a revocation still knows the key to put on the KRL.
            persons.append(next(old for old in previous["persons"] if old["login"] == login))
        for person in persons:
            if person["revoked"]:
                revoked.add(person["login"])
            # A card replaced under another key takes the login back; the old key stays on the KRL, which locks it alone.
            elif person["login"] in revoked and person["key"] != held.get(person["login"]):
                revoked.discard(person["login"])
        for person in persons:
            person["revoked"] = person["login"] in revoked
        return {"revision": revision, "commit": revision, "host_card": card, "persons": persons,
                "admins": admins, "projects": projects, "project_refusals": project_refusals, "revoked": sorted(revoked),
                "revisions": list(dict.fromkeys([*revisions, revision]))}

    def follow_project_state(self, project, logins, duplicates):
        """Reject one project's unusable contract without delaying another project's access removal."""
        if (not isinstance(project, dict) or not isinstance(project.get("project"), str)
                or not re.fullmatch(PROJECT, project["project"]) or project["project"] == "default"
                or project["project"] in duplicates or not isinstance(project.get("members"), list)
                or not isinstance(project.get("signing_keys"), list)
                or "address" not in project):
            refuse("porelo org fetch answered a malformed or duplicate project", 65)
        members = set()
        # A first-seen person has a role here and no card anyone vouches for yet: no key, so no access.
        project = {**project, "members": [
            member for member in project["members"]
            if not (isinstance(member, dict) and isinstance(member.get("login"), str)
                    and member["login"] not in logins)]}
        for member in project["members"]:
            if (not isinstance(member, dict) or not isinstance(member.get("login"), str)
                    or member["login"] not in logins or member["login"] in members
                    or member.get("role") not in ("admin", "developer")
                    or type(member.get("locked")) is not bool):
                refuse("porelo org fetch answered malformed project members", 65)
            members.add(member["login"])
        for key in project["signing_keys"]:
            if (not isinstance(key, dict) or not isinstance(key.get("login"), str)
                    or not re.fullmatch(USER, key["login"]) or key.get("role") not in ("admin", "developer")
                    or not valid_ssh_key(key.get("key"))
                    or any(field not in key for field in ("valid_from", "valid_until", "revoked_since"))):
                refuse("porelo org fetch answered malformed project signing keys", 65)
            for field in ("valid_from", "valid_until", "revoked_since"):
                self.card_expiry(key[field])
        return project

    def follow_signers(self, answer, applied):
        """Have Porelo derive project signers before applying anything, with only the fetched state readable."""
        publications = {}
        with tempfile.TemporaryDirectory(prefix="porelo-org-signers-") as directory:
            path = Path(directory) / "state"
            accepted = {project["project"] for project in applied["projects"]}
            state = {**answer, "projects": [project for project in answer["projects"]
                                            if isinstance(project, dict) and isinstance(project.get("project"), str)
                                            and project["project"] in accepted]}
            path.write_text(json.dumps(state), encoding="utf-8")
            path.chmod(0o600)
            for project in applied["projects"]:
                name = project["project"]
                unit = "porelo-host-org-signers"
                try:
                    result = self.isolated_porelo(
                        unit, {"state": path},
                        ["org", "signers", "--state", f"/run/credentials/{unit}.service/state",
                         "--project", name, "--json"],
                        "porelo org signers", "porelo org signers refused the project",
                    )
                    if (result.get("project") != name or result.get("revision") != answer["revision"]
                            or any(not isinstance(result.get(field), str) for field in ("signers", "certifiers"))):
                        refuse("porelo org signers answered another project, revision or malformed keys", 65)
                    publications[name] = result
                except Refusal as error:
                    project["why"] = str(error)
                    applied["project_refusals"][name] = str(error)
                    publications[name] = {"signers": "", "certifiers": ""}
        return publications

    def read_key_added(self):
        """Whether the central forge knows the host's read key, which only the host admin's token can have added."""
        path = self.path("/etc/porelo-host/organization/read/organization.added")
        self.check(path)
        return path.exists()

    def add_read_key(self, token):
        """Hand the token to Porelo on standard input alone, since only the adapter reads where the organization is."""
        directory = self.path("/etc/porelo-host/organization")
        staged = {"organization.yml": directory / "organization.yml", "read.pub": directory / "read/organization.pub"}
        for path in staged.values():
            self.check(path, required=True)
        unit = "porelo-host-org-read-key"
        credential = f"/run/credentials/{unit}.service/"
        answer = self.isolated_porelo(
            unit, staged,
            ["org", "add-read-key", "--settings", credential + "organization.yml", "--key", credential + "read.pub",
             "--json"],
            "porelo org add-read-key", "porelo org add-read-key refused", input=token, network=True,
        )
        if type(answer.get("added")) is not bool:
            refuse("porelo org add-read-key answered malformed", 65)
        self.write(directory / "read/organization.added", "added\n", 0o600)

    def refresh(self, supplied):
        """Follow at once with a transient central token for migrations discovered by this refresh."""
        if len(supplied) > TOKEN_LIMIT:
            refuse("the token is too long", 65)
        try:
            token = supplied.decode("ascii").strip()
        except UnicodeError:
            refuse("the token is not one printable line", 65)
        if token:
            if not re.fullmatch(r"[!-~]+", token):
                refuse("the token is not one printable line", 65)
            if self.read_key_added():
                if (self.forge_configuration("porelo-admin") is None
                        and not any(item.get("state") == "waiting-for-token" for item in self.host_projects().values())):
                    refuse("no project waits for a token; org refresh requires empty standard input", 65)
            else:
                self.add_read_key(token)
        return self.follow(token or None)

    def follow(self, token=None):
        """Fetch through the host's credentials, refuse before mutation, then reconcile accepted access."""
        self.require(["systemd-run", "porelo", "setfacl"])
        host = self.setting("/etc/porelo-host/forge.conf", "host")
        if not re.fullmatch(HOST, host):
            refuse("forge.conf names no valid host", 69)
        if not self.read_key_added():
            return self.org_status(host)
        self.follow_pin()
        applied_path, previous = self.applied_organization()
        directory = self.path("/etc/porelo-host/organization")
        staged = {"organization.yml": directory / "organization.yml", "organization": directory / "read/organization",
                  "known_hosts": directory / "known_hosts", "pin": directory / "pin"}
        for path in staged.values():
            self.check(path, required=True, mode=0o600)
        unit = "porelo-host-org-fetch"
        credential = f"/run/credentials/{unit}.service/"
        arguments = ["org", "fetch", "--host", host, "--settings", credential + "organization.yml",
                     "--ssh-key", credential + "organization", "--known-hosts", credential + "known_hosts",
                     "--pin", credential + "pin"]
        if previous is not None:
            arguments.extend(["--since", previous["commit"]])
        arguments.append("--json")
        # The trust record lives across follows, or each one asks the forge about every person again.
        answer = self.isolated_porelo(unit, staged, arguments, "porelo org fetch",
                                      "porelo org fetch refused the state", network=True, state=unit,
                                      refused=self.follow_refused)
        applied = self.follow_state(answer, host, previous)
        files = {item["project"]: self.follow_project_file(item, applied) for item in applied["projects"]}
        signers = self.follow_signers(answer, applied)
        records = self.records()
        accounts = self.account_ids()
        # On the KRL before the state is recorded: a failure here retries with every key still known.
        gone = set(applied["revoked"]) | (set() if previous is None else set(previous["revoked"]))
        krl = [item["ssh"] for item in ([] if previous is None else previous["persons"]) if item["login"] in gone]
        krl.extend(item["ssh"] for item in applied["persons"] if item["login"] in applied["revoked"])
        krl.extend(record["ssh"] for login, record in records.items() if login in gone)
        if krl:
            self.write_krl(list(dict.fromkeys(krl)))
        # The pin first: cut off here, the next fetch judges by the newer keys and takes this same state again.
        self.write_follow_pin(applied)
        # Accepted from here on: a failure below is retried on this revision, and an older one stays refused.
        self.write(applied_path, json.dumps(applied, indent=1) + "\n", 0o600)
        self.path(FOLLOW_REFUSED).unlink(missing_ok=True)
        # Access is taken away first, so no failure in a service can leave a removed member reading.
        self.follow_publish(applied, files, signers, records, accounts)
        errors = []
        for step in (lambda: self.apply_org_cards(applied["persons"], applied["revoked"], records, previous),
                     lambda: self.follow_memberships(applied, records, accounts),
                     lambda: self.follow_projects(applied, previous, token),
                     lambda: self.follow_forge_members(applied, previous, records, self.account_ids())):
            try:
                step()
            except Refusal as error:
                errors.append(str(error))
        # Read again: whoever this follow admitted has an account now, and reads the project file from this follow on.
        files = {item["project"]: self.follow_project_file(item, applied) for item in applied["projects"]}
        self.follow_publish(applied, files, signers, records, self.account_ids())
        if errors:
            refuse("the organization is taken; the next follow retries: " + "; ".join(errors), 69)
        return self.org_status(host)

    def host_projects(self):
        """Read root's progress separately from the accepted state, so interruptions cannot lose removals."""
        path = self.path(HOST_PROJECTS)
        self.check(path, mode=0o600)
        if not path.exists():
            return {}
        try:
            entries = json.loads(self.read(path))
        except (ValueError, UnicodeError):
            refuse("the host project progress does not read", 65)
        if (not isinstance(entries, dict)
                or any(not re.fullmatch(PROJECT, name) or not isinstance(item, dict)
                       or item.get("state") not in ("pending", "carried", "waiting-for-token", "held", "refused")
                       for name, item in entries.items())):
            refuse("the host project progress is malformed", 65)
        return entries

    def write_host_projects(self, entries):
        """Record a retry before starting a service change, without storing any central credential."""
        self.write(self.path(HOST_PROJECTS), json.dumps(entries, indent=1) + "\n", 0o600)

    def project_status(self, applied):
        """Include projects held on the forge or waiting for a room deletion after leaving the host card."""
        entries = self.host_projects()
        for project in [] if applied is None else applied["projects"]:
            name = project["project"]
            entries.setdefault(name, {"state": "carried", "why": project.get("why"), "since": project.get("since")})
        for name, why in {} if applied is None else applied.get("project_refusals", {}).items():
            entries[name] = {**entries.get(name, {}), "state": "refused", "why": why}
        return [{"project": name, "state": item["state"], "why": item.get("why"), "since": item.get("since")}
                for name, item in sorted(entries.items())]

    def follow_uses_gate(self, project):
        """Only an installed local gate may own a project room on this host."""
        path = self.path("/etc/systemd/system/porelo-matrix-gate.socket")
        self.check(path)
        return path.exists()

    def follow_project_room(self, project):
        """Publish a local room only after the gate has confirmed it under the same ownership condition."""
        item = self.host_projects().get(project["project"], {}) if self.follow_uses_gate(project) else {}
        return {field: item.get(field) for field in ("homeserver", "room")}

    def follow_room_command(self, verb, project, persons):
        """Keep gate credentials and captured diagnostics off command lines, files and logs."""
        self.require(["runuser", "env", "cat", TRANSPORT])
        supplied = json.dumps({"secrets": {"PORELO_MATRIX_ADMIN_TOKEN": self.matrix_admin_token()}})
        arguments = [TRANSPORT, verb, "--project", project]
        if verb == "keep-room":
            arguments.extend(["--persons", ",".join(persons)])
        result = self.as_account("porelo-matrix", arguments, input=supplied, accepted=(0, 75, 78))
        if result.returncode:
            refuse(f"{verb} exited {result.returncode}", result.returncode)
        if verb == "drop-room":
            return {}
        try:
            answer = json.loads(result.stdout)
        except (ValueError, UnicodeError):
            refuse("keep-room answered malformed JSON", 69)
        room = answer.get("room") if isinstance(answer, dict) else None
        removed = answer.get("removed", []) if isinstance(answer, dict) else None
        if (not isinstance(room, str) or not room or any(ord(char) < 33 or ord(char) > 126 for char in room)
                or not isinstance(removed, list)
                or any(not isinstance(name, str) or any(ord(char) < 33 or ord(char) > 126 for char in name)
                       for name in removed)):
            refuse("keep-room answered no room", 69)
        if removed:
            print(f"porelo-host-person: {project}: out of its room: {','.join(removed)}", file=sys.stderr)
        return {"homeserver": GATE_HOMESERVER, "room": room}

    def follow_project_command(self, arguments, supplied=None):
        """Lend the held lock to the root helper; never take the same flock through a second open file."""
        path = self.path(PROJECT_HELPER)
        self.check(path, required=True)
        descriptor = self.project_lock_fd
        try:
            result = self.runner([str(path), *arguments, "--lock-fd", str(descriptor)],
                                 input=None if supplied is None else json.dumps(supplied), pass_fds=(descriptor,),
                                 timeout=600)
        except (OSError, subprocess.TimeoutExpired, UnicodeError) as error:
            refuse(f"the project helper failed to complete ({type(error).__name__})", 69)
        if result.returncode:
            # Only removal's structured refusal may name commits.
            if arguments[0] == "remove" and result.returncode == 65:
                try:
                    held = json.loads(result.stdout)
                    commits = held["unpushed"]
                    if (held.get("project") != arguments[1] or not isinstance(commits, dict)
                            or any(not re.fullmatch(REPOSITORY, name) or not isinstance(values, list)
                                   or any(not isinstance(value, str) or not re.fullmatch(COMMIT, value)
                                          for value in values) for name, values in commits.items())):
                        raise ValueError()
                except (ValueError, TypeError, KeyError, AttributeError):
                    refuse("project removal was refused or could not verify every commit", 69)
                if not commits:
                    words = helper_words(result.stderr, supplied)
                    if words is None:
                        refuse("project removal was refused without a verified commit comparison", 65)
                    print(f"porelo-host-person: {arguments[1]}: {words} (exit 65)", file=sys.stderr)
                    refuse(words, 65)
                refuse("unpushed commits: " + "; ".join(f"{name}: {', '.join(values)}"
                                                        for name, values in commits.items()), 65)
            words = helper_words(result.stderr, supplied)
            if words is None:
                refuse(f"the project helper {arguments[0]} exited {result.returncode}", 69)
            print(f"porelo-host-person: {arguments[1]}: {words} (exit {result.returncode})", file=sys.stderr)
            # The follow reads its own codes as held or as a refused room, which a helper's exit must not become.
            raise Refusal(words, 69, told=result.returncode)
        if arguments[0] == "remove":
            self.say_left_at_central(arguments[1], result.stdout)
        return {}

    def say_left_at_central(self, project, answer):
        """Name what taking a project off leaves at the central forge, as no token is at hand then to remove it."""
        try:
            left = json.loads(answer).get("left_at_central", [])
            keys = [("".join(char for char in item[field] if char.isprintable()) for field in ("title", "address"))
                    for item in left]
            for title, address in keys:
                print(f'porelo-host-person: {project}: taken off the host; its read-only deploy key "{title}" stays at '
                      f"{address} until that repository's owner removes it", file=sys.stderr)
        except (ValueError, TypeError, KeyError, AttributeError):
            print(f"porelo-host-person: {project}: taken off the host; what it left at the central forge does not read",
                  file=sys.stderr)

    def follow_project_admin(self, project, records):
        """Choose a current unlocked project admin and that admin's current signing key from the taken state."""
        now = self.now().strftime("%Y%m%d%H%M%SZ")
        for member in project["members"]:
            login = member["login"]
            record = records.get(login)
            if (member["role"] != "admin" or member["locked"] or not record or record["locked"]
                    or record.get("lock") == "pending"):
                continue
            for key in reversed(project["signing_keys"]):
                if (key["login"] == login and key["role"] == "admin" and key["key"] == record["ssh"]
                        and key["revoked_since"] is None
                        and (self.card_expiry(key["valid_from"]) is None or self.card_expiry(key["valid_from"]) <= now)
                        and (self.card_expiry(key["valid_until"]) is None or now < self.card_expiry(key["valid_until"]))):
                    return login, key["key"]
        refuse("the project has no unlocked admin with a current signing key", 65)

    def follow_project_forge(self, project, item, has_forge, physical, token):
        """Put one project on the host's forge, and its repository as soon as a token is at hand."""
        name = project["project"]
        if not has_forge:
            item.pop("migrate_refused", None)
            item["state"] = "carried"
            return
        if name not in physical:
            admin, key = self.follow_project_admin(project, self.records())
            self.follow_project_command(["add", name, admin, "--signed-by", key])
            # A new forge organization holds no repository, whatever a record that outlived the old one says.
            for done in ("migrated", "migrate_refused"):
                item.pop(done, None)
        if item.get("migrated"):
            item["state"] = "carried"
            return
        item["state"] = "waiting-for-token"
        if token is None:
            return
        try:
            if project["address"] is None:
                refuse("the project names no usable central address", 65)
            self.follow_project_command(["migrate", name], {"address": project["address"], "token": token})
        except Refusal as error:
            item["migrate_refused"] = error.shown()
            raise
        item.pop("migrate_refused", None)
        item["migrated"] = True
        item["state"] = "carried"

    def follow_projects(self, applied, previous, token):
        """Reconcile physical project records, retaining work and retrying each project's unfinished service changes."""
        entries = self.host_projects()
        desired = {project["project"]: project for project in applied["projects"]}
        has_forge = self.forge_configuration(applied["admins"][0]["login"]) is not None
        directory = self.path("/etc/porelo-host/projects")
        physical = set()
        if has_forge:
            self.check(directory, directory=True)
            if directory.exists():
                for path in directory.glob("*.conf"):
                    self.check(path, mode=0o600)
                    if not re.fullmatch(PROJECT, path.stem):
                        refuse("the project records name an invalid project", 65)
                    physical.add(path.stem)
        for project in ([] if previous is None else previous["projects"]) + applied["projects"]:
            name = project["project"]
            entries.setdefault(name, {"state": "pending", "since": project.get("since"),
                                      "gate": self.follow_uses_gate(project)})
        for name in physical:
            entries.setdefault(name, {"state": "pending", "gate": self.follow_uses_gate({"project": name})})
        self.write_host_projects(entries)
        for name in sorted(set(entries) | set(desired)):
            if name in applied.get("project_refusals", {}):
                continue
            project = desired.get(name)
            item = entries[name]
            try:
                if project is not None:
                    # A forge that cannot go on yet keeps nobody out of the room: its refusal comes after.
                    forge_refusal = None
                    try:
                        self.follow_project_forge(project, item, has_forge, physical, token)
                    except Refusal as error:
                        forge_refusal = error
                    # A follow without a token makes no try, so the last try's refusal still stands.
                    item["why"] = "; ".join(filter(None, (item.get("migrate_refused"), project.get("why")))) or None
                    item["gate"] = self.follow_uses_gate(project)
                    if item["gate"] and not item.get("room_refused"):
                        records = self.records()
                        members = sorted(member["login"] for member in project["members"]
                                         if not member["locked"] and member["login"] in records
                                         and not records[member["login"]]["locked"]
                                         and records[member["login"]].get("lock") != "pending")
                        item.update(self.follow_room_command("keep-room", name, members))
                    if forge_refusal is not None:
                        raise forge_refusal
                else:
                    item["state"] = "pending"
                    if name in physical:
                        if (item.get("gate") and self.follow_uses_gate({"project": name})
                                and not item.get("room_refused")):
                            self.follow_room_command("keep-room", name, [])
                        self.follow_project_command(["remove", name])
                    if (item.get("gate") and self.follow_uses_gate({"project": name})
                            and not item.get("room_refused")):
                        self.follow_room_command("drop-room", name, [])
                    if not item.get("room_refused"):
                        del entries[name]
            except Refusal as error:
                if project is None and error.code == 65:
                    item["state"] = "held"
                elif error.code == 78:
                    item["room_refused"] = True
                item["why"] = error.shown()
            if item.get("room_refused"):
                item["why"] = "the gate refused the room (exit 78); left alone"
            self.write_host_projects(entries)

    def write_follow_pin(self, applied):
        """Write the pin only from a state already taken, and only when it differs, as the fetch reads it each time."""
        path = self.path("/etc/porelo-host/organization/pin")
        text = "".join(f'{admin["login"]} {admin["key"]}\n' for admin in applied["admins"])
        if self.read(path) != text:
            self.write(path, text, 0o600)
        # Root's login follows the same list, so a host admin the organization replaced does not keep it.
        root = self.path("/etc/ssh/authorized_keys/root")
        self.directories(root.parent)
        if not root.exists() or self.read(root) != text_keys(applied):
            self.write(root, text_keys(applied), 0o644)

    def follow_forge_members(self, applied, previous, records, accounts):
        """Apply project-local team removal even when the affected person still belongs to another project."""
        admin = applied["admins"][0]["login"]
        if self.forge_configuration(admin) is None:
            return
        projects = {project["project"]: project for project in applied["projects"]}
        old_names = set() if previous is None else {
            project["project"] for project in previous["projects"]
        }
        errors = []
        for name in sorted(set(projects) | old_names | set(self.host_projects())):
            try:
                self.follow_forge_project(name, projects.get(name), applied, previous, records, accounts, admin)
            except Refusal as error:
                errors.append(f"{name}: {error}")
        if errors:
            refuse("; ".join(errors), 69)

    def follow_forge_project(self, name, project, applied, previous, records, accounts, admin):
        """Finish one project's team and configuration changes without stopping another project's revocations."""
        if not self.forge_has_project(name, admin):
            return
        desired = {} if project is None else {
            member["login"]: member for member in project["members"] if not member["locked"]
            and member["login"] in records and not records[member["login"]]["locked"]
            and records[member["login"]].get("lock") != "pending"
        }
        self.forge_project_apply(name, admin, desired)
        if project is not None:
            self.arm_pushes(name)
        before = next((item for item in ([] if previous is None else previous["projects"])
                       if item["project"] == name), {})
        gone = {member["login"] for member in before.get("members", [])} - set(desired)
        self.follow_push_configs(name, admin, sorted(desired), sorted(gone), accounts, project is not None)


    def follow_push_configs(self, project, admin, members, gone, accounts, carried):
        """Write each member's push config in their own account, as them, so no link in a home can turn root's hand."""
        text = None
        if carried and members:
            with self.forge_session(admin, "read:organization,read:repository") as (_, opener, base, token):
                repositories = self.forge_pages(opener, base.removesuffix("admin/users/"), token,
                                                f"orgs/{project}/repos", "name")
            lines = []
            for repository in sorted(repositories, key=lambda item: item["name"]):
                address = repository.get("original_url")
                if (not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}", repository["name"]) or not isinstance(address, str)
                        or not re.fullmatch(r"https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/[^\s?#@]+", address)):
                    refuse(f"{project}: a repository has no valid central address to push to", 65)
                lines.append(f"repository {repository['name']} {address}\n")
            port = self.setting("/etc/porelo-host/forge.conf", "git_port")
            central = self.read(self.path("/etc/porelo-host/forge/central-ca.conf")).strip()
            if not re.fullmatch(r"[0-9]{1,5}", port) or not re.fullmatch(r"/\S+", central):
                refuse("the forge's git port or central CA is not valid", 69)
            text = (f"# Written by porelo-host-person org follow; read by porelo-host-push.\n"
                    f"local http://127.0.0.1:{port}\nowner {project}\ncentral-ca {central}\n" + "".join(lines))
        for login in members if text is not None else []:
            if accounts.get(login) is not None:
                self.as_account(login, ["sh", "-c", PUSH_CONFIG_WRITE, "sh", project], input=text)
        for login in gone:
            if accounts.get(login) is not None:
                self.as_account(login, ["sh", "-c", PUSH_CONFIG_REMOVE, "sh", project])

    def forge_has_project(self, project, admin):
        """Whether the project's organization stands on the host's forge; until put on, there is nothing to keep."""
        with self.forge_session(admin, "read:organization") as (_, opener, base, token):
            try:
                self.forge_api(opener, base.removesuffix("admin/users/"), token, "GET", f"orgs/{project}", 200,
                               not_found="absent")
            except Refusal as error:
                if error.code == 65:
                    return False
                raise
        return True

    def follow_memberships(self, applied, records, accounts):
        """Apply project roles and host admin access, preserving accounts throughout the removal grace period."""
        persons = {item["login"]: item for item in applied["persons"]}
        memberships = {login: [] for login in persons}
        listed = set()
        for project in applied["projects"]:
            for member in project["members"]:
                listed.add(member["login"])
                if not member["locked"]:
                    role = "project-admin" if member["role"] == "admin" else "developer"
                    memberships[member["login"]].append(f'{project["project"]} {role}')
        admins = {item["login"] for item in applied["admins"]}
        listed |= admins
        for login in admins:
            memberships[login].append(HOST_ADMIN)
        groups = self.groups if self.groups is not None else {entry.gr_name for entry in grp.getgrall()}
        purged = self.purged()
        today = self.now().date()
        errors = []
        for login in sorted(set(records) | set(persons)):
            record, person = records.get(login), persons.get(login)
            desired = memberships.get(login, [])
            expiry = self.card_expiry(person["expires"]) if person else None
            permitted = (person is not None and login not in purged and not person["revoked"]
                         and not self.key_revoked(person["ssh"])
                         and (expiry is None or expiry > self.now().strftime("%Y%m%d%H%M%SZ")))
            try:
                if not permitted or not desired:
                    if record is not None:
                        self.follow_remove(login, record, listed, permitted, today, accounts, records)
                else:
                    self.follow_admit(login, record, desired, person, groups, records, accounts)
            except Refusal as error:
                errors.append(f"{login}: {error}")
        self.people_group(records)
        if errors:
            refuse("; ".join(errors), 69)

    def follow_remove(self, login, record, listed, permitted, today, accounts, records):
        """Lock whoever may not be here; only leaving every project starts the days to the purge."""
        if login in listed:
            record.pop("locked_on", None)
        else:
            record.setdefault("locked_on", today.isoformat())
        # The memberships stay until the lock is done, so an unfinished one still knows what it owes.
        if not record["locked"] or record.get("lock") == "pending":
            record["reason"] = "membership" if permitted else "key"
            self.lock(login, record, True)
        record["members"] = []
        self.record(login, record)
        purge_day = None if "locked_on" not in record else datetime.date.fromisoformat(record["locked_on"]) + PURGE_AFTER
        if purge_day is not None and today >= purge_day:
            self.require(["userdel", "loginctl", "systemctl", "usermod", "gpasswd", "runuser", "env"])
            self.purge(login, record, self.available("porelo"), accounts.get(login) is not None)
            records.pop(login)

    def follow_admit(self, login, record, desired, person, groups, records, accounts):
        """Make the account or bring it back as it was left, touching nothing when nothing changed."""
        card = {field: person[field] for field in ("ssh", "expires")}
        if record is None:
            if login in groups:
                refuse("an organization login belongs to an existing group", 65)
            self.targets(login)
            self.prepare_services(login, "add")
            self.require(["useradd", "usermod", "loginctl", "systemctl"]
                         + ([] if "porelo-people" in groups else ["groupadd"]))
            self.add(login, card, groups, self.next_range(self.subids("subuid")),
                     self.next_range(self.subids("subgid")), members=desired)
            records[login] = {"members": desired, "locked": False, **card}
            self.start_daemon(login)
            return
        if record.get("lock") == "pending":
            refuse("a lock is unfinished, so the person is not admitted again", 69)
        if record["locked"] and login not in accounts:
            return
        unlocked = record["locked"]
        if (not unlocked and record["members"] == desired
                and all(record.get(field) == card[field] for field in card)):
            return
        if unlocked:
            self.hooks["forge_drop_tokens"](login)
            self.require(["usermod", "loginctl"])
            self.enable_linger(login)
            self.subordinate_ids(login)
            self.command(["usermod", "--expiredate", "", login])
            self.hooks["forge_admit"](login, card)
            self.forge_unlock(login)
        record.update(card, members=desired, locked=False, reason="")
        record.pop("locked_on", None)
        self.join_groups(login, groups)
        self.admit_runtime(login)
        self.write_authorized_key(login, card["ssh"], self.card_expiry(card["expires"]))
        self.record(login, record)
        if unlocked:
            self.private_umask(login)
            self.start_daemon(login)

    def follow_project_file(self, project, applied):
        """Build the member contract from accepted organization fields and the host's installed services."""
        fetch_from = None
        if self.forge_configuration(applied["admins"][0]["login"]) is not None and project["address"] is not None:
            services = applied["host_card"].get("services")
            forge = services.get("forge") if isinstance(services, dict) else None
            port = forge.get("git_port") if isinstance(forge, dict) else None
            if type(port) is int and 1 <= port <= 65535:
                # On the host's forge the repository stands in the project's organization, under its central name.
                repository = CENTRAL_ADDRESS.fullmatch(project["address"]).group("repository")
                fetch_from = f'http://127.0.0.1:{port}/{project["project"]}/{repository}.git'
            else:
                project["why"] = "the host card names no forge git port"
                print(f'porelo-host-person: {project["project"]}: {project["why"]}', file=sys.stderr)
        return {"project": project["project"], "host": applied["host_card"]["host"], "revision": applied["revision"],
                "address": project["address"], "fetch_from": fetch_from, "signing_keys": project["signing_keys"],
                **self.follow_project_room(project)}

    def follow_publish(self, applied, files, signers, records, accounts):
        """Replace each member publication whole, its ACL set before any reader can see it, so none sees it missing."""
        directory = self.path("/etc/porelo-host/organization/projects")
        self.check(directory, directory=True)
        self.directories(directory)
        directory.parent.chmod(0o711)
        directory.chmod(0o711)
        for path in directory.iterdir():
            self.check(path)
            # What an interrupted follow left beside a file is its own and goes; anything else is nobody's to remove.
            if path.name.startswith(".porelo-host-person.") or path.name.endswith(".json.new"):
                path.unlink()
                continue
            if path.suffix != ".json" or not re.fullmatch(PROJECT, path.stem):
                refuse("the organization projects directory holds an unknown file", 65)
            if path.stem not in files:
                path.unlink()
                for suffix in ("allowed", "certifiers"):
                    signer = self.path(f"/etc/porelo-host/signers/{path.stem}.{suffix}")
                    self.check(signer)
                    signer.unlink(missing_ok=True)
        has_forge = self.forge_configuration(applied["admins"][0]["login"]) is not None
        for project in applied["projects"]:
            name = project["project"]
            path = directory / (name + ".json")
            staged = directory / (name + ".json.new")
            self.write(staged, json.dumps(files[name]) + "\n", 0o600)
            entries = [f"user:{accounts[member['login']]}:r--" for member in project["members"]
                       if not member["locked"] and member["login"] in accounts and member["login"] in records
                       and not records[member["login"]]["locked"] and records[member["login"]].get("lock") != "pending"]
            if entries:
                self.command(["setfacl", "--modify", ",".join(entries), str(staged)])
            os.replace(staged, path)
            # Only the push judge reads the allowed signers, and a host with no forge has none; the gate reads the rest.
            for suffix, field in [("certifiers", "certifiers")] + ([("allowed", "signers")] if has_forge else []):
                self.write_signers(name, suffix, signers[name][field])

    def account_ids(self):
        """Every account on the machine now, login to uid."""
        return self.accounts if self.accounts is not None else {
            entry.pw_name: entry.pw_uid for entry in pwd.getpwall()
        }

    def write_signers(self, project, suffix, text):
        """Publish a signers file the forge's account can reach, refusing a link anywhere on the way."""
        directory = self.path("/etc/porelo-host/signers")
        self.check(directory, 73, directory=True)
        self.directories(directory)
        directory.chmod(0o755)
        path = directory / f"{project}.{suffix}"
        self.check(path, 73)
        self.write(path, text, 0o644)

    def organization_state(self):
        """Whether this host, once set up for an organization, follows it or still waits for the admin's token."""
        pin = self.path("/etc/porelo-host/organization/pin")
        self.check(pin)
        if not pin.exists():
            return None
        return "following" if self.read_key_added() else "waiting-for-token"

    def org_status(self, host=None):
        """The host, the applied organization and where each person stands on it, from root's records alone."""
        if host is None:
            host = self.setting("/etc/porelo-host/forge.conf", "host")
            if not re.fullmatch(HOST, host):
                refuse("forge.conf names no valid host", 69)
        _, pinned = self.org_pin()
        _, applied = self.applied_organization()
        persons = {}
        for login, record in self.records().items():
            state = "pending" if record.get("lock") == "pending" else "locked" if record["locked"] else "active"
            projects = []
            for member in record["members"]:
                if member != HOST_ADMIN:
                    project, role = member.split()
                    projects.append({"project": project, "role": role})
            persons[login] = {"login": login, "state": state, "host_admin": HOST_ADMIN in record["members"],
                              "projects": projects}
            if record.get("locked_on"):
                persons[login]["purge_on"] = (datetime.date.fromisoformat(record["locked_on"]) + PURGE_AFTER).isoformat()
        for login in self.purged():
            persons.setdefault(login, {"login": login, "state": "purged", "host_admin": False, "projects": []})
        for item in [] if applied is None else applied["persons"]:
            persons.setdefault(item["login"], {"login": item["login"], "state": "named", "host_admin": False,
                                               "projects": []})
        return {
            "host": host,
            "organization": self.organization_state(),
            "refused": self.follow_refusal(),
            "commit": None if applied is None else applied["commit"],
            "pinned": None if pinned is None else fingerprint(pinned["key"]),
            "persons": [persons[login] for login in sorted(persons)],
            "projects": self.project_status(applied),
        }

    def apply_org_cards(self, persons, revoked, records, previous=None, retried=(), retry_errors=()):
        """Apply host revocations and current card keys after recording the verified organization."""
        already_retried = set(retried)
        errors = list(retry_errors) + self.retry_locks({user: rec for user, rec in records.items()
                                                     if user not in already_retried})
        failed = {user for user, rec in records.items() if rec.get("lock") == "pending"}
        prior = previous["persons"] if previous else []
        keys = [entry["ssh"] for entry in [*prior, *persons] if entry["login"] in revoked]
        keys.extend(record["ssh"] for login, record in records.items() if login in revoked)
        self.write_krl(list(dict.fromkeys(keys)))
        cards = {entry["login"]: entry for entry in persons}
        for login in revoked:
            if login not in cards and login in records:
                cards[login] = {"login": login, **records[login]}
        for entry in cards.values():
            login = entry["login"]
            record = records.get(login)
            if record is None:
                continue
            try:
                if login in revoked or self.key_revoked(entry["ssh"]):
                    record["reason"] = "key"
                    self.lock(login, record, True)
                elif login not in failed and not record["locked"]:
                    record.update({key: entry[key] for key in ("ssh", "expires")})
                    self.write_authorized_key(login, entry["ssh"], self.card_expiry(entry["expires"]))
                    self.record(login, record)
            except Refusal as error:
                errors.append(f"{login}: {error}")
        self.people_group(records)
        if errors:
            refuse("the organization is applied; the next follow retries host revocation: "
                   + "; ".join(str(error) for error in errors), 69)


    def people_group(self, records):
        """Keep socket forwarding and sudo membership equal to the host's unlocked admissions."""
        desired = {user for user, rec in records.items()
                   if rec["members"] and not rec["locked"] and rec.get("lock") != "pending"}
        try:
            current = set(grp.getgrnam("porelo-people").gr_mem)
        except KeyError:
            current = set()
        for user in sorted(current - desired):
            if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", user):
                refuse("porelo-people holds an invalid login", 65)
            self.require(["gpasswd"])
            self.command(["gpasswd", "--delete", user, "porelo-people"])
        groups = self.groups if self.groups is not None else {entry.gr_name for entry in grp.getgrall()}
        for user in sorted(desired - current):
            self.join_groups(user, groups)

    def forge_project_apply(self, project, admin, persons):
        """Reconcile every project team, removing person and task identities only from this organization."""
        if self.forge_configuration(admin) is None:
            return
        with self.forge_session(admin, "write:organization,read:user") as (account, opener, base, token):
            users = self.forge_users(account)
            base = base.removesuffix("admin/users/")
            teams = self.forge_pages(opener, base, token, f"orgs/{project}/teams", "id")
            names = {row.get("name") for row in teams}
            if not {"Owners", "developers"} <= names:
                refuse(f"Forgejo organization {project} needs Owners and developers teams", 65)
            for team in teams:
                if not isinstance(team.get("name"), str):
                    refuse("Forgejo answered no valid team name", 69)
                team_id = team["id"]
                current = self.forge_pages(opener, base, token, f"teams/{team_id}/members", "login")
                desired = set()
                for user, entry in persons.items():
                    identities = self.forge_configuration(user)[1]
                    if team["name"] == ("Owners" if entry["role"] == "admin" else "developers"):
                        desired.add(user)
                    # Task gates cannot inherit the person's administrative role.
                    if team["name"] == "developers":
                        desired.update(identity for identity in identities[1:] if identity in users)
                for user in sorted(desired - {row["login"] for row in current}):
                    self.forge_api(opener, base, token, "PUT", f"teams/{team_id}/members/{user}", 204)
                known = set(self.records()) | self.purged()
                identities = {identity for user in known for identity in self.forge_configuration(user)[1]}
                for row in current:
                    user = row["login"]
                    if user in identities and user not in desired:
                        self.forge_api(opener, base, token, "DELETE", f"teams/{team_id}/members/{user}", 204)

    def forge_pages(self, opener, base, token, path, field):
        """Read bounded-progress API pages, refusing malformed or repeated entries."""
        result, seen, page = [], set(), 1
        while True:
            rows = self.forge_api(opener, base, token, "GET", f"{path}?limit=50&page={page}", 200)
            if not isinstance(rows, list):
                refuse("Forgejo answered no valid list", 69)
            if not rows:
                return result
            for row in rows:
                value = row.get(field) if isinstance(row, dict) else None
                valid = (type(value) is int and value > 0) if field == "id" else (
                    isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,95}", value))
                if not valid or value in seen:
                    refuse("Forgejo answered an invalid or repeated page entry", 69)
                seen.add(value)
            result.extend(rows)
            page += 1

    def forge_unlock(self, user):
        """Restore the person's forge logins after a membership-only lock, without issuing tokens."""
        config = self.forge_configuration(user)
        if config is None:
            return
        with self.forge_session(user) as (account, opener, base, token):
            users = self.forge_users(account)
            for identity in config[1]:
                if identity not in users:
                    continue
                self.forge_api(opener, base, token, "PATCH", identity, 200,
                               {"login_name": identity, "source_id": 0, "prohibit_login": False})

    def person(self, user, records):
        """The calling person, recorded, unlocked and holding a membership; anyone else is refused."""
        record = records.get(user)
        if record is None or record["locked"] or record.get("lock") == "pending" or not record["members"]:
            refuse(f"{user} is no unlocked person of this host", 65)
        return record

    def revoked(self, user):
        """Whether the applied organization names the login revoked."""
        _, applied = self.applied_organization()
        return applied is not None and user in applied["revoked"]

    def current_key(self, user):
        """The person's one current key in the applied organization, refused where it is missing or revoked."""
        _, applied = self.applied_organization()
        entries = [item for item in applied["persons"] if item.get("login") == user] if applied else []
        if (
            len(entries) != 1
            or entries[0].get("revoked") is not False
            or user in applied["revoked"]
            or not valid_ssh_key(entries[0].get("ssh"))
        ):
            refuse(f"the host's organization names no current, unrevoked key of {user}", 65)
        return entries[0]["ssh"]

    def certificate(self, line):
        """Have ssh-keygen check a certificate from a private file; only its path reaches argv."""
        with tempfile.TemporaryDirectory(prefix="porelo-host-task.") as directory:
            path = Path(directory) / "task-cert.pub"
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(descriptor, "w", encoding="ascii") as stream:
                stream.write(line + "\n")
            result = self.command(["env", "TZ=UTC", "ssh-keygen", "-L", "-f", str(path)], accepted=(0, 1, 255))
        if result.returncode != 0:
            refuse("ssh-keygen refused the task certificate: its form or signature is bad", 65)
        fields = read_certificate(result.stdout)
        if fields is None:
            refuse("ssh-keygen answered no certificate of the shape a task's takes, with a start and an end", 65)
        return fields

    def task_directory(self, user=None):
        """Root's private directory of task records, or one person's within it."""
        directory = self.path(TASKS if user is None else f"{TASKS}/{user}")
        self.check(directory, 73, directory=True, mode=0o700)
        return directory

    def task_records(self, user=None):
        """Every recorded task, or one person's, as (login, task, record); a record of another shape stops the call."""
        root = self.task_directory()
        if not root.exists():
            return []
        found = []
        for directory in sorted(root.iterdir()) if user is None else [root / user]:
            if not re.fullmatch(USER, directory.name):
                refuse(f"{root} holds an unknown entry", 65)
            self.check(directory, 73, directory=True, mode=0o700)
            if not directory.exists():
                continue
            for path in sorted(directory.iterdir()):
                task = path.name.removesuffix(".json")
                if not path.name.endswith(".json") or not re.fullmatch(TASK, task):
                    refuse(f"{directory} holds an unknown entry", 65)
                found.append((directory.name, task, self.task_record(path, directory.name, task)))
        return found

    def task_record(self, path, user, task):
        """One recorded task, checked to be root's, private and of its own name."""
        self.check(path, 73, required=True, mode=0o600)
        try:
            entry = json.loads(self.read(path))
        except ValueError:
            entry = None
        if (
            not isinstance(entry, dict)
            or entry.get("task") != task
            or entry.get("login") != user
            or not isinstance(entry.get("certificate"), str)
            or not isinstance(entry.get("fingerprint"), str)
            or certificate_time(str(entry.get("valid_before")).removesuffix("Z")) is None
        ):
            refuse(f"{path} holds no valid task record", 65)
        return entry

    def start_task(self, user, task, data, records):
        """Check the certificate, record it once and answer the task's new gate token, or nothing with no forge."""
        self.person(user, records)
        line = certificate_line(sys.stdin.buffer.read(MAX_CERTIFICATE + 1) if data is None else data)
        key = self.current_key(user)
        self.require(["env", "ssh-keygen", "systemd-run", "porelo"])
        fields = self.certificate(line)
        now = self.now()
        if fields["type"] != CERTIFICATE + " user certificate":
            refuse("the task certificate is no user certificate", 65)
        if fields["signed_by"] != fingerprint(key):
            refuse(f"the task certificate is signed by {fields['signed_by']}, not by {user}'s current key", 65)
        # Porelo names a task's principal by its project, or default for a task without one.
        named = fields["principals"]
        whole = len(named) == 1 and named[0].startswith("task:") and named[0].endswith(":" + task)
        project = named[0][len("task:") : -len(":" + task)] if whole else None
        if project is None or not (project == "default" or re.fullmatch(PROJECT, project)):
            refuse(f"the task certificate names not exactly one principal task:<project>:{task}", 65)
        if not (fields["valid_after"] is None or fields["valid_after"] <= now) or not now < fields["valid_before"]:
            refuse("the task certificate does not hold now", 65)
        if project != "default" and not any(m != HOST_ADMIN and m.split()[0] == project for m in records[user]["members"]):
            refuse(f"the task certificate names project {project}, of which {user} is no member here", 65)
        checked = self.check_task_certificate(user, task, line, key)
        if (checked.get("fingerprint"), checked.get("signed_by"), checked.get("project")) != (
            fields["fingerprint"], fields["signed_by"], project
        ):
            refuse("porelo task check-certificate answered for another certificate than the one given", 69)
        entry = {
            "task": task,
            "login": user,
            "fingerprint": fields["fingerprint"],
            "signed_by": fields["signed_by"],
            "key_id": fields["key_id"],
            "principals": fields["principals"],
            "valid_after": stamp(fields["valid_after"]),
            "valid_before": stamp(fields["valid_before"]),
            "certificate": line,
        }
        for login, other, recorded in self.task_records():
            if recorded["fingerprint"] == entry["fingerprint"] and (login, other) != (user, task):
                refuse(f"the task key {entry['fingerprint']} is recorded for another task", 65)
        config = self.forge_configuration(user)
        if config is not None:
            self.forge_endpoint()
        self.publish_task(user, task, entry)
        if config is None:
            return ""
        with self.forge_session(user) as (account, opener, base, token):
            self.forge_drop_named(opener, base, token, "porelo-" + user, {TASK_TOKEN + task})
            return self.forge_token(account, "porelo-" + user, TASK_SCOPES, TASK_TOKEN + task)

    def check_task_certificate(self, user, task, line, key):
        """Porelo's own judgement of the certificate against the person's key in force and the KRL, before a record."""
        temp_dir = self.sync_directory("task")
        try:
            staged = {"keys": temp_dir / "keys", "revoked.krl": temp_dir / "revoked.krl"}
            krl = self.path("/etc/ssh/porelo-revoked.krl")
            self.check(krl, 69, required=True)
            # Read by descriptor what was checked, so a link put there after the check is never followed.
            try:
                fd = os.open(krl, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            except OSError:
                refuse(f"cannot read {krl}", 69)
            try:
                status = os.fstat(fd)
                if not stat.S_ISREG(status.st_mode) or status.st_uid != self.owner or status.st_mode & 0o022:
                    refuse(f"{krl} is not a plain file of root's alone", 69)
                with os.fdopen(os.dup(fd), "rb") as source:
                    revocations = source.read()
            except OSError:
                refuse(f"cannot read {krl}", 69)
            finally:
                os.close(fd)
            try:
                self.write(staged["keys"], key + "\n", 0o600)
                flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
                with os.fdopen(os.open(staged["revoked.krl"], flags, 0o600), "wb") as sink:
                    os.fchown(sink.fileno(), self.owner, self.group)
                    os.fchmod(sink.fileno(), 0o600)
                    sink.write(revocations)
            except OSError:
                refuse("cannot stage the task check's keys and KRL in /run/porelo-host/sync", 73)
            unit = "porelo-host-task-check"
            credentials = f"/run/credentials/{unit}.service"
            arguments = [
                "task", "check-certificate", "--task", task, "--login", user,
                "--keys", f"{credentials}/keys", "--krl", f"{credentials}/revoked.krl", "--json",
            ]
            return self.isolated_porelo(
                unit,
                staged,
                arguments,
                "porelo task check-certificate",
                "porelo task check-certificate refused the task certificate",
                input=line + "\n",
            )
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)

    def publish_task(self, user, task, entry):
        """Record a task once with link(2), which fails on a name taken; the same certificate again is a retry."""
        directory = self.path(f"{TASKS}/{user}")
        self.directories(directory)
        self.task_directory()
        self.task_directory(user)
        target = directory / f"{task}.json"
        temporary = None
        try:
            fd, temporary = tempfile.mkstemp(prefix=".porelo-host-person.", dir=directory)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                os.fchown(stream.fileno(), self.owner, self.group)
                os.fchmod(stream.fileno(), 0o600)
                stream.write(json.dumps(entry, indent=1) + "\n")
                stream.flush()
                os.fsync(stream.fileno())
            try:
                os.link(temporary, target)
                return
            except FileExistsError:
                pass
        except OSError:
            refuse(f"cannot record task {task}", 73)
        finally:
            if temporary is not None:
                Path(temporary).unlink(missing_ok=True)
        if self.task_record(target, user, task)["certificate"] != entry["certificate"]:
            refuse(f"task {task} is recorded already, with another certificate", 65)

    def end_task(self, user, task, records):
        """Delete the ended task's gate token; its record stays."""
        self.person(user, records)
        target = self.task_directory() / user / f"{task}.json"
        self.task_directory(user)
        if not target.exists() and not target.is_symlink():
            refuse(f"task {task} is not recorded for {user}", 65)
        self.task_record(target, user, task)
        if self.forge_configuration(user) is not None:
            with self.forge_session(user) as (_, opener, base, token):
                self.forge_drop_named(opener, base, token, "porelo-" + user, {TASK_TOKEN + task})
        return {"task": task, "ended": True}

    def show_task(self, user, key, records):
        """The record of a task key, read-only, so a plain-key signature is traced after the task key is gone."""
        if user is not None:
            self.person(user, records)
        for _, _, entry in self.task_records():
            if entry["fingerprint"] == key:
                return entry
        refuse(f"no task certificate is recorded for {key}", 65)

    def push_signers(self, project):
        """The project's keys as Porelo gave them, each with its dates: persons' keys and task certifiers apart."""
        certifiers = self.path(f"/etc/porelo-host/signers/{project}.certifiers")
        self.check(certifiers, 69, required=True)
        return self.read(self.path(f"/etc/porelo-host/signers/{project}.allowed")), self.read(certifiers)

    def push_request(self, stream):
        """One push from the forge's hook: a request with its repository, quarantine and the hook's lines."""
        head = b""
        while b"\r\n\r\n" not in head:
            if len(head) > 16384:
                refuse("the hook sent no complete request", 64)
            chunk = stream.recv(4096)
            if not chunk:
                refuse("the hook sent no complete request", 64)
            head += chunk
        head, _, body = head.partition(b"\r\n\r\n")
        lines = head.decode("ascii", "replace").split("\r\n")
        if lines[0] != "POST /verify HTTP/1.1":
            refuse("the hook sent another request", 64)
        lengths = []
        for line in lines[1:]:
            name, separator, value = line.partition(":")
            name = name.strip().lower()
            if not separator or name == "transfer-encoding":
                refuse("the hook's request has a malformed or chunked header", 64)
            if name == "content-length":
                lengths.append(value.strip())
        if len(lengths) != 1 or not re.fullmatch(r"[0-9]{1,7}", lengths[0]) or not 0 < int(lengths[0]) <= MAX_PUSH:
            refuse(f"the hook's request is not 1 to {MAX_PUSH} bytes", 64)
        length = int(lengths[0])
        while len(body) < length:
            chunk = stream.recv(65536)
            if not chunk:
                refuse("the hook's request ended early", 64)
            body += chunk
        if len(body) != length:
            refuse("the hook's request is longer than it says", 64)
        try:
            text = body.decode("utf-8")
        except UnicodeError:
            refuse("the hook's request is not UTF-8", 64)
        fields, separator, updates = text.partition("\n\n")
        if not separator:
            refuse("the hook's request has no line between its fields and its updates", 64)
        values = {}
        for line in fields.split("\n"):
            key, _, value = line.partition(" ")
            if key not in ("repository", "quarantine", "objects", "alternates") or key in values:
                refuse("the hook's request names an unknown or repeated field", 64)
            values[key] = value
        if set(values) != {"repository", "quarantine", "objects", "alternates"}:
            refuse("the hook's request lacks a field", 64)
        update = rf"(?P<old>{COMMIT}) (?P<new>{COMMIT}) refs/[!-~]{{1,1000}}"
        lines = updates.split("\n")
        if lines[-1] == "":
            lines.pop()
        if not lines or len(lines) > 10000 or not all(re.fullmatch(update, line) for line in lines):
            refuse("the hook's updates are not 1 to 10000 lines <old> <new> <ref>", 64)
        deletions = all(set(line.split(" ")[1]) == {"0"} for line in lines)
        return values, "".join(line + "\n" for line in lines), deletions

    def push_repository(self, path):
        """The project and repository a container path names, both by their name rules alone."""
        match = re.fullmatch(
            FORGE_DATA + rf"git/repositories/(?P<project>{PROJECT})/(?P<repository>{REPOSITORY})\.git", path
        )
        if match is None:
            refuse("the hook names no repository of a project", 65)
        return match.group("project"), match.group("repository")

    def push_paths(self, values, account, entry):
        """Map the container's paths to the forge volume's on the host, each inside the pushed repository."""
        # Git names them through a "." segment (<repository>/./objects/…); dropping one never moves a path, ".." stays.
        values = {key: "/".join(part for part in value.split("/") if part != ".") for key, value in values.items()}
        inside = values["repository"]
        quarantine = values["quarantine"]
        if not re.fullmatch(re.escape(inside) + r"/objects/(tmp_objdir-)?incoming-[A-Za-z0-9]{1,64}", quarantine):
            refuse("the hook names no quarantine of this repository", 65)
        if values["objects"] != quarantine:
            refuse("the hook's object directory is not its quarantine", 65)
        if values["alternates"] != inside + "/objects":
            refuse("the hook's alternate objects are not this repository's", 65)
        home = str(self.path(entry.pw_dir))
        # The unit's properties split on spaces and colons; a home with either is never named to it.
        if not re.fullmatch(r"/[A-Za-z0-9._/-]{1,255}", home):
            refuse("the forge account's home cannot be named to a unit", 69)
        # Every directory from the forge's home to the quarantine is the forge's own and no link, so the unit
        # reads the push the hook named and nothing a link put in its place. Podman gives a volume's own directory to
        # the container's root, the first uid of the forge's subordinate range.
        owners = {entry.pw_uid} | {
            start for name, start, _ in self.subids("subuid") if name in (account, str(entry.pw_uid))
        }
        directory = Path(home)
        for part in (FORGE_VOLUME + quarantine.removeprefix(FORGE_DATA)).split("/"):
            directory = directory / part
            try:
                status = directory.lstat()
            except OSError:
                refuse(f"the push's directory {directory} is missing", 65)
            if not stat.S_ISDIR(status.st_mode) or status.st_uid not in owners:
                refuse(f"the push's directory {directory} is no directory of the forge's", 65)
        host = home + "/" + FORGE_VOLUME
        return {key: host + value.removeprefix(FORGE_DATA) for key, value in values.items()}

    def push_certificates(self, project):
        """The project's recorded task certificates valid now, one line each as task --show answers it."""
        now = self.now()
        lines = []
        for _, _, entry in self.task_records():
            after = certificate_time(str(entry.get("valid_after", "")).removesuffix("Z"))
            before = certificate_time(str(entry.get("valid_before", "")).removesuffix("Z"))
            principals = entry.get("principals") or []
            if after is None or before is None or not after <= now < before:
                continue
            if not all(isinstance(p, str) and p.startswith(f"task:{project}:") for p in principals) or not principals:
                continue
            lines.append(json.dumps(entry, separators=(",", ":")) + "\n")
        return "".join(lines)

    def arrivals_directory(self, project, create):
        """A project's verdict directory, root's and private; None when it is not there and not to be made."""
        for directory in (self.path(ARRIVALS), self.path(f"{ARRIVALS}/{project}")):
            self.check(directory, 73, directory=True, mode=0o700)
            if not directory.exists() and not directory.is_symlink():
                if not create:
                    return None
                self.directories(directory)
                self.check(directory, 73, required=True, directory=True, mode=0o700)
        return directory

    def arrivals_file(self, project, repository, create=True):
        """The repository's verdict record, root's and private; None when it is not there and not to be made."""
        directory = self.arrivals_directory(project, create)
        if directory is None:
            return None
        path = directory / f"{repository}.jsonl"
        self.check(path, 73, mode=0o600)
        return path

    def arrived_commits(self, path):
        """The commits a record names already, read under a shared lock; empty when there is no record."""
        try:
            descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        except FileNotFoundError:
            return "", set()
        except OSError:
            refuse(f"cannot read {path}", 73)
        with os.fdopen(descriptor, "r", encoding="utf-8", errors="replace") as source:
            fcntl.flock(source.fileno(), fcntl.LOCK_SH)
            status = os.fstat(source.fileno())
            if not stat.S_ISREG(status.st_mode) or status.st_uid != self.owner or stat.S_IMODE(status.st_mode) != 0o600:
                refuse(f"{path} is not root's alone", 73)
            text = source.read()
        commits = set()
        for line in text.splitlines():
            try:
                commits.add(json.loads(line).get("commit"))
            except (ValueError, AttributeError):
                refuse(f"{path} holds a malformed verdict", 73)
        return text, commits

    def record_arrivals(self, project, repository, entries):
        """Append verdicts once each, never rewriting what is there; a lock keeps two pushes' lines whole."""
        if not entries:
            return
        path = self.arrivals_file(project, repository)
        flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW
        try:
            descriptor = os.open(path, flags, 0o600)
        except OSError:
            refuse(f"cannot record arrivals in {path}", 73)
        with os.fdopen(descriptor, "ab") as sink:
            fcntl.flock(sink.fileno(), fcntl.LOCK_EX)
            if not stat.S_ISREG(os.fstat(sink.fileno()).st_mode) or os.fstat(sink.fileno()).st_uid != self.owner:
                refuse(f"{path} is not root's", 73)
            os.fchmod(sink.fileno(), 0o600)
            text = "".join(json.dumps(entry, separators=(",", ":")) + "\n" for entry in entries)
            os.write(sink.fileno(), text.encode("utf-8"))
            os.fsync(sink.fileno())

    def stage_krl(self, temp_dir):
        """Copy the KRL in force by one descriptor into the push's staging directory."""
        krl = self.path("/etc/ssh/porelo-revoked.krl")
        self.check(krl, 69, required=True)
        try:
            fd = os.open(krl, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        except OSError:
            refuse(f"cannot read {krl}", 69)
        try:
            status = os.fstat(fd)
            if not stat.S_ISREG(status.st_mode) or status.st_uid != self.owner or status.st_mode & 0o022:
                refuse(f"{krl} is not a plain file root's alone to write", 69)
            with os.fdopen(os.dup(fd), "rb") as source:
                revocations = source.read(MAX_CREDENTIAL + 1)
        except OSError:
            refuse(f"cannot read {krl}", 69)
        finally:
            os.close(fd)
        if len(revocations) > MAX_CREDENTIAL:
            refuse(f"{krl} is larger than a unit's credential", 69)
        staged = temp_dir / "revoked.krl"
        try:
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
            with os.fdopen(os.open(staged, flags, 0o600), "wb") as sink:
                os.fchown(sink.fileno(), self.owner, self.group)
                sink.write(revocations)
        except OSError:
            refuse("cannot stage the push's KRL in /run/porelo-host/push", 73)
        return staged

    def push_directory(self):
        """A fresh private directory of its own under /run/porelo-host/push; pushes run side by side."""
        push_root = self.path("/run/porelo-host/push")
        self.directories(push_root)
        self.check(push_root, 73, required=True, directory=True, mode=0o700)
        try:
            temp_dir = Path(tempfile.mkdtemp(prefix="push.", dir=push_root))
            os.chown(temp_dir, self.owner, self.group)
            temp_dir.chmod(0o700)
        except OSError:
            refuse("cannot create a private push directory under /run/porelo-host/push", 73)
        return temp_dir

    def verify_push(self, stream, peer_uid):
        """Judge one push for the forge's hook with Porelo's commit verify; answer the hook in HTTP, fail closed."""
        account = self.setting("/etc/porelo-host/forge.conf", "account")
        if not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", account):
            refuse("forge.conf names no valid account", 69)
        entry = self.account(account)
        if peer_uid != entry.pw_uid:
            refuse("only the forge's own hook asks for a push to be judged", 65)
        values, updates, deletions = self.push_request(stream)
        project, repository = self.push_repository(values["repository"])
        self.project_record(project)
        if deletions:
            # A push that only deletes refs brings no commit and no quarantine: nothing to judge or record.
            return 200, "porelo: the push brings no new commit\n"
        host = self.push_paths(values, account, entry)
        self.require(["systemd-run", "porelo"])
        signers, certifiers = self.push_signers(project)
        texts = {"signers": signers, "certifiers": certifiers, "certificates": self.push_certificates(project)}
        if any(len(text.encode("utf-8")) > MAX_CREDENTIAL for text in texts.values()):
            refuse("the push's signers or certificates are larger than a unit's credential", 69)
        temp_dir = self.push_directory()
        try:
            staged = {}
            for name, text in texts.items():
                staged[name] = temp_dir / name
                self.write(staged[name], text, 0o600)
            staged["revoked.krl"] = self.stage_krl(temp_dir)
            unit = f"porelo-host-push-{uuid.uuid4().hex[:16]}"
            credentials = f"/run/credentials/{unit}.service"
            command = [
                "systemd-run",
                "--pipe",
                "--wait",
                "--quiet",
                "--collect",
                f"--unit={unit}",
                "-p",
                f"User={account}",
                "-p",
                "PrivateNetwork=yes",
                "-p",
                "PrivateTmp=yes",
                "-p",
                "ProtectHome=tmpfs",
                "-p",
                "ProtectSystem=strict",
                "-p",
                "NoNewPrivileges=yes",
                "-p",
                f"RuntimeMaxSec={VERIFY_TIMEOUT - 10}",
                "-p",
                f"BindReadOnlyPaths={host['repository']}",
                "-p",
                "Environment=HOME=/tmp",
                "-p",
                f"Environment=GIT_QUARANTINE_PATH={host['quarantine']}",
                "-p",
                f"Environment=GIT_OBJECT_DIRECTORY={host['objects']}",
                "-p",
                f"Environment=GIT_ALTERNATE_OBJECT_DIRECTORIES={host['alternates']}",
            ]
            for name, path in staged.items():
                command.extend(["-p", f"LoadCredential={name}:{path}"])
            command += [
                "porelo",
                "commit",
                "verify",
                "--repository",
                host["repository"],
                "--signers",
                f"{credentials}/signers",
                "--certifiers",
                f"{credentials}/certifiers",
                "--krl",
                f"{credentials}/revoked.krl",
                "--certificates",
                f"{credentials}/certificates",
                "--json",
            ]
            try:
                result = self.runner(command, input=updates, timeout=VERIFY_TIMEOUT)
            except (OSError, subprocess.TimeoutExpired, UnicodeError):
                refuse("porelo commit verify could not run", 69)
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)
        if result.returncode == 65:
            lines = [line for line in (result.stderr or "").splitlines() if re.fullmatch(r"[ -~]{1,512}", line)]
            return 403, "".join(f"porelo: {line}\n" for line in lines[:100]) or "porelo: the push is refused\n"
        try:
            verdict = json.loads(result.stdout) if result.returncode == 0 else None
        except (ValueError, UnicodeError):
            verdict = None
        commits = verdict.get("commits") if isinstance(verdict, dict) and verdict.get("accepted") is True else None
        checked = verdict.get("checked_at") if isinstance(verdict, dict) else None
        if (
            not isinstance(commits, list)
            or not isinstance(checked, str)
            or not checked.endswith("Z")
            or certificate_time(checked.removesuffix("Z")) is None
        ):
            return 500, "porelo: the host could not judge this push\n"
        entries = []
        for item in commits:
            signer = item.get("signer") if isinstance(item, dict) else None
            if (
                not isinstance(item, dict)
                or item.get("verdict") != "accepted"
                or not isinstance(item.get("commit"), str)
                or not re.fullmatch(COMMIT, item["commit"])
                or not isinstance(signer, dict)
                or not isinstance(signer.get("fingerprint"), str)
                or not re.fullmatch(FINGERPRINT, signer["fingerprint"])
            ):
                return 500, "porelo: the host could not judge this push\n"
            entries.append(
                {
                    "commit": item["commit"],
                    "ref": item.get("ref"),
                    "verdict": "accepted",
                    "arrived": verdict["checked_at"],
                    "signer": item["signer"],
                }
            )
        # Forgejo's own hook runs before this one, and the push can still fail after both: a verdict records what
        # Porelo accepted when it arrived, not that the forge kept it.
        self.record_arrivals(project, repository, entries)
        return 200, f"porelo: {len(entries)} new commit(s) judged and recorded\n"

    def serve_push(self, stream):
        """Answer the hook in HTTP: 200 accepted, 403 refused with Porelo's lines, anything else refuses too."""
        try:
            # A hook that stops sending holds no judge longer than this, for each read of its request.
            stream.settimeout(30)
            peer = stream.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
            conf = self.path("/etc/porelo-host/forge.conf")
            self.check(conf, required=True)
            # Shared with other pushes, apart from a sync or a removal holding the lock alone.
            with conf.open("rb") as mutex:
                fcntl.flock(mutex, fcntl.LOCK_SH)
                code, text = self.verify_push(stream, int.from_bytes(peer[4:8], sys.byteorder))
        except Refusal as error:
            code, text = 403 if error.code in (64, 65) else 500, f"porelo: {error}\n"
        except OSError:
            code, text = 500, "porelo: the hook's request could not be read\n"
        reason = {200: "OK", 403: "Forbidden", 500: "Internal Server Error"}[code]
        body = text.encode("utf-8", "replace")
        try:
            stream.sendall(
                f"HTTP/1.1 {code} {reason}\r\nContent-Type: text/plain\r\nContent-Length: {len(body)}\r\n"
                "Connection: close\r\n\r\n".encode("ascii") + body
            )
        except OSError:
            pass
        return ""

    def arm_pushes(self, project):
        """Arm every repository of the project's organization; the history of one not yet recorded is migrated."""
        account = self.setting("/etc/porelo-host/forge.conf", "account")
        if not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", account):
            refuse("forge.conf names no valid account", 69)
        directory = self.arrivals_directory(project, create=False)
        recorded = set()
        for path in [] if directory is None else sorted(directory.iterdir()):
            if not re.fullmatch(REPOSITORY + r"\.jsonl", path.name):
                refuse(f"{directory} holds an unknown entry", 73)
            self.check(path, 73, required=True, mode=0o600)
            text, _ = self.arrived_commits(path)
            if any(json.loads(line).get("verdict") == "armed" for line in text.splitlines()):
                recorded.add(path.name.removesuffix(".jsonl"))
        # The hook is linked before the history is listed, so a commit pushed meanwhile is judged and also listed;
        # root records it once. A repository whose history root has not recorded is listed at each sync until it is.
        # A link that names no executable hook would let Forgejo skip it, so the arming stops instead.
        script = (
            # Forgejo makes the repositories root with its first repository: a fresh forge has nothing to arm.
            "[ -e /var/lib/gitea/git/repositories ] || [ -L /var/lib/gitea/git/repositories ] || exit 0\n"
            "[ -d /var/lib/gitea/git/repositories ] && [ ! -L /var/lib/gitea/git/repositories ] || exit 6\n"
            'organization="/var/lib/gitea/git/repositories/$1"\n'
            '[ -e "$organization" ] || [ -L "$organization" ] || exit 0\n'
            '[ -d "$organization" ] && [ ! -L "$organization" ] && cd "$organization" || exit 6\n'
            # Forgejo 17 keeps no hooks in a repository: its git's core.hooksPath names one shared directory, whose
            # pre-receive runs Forgejo's own check first and then each repository's hooks/pre-receive.d, the judge's.
            'hooks="$(git config --file /var/lib/gitea/home/.gitconfig core.hooksPath)" && [ -n "$hooks" ] || exit 4\n'
            '[ -f "$hooks/pre-receive" ] && [ -x "$hooks/pre-receive" ] || exit 4\n'
            "grep -qxF 'custom_hooks_dir=\"./hooks/${hookname}.d\"' \"$hooks/pre-receive\" || exit 4\n"
            "shift\n"
            "for repository in *.git .*.git; do\n"
            '  [ -d "$repository" ] && [ ! -L "$repository" ] || continue\n'
            '  [ ! -L "$repository/hooks" ] && [ ! -L "$repository/hooks/pre-receive.d" ] || exit 5\n'
            # A repository's own core.hooksPath would pass by the shared directory, and the judge with it.
            '  git config --file "$repository/config" --get core.hooksPath > /dev/null; [ "$?" -eq 1 ] || exit 4\n'
            '  hook="$repository/hooks/pre-receive.d/porelo"\n'
            '  if [ ! -e "$hook" ] && [ ! -L "$hook" ]; then\n'
            '    mkdir -p "$repository/hooks/pre-receive.d" || exit 5\n'
            f'    ln -s {PUSH_HOOK} "$hook" || exit 5\n'
            "  fi\n"
            f'  [ -L "$hook" ] && [ "$(readlink "$hook")" = {PUSH_HOOK} ] && [ -x "$hook" ] || exit 5\n'
            '  name="${repository%.git}"\n'
            '  for known in "$@"; do [ "$known" = "$name" ] && continue 2; done\n'
            '  printf "repository %s\\n" "$name"\n'
            '  git --git-dir="$repository" rev-list --all || exit 3\n'
            "done\n"
        )
        found = self.as_account(
            account, ["podman", "exec", "forgejo", "sh", "-c", script, "sh", project, *sorted(recorded)], accepted=(0, 4)
        )
        if found.returncode == 4:
            refuse(f"Forgejo's shared pre-receive hook would not run the judge for a repository of {project}", 69)
        found = found.stdout
        migrated, current = {}, None
        for line in found.splitlines():
            if line.startswith("repository "):
                current = line.removeprefix("repository ")
                if not re.fullmatch(REPOSITORY, current) or current in migrated or current in recorded:
                    refuse("the forge lists an invalid repository", 69)
                migrated[current] = []
            elif current is not None and re.fullmatch(COMMIT, line):
                migrated[current].append(line)
            else:
                refuse("the forge lists an invalid repository history", 69)
        stamp_now = stamp(self.now())
        for repository, commits in migrated.items():
            path = self.arrivals_file(project, repository)
            _, known = self.arrived_commits(path)
            self.record_arrivals(
                project,
                repository,
                [
                    *(
                        {"commit": commit, "verdict": "migrated", "arrived": stamp_now}
                        for commit in dict.fromkeys(commits)
                        if commit not in known
                    ),
                    {"verdict": "armed", "arrived": stamp_now},
                ],
            )
        return sorted(migrated)

    def show_arrivals(self, user, project, repository, records):
        """A repository's verdicts, read-only, to root or a person of its project."""
        if user is not None:
            record = self.person(user, records)
            if not any(m != HOST_ADMIN and m.split()[0] == project for m in record["members"]):
                refuse(f"{user} is no member of project {project}", 65)
        path = self.arrivals_file(project, repository, create=False)
        return "" if path is None else self.arrived_commits(path)[0]

    def sweep(self, records):
        """Delete every task token whose recorded certificate has ended; one person's failure stops no other."""
        if self.sudo_user is not None:
            refuse("the sweep is root's alone, from its timer", 65)
        errors = [str(error) for error in self.retry_locks(records)]
        now = self.now()
        due = {}
        for login, task, entry in self.task_records():
            record = records.get(login)
            ended = certificate_time(entry["valid_before"].removesuffix("Z")) <= now
            if ended and record is not None and (not record["locked"] or record.get("lock") == "pending"):
                due.setdefault(login, set()).add(TASK_TOKEN + task)
        if not due or self.forge_configuration(min(due)) is None:
            if errors:
                refuse("unfinished host revocation: " + "; ".join(errors), 69)
            return {"swept": []}
        swept = []
        with self.forge_session(min(due)) as (_, opener, base, token):
            for login in sorted(due):
                try:
                    dropped = self.forge_drop_named(opener, base, token, "porelo-" + login, due[login])
                    swept.extend(f"{login}/{name.removeprefix(TASK_TOKEN)}" for name in dropped)
                except Refusal as error:
                    errors.append(f"{login}: {error}")
        if errors:
            refuse(f"the sweep deleted {', '.join(sorted(swept)) or 'nothing'}; it failed for " + "; ".join(errors), 69)
        return {"swept": sorted(swept)}

    def person_forge_token(self, user, records):
        """The person's one forge token, made anew in place of every other of their login, answered alone."""
        self.person(user, records)
        if self.revoked(user):
            refuse(f"the host's organization names {user} revoked", 65)
        config = self.forge_configuration(user)
        if config is None:
            refuse("the host runs no forge, so there is no forge token to make", 69)
        with self.forge_session(user) as (account, opener, base, token):
            self.forge_drop_named(opener, base, token, user)
            return self.forge_token(account, user, PERSON_SCOPES)

    def tasks_verb(self, verb, value, data):
        """forge-token, task, task --end, task --show and sweep: they read the people records alone."""
        records = self.records()
        if verb == "sweep":
            return self.sweep(records)
        if verb == "show":
            return self.show_task(self.sudo_user, value, records)
        if not self.sudo_user:
            refuse(f"{verb} runs through sudo, for the person who calls it", 64)
        if verb == "forge-token":
            return self.person_forge_token(self.sudo_user, records)
        if verb == "end":
            return self.end_task(self.sudo_user, value, records)
        return self.start_task(self.sudo_user, value, data, records)

    def execute(self, arguments, data):
        """Validate the complete request under the configuration lock before applying it."""
        if self.euid != 0:
            refuse("runs only as root", 69)
        if arguments == ["verify-push"]:
            # The forge's hook connects through a socket unit; that socket is this call's stdin and stdout.
            if self.sudo_user is not None:
                refuse("verify-push is the forge hook's socket unit's alone", 65)
            return self.serve_push(data if data is not None else socket.socket(fileno=0))
        if len(arguments) == 3 and arguments[0] == "arrivals":
            project, repository = arguments[1:]
            if not re.fullmatch(PROJECT, project) or not re.fullmatch(REPOSITORY, repository):
                refuse("arrivals takes a project and one of its repositories")
            conf = self.path("/etc/porelo-host/forge.conf")
            self.check(conf, required=True)
            # Shared, so a lock, a removal or a sync is never read half done.
            with conf.open("rb") as mutex:
                fcntl.flock(mutex, fcntl.LOCK_SH)
                return self.show_arrivals(self.sudo_user, project, repository, self.records())
        if arguments == ["org", "status"]:
            # Read-only, for the interface over root's SSH; a person's sudo reaches none of it.
            if self.sudo_user is not None:
                refuse("org status is root's alone and never runs through sudo", 65)
            conf = self.path("/etc/porelo-host/forge.conf")
            self.check(conf, required=True)
            with conf.open("rb") as mutex:
                fcntl.flock(mutex, fcntl.LOCK_SH)
                return self.org_status()
        if arguments == ["restore-runtime"]:
            changed = 0
            conf = self.path("/etc/porelo-host/forge.conf")
            self.check(conf, required=True)
            with conf.open("rb") as mutex:
                fcntl.flock(mutex, fcntl.LOCK_EX)
                for login, record in self.records().items():
                    if record["members"] and not record["locked"] and record.get("lock") != "pending":
                        changed += self.admit_runtime(login)
            return {"changed": changed}
        user = None
        if arguments in (["org", "follow"], ["org", "refresh"], ["org", "renew-pin"]):
            verb, value = arguments[1], None
            if self.sudo_user is not None:
                refuse(f"org {verb} is root's alone and never runs through sudo", 65)
            if verb in ("refresh", "renew-pin"):
                value = sys.stdin.buffer.read(TOKEN_LIMIT + 1) if data is None else data
        elif len(arguments) == 2 and arguments[0] == "purge":
            verb, user = arguments
        elif arguments in (["forge-token"], ["sweep"]):
            verb, value = arguments[0], None
        elif len(arguments) in (2, 3) and arguments[0] == "task" and arguments[1:-1] in ([], ["--end"], ["--show"]):
            verb, value = {(): "task", ("--end",): "end", ("--show",): "show"}[tuple(arguments[1:-1])], arguments[-1]
            if not re.fullmatch(FINGERPRINT if verb == "show" else TASK, value):
                refuse("a task must match [a-z0-9][a-z0-9._-]{0,63}, a task key's fingerprint SHA256:<43 base64>")
        else:
            refuse(
                "use purge <user>,"
                " org follow, org refresh, org renew-pin, org status, forge-token, task <task>, task --end <task>,"
                " task --show <fingerprint>, arrivals <project> <repository>, verify-push"
                " or sweep"
            )
        if user is not None and not re.fullmatch(USER, user):
            refuse("the person name must match [a-z][a-z0-9-]{0,30}")
        conf = self.path("/etc/porelo-host/forge.conf")
        self.check(conf, required=True)
        with conf.open("rb") as mutex:
            fcntl.flock(mutex, fcntl.LOCK_EX)
            self.project_lock_fd = mutex.fileno()
            if verb == "refresh":
                return self.refresh(value)
            if verb == "follow":
                return self.follow()
            if verb == "renew-pin":
                return self.renew_pin(value)
            if verb in ("forge-token", "sweep", "task", "end", "show"):
                return self.tasks_verb(verb, value, data)
            records = self.records()
            accounts = (
                self.accounts
                if self.accounts is not None
                else {entry.pw_name: entry.pw_uid for entry in pwd.getpwall()}
            )
            uid = accounts.get(user)
            if user == "root" or (uid is not None and (uid < self.uid_min() or user not in records)):
                refuse("the name belongs to root, a system account or an account outside the people records", 65)
            record = records.get(user)
            if record is None:
                refuse("the person is unknown to the people records", 65)
            if record.get("lock") == "pending":
                self.lock(user, record, None)
            porelo = self.available("porelo")
            programs = ["gpasswd"] + ([] if uid is None else ["loginctl", "usermod", "systemctl"])
            if porelo and uid is not None:
                programs.extend(["runuser", "env", "usermod", "systemctl"])
            self.subids("subuid")
            self.subids("subgid")
            for kind in ("subuid", "subgid"):
                self.check(self.path("/etc/" + kind), 73, required=True)
            if uid is not None:
                programs.extend(["loginctl", "systemctl", "userdel"])
            self.require(programs)
            self.purge(user, record, porelo, uid is not None)
            return {"person": user, "purged": True}


def entry(host, arguments, data=None):
    """Turn every expected refusal into one safe diagnostic and the contract's exit code."""
    try:
        answer = host.execute(arguments, data)
    except Refusal as error:
        print(f"porelo-host-person: {error}", file=sys.stderr)
        return error.code
    except OSError:
        print("porelo-host-person: cannot read or change the host's files", file=sys.stderr)
        return 73
    # A token is answered alone, no newline, for its caller's pipe; every other answer is one JSON line.
    if isinstance(answer, str):
        sys.stdout.write(answer)
        sys.stdout.flush()
        return 0
    print(json.dumps(answer, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    if os.geteuid() != 0:
        print("porelo-host-person: runs only as root", file=sys.stderr)
        sys.exit(69)
    sudo_user = os.environ.get("SUDO_USER")
    os.environ.clear()
    os.environ.update(ENV)
    host = Host()
    host.sudo_user = sudo_user
    sys.exit(entry(host, sys.argv[1:]))
else:

    def _test_entry(root, runner, *, euid, owner, accounts, groups, commands, hooks=None, sudo_user=None):
        """Import-only injection; there is no production argument or environment switch to reach it."""
        host = Host()
        host.root, host.runner, host.euid = root, runner, euid
        host.sudo_user = sudo_user
        host.owner, host.group = owner, os.getgid()
        host.accounts, host.groups, host.commands = accounts, groups, commands
        if hooks is not None:
            host.hooks = hooks
        return lambda arguments, data: entry(host, arguments, data)
