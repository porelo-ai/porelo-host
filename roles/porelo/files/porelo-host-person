class Host:
    """Root's paths and system operations, with no production configuration overrides."""

    def __init__(self):
        """Use root's fixed paths, the real identity and the single system command runner."""
        self.root = Path("/")
        self.euid = os.geteuid()
        self.owner, self.group = 0, 0
        self.runner = run_command
        self.accounts = None
        self.groups = None
        self.commands = None
        self.hooks = {
            name: getattr(self, name) for name in ("forge_admit", "matrix_issue", "forge_lock", "matrix_expel_revoke")
        }

    def path(self, name):
        """An absolute host path, rooted elsewhere only through the import-only test hook."""
        return self.root / name.lstrip("/")

    def check(self, path, code=69, required=False, directory=False, mode=None):
        """Reject links, wrong owners and writable ancestors before reading or changing a path."""
        if path != self.root:
            self.check(path.parent, code, directory=True)
        try:
            status = path.lstat()
        except FileNotFoundError:
            if required:
                refuse(f"{path} is missing; prepare the host first", code)
            return
        except OSError:
            refuse(f"cannot inspect {path}", code)
        correct_type = stat.S_ISDIR(status.st_mode) if directory else stat.S_ISREG(status.st_mode)
        if (
            not correct_type
            or status.st_uid != self.owner
            or status.st_mode & 0o022
            or (mode is not None and stat.S_IMODE(status.st_mode) != mode)
        ):
            refuse(f"{path} is not a {'directory' if directory else 'plain file'} of root's alone", code)

    def read(self, path):
        """Read trusted UTF-8 without exposing bad content in the error."""
        self.check(path, required=True)
        try:
            return path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            refuse(f"cannot read {path}", 69)

    def setting(self, name, key):
        """Read one unambiguous setting from root's own configuration."""
        values = [
            line.partition("=")[2] for line in self.read(self.path(name)).splitlines() if line.startswith(key + "=")
        ]
        if len(values) != 1:
            refuse(f"{name} names no single valid {key}", 69)
        return values[0]

    def network(self):
        """The host's /24 and its host admin reservation come from the prepared host."""
        host = ipv4(self.setting("/etc/porelo-host/forge.conf", "address"), 69)
        if not re.fullmatch(r"10\.73\.[0-9]{1,3}\.1", str(host)):
            refuse("forge.conf names no host VPN address at 10.73.<n>.1", 69)
        network = ipaddress.IPv4Network(f"{host}/24", strict=False)
        admin = ipv4(self.setting("/etc/porelo-host/vpn.conf", "admin_address"), 69)
        if admin not in network or admin in (host, network.network_address, network.broadcast_address):
            refuse("vpn.conf names no usable admin_address in the host network", 69)
        return network, {str(host), str(admin), str(network.network_address), str(network.broadcast_address)}

    def records(self):
        """Read all people before allocation; corrupt or unsafe records stop every change."""
        directory = self.path("/etc/porelo-host/people")
        self.check(directory, directory=True, mode=0o700)
        records = {}
        if not directory.exists():
            return records
        for path in sorted(directory.iterdir()):
            if not path.name.endswith(".conf") or not re.fullmatch(USER, path.stem):
                refuse("the people directory holds an unknown record", 65)
            self.check(path, required=True, mode=0o600)
            lines = self.read(path).splitlines()
            if (
                len(lines) < 4
                or lines[0] != "role=project-admin"
                or lines[1] != "projects="
                or lines[2] not in ("locked=false", "locked=true")
                or any(not line.startswith("laptop=") for line in lines[3:])
            ):
                refuse(f"the record for {path.stem} is malformed or unsupported", 65)
            laptops = key_block(("\n".join(line[7:] for line in lines[3:]) + "\n").encode(), 65, True)
            records[path.stem] = {"locked": lines[2] == "locked=true", "laptops": laptops}
        return records

    def credentials(self, records, network, reserved):
        """A complete reference set of occupied addresses and keys, including locked people."""
        addresses, ssh_keys, wg_keys = set(reserved), set(), set()
        for record in records.values():
            for item in record["laptops"]:
                address = item["address"]
                if (
                    ipv4(address, 65) not in network
                    or address in addresses
                    or item["ssh"] in ssh_keys
                    or item["wg"] in wg_keys
                ):
                    refuse("the people records hold conflicting keys or VPN addresses", 65)
                addresses.add(address)
                ssh_keys.add(item["ssh"])
                wg_keys.add(item["wg"])
        return addresses, ssh_keys, wg_keys

    def allocate(self, laptops, records, network, reserved):
        """Reserve explicit requests first, then take the lowest remaining usable address."""
        addresses, ssh_keys, wg_keys = self.credentials(records, network, reserved)
        for item in laptops:
            if item["ssh"] in ssh_keys or item["wg"] in wg_keys:
                refuse("a public key belongs to a recorded laptop", 65)
            if item["address"] is not None:
                if ipv4(item["address"], 64) not in network or item["address"] in addresses:
                    refuse("a requested VPN address is outside the network or already reserved", 65)
                addresses.add(item["address"])
        for item in laptops:
            if item["address"] is None:
                item["address"] = next(
                    (str(address) for address in network.hosts() if str(address) not in addresses), None
                )
                if item["address"] is None:
                    refuse("the host VPN network has no free laptop address", 65)
                addresses.add(item["address"])
        return laptops

    def available(self, program):
        """Find a command only on the fixed path, refusing executable paths writable by another account."""
        if self.commands is not None:
            return program in self.commands
        found = shutil.which(program, path=ENV["PATH"])
        if found is None:
            return False
        self.check(Path(os.path.realpath(found)), required=True)
        return True

    def require(self, programs):
        """Resolve every required dependency before any write or command."""
        for program in programs:
            if not self.available(program):
                refuse(f"{program} is missing from the fixed PATH", 69)

    def command(self, arguments, required=True, input=None, accepted=(0,)):
        """Report only the program and exit status; never relay stdout, stderr or key arguments."""
        try:
            result = self.runner(arguments) if input is None else self.runner(arguments, input=input)
            if result.returncode in accepted:
                return result
            message = f"{arguments[0]} failed (exit {result.returncode})"
        except (OSError, subprocess.TimeoutExpired, UnicodeError) as error:
            message = f"{arguments[0]} failed to complete ({type(error).__name__})"
        if required:
            refuse(message, 69)
        print(f"porelo-host-person: task stop for the person failed: {message}; lock continues", file=sys.stderr)
        return False

    def account(self, user):
        """Resolve a non-root service or person account without trusting caller-supplied IDs or homes."""
        try:
            entry = pwd.getpwnam(user)
        except KeyError:
            refuse("a required service or person account is missing", 69)
        home = entry.pw_dir
        if entry.pw_uid == 0 or not home.startswith("/") or str(Path(home)) != home or ".." in Path(home).parts:
            refuse("a required account is root or has no usable absolute home", 69)
        return entry

    def porelo(self, user, *arguments):
        """Porelo as the person, with their own user manager's runtime, which rootless podman needs."""
        return ["runuser", "-u", user, "--", "env", f"XDG_RUNTIME_DIR=/run/user/{self.uid(user)}", "porelo", *arguments]

    def uid(self, user):
        """The person's uid, from the accounts this call read."""
        return self.accounts[user] if self.accounts is not None else pwd.getpwnam(user).pw_uid

    def as_account(self, user, arguments, **kwargs):
        """Pass credentials on stdin only, with a fixed runtime and the account's own home."""
        entry = self.account(user)
        return self.command(
            [
                "runuser", "-u", user, "--", "env", f"HOME={entry.pw_dir}",
                f"XDG_RUNTIME_DIR=/run/user/{entry.pw_uid}", *arguments,
            ],
            **kwargs,
        )

    def forge_configuration(self, user):
        """An absent/empty account switches the forge off; an enabled forge requires agents=."""
        path = self.path("/etc/porelo-host/forge.conf")
        self.check(path)
        if not path.exists():
            return None
        accounts = [line[8:] for line in self.read(path).splitlines() if line.startswith("account=")]
        if not accounts or accounts == [""]:
            return None
        if len(accounts) != 1 or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", accounts[0]):
            refuse("forge.conf names no single valid account", 69)
        agents = self.setting("/etc/porelo-host/forge.conf", "agents")
        agents = agents.split(",") if agents else []
        if any(not re.fullmatch(USER, agent) for agent in agents):
            refuse("forge.conf names no valid agent list", 69)
        identities = [user, "porelo-" + user] + [agent + "-" + user for agent in agents]
        if len(set(identities)) != len(identities):
            refuse("forge.conf repeats an identity", 69)
        self.account(accounts[0])
        self.require(["runuser", "podman"])
        return accounts[0], identities

    def forge_command(self, account, arguments):
        """Run Forgejo's admin command as its rootless container account."""
        return self.as_account(account, ["podman", "exec", "forgejo", "forgejo", "admin", "user", *arguments])

    def forge_token(self, account, user, scopes):
        """Capture a generated token in memory without ever relaying the command's output."""
        result = self.forge_command(
            account,
            [
                "generate-access-token", "--username", user, "--token-name",
                "porelo-host-person-" + uuid.uuid4().hex, "--scopes", scopes, "--raw",
            ],
        )
        token = result.stdout.strip()
        if not re.fullmatch(r"[0-9a-f]{40}", token):
            refuse("Forgejo made no valid access token", 69)
        return token

    def forge_tokens_directory(self, user, private=True):
        """Refuse a linked delivery directory or one owned by another account."""
        directory = self.path(f"/run/porelo-host/people/{user}")
        self.check(directory.parent, 73, directory=True)
        try:
            status = directory.lstat()
        except FileNotFoundError:
            return directory
        if (
            not stat.S_ISDIR(status.st_mode)
            or status.st_uid != self.account(user).pw_uid
            or (private and stat.S_IMODE(status.st_mode) != 0o700)
        ):
            refuse("the forge token delivery directory is not a private directory of the person's", 73)
        return directory

    def forge_tokens_path(self, user, private=True):
        """Validate the person's delivery directory and any existing private token file."""
        path = self.forge_tokens_directory(user, private) / "identities.tokens"
        if private and (path.exists() or path.is_symlink()):
            entry, status = self.account(user), path.lstat()
            if not stat.S_ISREG(status.st_mode) or status.st_uid != entry.pw_uid or stat.S_IMODE(status.st_mode) != 0o600:
                refuse("the person's forge token delivery file is not private and plain", 73)
        return path

    def remove_forge_tokens(self, user):
        """Remove only this person's delivery directory, never following links in its writable contents."""
        directory = self.forge_tokens_directory(user, private=False)
        if directory.exists():
            if not shutil.rmtree.avoids_symlink_attacks:
                refuse("safe removal of the forge token delivery directory is unavailable", 69)
            try:
                shutil.rmtree(directory)
            except OSError:
                refuse("cannot remove the person's forge token delivery directory; it remains for retry", 73)

    def forge_domain(self):
        """Validate the email domain before it reaches Forgejo's account creation command."""
        domain = self.setting("/etc/porelo-host/forge.conf", "name")
        if not re.fullmatch(r"[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?", domain):
            refuse("forge.conf names no valid name", 69)
        return domain

    def forge_endpoint(self):
        """Validate the fixed API endpoint and its trusted CA before revocation starts."""
        address = str(ipv4(self.setting("/etc/porelo-host/forge.conf", "address"), 69))
        port = self.setting("/etc/porelo-host/forge.conf", "port")
        if not re.fullmatch(r"[1-9][0-9]{0,4}", port) or int(port) > 65535:
            refuse("forge.conf names no valid port", 69)
        ca = self.path("/etc/porelo-host/forge/ca.pem")
        self.check(ca, required=True)
        return f"https://{address}:{port}/api/v1/admin/users/", ca

    def prepare_services(self, user, verb):
        """Validate real hooks' settings, root paths and programs before changing host access."""
        forge = "forge_admit" if verb == "add" else "forge_lock"
        matrix = "matrix_issue" if verb == "add" else "matrix_expel_revoke"
        if self.hooks[forge] == getattr(self, forge):
            config = self.forge_configuration(user)
            if config is not None or verb != "add":
                self.forge_tokens_path(user, private=verb == "add")
            if config is not None:
                if verb == "add":
                    self.forge_domain()
                else:
                    self.forge_endpoint()
        if self.hooks[matrix] == getattr(self, matrix):
            self.matrix_context(user)

    def forge_admit(self, user, laptops):
        """Make only missing identities and deliver their credentials for the person's own vault import."""
        config = self.forge_configuration(user)
        if config is None:
            return
        account, identities = config
        path = self.forge_tokens_path(user)
        domain = self.forge_domain()
        lines = self.forge_command(account, ["list"]).stdout.splitlines()
        if not lines or not re.match(r"ID\s+Username\s+Email\b", lines[0]):
            refuse("Forgejo answered no valid user list", 69)
        users = set()
        for line in lines[1:]:
            fields = line.split()
            if len(fields) < 3 or not fields[0].isdigit():
                refuse("Forgejo answered no valid user list", 69)
            users.add(fields[1])
        tokens = []
        for identity in identities:
            if identity in users:
                continue
            self.forge_command(
                account,
                ["create", "--username", identity, "--email", identity + "@" + domain,
                 "--random-password", "--must-change-password=false"],
            )
            scopes = "write:repository,read:organization"
            if identity not in (user, "porelo-" + user):
                scopes += ",read:package"
            tokens.append(identity + " " + self.forge_token(account, identity, scopes) + "\n")
        if tokens:
            entry = self.account(user)
            self.directories(path.parent.parent)
            for directory in (path.parent.parent.parent, path.parent.parent):
                self.check(directory, 73, required=True, directory=True)
                directory.chmod(0o755)
            if not path.parent.exists():
                path.parent.mkdir(mode=0o700)
                os.chown(path.parent, entry.pw_uid, entry.pw_gid)
                path.parent.chmod(0o700)
            self.write(path, "".join(tokens), 0o600, owner=entry.pw_uid, group=entry.pw_gid)

    def forge_api(self, opener, base, token, method, route, expected, body=None):
        """Refuse HTTP and TLS failures without printing a header, credential or response body."""
        request = urllib.request.Request(
            base + route,
            method=method,
            data=None if body is None else json.dumps(body).encode(),
            headers={"Authorization": "token " + token, "Content-Type": "application/json"},
        )
        try:
            with opener.open(request, timeout=30) as answer:
                if answer.status != expected:
                    refuse(f"Forgejo admin API answered HTTP {answer.status}", 69)
                return None if expected == 204 else json.load(answer)
        except urllib.error.HTTPError as error:
            refuse(f"Forgejo admin API answered HTTP {error.code}", 69)
        except (OSError, urllib.error.URLError, http.client.HTTPException, ValueError, UnicodeError):
            refuse("Forgejo admin API did not answer valid JSON over trusted TLS", 69)

    def forge_lock(self, user):
        """Prohibit all the person's logins and delete every token, including tokens outside delivery."""
        config = self.forge_configuration(user)
        self.forge_tokens_directory(user, private=False)
        errors = []
        try:
            self.remove_forge_tokens(user)
        except Refusal as error:
            errors.append(error)
        if config is None:
            if errors:
                raise errors[0]
            return
        account, identities = config
        base, ca = self.forge_endpoint()
        try:
            opener = urllib.request.build_opener(
                urllib.request.ProxyHandler({}),
                NoRedirect(),
                urllib.request.HTTPSHandler(context=ssl.create_default_context(cafile=str(ca))),
            )
        except (OSError, ValueError):
            refuse("the forge CA cannot be loaded", 69)
        token = self.forge_token(account, "porelo-admin", "write:admin")
        for identity in identities:
            try:
                self.forge_revoke_identity(opener, base, token, identity)
            except Refusal as error:
                errors.append(error)
        if errors:
            refuse("; ".join(str(error) for error in errors), errors[0].code)

    def forge_revoke_identity(self, opener, base, token, identity):
        """Disable one login and enumerate its complete token set before any deletion shrinks a page."""
        self.forge_api(
            opener, base, token, "PATCH", identity, 200,
            {"login_name": identity, "source_id": 0, "prohibit_login": True},
        )
        ids, page = set(), 1
        while True:
            rows = self.forge_api(opener, base, token, "GET", identity + f"/tokens?limit=50&page={page}", 200)
            if not isinstance(rows, list) or any(
                not isinstance(row, dict) or type(row.get("id")) is not int or row["id"] < 1 for row in rows
            ):
                refuse("Forgejo answered no valid access-token list", 69)
            if not rows:
                break
            batch = {row["id"] for row in rows}
            if batch & ids:
                refuse("Forgejo repeated a page of access tokens", 69)
            ids.update(batch)
            page += 1
        for identifier in sorted(ids):
            self.forge_api(opener, base, token, "DELETE", identity + f"/tokens/{identifier}", 204)

    def matrix_context(self, user):
        """Resolve the exact machine name and root's optional private admin credential."""
        host = self.setting("/etc/porelo-host/forge.conf", "host")
        if not re.fullmatch(LAPTOP, host):
            refuse("forge.conf names no valid host", 69)
        self.account("porelo-matrix")
        self.require(["runuser", TRANSPORT])
        path = self.path("/etc/porelo-host/matrix-admin.token")
        self.check(path, mode=0o600)
        admin = self.secret(self.read(path).removesuffix("\n")) if path.exists() else None
        return host + "-" + user, path, admin

    def secret(self, value):
        """Accept one bounded graphic-ASCII token without ever including it in a refusal."""
        if not isinstance(value, str) or not re.fullmatch(r"[!-~]{1,1024}", value):
            refuse("Matrix answered no valid token", 69)
        return value

    def matrix_call(self, user, verb):
        """Exchange JSON secrets on stdin; persist a first admin credential before using the answer."""
        machine, path, admin = self.matrix_context(user)
        result = self.as_account(
            "porelo-matrix", [TRANSPORT, "machine-token", verb, machine],
            input=json.dumps({"secrets": {"PORELO_MATRIX_ADMIN_TOKEN": admin}} if admin else {}),
            accepted=(0, 78),
        )
        if result.returncode == 78:
            message = result.stderr.strip()
            if admin:
                message = message.replace(admin, "[redacted]")
            refuse(message or "Matrix refused the expelled machine", 65)
        try:
            answer = json.loads(result.stdout)
        except (ValueError, UnicodeError):
            refuse("Matrix answered no valid JSON", 69)
        if not isinstance(answer, dict):
            refuse("Matrix answered no machine object", 69)
        if "account" in answer:
            account = answer["account"]
            if not isinstance(account, dict):
                refuse("Matrix answered no valid admin account", 69)
            received = self.secret(account.get("PORELO_MATRIX_ADMIN_TOKEN"))
            self.write(path, received + "\n", 0o600)
        if answer.get("machine") != machine:
            refuse("Matrix answered for another machine", 69)
        return answer

    def matrix_file(self, user, action, token=None):
        """Run the link-refusing atomic writer/remover as the person, with a token only on stdin."""
        result = self.as_account(
            user, ["/bin/sh", "-c", MATRIX_FILE, "matrix-token", action], input=token, accepted=(0, 73)
        )
        if result.returncode != 0:
            refuse("cannot write or remove the person's Matrix token safely", 73)

    def matrix_issue(self, user):
        """Issue <host>-<user> and deliver its registration credential in the person's own home."""
        answer = self.matrix_call(user, "issue")
        self.matrix_file(user, "write", self.secret(answer.get("token")))

    def matrix_expel_revoke(self, user):
        """Expulsion revokes registration too; only a validated answer permits local cleanup."""
        answer = self.matrix_call(user, "expel")
        if (
            not isinstance(answer.get("expelled"), list)
            or any(not isinstance(account, str) for account in answer["expelled"])
            or type(answer.get("revoked")) is not bool
            or type(answer.get("known")) is not bool
            or (not answer["known"] and (answer["expelled"] or answer["revoked"]))
        ):
            refuse("Matrix answered no valid expulsion and revocation result", 69)
        self.matrix_file(user, "remove")

    def targets(self, user):
        """Check all publication/removal paths without creating directories."""
        paths = [
            self.path(f"/etc/ssh/authorized_keys/{user}"),
            self.path(f"/etc/wireguard/porelo-host-peers/{user}.conf"),
            self.path(f"/etc/porelo-host/people/{user}.conf"),
        ]
        for path in paths:
            self.check(path, 73)
        return paths

    def directories(self, directory):
        """Create missing root directories privately; preserve safe existing directories."""
        if directory.exists():
            return
        self.directories(directory.parent)
        public = ("/etc/ssh/authorized_keys", "/run/porelo-host", "/run/porelo-host/people")
        mode = 0o755 if directory in map(self.path, public) else 0o700
        directory.mkdir(mode=mode)
        os.chown(directory, self.owner, self.group)
        directory.chmod(mode)

    def write(self, path, text, mode, owner=None, group=None):
        """Write beside the target, fsync and rename so no reader can see partial access or a record."""
        temporary = None
        try:
            self.directories(path.parent)
            fd, temporary = tempfile.mkstemp(prefix=".porelo-host-person.", dir=path.parent)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                os.fchown(stream.fileno(), self.owner if owner is None else owner, self.group if group is None else group)
                os.fchmod(stream.fileno(), mode)
                stream.write(text)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, path)
        except OSError:
            refuse(f"cannot write {path}", 73)
        finally:
            if temporary is not None:
                Path(temporary).unlink(missing_ok=True)

    def record(self, user, record):
        """Publish admission or completed revocation only after its preceding operations."""
        text = "role=project-admin\nprojects=\nlocked=" + str(record["locked"]).lower() + "\n"
        text += "".join(
            f'laptop={item["laptop"]} {item["ssh"]} {item["wg"]} {item["address"]}\n' for item in record["laptops"]
        )
        self.write(self.path(f"/etc/porelo-host/people/{user}.conf"), text, 0o600)

    def subids(self, kind):
        """Read all subordinate ranges, rejecting malformed ranges rather than overlapping them."""
        path = self.path("/etc/" + kind)
        rows = []
        for line in self.read(path).splitlines():
            fields = line.split(":")
            if (
                len(fields) != 3
                or not re.fullmatch(r"[a-zA-Z0-9_-]+", fields[0])
                or not re.fullmatch(r"[0-9]{1,10}", fields[1])
                or not re.fullmatch(r"[0-9]{1,10}", fields[2])
                or int(fields[2]) < 1
                or int(fields[1]) + int(fields[2]) > 4294967295
            ):
                refuse(f"{kind} holds a malformed subordinate ID range", 69)
            rows.append((fields[0], int(fields[1]), int(fields[2])))
        return rows

    def next_range(self, rows):
        """A free 65536-ID interval after the highest occupied ID, at least 100000."""
        start = max([100000] + [start + count for _, start, count in rows])
        if start + 65536 > 4294967295:
            refuse("there is no free subordinate ID range", 69)
        return f"{start}-{start + 65535}"

    def create_account(self, user):
        """Create the home and private primary group before enabling user services."""
        # useradd must not allocate its own defaults before the explicit, prevalidated ranges.
        self.command(
            ["useradd", "--create-home", "--user-group", "--shell", "/bin/bash",
             "--key", "SUB_UID_COUNT=0", "--key", "SUB_GID_COUNT=0", user]
        )

    def enable_linger(self, user):
        """Allow the person's own user services to survive sign-out."""
        self.command(["loginctl", "enable-linger", user])

    def subordinate_ids(self, user, uid_range, gid_range):
        """Give the person's rootless containers their own nonoverlapping ID ranges."""
        self.command(["usermod", "--add-subuids", uid_range, user])
        self.command(["usermod", "--add-subgids", gid_range, user])

    def join_groups(self, user, groups):
        """Limit password sudo to people, adding virtualization groups only where installed."""
        if "porelo-people" not in groups:
            self.command(["groupadd", "--system", "porelo-people"])
        names = [name for name in ("kvm", "libvirt") if name in groups] + ["porelo-people"]
        self.command(["usermod", "--append", "--groups", ",".join(names), user])

    def add(self, user, laptops, groups, uid_range, gid_range):
        """Apply validated admission in account, SSH, VPN, hook and record order."""
        self.create_account(user)
        self.enable_linger(user)
        self.subordinate_ids(user, uid_range, gid_range)
        self.join_groups(user, groups)
        self.write(
            self.path(f"/etc/ssh/authorized_keys/{user}"),
            "".join(f'from="{item["address"]}" {item["ssh"]}\n' for item in laptops),
            0o644,
        )
        for item in laptops:
            self.command(["wg", "set", "wg-porelo", "peer", item["wg"], "allowed-ips", item["address"] + "/32"])
        self.write(
            self.path(f"/etc/wireguard/porelo-host-peers/{user}.conf"),
            "".join(f'[Peer]\nPublicKey = {item["wg"]}\nAllowedIPs = {item["address"]}/32\n\n' for item in laptops),
            0o600,
        )
        self.hooks["forge_admit"](user, laptops)
        self.hooks["matrix_issue"](user)
        self.record(user, {"locked": False, "laptops": laptops})

    def lock(self, user, record, porelo):
        """Remove access first; task-stop failure cannot prevent account revocation."""
        self.path(f"/etc/ssh/authorized_keys/{user}").unlink(missing_ok=True)
        self.path(f"/etc/wireguard/porelo-host-peers/{user}.conf").unlink(missing_ok=True)
        errors = []
        for item in record["laptops"]:
            try:
                self.command(["wg", "set", "wg-porelo", "peer", item["wg"], "remove"])
            except Refusal as error:
                errors.append(error)
        for name in ("forge_lock", "matrix_expel_revoke"):
            try:
                self.hooks[name](user)
            except Refusal as error:
                errors.append(error)
        if porelo:
            self.command(self.porelo(user, "task", "stop", "--all"), required=False)
        for args in (["loginctl", "terminate-user", user], ["usermod", "--lock", "--expiredate", "1", user]):
            try:
                self.command(args)
            except Refusal as error:
                errors.append(error)
        if errors:
            refuse("; ".join(str(error) for error in errors), errors[0].code)
        record["locked"] = True
        self.record(user, record)

    def clear_vault(self, user):
        """Porelo's lock-out order as the person: no task left that could hold a token, then the vault, no terminal.

        The lock expired the account, which PAM refuses to runuser and to the user manager the vault's runtime needs;
        only the expiry is lifted for this, the password stays locked and no key or peer lets anyone in. Any failure
        expires the account again, as the lock left it.
        """
        self.command(["usermod", "--expiredate", "", user])
        try:
            self.command(["systemctl", "start", f"user@{self.uid(user)}.service"])
            self.command(self.porelo(user, "task", "stop", "--all"))
            self.command(self.porelo(user, "vault", "clear", "--yes", "--force"))
        except Refusal:
            self.command(["usermod", "--expiredate", "1", user])
            raise

    def purge(self, user, record, porelo, account_exists):
        """Lock before clearing the vault, deleting the account and releasing recorded IDs."""
        if not record["locked"]:
            self.lock(user, record, porelo)
        self.remove_forge_tokens(user)
        if account_exists:
            if porelo:
                self.clear_vault(user)
            self.command(["loginctl", "disable-linger", user])
            if porelo:
                self.command(["loginctl", "terminate-user", user])
                # terminate-user returns before the manager ends; userdel refuses an account still running anything.
                self.command(["systemctl", "stop", f"user@{self.uid(user)}.service"])
            self.command(["userdel", "--remove", user])
        for kind in ("subuid", "subgid"):
            path = self.path("/etc/" + kind)
            text = self.read(path)
            remaining = "".join(line for line in text.splitlines(keepends=True) if line.partition(":")[0] != user)
            if remaining != text:
                self.write(path, remaining, stat.S_IMODE(path.stat().st_mode))
        self.path(f"/etc/porelo-host/people/{user}.conf").unlink()

    def execute(self, arguments, data):
        """Validate the complete request under the configuration lock before applying it."""
        if self.euid != 0:
            refuse("runs only as root", 69)
        if len(arguments) == 4 and arguments[0] == "add" and arguments[2:] == ["--role", "project-admin"]:
            verb, user = arguments[:2]
        elif len(arguments) == 2 and arguments[0] in ("lock", "purge"):
            verb, user = arguments
        else:
            refuse("use add <user> --role project-admin, lock <user> or purge <user>")
        if not re.fullmatch(USER, user):
            refuse("the person name must match [a-z][a-z0-9-]{0,30}")
        conf = self.path("/etc/porelo-host/forge.conf")
        self.check(conf, required=True)
        with conf.open("rb") as mutex:
            fcntl.flock(mutex, fcntl.LOCK_EX)
            network, reserved = self.network()
            records = self.records()
            self.credentials(records, network, reserved)
            accounts = (
                self.accounts
                if self.accounts is not None
                else {entry.pw_name: entry.pw_uid for entry in pwd.getpwall()}
            )
            uid = accounts.get(user)
            if user == "root" or (uid is not None and (uid < 1000 or user not in records)):
                refuse("the name belongs to root, a system account or an account outside the people records", 65)
            record = records.get(user)
            if verb != "add" and record is None:
                refuse("the person is unknown to the people records", 65)
            if verb == "add":
                laptops = key_block(sys.stdin.buffer.read(MAX_INPUT + 1) if data is None else data)
                if record is not None:
                    known = {item["laptop"]: item for item in record["laptops"]}
                    if uid is None or len(known) != len(laptops):
                        refuse("the recorded person has no account or has different laptops", 65)
                    for item in laptops:
                        old = known.get(item["laptop"])
                        if (
                            old is None
                            or old["ssh"] != item["ssh"]
                            or old["wg"] != item["wg"]
                            or item["address"] not in (None, old["address"])
                        ):
                            refuse("keys or addresses differ from the recorded laptop", 65)
                    return self.add_answer(user, record["laptops"])
                laptops = self.allocate(laptops, records, network, reserved)
                uid_range = self.next_range(self.subids("subuid"))
                gid_range = self.next_range(self.subids("subgid"))
                groups = self.groups if self.groups is not None else {entry.gr_name for entry in grp.getgrall()}
                self.targets(user)
                self.require(
                    ["useradd", "loginctl", "usermod", "wg"] + ([] if "porelo-people" in groups else ["groupadd"])
                )
                self.prepare_services(user, verb)
                self.add(user, laptops, groups, uid_range, gid_range)
                return self.add_answer(user, laptops)
            if verb == "lock" and record["locked"]:
                self.remove_forge_tokens(user)
                return {"person": user, "locked": True}
            if uid is None and not record["locked"]:
                refuse("the unlocked person has no account", 65)
            self.targets(user)
            programs = [] if record["locked"] else ["wg", "loginctl", "usermod"]
            porelo = self.available("porelo")
            if porelo and uid is not None:
                programs.append("runuser")
                if verb == "purge":
                    programs.extend(["usermod", "systemctl"])
            if verb == "purge":
                self.subids("subuid")
                self.subids("subgid")
                for kind in ("subuid", "subgid"):
                    self.check(self.path("/etc/" + kind), 73, required=True)
                if uid is not None:
                    programs.extend(["loginctl", "userdel"])
            self.require(programs)
            if not record["locked"]:
                self.prepare_services(user, verb)
            if verb == "lock":
                self.lock(user, record, porelo)
                return {"person": user, "locked": True}
            self.purge(user, record, porelo, uid is not None)
            return {"person": user, "purged": True}

    def add_answer(self, user, laptops):
        """The interface sees names and addresses, never the credential lines."""
        return {
            "person": user,
            "role": "project-admin",
            "laptops": [{"laptop": item["laptop"], "vpn_address": item["address"]} for item in laptops],
        }


def entry(host, arguments, data=None):
    """Turn every expected refusal into one safe diagnostic and the contract's exit code."""
    try:
        answer = host.execute(arguments, data)
    except Refusal as error:
        print(f"porelo-host-person: {error}", file=sys.stderr)
        return error.code
    except OSError:
        print("porelo-host-person: cannot read or change the host's files", file=sys.stderr)
        return 73
    print(json.dumps(answer, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    if os.geteuid() != 0:
        print("porelo-host-person: runs only as root", file=sys.stderr)
        sys.exit(69)
    os.environ.clear()
    os.environ.update(ENV)
    sys.exit(entry(Host(), sys.argv[1:]))
else:

    def _test_entry(root, runner, *, euid, owner, accounts, groups, commands, hooks=None):
        """Import-only injection; there is no production argument or environment switch to reach it."""
        host = Host()
        host.root, host.runner, host.euid = root, runner, euid
        host.owner, host.group = owner, os.getgid()
        host.accounts, host.groups, host.commands = accounts, groups, commands
        if hooks is not None:
            host.hooks = hooks
        return lambda arguments, data: entry(host, arguments, data)
