class Host:
    """Root's paths and system operations, with no production configuration overrides."""

    def __init__(self):
        """Use root's fixed paths, the real identity and the single system command runner."""
        self.root = Path("/")
        self.euid = os.geteuid()
        self.sudo_user = None
        self.owner, self.group = 0, 0
        self.runner = run_command
        self.accounts = None
        self.groups = None
        self.commands = None
        self.hooks = {
            name: getattr(self, name) for name in ("forge_admit", "matrix_issue", "forge_lock", "matrix_expel_revoke")
        }

    def path(self, name):
        """An absolute host path, rooted elsewhere only through the import-only test hook."""
        return self.root / name.lstrip("/")

    def check(self, path, code=69, required=False, directory=False, mode=None):
        """Reject links, wrong owners and writable ancestors before reading or changing a path."""
        if path != self.root:
            self.check(path.parent, code, directory=True)
        try:
            status = path.lstat()
        except FileNotFoundError:
            if required:
                refuse(f"{path} is missing; prepare the host first", code)
            return
        except OSError:
            refuse(f"cannot inspect {path}", code)
        correct_type = stat.S_ISDIR(status.st_mode) if directory else stat.S_ISREG(status.st_mode)
        if (
            not correct_type
            or status.st_uid != self.owner
            or status.st_mode & 0o022
            or (mode is not None and stat.S_IMODE(status.st_mode) != mode)
        ):
            refuse(f"{path} is not a {'directory' if directory else 'plain file'} of root's alone", code)

    def read(self, path):
        """Read trusted UTF-8 without exposing bad content in the error."""
        self.check(path, required=True)
        try:
            return path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            refuse(f"cannot read {path}", 69)

    def setting(self, name, key):
        """Read one unambiguous setting from root's own configuration."""
        values = [
            line.partition("=")[2] for line in self.read(self.path(name)).splitlines() if line.startswith(key + "=")
        ]
        if len(values) != 1:
            refuse(f"{name} names no single valid {key}", 69)
        return values[0]

    def network(self):
        """The host's /24 and its host admin reservation come from the prepared host."""
        host = ipv4(self.setting("/etc/porelo-host/forge.conf", "address"), 69)
        if not re.fullmatch(r"10\.73\.[0-9]{1,3}\.1", str(host)):
            refuse("forge.conf names no host VPN address at 10.73.<n>.1", 69)
        network = ipaddress.IPv4Network(f"{host}/24", strict=False)
        admin = network.network_address + 2
        return network, {str(host), str(admin), str(network.network_address), str(network.broadcast_address)}

    def records(self):
        """Read all people before allocation; corrupt or unsafe records stop every change."""
        directory = self.path("/etc/porelo-host/people")
        self.check(directory, directory=True, mode=0o700)
        records = {}
        if not directory.exists():
            return records
        for path in sorted(directory.iterdir()):
            if not path.name.endswith(".conf") or not re.fullmatch(USER, path.stem):
                refuse("the people directory holds an unknown record", 65)
            self.check(path, required=True, mode=0o600)
            lines = self.read(path).splitlines()
            if (
                len(lines) >= 4
                and lines[0] == "role=project-admin"
                and lines[1] == "projects="
                and lines[2] in ("locked=false", "locked=true")
                and all(line.startswith("laptop=") for line in lines[3:])
            ):
                members, locked_line, laptop_lines = ["hand"], lines[2], lines[3:]
            else:
                members, previous = [], None
                index = 0
                while index < len(lines) and lines[index].startswith("member="):
                    member = lines[index][7:]
                    order = member_key(member, 65)
                    if previous is not None and order <= previous:
                        refuse(f"the record for {path.stem} is malformed or unsupported", 65)
                    members.append(member)
                    previous = order
                    index += 1
                if (
                    len(lines) < index + 2
                    or lines[index] not in ("locked=false", "locked=true")
                    or any(not line.startswith("laptop=") for line in lines[index + 1 :])
                ):
                    refuse(f"the record for {path.stem} is malformed or unsupported", 65)
                locked_line, laptop_lines = lines[index], lines[index + 1 :]
            laptops = key_block(("\n".join(line[7:] for line in laptop_lines) + "\n").encode(), 65, True)
            records[path.stem] = {"members": members, "locked": locked_line == "locked=true", "laptops": laptops}
        return records

    def credentials(self, records, network, reserved):
        """A complete reference set of occupied addresses and keys, including locked people."""
        addresses, ssh_keys, wg_keys = set(reserved), set(), set()
        for record in records.values():
            for item in record["laptops"]:
                address = item["address"]
                if (
                    ipv4(address, 65) not in network
                    or address in addresses
                    or item["ssh"] in ssh_keys
                    or item["wg"] in wg_keys
                ):
                    refuse("the people records hold conflicting keys or VPN addresses", 65)
                addresses.add(address)
                ssh_keys.add(item["ssh"])
                wg_keys.add(item["wg"])
        return addresses, ssh_keys, wg_keys

    def allocate(self, laptops, records, network, reserved):
        """Reserve explicit requests first, then take the lowest remaining usable address."""
        addresses, ssh_keys, wg_keys = self.credentials(records, network, reserved)
        for item in laptops:
            if item["ssh"] in ssh_keys or item["wg"] in wg_keys:
                refuse("a public key belongs to a recorded laptop", 65)
            if item["address"] is not None:
                if ipv4(item["address"], 64) not in network or item["address"] in addresses:
                    refuse("a requested VPN address is outside the network or already reserved", 65)
                addresses.add(item["address"])
        for item in laptops:
            if item["address"] is None:
                item["address"] = next(
                    (str(address) for address in network.hosts() if str(address) not in addresses), None
                )
                if item["address"] is None:
                    refuse("the host VPN network has no free laptop address", 65)
                addresses.add(item["address"])
        return laptops

    def available(self, program):
        """Find a command only on the fixed path, refusing executable paths writable by another account."""
        if self.commands is not None:
            return program in self.commands
        found = shutil.which(program, path=ENV["PATH"])
        if found is None:
            return False
        self.check(Path(os.path.realpath(found)), required=True)
        return True

    def require(self, programs):
        """Resolve every required dependency before any write or command."""
        for program in programs:
            if not self.available(program):
                refuse(f"{program} is missing from the fixed PATH", 69)

    def command(self, arguments, required=True, input=None, accepted=(0,)):
        """Report only the program and exit status; never relay stdout, stderr or key arguments."""
        try:
            result = self.runner(arguments) if input is None else self.runner(arguments, input=input)
            if result.returncode in accepted:
                return result
            message = f"{arguments[0]} failed (exit {result.returncode})"
        except (OSError, subprocess.TimeoutExpired, UnicodeError) as error:
            message = f"{arguments[0]} failed to complete ({type(error).__name__})"
        if required:
            refuse(message, 69)
        print(f"porelo-host-person: task stop for the person failed: {message}; lock continues", file=sys.stderr)
        return False

    def account(self, user):
        """Resolve a non-root service or person account without trusting caller-supplied IDs or homes."""
        try:
            entry = pwd.getpwnam(user)
        except KeyError:
            refuse("a required service or person account is missing", 69)
        home = entry.pw_dir
        if entry.pw_uid == 0 or not home.startswith("/") or str(Path(home)) != home or ".." in Path(home).parts:
            refuse("a required account is root or has no usable absolute home", 69)
        return entry

    def porelo(self, user, *arguments):
        """Porelo as the person, with their own user manager's runtime, which rootless podman needs."""
        return ["runuser", "-u", user, "--", "env", f"XDG_RUNTIME_DIR=/run/user/{self.uid(user)}", "porelo", *arguments]

    def uid_min(self):
        """The first UID of a person's account, as useradd takes it from /etc/login.defs."""
        path = self.path("/etc/login.defs")
        if not path.exists():
            return 1000
        for line in self.read(path).splitlines():
            fields = line.split()
            if len(fields) == 2 and fields[0] == "UID_MIN" and re.fullmatch(r"[0-9]{1,10}", fields[1]):
                return int(fields[1])
        return 1000

    def uid(self, user):
        """The person's uid, from the accounts this call read."""
        return self.accounts[user] if self.accounts is not None else pwd.getpwnam(user).pw_uid

    def as_account(self, user, arguments, **kwargs):
        """Pass credentials on stdin only, with a fixed runtime and the account's own home."""
        entry = self.account(user)
        return self.command(
            [
                "runuser", "-u", user, "--", "env", f"HOME={entry.pw_dir}",
                f"XDG_RUNTIME_DIR=/run/user/{entry.pw_uid}", *arguments,
            ],
            **kwargs,
        )

    def forge_configuration(self, user):
        """An absent/empty account switches the forge off; agents= names a 6j host's agent identities, for lock."""
        path = self.path("/etc/porelo-host/forge.conf")
        self.check(path)
        if not path.exists():
            return None
        accounts = [line[8:] for line in self.read(path).splitlines() if line.startswith("account=")]
        if not accounts or accounts == [""]:
            return None
        if len(accounts) != 1 or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", accounts[0]):
            refuse("forge.conf names no single valid account", 69)
        agents = [line[7:] for line in self.read(path).splitlines() if line.startswith("agents=")]
        if len(agents) > 1:
            refuse("forge.conf names no valid agent list", 69)
        agents = agents[0].split(",") if agents and agents[0] else []
        if any(not re.fullmatch(USER, agent) for agent in agents):
            refuse("forge.conf names no valid agent list", 69)
        identities = [user, "porelo-" + user] + [agent + "-" + user for agent in agents]
        if len(set(identities)) != len(identities):
            refuse("forge.conf repeats an identity", 69)
        self.account(accounts[0])
        self.require(["runuser", "podman"])
        return accounts[0], identities

    def forge_command(self, account, arguments):
        """Run Forgejo's admin command as its rootless container account."""
        return self.as_account(account, ["podman", "exec", "forgejo", "forgejo", "admin", "user", *arguments])

    def forge_token(self, account, user, scopes):
        """Capture a generated token in memory without ever relaying the command's output."""
        result = self.forge_command(
            account,
            [
                "generate-access-token", "--username", user, "--token-name",
                "porelo-host-person-" + uuid.uuid4().hex, "--scopes", scopes, "--raw",
            ],
        )
        token = result.stdout.strip()
        if not re.fullmatch(r"[0-9a-f]{40}", token):
            refuse("Forgejo made no valid access token", 69)
        return token

    def forge_tokens_directory(self, user, private=True):
        """Refuse a linked delivery directory or one owned by another account."""
        directory = self.path(f"/run/porelo-host/people/{user}")
        self.check(directory.parent, 73, directory=True)
        try:
            status = directory.lstat()
        except FileNotFoundError:
            return directory
        if (
            not stat.S_ISDIR(status.st_mode)
            or status.st_uid != self.account(user).pw_uid
            or (private and stat.S_IMODE(status.st_mode) != 0o700)
        ):
            refuse("the forge token delivery directory is not a private directory of the person's", 73)
        return directory

    def forge_tokens_path(self, user, private=True):
        """Validate the person's delivery directory and any existing private token file."""
        path = self.forge_tokens_directory(user, private) / "identities.tokens"
        if private and (path.exists() or path.is_symlink()):
            entry, status = self.account(user), path.lstat()
            if not stat.S_ISREG(status.st_mode) or status.st_uid != entry.pw_uid or stat.S_IMODE(status.st_mode) != 0o600:
                refuse("the person's forge token delivery file is not private and plain", 73)
        return path

    def remove_forge_tokens(self, user):
        """Remove only this person's delivery directory, never following links in its writable contents."""
        directory = self.forge_tokens_directory(user, private=False)
        if directory.exists():
            if not shutil.rmtree.avoids_symlink_attacks:
                refuse("safe removal of the forge token delivery directory is unavailable", 69)
            try:
                shutil.rmtree(directory)
            except OSError:
                refuse("cannot remove the person's forge token delivery directory; it remains for retry", 73)

    def forge_domain(self):
        """Validate the email domain before it reaches Forgejo's account creation command."""
        domain = self.setting("/etc/porelo-host/forge.conf", "name")
        if not re.fullmatch(r"[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?", domain):
            refuse("forge.conf names no valid name", 69)
        return domain

    def forge_endpoint(self):
        """Validate the fixed API endpoint and its trusted CA before revocation starts."""
        address = str(ipv4(self.setting("/etc/porelo-host/forge.conf", "address"), 69))
        port = self.setting("/etc/porelo-host/forge.conf", "port")
        if not re.fullmatch(r"[1-9][0-9]{0,4}", port) or int(port) > 65535:
            refuse("forge.conf names no valid port", 69)
        ca = self.path("/etc/porelo-host/forge/ca.pem")
        self.check(ca, required=True)
        return f"https://{address}:{port}/api/v1/admin/users/", ca

    def prepare_services(self, user, verb):
        """Validate real hooks' settings, root paths and programs before changing host access."""
        forge = "forge_admit" if verb == "add" else "forge_lock"
        matrix = "matrix_issue" if verb == "add" else "matrix_expel_revoke"
        if self.hooks[forge] == getattr(self, forge):
            config = self.forge_configuration(user)
            if config is not None or verb != "add":
                self.forge_tokens_path(user, private=verb == "add")
            if config is not None:
                if verb == "add":
                    self.forge_domain()
                else:
                    self.forge_endpoint()
        if self.hooks[matrix] == getattr(self, matrix):
            self.matrix_context(user)

    def forge_admit(self, user, laptops):
        """Make only missing identities and deliver their credentials for the person's own vault import."""
        config = self.forge_configuration(user)
        if config is None:
            return
        # Porelo lends agents no forge identity of their own: the person's login and gate alone, whatever agents= names.
        account, identities = config[0], config[1][:2]
        path = self.forge_tokens_path(user)
        domain = self.forge_domain()
        lines = self.forge_command(account, ["list"]).stdout.splitlines()
        if not lines or not re.match(r"ID\s+Username\s+Email\b", lines[0]):
            refuse("Forgejo answered no valid user list", 69)
        users = set()
        for line in lines[1:]:
            fields = line.split()
            if len(fields) < 3 or not fields[0].isdigit():
                refuse("Forgejo answered no valid user list", 69)
            users.add(fields[1])
        tokens = []
        for identity in identities:
            if identity in users:
                continue
            self.forge_command(
                account,
                ["create", "--username", identity, "--email", identity + "@" + domain,
                 "--random-password", "--must-change-password=false"],
            )
            # The person's login brings their projects: teams, Actions variables and their standing in the
            # organization; the gate pushes task branches alone.
            scopes = "write:repository,write:organization,read:user" if identity == user else (
                "write:repository,read:organization"
            )
            tokens.append(identity + " " + self.forge_token(account, identity, scopes) + "\n")
        if tokens:
            entry = self.account(user)
            self.directories(path.parent.parent)
            for directory in (path.parent.parent.parent, path.parent.parent):
                self.check(directory, 73, required=True, directory=True)
                directory.chmod(0o755)
            if not path.parent.exists():
                path.parent.mkdir(mode=0o700)
                os.chown(path.parent, entry.pw_uid, entry.pw_gid)
                path.parent.chmod(0o700)
            self.write(path, "".join(tokens), 0o600, owner=entry.pw_uid, group=entry.pw_gid)

    def forge_api(self, opener, base, token, method, route, expected, body=None, not_found=None):
        """Refuse HTTP and TLS failures without printing a header, credential or response body."""
        request = urllib.request.Request(
            base + route,
            method=method,
            data=None if body is None else json.dumps(body).encode(),
            headers={"Authorization": "token " + token, "Content-Type": "application/json"},
        )
        try:
            with opener.open(request, timeout=30) as answer:
                if answer.status != expected:
                    refuse(f"Forgejo admin API answered HTTP {answer.status}", 69)
                return None if expected == 204 else json.load(answer)
        except urllib.error.HTTPError as error:
            if error.code == 404 and not_found is not None:
                refuse(not_found, 65)
            refuse(f"Forgejo admin API answered HTTP {error.code}", 69)
        except (OSError, urllib.error.URLError, http.client.HTTPException, ValueError, UnicodeError):
            refuse("Forgejo admin API did not answer valid JSON over trusted TLS", 69)

    def forge_opener(self, ca):
        """Build a redirect-free HTTPS opener trusting only the host forge CA."""
        try:
            return urllib.request.build_opener(
                urllib.request.ProxyHandler({}),
                NoRedirect(),
                urllib.request.HTTPSHandler(context=ssl.create_default_context(cafile=str(ca))),
            )
        except (OSError, ValueError):
            refuse("the forge CA cannot be loaded", 69)

    def forge_developers_prepare(self, project, admin):
        """Verify the project's developers team exists on the local forge and read its members."""
        config = self.forge_configuration(admin)
        if config is None:
            return None
        account, _ = config
        admin_base, ca = self.forge_endpoint()
        api_base = admin_base.removesuffix("admin/users/")
        opener = self.forge_opener(ca)
        token = self.forge_token(account, "porelo-admin", "write:admin,write:organization,read:user")
        missing = f"Forgejo organization {project} has no developers team; run bring first"
        teams, seen_ids, page = [], set(), 1
        while True:
            rows = self.forge_api(
                opener, api_base, token, "GET", f"orgs/{project}/teams?limit=50&page={page}", 200, not_found=missing
            )
            if not isinstance(rows, list) or any(
                not isinstance(row, dict)
                or type(row.get("id")) is not int
                or row["id"] < 1
                or not isinstance(row.get("name"), str)
                for row in rows
            ):
                refuse("Forgejo answered no valid team list", 69)
            if not rows:
                break
            batch = {row["id"] for row in rows}
            if batch & seen_ids:
                refuse("Forgejo repeated a page of organization teams", 69)
            seen_ids.update(batch)
            teams.extend(rows)
            page += 1
        developers_teams = [row for row in teams if row["name"] == "developers"]
        if len(developers_teams) != 1:
            refuse(missing, 65)
        team_id = developers_teams[0]["id"]
        members, page = set(), 1
        while True:
            rows = self.forge_api(opener, api_base, token, "GET", f"teams/{team_id}/members?limit=50&page={page}", 200)
            if not isinstance(rows, list):
                refuse("Forgejo answered no valid team member list", 69)
            if not rows:
                break
            batch = set()
            for row in rows:
                login = row.get("login") or row.get("username") if isinstance(row, dict) else None
                if not isinstance(login, str) or not login:
                    refuse("Forgejo answered no valid team member list", 69)
                batch.add(login)
            if batch & members:
                refuse("Forgejo repeated a page of team members", 69)
            members.update(batch)
            page += 1
        return opener, api_base, token, team_id, members

    def forge_developers_apply(self, forge_context, desired_users):
        """Reconcile the forge organization's developers team with the signed developer list."""
        if forge_context is None:
            return
        opener, api_base, token, team_id, current_members = forge_context
        desired = set(desired_users)
        for user in desired_users:
            if user not in current_members:
                self.forge_api(opener, api_base, token, "PUT", f"teams/{team_id}/members/{user}", 204)
        for user in sorted(current_members - desired):
            self.forge_api(opener, api_base, token, "DELETE", f"teams/{team_id}/members/{user}", 204)

    def forge_lock(self, user):
        """Prohibit all the person's logins and delete every token, including tokens outside delivery."""
        config = self.forge_configuration(user)
        self.forge_tokens_directory(user, private=False)
        errors = []
        try:
            self.remove_forge_tokens(user)
        except Refusal as error:
            errors.append(error)
        if config is None:
            if errors:
                raise errors[0]
            return
        account, identities = config
        base, ca = self.forge_endpoint()
        opener = self.forge_opener(ca)
        token = self.forge_token(account, "porelo-admin", "write:admin")
        for identity in identities:
            try:
                self.forge_revoke_identity(opener, base, token, identity)
            except Refusal as error:
                errors.append(error)
        if errors:
            refuse("; ".join(str(error) for error in errors), errors[0].code)

    def forge_revoke_identity(self, opener, base, token, identity):
        """Disable one login and enumerate its complete token set before any deletion shrinks a page."""
        self.forge_api(
            opener, base, token, "PATCH", identity, 200,
            {"login_name": identity, "source_id": 0, "prohibit_login": True},
        )
        ids, page = set(), 1
        while True:
            rows = self.forge_api(opener, base, token, "GET", identity + f"/tokens?limit=50&page={page}", 200)
            if not isinstance(rows, list) or any(
                not isinstance(row, dict) or type(row.get("id")) is not int or row["id"] < 1 for row in rows
            ):
                refuse("Forgejo answered no valid access-token list", 69)
            if not rows:
                break
            batch = {row["id"] for row in rows}
            if batch & ids:
                refuse("Forgejo repeated a page of access tokens", 69)
            ids.update(batch)
            page += 1
        for identifier in sorted(ids):
            self.forge_api(opener, base, token, "DELETE", identity + f"/tokens/{identifier}", 204)

    def matrix_context(self, user):
        """Resolve the exact machine name and root's optional private admin credential."""
        host = self.setting("/etc/porelo-host/forge.conf", "host")
        if not re.fullmatch(LAPTOP, host):
            refuse("forge.conf names no valid host", 69)
        self.account("porelo-matrix")
        self.require(["runuser", TRANSPORT])
        path = self.path("/etc/porelo-host/matrix-admin.token")
        self.check(path, mode=0o600)
        admin = self.secret(self.read(path).removesuffix("\n")) if path.exists() else None
        return host + "-" + user, path, admin

    def secret(self, value):
        """Accept one bounded graphic-ASCII token without ever including it in a refusal."""
        if not isinstance(value, str) or not re.fullmatch(r"[!-~]{1,1024}", value):
            refuse("Matrix answered no valid token", 69)
        return value

    def matrix_call(self, user, verb):
        """Exchange JSON secrets on stdin; persist a first admin credential before using the answer."""
        machine, path, admin = self.matrix_context(user)
        result = self.as_account(
            "porelo-matrix", [TRANSPORT, "machine-token", verb, machine],
            input=json.dumps({"secrets": {"PORELO_MATRIX_ADMIN_TOKEN": admin}} if admin else {}),
            accepted=(0, 78),
        )
        if result.returncode == 78:
            message = result.stderr.strip()
            if admin:
                message = message.replace(admin, "[redacted]")
            refuse(message or "Matrix refused the expelled machine", 65)
        try:
            answer = json.loads(result.stdout)
        except (ValueError, UnicodeError):
            refuse("Matrix answered no valid JSON", 69)
        if not isinstance(answer, dict):
            refuse("Matrix answered no machine object", 69)
        if "account" in answer:
            account = answer["account"]
            if not isinstance(account, dict):
                refuse("Matrix answered no valid admin account", 69)
            received = self.secret(account.get("PORELO_MATRIX_ADMIN_TOKEN"))
            self.write(path, received + "\n", 0o600)
        if answer.get("machine") != machine:
            refuse("Matrix answered for another machine", 69)
        return answer

    def matrix_file(self, user, action, token=None):
        """Run the link-refusing atomic writer/remover as the person, with a token only on stdin."""
        result = self.as_account(
            user, ["/bin/sh", "-c", MATRIX_FILE, "matrix-token", action], input=token, accepted=(0, 73)
        )
        if result.returncode != 0:
            refuse("cannot write or remove the person's Matrix token safely", 73)

    def matrix_issue(self, user):
        """Issue <host>-<user> and deliver its registration credential in the person's own home."""
        answer = self.matrix_call(user, "issue")
        self.matrix_file(user, "write", self.secret(answer.get("token")))

    def matrix_expel_revoke(self, user):
        """Expulsion revokes registration too; only a validated answer permits local cleanup."""
        answer = self.matrix_call(user, "expel")
        if (
            not isinstance(answer.get("expelled"), list)
            or any(not isinstance(account, str) for account in answer["expelled"])
            or type(answer.get("revoked")) is not bool
            or type(answer.get("known")) is not bool
            or (not answer["known"] and (answer["expelled"] or answer["revoked"]))
        ):
            refuse("Matrix answered no valid expulsion and revocation result", 69)
        self.matrix_file(user, "remove")

    def targets(self, user):
        """Check all publication/removal paths without creating directories."""
        paths = [
            self.path(f"/etc/ssh/authorized_keys/{user}"),
            self.path(f"/etc/porelo-host/people/{user}.conf"),
        ]
        for path in paths:
            self.check(path, 73)
        self.check(self.path(f"/etc/tmpfiles.d/porelo-person-{user}.conf"), 73)
        self.forge_tokens_directory(user, private=False)
        return paths

    def write_authorized_key(self, user, key, expires=None):
        """Publish the verified registry's single card key; root's pinned key has no expiry."""
        if not isinstance(user, str) or not re.fullmatch(USER, user) or not valid_ssh_key(key):
            refuse("invalid SSH account or public key", 65)
        options = ""
        if expires is not None:
            if not isinstance(expires, str) or not re.fullmatch(r"[0-9]{14}Z", expires):
                refuse("invalid SSH expiry", 65)
            try:
                datetime.datetime.strptime(expires, "%Y%m%d%H%M%SZ")
            except ValueError:
                refuse("invalid SSH expiry", 65)
            options = f'expiry-time="{expires}" '
        path = self.path(f"/etc/ssh/authorized_keys/{user}")
        self.check(path, 73)
        self.write(path, options + key + "\n", 0o644)

    def write_krl(self, keys):
        """Atomically publish only host-wide revocations supplied by the verified registry."""
        if not isinstance(keys, list) or any(not valid_ssh_key(key) for key in keys):
            refuse("invalid SSH revocation keys", 65)
        target = self.path("/etc/ssh/porelo-revoked.krl")
        self.check(target, 73)
        self.require(["ssh-keygen"])
        self.directories(target.parent)
        with tempfile.TemporaryDirectory(prefix=".porelo-krl-", dir=target.parent) as directory:
            source, output = Path(directory) / "keys", Path(directory) / "revoked.krl"
            self.write(source, "".join(key + "\n" for key in keys), 0o600)
            self.command(["ssh-keygen", "-q", "-k", "-f", str(output), str(source)])
            with output.open("rb") as stream:
                if stream.read(8) != b"SSHKRL\n\x00":
                    refuse("ssh-keygen produced no valid KRL", 69)
                os.fchown(stream.fileno(), self.owner, self.group)
                os.fchmod(stream.fileno(), 0o644)
                os.fsync(stream.fileno())
            os.replace(output, target)

    def apply_ssh_revocations(self, keys, users):
        """Apply verified host-wide KRL entries and end the affected accounts' existing tunnels."""
        if not isinstance(users, list) or any(
            not isinstance(user, str) or not re.fullmatch(USER, user) or user == "root" for user in users
        ):
            refuse("invalid SSH revocation accounts", 65)
        for user in users:
            if self.accounts is not None and user not in self.accounts:
                refuse("a revoked SSH account is missing", 65)
            self.uid(user)
        self.require(["loginctl", "systemctl"])
        self.write_krl(keys)
        errors = []
        for user in dict.fromkeys(users):
            try:
                self.end_sessions(user)
            except Refusal as error:
                errors.append(error)
        if errors:
            refuse("; ".join(str(error) for error in errors), errors[0].code)

    def admit_runtime(self, user):
        """Create a private return-socket directory and its persistent boot rule."""
        if not isinstance(user, str) or not re.fullmatch(USER, user):
            refuse("invalid SSH account", 65)
        entry = self.account(user)
        directory = self.forge_tokens_directory(user)
        rule = self.path(f"/etc/tmpfiles.d/porelo-person-{user}.conf")
        self.check(rule, 73)
        self.directories(directory.parent)
        changed = False
        if not directory.exists():
            directory.mkdir(mode=0o700)
            os.chown(directory, entry.pw_uid, entry.pw_gid)
            changed = True
        content = f"d /run/porelo-host/people/{user} 0700 {user} {user} -\n"
        if not rule.exists() or self.read(rule) != content or stat.S_IMODE(rule.stat().st_mode) != 0o644:
            self.write(rule, content, 0o644)
            changed = True
        return changed

    def remove_runtime(self, user):
        """Remove the return socket without following links in the person's writable directory."""
        if not isinstance(user, str) or not re.fullmatch(USER, user):
            refuse("invalid SSH account", 65)
        rule = self.path(f"/etc/tmpfiles.d/porelo-person-{user}.conf")
        self.check(rule, 73)
        rule.unlink(missing_ok=True)
        self.remove_forge_tokens(user)

    def end_sessions(self, user):
        """End every SSH tunnel and wait for the user's manager to stop."""
        if not isinstance(user, str) or not re.fullmatch(USER, user) or user == "root":
            refuse("invalid SSH session account", 65)
        errors = []
        for args, accepted in (
            (["loginctl", "terminate-user", user], (0, 1)),
            (["systemctl", "stop", f"user@{self.uid(user)}.service"], (0,)),
        ):
            try:
                self.command(args, accepted=accepted)
            except Refusal as error:
                errors.append(error)
        if errors:
            refuse("; ".join(str(error) for error in errors), errors[0].code)

    def directories(self, directory):
        """Create missing root directories privately; preserve safe existing directories."""
        if directory.exists():
            return
        self.directories(directory.parent)
        public = ("/etc/ssh/authorized_keys", "/run/porelo-host", "/run/porelo-host/people")
        mode = 0o755 if directory in map(self.path, public) else 0o700
        directory.mkdir(mode=mode)
        os.chown(directory, self.owner, self.group)
        directory.chmod(mode)

    def write(self, path, text, mode, owner=None, group=None):
        """Write beside the target, fsync and rename so no reader can see partial access or a record."""
        temporary = None
        try:
            self.directories(path.parent)
            fd, temporary = tempfile.mkstemp(prefix=".porelo-host-person.", dir=path.parent)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                os.fchown(stream.fileno(), self.owner if owner is None else owner, self.group if group is None else group)
                os.fchmod(stream.fileno(), mode)
                stream.write(text)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, path)
        except OSError:
            refuse(f"cannot write {path}", 73)
        finally:
            if temporary is not None:
                Path(temporary).unlink(missing_ok=True)

    def record(self, user, record):
        """Publish admission or completed revocation only after its preceding operations."""
        members = sorted(set(record["members"]), key=lambda item: member_key(item, 65))
        text = "".join(f"member={item}\n" for item in members)
        text += "locked=" + str(record["locked"]).lower() + "\n"
        text += "".join(
            f'laptop={item["laptop"]} {item["ssh"]} {item["wg"]} {item["address"]}\n' for item in record["laptops"]
        )
        self.write(self.path(f"/etc/porelo-host/people/{user}.conf"), text, 0o600)

    def subids(self, kind):
        """Read all subordinate ranges, rejecting malformed ranges rather than overlapping them."""
        path = self.path("/etc/" + kind)
        rows = []
        for line in self.read(path).splitlines():
            fields = line.split(":")
            if (
                len(fields) != 3
                or not re.fullmatch(r"[a-zA-Z0-9_-]+", fields[0])
                or not re.fullmatch(r"[0-9]{1,10}", fields[1])
                or not re.fullmatch(r"[0-9]{1,10}", fields[2])
                or int(fields[2]) < 1
                or int(fields[1]) + int(fields[2]) > 4294967295
            ):
                refuse(f"{kind} holds a malformed subordinate ID range", 69)
            rows.append((fields[0], int(fields[1]), int(fields[2])))
        return rows

    def next_range(self, rows):
        """A free 65536-ID interval after the highest occupied ID, at least 100000."""
        start = max([100000] + [start + count for _, start, count in rows])
        if start + 65536 > 4294967295:
            refuse("there is no free subordinate ID range", 69)
        return f"{start}-{start + 65535}"

    def create_account(self, user):
        """Create the home and private primary group before enabling user services."""
        # useradd must not allocate its own defaults before the explicit, prevalidated ranges.
        self.command(
            ["useradd", "--create-home", "--user-group", "--shell", "/bin/bash",
             "--key", "SUB_UID_COUNT=0", "--key", "SUB_GID_COUNT=0", user]
        )

    def enable_linger(self, user):
        """Allow the person's own user services to survive sign-out."""
        self.command(["loginctl", "enable-linger", user])

    def subordinate_ids(self, user, uid_range, gid_range):
        """Give the person's rootless containers their own nonoverlapping ID ranges."""
        self.command(["usermod", "--add-subuids", uid_range, user])
        self.command(["usermod", "--add-subgids", gid_range, user])

    def join_groups(self, user, groups):
        """Limit password sudo to people, adding virtualization groups only where installed."""
        if "porelo-people" not in groups:
            self.command(["groupadd", "--system", "porelo-people"])
            groups.add("porelo-people")
        names = [name for name in ("kvm", "libvirt") if name in groups] + ["porelo-people"]
        self.command(["usermod", "--append", "--groups", ",".join(names), user])

    def add(self, user, laptops, groups, uid_range, gid_range, members=("hand",)):
        """Apply validated admission in account, SSH, hook and record order.

        Once the account exists, a failure takes back what was given and records the person locked, so that purge
        can remove the account; unrecorded, every verb would refuse it as an account outside the people records.
        """
        self.create_account(user)
        try:
            self.grant(user, laptops, groups, uid_range, gid_range, members)
        except (Refusal, OSError) as error:
            record = {"members": [], "locked": False, "laptops": laptops}
            try:
                self.lock(user, record, False)
            except (Refusal, OSError):
                record["locked"] = True
                self.record(user, record)
            words = str(error) if isinstance(error, Refusal) else "cannot read or change the host's files"
            code = error.code if isinstance(error, Refusal) else 73
            refuse(f"{words}; the account is locked, and purge {user} removes it", code)

    def grant(self, user, laptops, groups, uid_range, gid_range, members=("hand",)):
        """Everything of an admission after the account, ending with the record that admits."""
        self.enable_linger(user)
        self.subordinate_ids(user, uid_range, gid_range)
        self.join_groups(user, groups)
        self.admit_runtime(user)
        self.write(
            self.path(f"/etc/ssh/authorized_keys/{user}"),
            "".join(f'{item["ssh"]}\n' for item in laptops),
            0o644,
        )
        self.hooks["forge_admit"](user, laptops)
        self.hooks["matrix_issue"](user)
        self.record(user, {"members": list(members), "locked": False, "laptops": laptops})

    def lock(self, user, record, porelo):
        """Remove access first; task-stop failure cannot prevent account revocation."""
        self.path(f"/etc/ssh/authorized_keys/{user}").unlink(missing_ok=True)
        self.path(f"/etc/wireguard/porelo-host-peers/{user}.conf").unlink(missing_ok=True)
        errors = []
        try:
            self.remove_runtime(user)
        except Refusal as error:
            errors.append(error)
        for name in ("forge_lock", "matrix_expel_revoke"):
            try:
                self.hooks[name](user)
            except Refusal as error:
                errors.append(error)
        if porelo:
            self.command(self.porelo(user, "task", "stop", "--all"), required=False)
        # Without linger or a session logind may already have let the person go, and knows nobody to end.
        for args, accepted in (
            (["loginctl", "terminate-user", user], (0, 1)),
            (["systemctl", "stop", f"user@{self.uid(user)}.service"], (0,)),
            (["usermod", "--lock", "--expiredate", "1", user], (0,)),
        ):
            try:
                self.command(args, accepted=accepted)
            except Refusal as error:
                errors.append(error)
        if errors:
            refuse("; ".join(str(error) for error in errors), errors[0].code)
        record["locked"] = True
        self.record(user, record)

    def clear_vault(self, user):
        """Porelo's lock-out order as the person: no task left that could hold a token, then the vault, no terminal.

        The lock expired the account, which PAM refuses to runuser and to the user manager the vault's runtime needs;
        only the expiry is lifted for this, the password stays locked and no key or peer lets anyone in. Any failure
        expires the account again, as the lock left it.
        """
        self.command(["usermod", "--expiredate", "", user])
        try:
            self.command(["systemctl", "start", f"user@{self.uid(user)}.service"])
            self.command(self.porelo(user, "task", "stop", "--all"))
            # Forced, Porelo still exits 1 for a transport's account kept elsewhere; as at down, only that may stay.
            cleared = self.command(self.porelo(user, "vault", "clear", "--yes", "--force", "--json"), accepted=(0, 1))
            if cleared.returncode != 0 and not only_transports_kept(cleared.stdout):
                refuse("porelo vault clear kept more than the accounts a transport keeps elsewhere", 69)
        except Refusal:
            self.command(["usermod", "--expiredate", "1", user])
            raise

    def purge(self, user, record, porelo, account_exists):
        """Lock before clearing the vault, deleting the account and releasing recorded IDs."""
        if not record["locked"]:
            self.lock(user, record, porelo)
        self.remove_runtime(user)
        if account_exists:
            lifted = False
            try:
                if porelo:
                    self.clear_vault(user)
                    lifted = True
                self.command(["loginctl", "disable-linger", user])
                # Without linger or a session logind may already have let the person go, and knows nobody to end.
                self.command(["loginctl", "terminate-user", user], accepted=(0, 1))
                # terminate-user returns before the manager ends; userdel refuses an account still running anything.
                self.command(["systemctl", "stop", f"user@{self.uid(user)}.service"])
                self.command(["userdel", "--remove", user])
            except Refusal:
                if lifted:
                    self.command(["usermod", "--expiredate", "1", user])
                raise
        for kind in ("subuid", "subgid"):
            path = self.path("/etc/" + kind)
            text = self.read(path)
            remaining = "".join(line for line in text.splitlines(keepends=True) if line.partition(":")[0] != user)
            if remaining != text:
                self.write(path, remaining, stat.S_IMODE(path.stat().st_mode))
        self.path(f"/etc/porelo-host/people/{user}.conf").unlink()

    def project_record(self, project):
        """Read and validate root's private project record, including any recorded sync state."""
        directory = self.path("/etc/porelo-host/projects")
        self.check(directory, directory=True, mode=0o700)
        path = directory / f"{project}.conf"
        if not path.exists() and not path.is_symlink():
            refuse(f"project {project} is not registered on this host", 65)
        self.check(path, required=True, mode=0o600)
        values, signers = {}, []
        allowed = {"admin", "signed_by", "publisher", "commit", "access_commit"}
        for line in self.read(path).splitlines():
            key, separator, value = line.partition("=")
            if not separator:
                refuse(f"{path} has a malformed or duplicate setting", 65)
            if key == "signer":
                if not valid_ssh_key(value) or value in signers:
                    refuse(f"{path} holds an invalid or duplicate signer key", 65)
                signers.append(value)
            elif key in allowed and key not in values:
                values[key] = value
            else:
                refuse(f"{path} has a malformed or duplicate setting", 65)
        admin = values.get("admin", "")
        signed_by = values.get("signed_by", "")
        publisher = values.get("publisher", "")
        if (
            not re.fullmatch(USER, admin)
            or not valid_ssh_key(signed_by)
            or publisher != "porelo-publisher-" + project
        ):
            refuse(f"{path} holds an invalid project registration", 65)
        synced = ("commit" in values, "access_commit" in values, bool(signers))
        if any(synced):
            if (
                not all(synced)
                or not re.fullmatch(COMMIT, values["commit"])
                or not re.fullmatch(COMMIT, values["access_commit"])
            ):
                refuse(f"{path} holds an incomplete or invalid sync state", 65)
        return path, {
            "admin": admin,
            "signed_by": signed_by,
            "publisher": publisher,
            "commit": values.get("commit"),
            "access_commit": values.get("access_commit"),
            "signers": signers,
        }

    def write_project_record(self, path, project_record, commit, access_commit, signers):
        """Record the applied sync commits and current signer keys atomically in projects/<project>.conf."""
        text = (
            f'admin={project_record["admin"]}\n'
            f'signed_by={project_record["signed_by"]}\n'
            f'publisher={project_record["publisher"]}\n'
            f"commit={commit}\n"
            f"access_commit={access_commit}\n"
            + "".join(f"signer={signer}\n" for signer in signers)
        )
        self.write(path, text, 0o600)

    def copy_admin_bundles(self, admin, project, destination):
        """Copy the admin's plain private project.bundle and access.bundle without following links."""
        entry = self.account(admin)
        try:
            relative_home = Path(entry.pw_dir).relative_to(self.root)
        except ValueError:
            refuse(f"{admin}'s home directory lies outside the host root", 65)
        dir_fd = None
        sources = {}
        try:
            try:
                dir_fd = os.open(self.root, os.O_RDONLY | os.O_DIRECTORY)
                for part in (*relative_home.parts, ".local", "share", "porelo-host", "setup", project):
                    next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dir_fd)
                    os.close(dir_fd)
                    dir_fd = next_fd
                for name in ("project.bundle", "access.bundle"):
                    bundle_fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
                    sources[name] = os.fdopen(bundle_fd, "rb")
                    status = os.fstat(sources[name].fileno())
                    if not stat.S_ISREG(status.st_mode) or status.st_uid != entry.pw_uid or status.st_mode & 0o022:
                        refuse(f"{name} for {project} is not a plain private file of {admin}'s", 65)
            except OSError:
                refuse(f"cannot read {admin}'s plain private setup bundles for {project}", 65)
            copied = {}
            try:
                for name, source in sources.items():
                    target = destination / name
                    out_fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                    with os.fdopen(out_fd, "wb") as sink:
                        os.fchown(sink.fileno(), self.owner, self.group)
                        os.fchmod(sink.fileno(), 0o600)
                        shutil.copyfileobj(source, sink)
                    copied[name] = target
            except OSError:
                refuse("cannot stage setup bundles in /run/porelo-host/sync", 73)
            return copied["project.bundle"], copied["access.bundle"]
        finally:
            for stream in sources.values():
                stream.close()
            if dir_fd is not None:
                os.close(dir_fd)

    def verify_bundles(self, project, admin, project_record):
        """Verify copied bundles through porelo project verify --json in an isolated throwaway unit."""
        sync_root = self.path("/run/porelo-host/sync")
        self.directories(sync_root)
        self.check(sync_root, 73, required=True, directory=True, mode=0o700)
        # Every call holds forge.conf's lock, so whatever is here was left by a sync stopped before its finally ran.
        try:
            for left in sync_root.iterdir():
                if stat.S_ISDIR(left.lstat().st_mode):
                    shutil.rmtree(left)
                else:
                    left.unlink()
        except OSError:
            refuse("cannot remove what an earlier sync left in /run/porelo-host/sync", 73)
        try:
            temp_dir = Path(tempfile.mkdtemp(prefix=f"{project}.", dir=sync_root))
            os.chown(temp_dir, self.owner, self.group)
            temp_dir.chmod(0o700)
        except OSError:
            refuse("cannot create a private sync directory under /run/porelo-host/sync", 73)
        try:
            project_copy, access_copy = self.copy_admin_bundles(admin, project, temp_dir)
            unit = f"porelo-host-sync-{project}"
            credentials = f"/run/credentials/{unit}.service"
            arguments = [
                "systemd-run",
                "--pipe",
                "--wait",
                "--quiet",
                "--collect",
                f"--unit={unit}",
                "-p",
                "DynamicUser=yes",
                "-p",
                "PrivateNetwork=yes",
                "-p",
                "ProtectHome=yes",
                "-p",
                f"LoadCredential=project.bundle:{project_copy}",
                "-p",
                f"LoadCredential=access.bundle:{access_copy}",
                "porelo",
                "project",
                "verify",
                "--json",
                "--project",
                project,
                "--repository",
                f"{credentials}/project.bundle",
                "--access-repository",
                f"{credentials}/access.bundle",
            ]
            for signer in project_record["signers"] or [project_record["signed_by"]]:
                arguments.extend(["--signed-by", signer])
            if project_record["commit"] is not None:
                arguments.extend(
                    ["--since", project_record["commit"], "--access-since", project_record["access_commit"]]
                )
            try:
                result = self.runner(arguments)
            except (OSError, subprocess.TimeoutExpired, UnicodeError) as error:
                refuse(f"systemd-run failed to complete ({type(error).__name__})", 69)
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)
        if result.returncode != 0:
            lines = [line.strip().removeprefix("porelo: ") for line in (result.stderr or "").splitlines() if line.strip()]
            words = "; ".join(lines)[:512] if lines else f"porelo project verify refused {project} (exit {result.returncode})"
            refuse(words, 65)
        try:
            verified = json.loads(result.stdout)
        except (ValueError, UnicodeError):
            refuse("porelo project verify answered no valid JSON", 69)
        if not isinstance(verified, dict):
            refuse("porelo project verify answered no JSON object", 69)
        if verified.get("project") != project:
            refuse(f"verified bundles belong to another project ({verified.get('project')})", 65)
        commit = verified.get("commit")
        access_commit = verified.get("access_commit")
        if (
            not isinstance(commit, str)
            or not re.fullmatch(COMMIT, commit)
            or not isinstance(access_commit, str)
            or not re.fullmatch(COMMIT, access_commit)
        ):
            refuse("porelo project verify answered no valid commit IDs", 69)
        signers = verified.get("signers")
        if (
            not isinstance(signers, list)
            or not signers
            or len(set(signers)) != len(signers)
            or any(not valid_ssh_key(key) for key in signers)
        ):
            refuse("porelo project verify answered no valid signer keys", 69)
        if not isinstance(verified.get("developers"), dict):
            refuse("porelo project verify answered no developers map", 65)
        return verified, commit, access_commit, signers

    def check_host_block(self, host_block, network):
        """Require access.yml's host block to match this host's CA digest."""
        ca_path = self.path("/etc/porelo-host/forge/ca.pem")
        blocks = re.findall(r"-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----", self.read(ca_path), re.DOTALL)
        if len(blocks) != 1:
            refuse(f"{ca_path} holds no single PEM certificate", 69)
        try:
            ca_sha256 = hashlib.sha256(ssl.PEM_cert_to_DER_cert(blocks[0])).hexdigest()
        except ValueError:
            refuse(f"{ca_path} holds no valid PEM certificate", 69)
        if not isinstance(host_block, dict):
            refuse("access.yml has no host block for this host", 65)
        expected = {
            "ca_sha256": ca_sha256,
        }
        mismatches = [
            f"{field} ({host_block.get(field)} != {value})"
            for field, value in expected.items()
            if host_block.get(field) != value
        ]
        if mismatches:
            refuse("access.yml host does not match this host: " + "; ".join(mismatches), 65)

    def update_person_laptops(self, user, laptops, added_laptops, dropped_laptops):
        """Bring an existing person's SSH keys to the desired legacy laptop list."""
        if added_laptops or dropped_laptops:
            self.write(
                self.path(f"/etc/ssh/authorized_keys/{user}"),
                "".join(f'{item["ssh"]}\n' for item in laptops),
                0o644,
            )

    def sync(self, project, network, reserved, records, accounts):
        """Verify signed project and access bundles, validate the complete diff and reconcile developers."""
        project_path, project_record = self.project_record(project)
        admin = project_record["admin"]
        if self.sudo_user is not None and self.sudo_user != admin:
            refuse(f"only project {project}'s recorded admin may run sync", 65)
        admin_record = records.get(admin)
        if (
            admin_record is None
            or admin_record["locked"]
            or not admin_record["members"]
            or accounts.get(admin) is None
        ):
            refuse(f"project {project}'s recorded admin {admin} has no unlocked host access", 65)
        self.check(self.path("/etc/porelo-host/forge/ca.pem"), required=True)
        self.require(["systemd-run", "porelo"])
        verified, commit, access_commit, next_signers = self.verify_bundles(project, admin, project_record)
        self.check_host_block(verified.get("host"), network)
        if project_record["commit"] == commit and project_record["access_commit"] == access_commit:
            return {
                "project": project,
                "commit": commit,
                "access_commit": access_commit,
                "added": [],
                "dropped": [],
                "laptops_added": [],
                "laptops_dropped": [],
                "unchanged": True,
            }
        developers = verified["developers"]
        groups = self.groups if self.groups is not None else {entry.gr_name for entry in grp.getgrall()}
        uid_min = self.uid_min()
        occupied_addr, occupied_ssh, occupied_wg = {}, {}, {}
        for person, rec in records.items():
            if person not in developers or rec["locked"]:
                for item in rec["laptops"]:
                    occupied_addr[item["address"]] = person
                    occupied_ssh[item["ssh"]] = person
                    occupied_wg[item["wg"]] = person
        problems = []
        seen_addr, seen_ssh, seen_wg = {}, {}, {}
        for user, spec in developers.items():
            if not isinstance(user, str) or not re.fullmatch(USER, user):
                problems.append(f"{user}: invalid person name")
                continue
            uid = accounts.get(user)
            rec = records.get(user)
            if user == "root" or (uid is not None and (uid < uid_min or rec is None)):
                problems.append(f"{user}: belongs to root, a system account or an account outside the people records")
            elif rec is not None:
                if rec["locked"]:
                    problems.append(f"{user}: person is locked; purge {user} first")
                elif uid is None:
                    problems.append(f"{user}: recorded person has no host account")
            elif user in groups:
                problems.append(f"{user}: name belongs to an existing group")
            laptop_specs = spec.get("laptops") if isinstance(spec, dict) else None
            if not isinstance(laptop_specs, list) or not laptop_specs:
                problems.append(f"{user}: must list at least one laptop")
                continue
            for index, item in enumerate(laptop_specs, start=1):
                if not isinstance(item, dict):
                    problems.append(f"{user} laptop {index}: invalid laptop entry")
                    continue
                ssh = item.get("ssh_public_key")
                wg = item.get("wireguard_public_key")
                address_raw = item.get("vpn_address")
                if not valid_ssh_key(ssh):
                    problems.append(f"{user} laptop {index}: invalid ssh_public_key")
                elif ssh in occupied_ssh or ssh in seen_ssh:
                    holder = occupied_ssh.get(ssh) or seen_ssh.get(ssh)
                    problems.append(f"{user}: ssh public key already belongs to {holder}")
                else:
                    seen_ssh[ssh] = user
                if not valid_wg_key(wg):
                    problems.append(f"{user} laptop {index}: invalid wireguard_public_key")
                elif wg in occupied_wg or wg in seen_wg:
                    holder = occupied_wg.get(wg) or seen_wg.get(wg)
                    problems.append(f"{user}: WireGuard public key already belongs to {holder}")
                else:
                    seen_wg[wg] = user
                address = parse_ipv4(address_raw)
                if address is None:
                    problems.append(f"{user} laptop {index}: invalid vpn_address")
                elif address not in network:
                    problems.append(f"{user}: vpn_address {address_raw} is outside {network}")
                elif address_raw in reserved:
                    problems.append(f"{user}: vpn_address {address_raw} is reserved on {network}")
                elif address_raw in occupied_addr or address_raw in seen_addr:
                    holder = occupied_addr.get(address_raw) or seen_addr.get(address_raw)
                    problems.append(f"{user}: vpn_address {address_raw} already belongs to {holder}")
                else:
                    seen_addr[address_raw] = user
        member_tag = f"{project} developer"
        dropped_people = [
            person for person, rec in sorted(records.items()) if member_tag in rec["members"] and person not in developers
        ]
        for person in dropped_people:
            rec = records[person]
            remaining = [item for item in rec["members"] if item != member_tag]
            if not remaining and not rec["locked"] and accounts.get(person) is None:
                problems.append(f"{person}: unlocked person to lock has no host account")
        if problems:
            refuse(f"cannot apply sync for {project}: " + "; ".join(problems), 65)

        added_people, laptops_added, laptops_dropped = [], [], []
        new_plans, existing_plans = [], []
        for user, spec in developers.items():
            rec = records.get(user)
            existing_laptops = [] if rec is None else rec["laptops"]
            planned, added_l, dropped_l = plan_laptops(existing_laptops, spec["laptops"])
            if rec is None or member_tag not in rec["members"]:
                added_people.append(user)
            laptops_added.extend(f"{user}/{item['laptop']}" for item in added_l)
            laptops_dropped.extend(f"{user}/{item['laptop']}" for item in dropped_l)
            if rec is None:
                new_plans.append((user, planned))
            else:
                existing_plans.append((user, rec, planned, added_l, dropped_l))

        uid_rows = self.subids("subuid") if new_plans else []
        gid_rows = self.subids("subgid") if new_plans else []
        subid_ranges = {}
        for user, _ in new_plans:
            uid_range = self.next_range(uid_rows)
            uid_rows.append((user, int(uid_range.partition("-")[0]), 65536))
            gid_range = self.next_range(gid_rows)
            gid_rows.append((user, int(gid_range.partition("-")[0]), 65536))
            subid_ranges[user] = (uid_range, gid_range)

        self.check(project_path, 73, required=True, mode=0o600)
        for user, _ in new_plans:
            self.targets(user)
        for user, rec, _, added_l, dropped_l in existing_plans:
            if member_tag not in rec["members"] or added_l or dropped_l:
                self.targets(user)
        for user in dropped_people:
            self.targets(user)

        users_to_lock = [
            user
            for user in dropped_people
            if not records[user]["locked"] and [m for m in records[user]["members"] if m != member_tag] == []
        ]
        programs = []
        if new_plans:
            programs.extend(["useradd", "loginctl", "usermod", "systemctl"])
            if "porelo-people" not in groups:
                programs.append("groupadd")
        if users_to_lock:
            programs.extend(["loginctl", "usermod", "systemctl", "runuser"])
        self.require(list(dict.fromkeys(programs)))
        for user, _ in new_plans:
            self.prepare_services(user, "add")
        for user in users_to_lock:
            self.prepare_services(user, "lock")
        forge_context = self.forge_developers_prepare(project, admin)

        for user, rec, planned, added_l, dropped_l in existing_plans:
            self.update_person_laptops(user, planned, added_l, dropped_l)
            if member_tag not in rec["members"] or added_l or dropped_l:
                members = rec["members"] if member_tag in rec["members"] else [*rec["members"], member_tag]
                self.record(user, {"members": members, "locked": False, "laptops": planned})
        for user, planned in new_plans:
            uid_range, gid_range = subid_ranges[user]
            self.add(user, planned, groups, uid_range, gid_range, members=(member_tag,))
        self.forge_developers_apply(forge_context, list(developers))
        for user in dropped_people:
            rec = records[user]
            rec["members"] = [item for item in rec["members"] if item != member_tag]
            if not rec["members"] and not rec["locked"]:
                self.lock(user, rec, True)
            else:
                self.record(user, rec)
        self.write_project_record(project_path, project_record, commit, access_commit, next_signers)
        return {
            "project": project,
            "commit": commit,
            "access_commit": access_commit,
            "added": added_people,
            "dropped": dropped_people,
            "laptops_added": laptops_added,
            "laptops_dropped": laptops_dropped,
            "unchanged": False,
        }

    def execute(self, arguments, data):
        """Validate the complete request under the configuration lock before applying it."""
        if self.euid != 0:
            refuse("runs only as root", 69)
        if arguments == ["restore-runtime"]:
            changed = 0
            conf = self.path("/etc/porelo-host/forge.conf")
            self.check(conf, required=True)
            with conf.open("rb") as mutex:
                fcntl.flock(mutex, fcntl.LOCK_EX)
                for login, record in self.records().items():
                    if record["members"] and not record["locked"]:
                        changed += self.admit_runtime(login)
            return {"changed": changed}
        project = None
        if len(arguments) == 4 and arguments[0] == "add" and arguments[2:] == ["--role", "project-admin"]:
            verb, user = arguments[:2]
        elif len(arguments) == 2 and arguments[0] in ("lock", "purge"):
            verb, user = arguments
        elif len(arguments) == 2 and arguments[0] == "sync":
            verb, project = arguments
            if not re.fullmatch(PROJECT, project):
                refuse("the project name must match [a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?")
        else:
            refuse("use add <user> --role project-admin, lock <user>, purge <user> or sync <project>")
        if project is None and not re.fullmatch(USER, user):
            refuse("the person name must match [a-z][a-z0-9-]{0,30}")
        conf = self.path("/etc/porelo-host/forge.conf")
        self.check(conf, required=True)
        with conf.open("rb") as mutex:
            fcntl.flock(mutex, fcntl.LOCK_EX)
            network, reserved = self.network()
            records = self.records()
            self.credentials(records, network, reserved)
            accounts = (
                self.accounts
                if self.accounts is not None
                else {entry.pw_name: entry.pw_uid for entry in pwd.getpwall()}
            )
            if verb == "sync":
                return self.sync(project, network, reserved, records, accounts)
            uid = accounts.get(user)
            if user == "root" or (uid is not None and (uid < self.uid_min() or user not in records)):
                refuse("the name belongs to root, a system account or an account outside the people records", 65)
            record = records.get(user)
            if verb != "add" and record is None:
                refuse("the person is unknown to the people records", 65)
            if verb == "add":
                laptops = key_block(sys.stdin.buffer.read(MAX_INPUT + 1) if data is None else data)
                if record is not None:
                    if record["locked"]:
                        refuse("the person is locked; purge them, then add them again", 65)
                    known = {item["laptop"]: item for item in record["laptops"]}
                    if uid is None or len(known) != len(laptops):
                        refuse("the recorded person has no account or has different laptops", 65)
                    for item in laptops:
                        old = known.get(item["laptop"])
                        if (
                            old is None
                            or old["ssh"] != item["ssh"]
                            or old["wg"] != item["wg"]
                            or item["address"] not in (None, old["address"])
                        ):
                            refuse("keys or addresses differ from the recorded laptop", 65)
                    if "hand" not in record["members"]:
                        record["members"] = ["hand", *record["members"]]
                        self.record(user, record)
                    return self.add_answer(user, record["laptops"])
                laptops = self.allocate(laptops, records, network, reserved)
                uid_range = self.next_range(self.subids("subuid"))
                gid_range = self.next_range(self.subids("subgid"))
                groups = self.groups if self.groups is not None else {entry.gr_name for entry in grp.getgrall()}
                # useradd --user-group makes the person's own group; a group of that name already there is a
                # system's or someone else's, such as Ubuntu's operator, and no new person's.
                if user in groups:
                    refuse("the name belongs to an existing group", 65)
                self.targets(user)
                self.require(
                    ["useradd", "loginctl", "usermod", "systemctl"] + ([] if "porelo-people" in groups else ["groupadd"])
                )
                self.prepare_services(user, verb)
                self.add(user, laptops, groups, uid_range, gid_range)
                return self.add_answer(user, laptops)
            if verb == "lock" and record["locked"]:
                if uid is not None:
                    self.require(["loginctl", "systemctl"])
                    self.end_sessions(user)
                self.remove_runtime(user)
                return {"person": user, "locked": True}
            if uid is None and not record["locked"]:
                refuse("the unlocked person has no account", 65)
            self.targets(user)
            programs = [] if record["locked"] else ["loginctl", "usermod", "systemctl"]
            porelo = self.available("porelo")
            if porelo and uid is not None:
                programs.append("runuser")
                if verb == "purge":
                    programs.extend(["usermod", "systemctl"])
            if verb == "purge":
                self.subids("subuid")
                self.subids("subgid")
                for kind in ("subuid", "subgid"):
                    self.check(self.path("/etc/" + kind), 73, required=True)
                if uid is not None:
                    programs.extend(["loginctl", "systemctl", "userdel"])
            self.require(programs)
            if not record["locked"]:
                self.prepare_services(user, verb)
            if verb == "lock":
                self.lock(user, record, porelo)
                return {"person": user, "locked": True}
            self.purge(user, record, porelo, uid is not None)
            return {"person": user, "purged": True}

    def add_answer(self, user, laptops):
        """The interface sees names and addresses, never the credential lines."""
        return {
            "person": user,
            "role": "project-admin",
            "laptops": [{"laptop": item["laptop"], "vpn_address": item["address"]} for item in laptops],
        }


def entry(host, arguments, data=None):
    """Turn every expected refusal into one safe diagnostic and the contract's exit code."""
    try:
        answer = host.execute(arguments, data)
    except Refusal as error:
        print(f"porelo-host-person: {error}", file=sys.stderr)
        return error.code
    except OSError:
        print("porelo-host-person: cannot read or change the host's files", file=sys.stderr)
        return 73
    print(json.dumps(answer, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    if os.geteuid() != 0:
        print("porelo-host-person: runs only as root", file=sys.stderr)
        sys.exit(69)
    sudo_user = os.environ.get("SUDO_USER")
    os.environ.clear()
    os.environ.update(ENV)
    host = Host()
    host.sudo_user = sudo_user
    sys.exit(entry(host, sys.argv[1:]))
else:

    def _test_entry(root, runner, *, euid, owner, accounts, groups, commands, hooks=None, sudo_user=None):
        """Import-only injection; there is no production argument or environment switch to reach it."""
        host = Host()
        host.root, host.runner, host.euid = root, runner, euid
        host.sudo_user = sudo_user
        host.owner, host.group = owner, os.getgid()
        host.accounts, host.groups, host.commands = accounts, groups, commands
        if hooks is not None:
            host.hooks = hooks
        return lambda arguments, data: entry(host, arguments, data)
