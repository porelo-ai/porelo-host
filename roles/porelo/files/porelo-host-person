# Installed by the transport's package outside every PATH, as the matrix role names it too.
TRANSPORT = "/usr/libexec/porelo/transports/porelo-message-transport-matrix"
ENV = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}
USER = r"[a-z][a-z0-9-]{0,30}"
PROJECT = r"[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?"
LAPTOP = r"[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?"
COMMIT = r"[0-9a-f]{40}([0-9a-f]{24})?"
MAX_INPUT = 262144


class Refusal(Exception):
    """A safe diagnostic and the interface's exit code."""

    def __init__(self, message, code=64):
        """Keep the interface exit code with the diagnostic."""
        super().__init__(message)
        self.code = code


def refuse(message, code=64):
    """Stop without echoing the input or a command's potentially sensitive output."""
    raise Refusal(message, code)


def run_command(arguments, input=None):
    """The only system command runner; no shell or inherited input/output."""
    return subprocess.run(
        arguments,
        stdin=subprocess.DEVNULL if input is None else None,
        input=input,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        check=False,
        cwd="/",
        env=ENV,
        timeout=60,
    )


def valid_ssh_key(ssh):
    """Return True when ssh is one canonical ssh-ed25519 public key without a comment."""
    if not isinstance(ssh, str):
        return False
    parts = ssh.split(" ")
    if len(parts) != 2 or parts[0] != "ssh-ed25519":
        return False
    try:
        blob = base64.b64decode(parts[1], validate=True)
    except (ValueError, binascii.Error):
        return False
    return (
        len(blob) == 51
        and blob[:19] == b"\x00\x00\x00\x0bssh-ed25519\x00\x00\x00\x20"
        and base64.b64encode(blob).decode() == parts[1]
    )


def valid_wg_key(wireguard):
    """Return True when wireguard is one canonical 32-byte base64 public key."""
    if not isinstance(wireguard, str):
        return False
    try:
        wg = base64.b64decode(wireguard, validate=True)
    except (ValueError, binascii.Error):
        return False
    return len(wg) == 32 and base64.b64encode(wg).decode() == wireguard


def public_keys(ssh, wireguard, code):
    """Check both canonical encodings and the SSH ed25519 wire format."""
    if not valid_ssh_key(ssh) or not valid_wg_key(wireguard):
        refuse("a laptop holds no valid public key", code)


def parse_ipv4(value):
    """Return an IPv4Address for a canonical IPv4 string, or None."""
    if not isinstance(value, str):
        return None
    try:
        address = ipaddress.IPv4Address(value)
    except ipaddress.AddressValueError:
        return None
    return address if str(address) == value else None


def ipv4(value, code):
    """A canonical IPv4 address, without a prefix or leading zeroes."""
    address = parse_ipv4(value)
    if address is None:
        refuse("a laptop or configuration holds no valid IPv4 address", code)
    return address


def plan_laptops(existing, desired_specs):
    """Keep unchanged recorded laptop names and assign lowest free l<n> names to new laptops."""
    by_tuple = {(item["ssh"], item["wg"], item["address"]): item for item in existing}
    desired_tuples = {
        (spec["ssh_public_key"], spec["wireguard_public_key"], spec["vpn_address"]) for spec in desired_specs
    }
    dropped = [item for item in existing if (item["ssh"], item["wg"], item["address"]) not in desired_tuples]
    used_names = {item["laptop"] for key, item in by_tuple.items() if key in desired_tuples}
    planned, added = [], []
    next_index = 1
    for spec in desired_specs:
        key = (spec["ssh_public_key"], spec["wireguard_public_key"], spec["vpn_address"])
        if key in by_tuple:
            planned.append(dict(by_tuple[key]))
        else:
            while f"l{next_index}" in used_names:
                next_index += 1
            name = f"l{next_index}"
            used_names.add(name)
            entry = {"laptop": name, "ssh": key[0], "wg": key[1], "address": key[2]}
            planned.append(entry)
            added.append(entry)
    return planned, added, dropped


def only_transports_kept(answer):
    """Whether a forced vault clear's JSON answer left nothing unremoved but accounts a transport keeps elsewhere."""
    try:
        cleared = json.loads(answer)
        kept = [item for item in cleared["items"] if item["status"] == "NOT_REMOVED"]
        return (
            cleared["refused"] is False
            and bool(kept)
            and all(item["kind"] in ("transport", "conversation") or item.get("transport") for item in kept)
        )
    except (ValueError, TypeError, KeyError, AttributeError):
        return False


def member_key(value, code=65):
    """Return the canonical sort key for one membership value, refusing unknown shapes."""
    if value == "hand":
        return (0, "", 0)
    parts = value.split(" ")
    if len(parts) == 2 and re.fullmatch(PROJECT, parts[0]) and parts[1] in ("project-admin", "developer"):
        return (1, parts[0], 0 if parts[1] == "project-admin" else 1)
    refuse("a record holds an invalid membership", code)


def key_block(data, code=64, addresses_required=False):
    """Read the interface's exact single-space fields, validating the entire block."""
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        refuse("standard input is not UTF-8", code)
    if len(data) > MAX_INPUT or not text:
        refuse("the laptop block is empty or too large", code)
    if text.endswith("\n"):
        text = text[:-1]
    result, names, ssh_keys, wg_keys = [], set(), set(), set()
    for line in text.split("\n"):
        fields = line.split(" ")
        if (
            len(fields) not in (4, 5)
            or any(not field for field in fields)
            or not re.fullmatch(LAPTOP, fields[0])
            or fields[1] != "ssh-ed25519"
        ):
            refuse("a laptop line must hold its name, ssh-ed25519 key, VPN key and optional address", code)
        name, ssh, wg = fields[0], " ".join(fields[1:3]), fields[3]
        public_keys(ssh, wg, code)
        address = str(ipv4(fields[4], code)) if len(fields) == 5 else None
        if addresses_required and address is None:
            refuse("a recorded laptop has no address", code)
        if name in names or ssh in ssh_keys or wg in wg_keys:
            refuse("a laptop name or public key is repeated in the block", code)
        names.add(name)
        ssh_keys.add(ssh)
        wg_keys.add(wg)
        result.append({"laptop": name, "ssh": ssh, "wg": wg, "address": address})
    return result


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Keep an admin credential from following an API redirect to another address."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        """Let the API caller refuse the redirect without forwarding its header."""
        return None


