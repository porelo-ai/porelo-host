{{ ansible_managed | comment }}
[Unit]
Description=Follow the host's organization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/sbin/porelo-host org follow
StandardInput=null
TimeoutStartSec={{ (300 * __porelo_host_limits.machines | float) | round(6) | round(0, 'ceil') | int }}s
