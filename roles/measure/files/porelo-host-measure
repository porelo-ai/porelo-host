#!/usr/bin/python3
"""Measure a disposable local host; write only selected, typed facts, never command messages."""

import argparse
import base64
import fcntl
import hashlib
import http.client
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

VERSION = 1
SHAPES = {"none": (False, False), "room": (False, True), "forge": (True, False), "both": (True, True)}
SAMPLES = ("first", "second", "third")
PATHS = ("/", "/var/lib", "/var/cache", "/home", "/var/lib/containers", "/var/lib/porelo-host")
SERVICES = {"porelo", "porelo-forge", "porelo-runner", "porelo-matrix"}
UNITS = {"system.slice", "user.slice", "machine.slice", "init.scope"}
FIELDS = {
    "cpu.model": "text",
    "cpu.count": "count",
    "cpu.virtualization": "text",
    "memory.total": "bytes",
    "disk.size": "bytes",
    "disk.rotational": "boolean",
    "kernel": "text",
    "system": "text",
    "kvm": "boolean",
    "provider": "text",
    "offer": "text",
    "collection.version": "text",
    "distribution": "text",
    "packages": "text",
    "package.version": "text",
    "memory.current": "bytes",
    "memory.peak": "bytes",
    "memory.anon": "bytes",
    "disk.used": "bytes",
    "up.time": "seconds",
    "up.state": "text",
    "work": "text",
    "disk.growth": "bytes",
    "start.time": "seconds",
    "work.time": "seconds",
    "cpu.time": "seconds",
    "developers": "count",
    **{
        f"changes.{kind}.{way}": "names"
        for kind in ("packages", "units", "accounts", "directories")
        for way in ("added", "removed")
    },
}
ORGANIZATION = "organization: {address: 'git@central.example:acme/organization.git', forge: central.example}\n"
# A key whose private half was thrown away when it was made, so the stand-in organization is signed by nobody.
NOBODY = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILFraP+M35OcLFjqbjgKBCM2EA+3jOGl/hN9CE3dkT7C"
PROBLEMS = (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError)


def put(report, field, value, step, *, sample=None, subject=None, why=None):
    """The only route into the result: refuse unknown fields and values of the wrong type."""
    unit = FIELDS[field]
    if step not in {"machine", "before", "after", "task", "agent", "job", *(f"idle.{s}" for s in SHAPES)}:
        raise ValueError("unknown step")
    if value is None:
        if not why:
            raise ValueError("an absent value needs a reason")
    elif unit in ("bytes", "count", "seconds"):
        if type(value) not in (int, float) or value < 0 or not math.isfinite(value):
            raise ValueError("invalid number")
    elif unit == "boolean":
        if type(value) is not bool:
            raise ValueError("invalid boolean")
    elif unit == "names":
        if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
            raise ValueError("invalid names")
    elif not isinstance(value, str) or len(value) > 240 or any(ord(c) < 32 for c in value):
        raise ValueError("invalid text")
    row = {"field": field, "value": value, "unit": unit, "step": step}
    if sample is not None:
        if sample not in SAMPLES:
            raise ValueError("unknown sample")
        row["sample"] = sample
    if subject is not None:
        row["subject"] = subject
    if value is None:
        row["why"] = why
    report["facts"].append(row)


def unit_name(name):
    """A unit's file by what it is: an instance without what it was made for, a backup without its time, and no other name."""
    found = re.fullmatch(r"([^@]+?)(@.*?)?\.(service|socket|timer|path|target)(\..*|~)?", name)
    if not found:
        return "another file"
    shown = found[1] + ("@" if found[2] is not None else "") + "." + found[3]
    return shown + " (backup)" if found[4] else shown


STOPS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)


class Machine:
    """All contact with the host; tests replace this with files and a command stand-in."""

    dirty = False
    stopping = False
    holding = False

    def __init__(self, root=""):
        self.root = Path(root) if root else Path("/")
        self.collection = Path(__file__).resolve().parents[3]

    def path(self, name):
        """Resolve a machine path below the fixture directory."""
        return self.root / name.lstrip("/")

    def read(self, name):
        """Read a file; absence is different from an unreadable file."""
        try:
            return self.path(name).read_text(encoding="utf-8")
        except FileNotFoundError:
            return None

    def euid(self):
        """Ask who runs this, without changing the machine."""
        return os.geteuid()

    def command(self, arguments, timeout, given=None):
        """Bound the whole process group, including Ansible's children; never print its output. What is given goes to
        standard input, never onto the command line."""
        environment = dict(os.environ, ANSIBLE_STDOUT_CALLBACK="porelo.host.lines", ANSIBLE_NOCOLOR="1")
        with subprocess.Popen(
            arguments,
            stdin=subprocess.PIPE if given is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=environment,
            start_new_session=True,
        ) as process:
            try:
                if given is None:
                    output, _ = process.communicate(timeout=timeout)
                else:
                    output, _ = process.communicate(given, timeout=timeout)
            except BaseException:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.communicate()
                raise
            return process.returncode, output

    def forge(self, method, route, body=None):
        """Ask the host's forge as its admin, through its socket; the token goes to curl on standard input only."""
        uid = self.account("porelo-forge")
        home = next(
            (
                line.split(":")[5]
                for line in (self.read("/etc/passwd") or "").splitlines()
                if line.startswith("porelo-forge:")
            ),
            None,
        )
        token = (self.read(f"{home}/.config/porelo-forge/api.token") or "").strip() if home else ""
        if uid is None or not token:
            raise ValueError("the host's forge has no admin token")
        words = [
            "curl",
            "-sS",
            "--max-time",
            "120",
            "-K",
            "-",
            "--unix-socket",
            f"/run/user/{uid}/porelo-forge/http.sock",
        ]
        words += ["-X", method, "-H", "Content-Type: application/json", "-w", "\n%{http_code}"]
        words += ["-d", json.dumps(body)] if body is not None else []
        code, output = self.command(
            [*words, f"http://localhost/api/v1/{route}"], 180, f'header = "Authorization: token {token}"\n'
        )
        text, unused, status = output.rpartition("\n")
        if code != 0 or not status.strip().isdigit():
            return 0, None
        try:
            return int(status), json.loads(text) if text.strip().startswith(("{", "[")) else None
        except json.JSONDecodeError:
            return int(status), None

    def fetch(self, url, timeout):
        """Read one published file anonymously; an answer other than 200 is an OSError."""
        with urllib.request.urlopen(url, timeout=timeout) as answer:
            return answer.read()

    def pause(self, seconds):
        """Wait without using wall-clock time in tests."""
        time.sleep(seconds)

    def clock(self):
        """A duration is measured by a monotonic clock."""
        return time.monotonic()

    def kvm(self):
        """Ask KVM's API without loading a module or creating a VM."""
        try:
            with self.path("/dev/kvm").open("rb", buffering=0) as stream:
                return fcntl.ioctl(stream.fileno(), 0xAE00, 0) == 12
        except OSError:
            return False

    def groups(self):
        """The top slices, the service accounts' by name, and their sum as the host; the kernel's root has no file."""
        root = self.path("/sys/fs/cgroup")
        accounts = {}
        for line in (self.read("/etc/passwd") or "").splitlines():
            parts = line.split(":")
            if len(parts) == 7 and parts[0] in SERVICES:
                accounts[f"user.slice/user-{parts[2]}.slice"] = parts[0]
        groups = {}
        for relative, label in {**{unit: unit for unit in sorted(UNITS)}, **accounts}.items():
            directory = root / relative
            if not (directory / "memory.current").exists():
                continue
            values = {}
            for name in ("current", "peak"):
                try:
                    text = (directory / f"memory.{name}").read_text().strip()
                    values[name] = int(text) if re.fullmatch(r"[0-9]+", text) else None
                except OSError:
                    values[name] = None
            # What is in use, as current holds the page cache too, which the kernel gives back when asked.
            anon = re.search(r"(?m)^anon ([0-9]+)$", self.read(f"/sys/fs/cgroup/{relative}/memory.stat") or "")
            values["anon"] = int(anon[1]) if anon else None
            groups[label] = values
        tops = [groups[unit] for unit in UNITS if unit in groups]
        if tops:
            groups["host"] = {"peak": None}
            for name in ("current", "anon"):
                numbers = [top[name] for top in tops]
                groups["host"][name] = None if None in numbers else sum(numbers)
        return groups

    def account(self, name):
        """An account's uid, or None."""
        for line in (self.read("/etc/passwd") or "").splitlines():
            parts = line.split(":")
            if len(parts) == 7 and parts[0] == name and parts[2].isdigit():
                return int(parts[2])
        return None

    def slice_reading(self, uid):
        """An account's slice: memory in use, its peak, and the CPU it has used, each None where the kernel has no file."""
        relative = f"user.slice/user-{uid}.slice"
        values = {}
        for name in ("current", "peak"):
            text = (self.read(f"/sys/fs/cgroup/{relative}/memory.{name}") or "").strip()
            values[name] = int(text) if re.fullmatch(r"[0-9]+", text) else None
        anon = re.search(r"(?m)^anon ([0-9]+)$", self.read(f"/sys/fs/cgroup/{relative}/memory.stat") or "")
        values["anon"] = int(anon[1]) if anon else None
        usage = re.search(r"(?m)^usage_usec ([0-9]+)$", self.read(f"/sys/fs/cgroup/{relative}/cpu.stat") or "")
        values["cpu"] = int(usage[1]) / 1e6 if usage else None
        return values

    def disk(self, path):
        """Filesystem bytes used at a growing path; shared filesystems must not be summed."""
        stats = os.statvfs(self.path(path))
        return (stats.f_blocks - stats.f_bfree) * stats.f_frsize

    def packages(self):
        """Read installed package names and versions from dpkg's database, without a command."""
        text = self.read("/var/lib/dpkg/status")
        if text is None:
            raise ValueError("cannot read installed packages")
        packages = {}
        for paragraph in text.split("\n\n"):
            fields = dict(
                line.split(": ", 1) for line in paragraph.splitlines() if ": " in line and not line[0].isspace()
            )
            name, version = fields.get("Package", ""), fields.get("Version", "")
            if fields.get("Status") == "install ok installed" and re.fullmatch(r"[a-z0-9][a-z0-9+.-]*", name):
                if re.fullmatch(r"[0-9][A-Za-z0-9.+:~_-]*", version):
                    packages[name] = version
        return packages

    def snapshot(self):
        """List names before and after; only the difference is published."""
        # A person's name never enters the result: only what a package or a role makes, by its low uid or known name.
        accounts = set()
        for line in (self.read("/etc/passwd") or "").splitlines():
            parts = line.split(":")
            if len(parts) == 7 and (parts[0] in SERVICES or (parts[2].isdigit() and int(parts[2]) < 1000)):
                accounts.add(parts[0])
        units = set()
        for directory in ("/etc/systemd/system", "/usr/lib/systemd/system", "/usr/lib/systemd/user"):
            units.update(unit_name(p.name) for p in self.path(directory).rglob("*") if p.is_file() or p.is_symlink())
        directories = set()
        for directory in ("/", "/home", "/var/lib"):
            directories.update(
                directory.rstrip("/") + "/" + p.name for p in self.path(directory).iterdir() if p.is_dir()
            )
        return {"packages": set(self.packages()), "units": units, "accounts": accounts, "directories": directories}

    def obstruction(self, fresh):
        """Refuse before creating even a temporary inventory; uncertainty cannot permit destruction."""
        if not fresh:
            return "give --fresh only for a disposable fresh machine"
        if self.euid() != 0:
            return "run as root"
        for directory in ("/etc/porelo-host/people", "/var/lib/porelo-host/people"):
            path = self.path(directory)
            if path.is_symlink() or (path.exists() and not path.is_dir()):
                return "cannot safely inspect person records"
            if path.exists() and any(p.name != "purged" for p in path.iterdir()):
                return "a person record is present"
        # The room database is not a standard-library format; any existing homeserver data is unsafe to remove.
        for line in (self.read("/etc/passwd") or "").splitlines():
            parts = line.split(":")
            if len(parts) == 7 and parts[0] == "porelo-matrix":
                return "an existing homeserver may hold a room"
            if len(parts) == 7 and parts[5].startswith("/"):
                volume = parts[5] + "/.local/share/containers/storage/volumes/porelo-matrix-homeserver"
                if self.path(volume).exists():
                    return "an existing homeserver may hold a room"
        if self.path("/etc/porelo-host/matrix").exists():
            return "an existing homeserver may hold a room"
        # What a down removes with its account or directory: a fresh machine has seen neither.
        for line in (self.read("/etc/passwd") or "").splitlines():
            if line.split(":")[0] in ("porelo-forge", "porelo-runner"):
                return "an existing forge may hold repositories"
        for directory in ("/etc/porelo-host", "/var/lib/porelo-host"):
            if self.path(directory).exists() or self.path(directory).is_symlink():
                return f"{directory} is here, so this machine has seen an up or an interface"
        return None

    def stand_in_organization(self):
        """What the interface hands an up, for an organization that does not exist: the follow only waits for it."""
        key = " ".join((self.read("/etc/ssh/ssh_host_ed25519_key.pub") or "").split()[:2])
        if not key:
            raise ValueError("no ed25519 host key to stand in for")
        machine = self.path("/etc/porelo-host/setup/machine.yml")
        machine.parent.mkdir(parents=True, exist_ok=True)
        descriptor = os.open(machine, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(
                {
                    "organization": {
                        "settings": ORGANIZATION,
                        "known_hosts": f"central.example {key}\n",
                        "pin": f"hostadmin {NOBODY}\n",
                    }
                },
                stream,
            )

    def play(self, inventory, name):
        """Run with only this run's inventory, not the invoking person's inventory."""
        return self.command(
            ["ansible-playbook", "-c", "local", "-i", str(inventory), f"porelo.host.{name}"],
            600 if name == "up" else 300,
        )


def known_tasks(collection):
    """Only names written in the collection can become a stop reason; never a command's arbitrary text."""
    names = set()
    for path in [*collection.glob("playbooks/*.yml"), *collection.glob("roles/*/tasks/*.yml")]:
        for name in re.findall(r"^\s*- name: (.+)$", path.read_text(), re.M):
            if "{{" not in name and len(name) < 200:
                names.add(name)
                if "roles" in path.parts:
                    names.add(f"{path.parents[1].name} : {name}")
                    names.add(f"porelo.host.{path.parents[1].name} : {name}")
    return names


def outcome(code, output, tasks):
    """Read the lines contract, discarding messages and every unknown field."""
    states = []
    for line in output.splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if not isinstance(row, dict) or row.get("v") != 1:
            continue
        state = row.get("state")
        if state == "failed":
            task = row.get("task")
            return None, task if isinstance(task, str) and task in tasks else "unrecognized stop task"
        if state in ("ok", "changed", "waiting"):
            states.append(state)
    if states and states[-1] == "waiting":
        return "waiting", None
    if code == 0 and states:
        return "reached", None
    return None, "up did not report reaching its end"


def settled(machine):
    """Pause, then require three close readings within 24 seconds, in addition to the first pause."""
    machine.pause(5)
    window = []
    for _ in range(12):
        groups = machine.groups()
        values = {key: value["current"] for key, value in groups.items() if key in UNITS or key == "host"}
        if not values or any(v is None for v in values.values()):
            return "cgroup memory is unavailable"
        # What is in use as well: a service starting takes over the cache under a still total.
        values.update(
            {
                (key, "anon"): value["anon"]
                for key, value in groups.items()
                if (key in UNITS or key == "host") and value.get("anon") is not None
            }
        )
        window = [earlier for earlier in window if earlier.keys() == values.keys()][-2:] + [values]
        if len(window) == 3 and all(
            max(reading[key] for reading in window) - min(reading[key] for reading in window)
            <= max(1024**2, value // 100)
            for key, value in values.items()
        ):
            return None
        machine.pause(2)
    return "memory did not settle within 24 seconds"


def readings(machine, report, step, sample, why=None):
    """Keep each observation, including absent peaks and paths, with its own step and unit."""
    why = why or settled(machine)
    groups = machine.groups()
    for subject, values in (groups or {"host": {"current": None, "peak": None}}).items():
        for name, value in values.items():
            put(
                report,
                f"memory.{name}",
                None if why else value,
                step,
                sample=sample,
                subject=subject,
                why=why or "cgroup file is unavailable",
            )
    for path in PATHS:
        try:
            value = machine.disk(path)
        except OSError:
            value = None
        put(
            report,
            "disk.used",
            None if why else value,
            step,
            sample=sample,
            subject=path,
            why=why or "path is unavailable",
        )


def facts(machine, report, given):
    """Select hardware fields from kernel files, without reading host or network identities."""
    cpu = machine.read("/proc/cpuinfo") or ""
    model = re.search(r"(?m)^model name\s*:\s*(.+)$", cpu)
    flags = set(" ".join(re.findall(r"(?m)^flags\s*:\s*(.+)$", cpu)).split())
    memory = re.search(r"(?m)^MemTotal:\s+([0-9]+) kB$", machine.read("/proc/meminfo") or "")
    system = dict(re.findall(r"^([A-Z_]+)=(.*)$", machine.read("/etc/os-release") or "", re.M))
    values = {
        "cpu.model": model[1] if model else None,
        "cpu.count": len(re.findall(r"(?m)^processor\s*:", cpu)) or None,
        "cpu.virtualization": (" ".join(sorted(flags & {"vmx", "svm"})) or "none") if cpu else None,
        "memory.total": int(memory[1]) * 1024 if memory else None,
        "kernel": (machine.read("/proc/sys/kernel/osrelease") or "").strip() or None,
        "system": " ".join(system.get(k, "").strip('"') for k in ("ID", "VERSION_ID")).strip() or None,
        "kvm": machine.kvm(),
        "provider": given.get("provider"),
        "offer": given.get("offer"),
    }
    manifest = machine.collection / "MANIFEST.json"
    galaxy = machine.collection / "galaxy.yml"
    if manifest.exists():
        values["collection.version"] = json.loads(manifest.read_text())["collection_info"]["version"]
    else:
        version = re.search(r"(?m)^version:\s*(\S+)", galaxy.read_text())
        values["collection.version"] = version[1].strip("\"'") if version else None
    for field, value in values.items():
        put(report, field, value, "machine", why="not available" if value is None else None)
    disks = [
        p for p in sorted(machine.path("/sys/block").glob("*")) if not re.fullmatch(r"(?:loop|ram|zram)[0-9]+", p.name)
    ]
    for disk in disks:
        for field, path, factor in (("disk.size", "size", 512), ("disk.rotational", "queue/rotational", 1)):
            text = machine.read(f"/sys/block/{disk.name}/{path}") or ""
            value = int(text.strip()) * factor if re.fullmatch(r"[0-9]+\s*", text) else None
            if field == "disk.rotational" and value is not None:
                value = bool(value) if value in (0, 1) else None
            put(report, field, value, "machine", subject=disk.name, why="not available")
    if not disks:
        for field in ("disk.size", "disk.rotational"):
            put(report, field, None, "machine", why="no block device reported")


def versions(machine, report, step):
    """Keep installed podman and Porelo package versions, including their absence."""
    packages = machine.packages()
    selected = {name: version for name, version in packages.items() if name == "podman" or name.startswith("porelo")}
    selected.setdefault("podman", None)
    selected.setdefault("porelo", None)
    for name, version in sorted(selected.items()):
        put(report, "package.version", version, step, subject=name, why="not installed")


def differences(report, before, after):
    """Name residual changes; existing account names never enter the result."""
    for kind in before:
        for way, names in (("added", after[kind] - before[kind]), ("removed", before[kind] - after[kind])):
            private = kind == "directories" and any(p.startswith("/home/") and p[6:] not in SERVICES for p in names)
            put(
                report,
                f"changes.{kind}.{way}",
                None if private else sorted(names),
                "after",
                why="change includes a person's directory",
            )


def run(machine, given, steps, distribution="releases", count=2, raised=False, packages=None):
    """Measure before and each requested shape, always taking down even a failed up."""
    report = {"v": VERSION, "facts": []}
    local = handed_over(machine, packages) if packages else None
    pins = local["pins"] if local else pinned(machine, distribution)
    machine.local_stub = bool(local and local["stub"])
    before = machine.snapshot()
    facts(machine, report, given)
    put(report, "distribution", distribution, "machine")
    if local:
        put(report, "packages", local["sums"], "machine")
    versions(machine, report, "before")
    tasks = known_tasks(machine.collection)
    for sample in SAMPLES:
        readings(machine, report, "before", sample)
    if "idle" in steps:
        with tempfile.TemporaryDirectory(prefix="porelo-measure-") as directory:
            inventory = Path(directory) / "inventory.json"
            for shape, (forge, room) in SHAPES.items():
                inventory.write_text(json.dumps(inventory_of(distribution, forge, room, pins)))
                stopped = None
                for sample in SAMPLES:
                    step = f"idle.{shape}"
                    if stopped:
                        put(report, "up.state", None, step, sample=sample, why=stopped)
                        put(report, "up.time", None, step, sample=sample, why=stopped)
                        readings(machine, report, step, sample, stopped)
                        continue
                    state, why, elapsed = None, None, None
                    machine.dirty = True
                    try:
                        try:
                            why = settled(machine)
                            if not why:
                                machine.stand_in_organization()
                                start = machine.clock()
                                code, output = machine.play(inventory, "up")
                                elapsed = machine.clock() - start
                                state, why = outcome(code, output, tasks)
                        except PROBLEMS:
                            why = "up could not run"
                        put(report, "up.state", state, step, sample=sample, why=why)
                        put(report, "up.time", elapsed if state else None, step, sample=sample, why=why)
                        readings(machine, report, step, sample, why)
                        stopped = why
                    finally:
                        # A signal now only asks: a down cut in two would leave what no later one reads.
                        machine.holding = True
                        code, output = machine.play(inventory, "down")
                        state, unused = outcome(code, output, tasks)
                        if code != 0 or state != "reached":
                            raise ValueError("down failed; refusing to measure over leftovers")
                        machine.dirty = False
                        machine.holding = False
                        if machine.stopping:
                            raise KeyboardInterrupt
    if "task" in steps:
        with tempfile.TemporaryDirectory(prefix="porelo-measure-") as directory:
            inventory = Path(directory) / "inventory.json"
            inventory.write_text(json.dumps(inventory_of(distribution, False, True, pins)))
            task_step(machine, report, inventory, tasks, count)
            if raised:
                raise_step(machine, report, inventory, tasks)
    if "job" in steps:
        job_step(machine, report, tasks, distribution, pins)
    for step in ("task", "agent", "job"):
        if step in ("task", "job") and step in steps:
            continue
        why = "not measured"
        if step == "agent":
            why += ": real work needs a token and a model's answer varies"
        for sample in SAMPLES:
            for field in ("work", "memory.peak", "disk.growth", "start.time", "work.time", "cpu.time"):
                put(report, field, None, step, sample=sample, why=why)
    versions(machine, report, "after")
    differences(report, before, machine.snapshot())
    return report


# The snapshots channel holds no release, so a run from it names the newest Porelo and host program it holds; apt still
# checks what it installs against the channel's signature.
CHANNEL = "https://fuinorg.jfrog.io/artifactory/porelo-dist-deb/dists/{}/main/binary-amd64/Packages"


def pinned(machine, distribution):
    """The package versions up is to install: the roles' own for releases, the channel's newest for snapshots."""
    if distribution != "snapshots":
        return {}
    try:
        index = machine.fetch(CHANNEL.format(distribution), 120).decode("utf-8")
    except (OSError, http.client.HTTPException, UnicodeDecodeError) as error:
        raise ValueError("the snapshots channel's index could not be read") from error
    newest = {}
    for stanza in index.split("\n\n"):
        fields = dict(re.findall(r"(?m)^(Package|Version): (\S+)$", stanza))
        name, version = fields.get("Package"), fields.get("Version")
        if name in ("porelo", "porelo-host") and re.fullmatch(r"[0-9][A-Za-z0-9.+:~_-]*", version or ""):
            newest[name] = max(newest.get(name, version), version, key=debian_order)
    if set(newest) != {"porelo", "porelo-host"}:
        raise ValueError("the snapshots channel names no porelo or no porelo-host")
    return {"porelo_version": newest["porelo"], "porelo_host_version": newest["porelo-host"]}


# The packages build/stage-packages.sh stages: <package>.deb and <package>.version, SHA256SUMS over every file.
STAGED = re.compile(r"([0-9a-f]{64})  \./([a-z0-9][a-z0-9+.-]*\.(?:deb|version))")


def handed_over(machine, directory):
    """A local hand-over checked by its sums, as the channel is by its signature; its pins, its sums' digest, its stub."""
    if not directory.startswith("/"):
        raise ValueError("the handed-over packages must be an absolute directory")
    sums = machine.read(directory.rstrip("/") + "/SHA256SUMS")
    if not sums:
        raise ValueError("the handed-over packages hold no SHA256SUMS")
    listed = {}
    for line in sums.splitlines():
        found = STAGED.fullmatch(line)
        if not found:
            raise ValueError("SHA256SUMS of the handed-over packages has a line of another shape")
        listed[found[2]] = found[1]
    place = machine.path(directory)
    files = {entry.name for entry in place.iterdir() if entry.name != "SHA256SUMS"}
    if files != set(listed):
        raise ValueError("the handed-over packages and their SHA256SUMS name different files")
    for name, digest in listed.items():
        if hashlib.sha256((place / name).read_bytes()).hexdigest() != digest:
            raise ValueError(f"the handed-over {name} does not match its SHA-256")
    versions = {}
    for name in ("porelo", "porelo-host"):
        if f"{name}.deb" not in listed or f"{name}.version" not in listed:
            raise ValueError(f"the handed-over packages hold no {name}")
        versions[name] = (place / f"{name}.version").read_text(encoding="utf-8").strip()
        if not re.fullmatch(r"[0-9][A-Za-z0-9.+:~_-]*", versions[name]):
            raise ValueError(f"the handed-over {name} has no valid version")
    pins = {
        "porelo_version": versions["porelo"],
        "porelo_host_version": versions["porelo-host"],
        "porelo_local_packages": directory.rstrip("/"),
    }
    digest = hashlib.sha256(sums.encode("utf-8")).hexdigest()
    return {"pins": pins, "sums": digest, "stub": "porelo-agent-stub.deb" in listed}


def debian_order(version):
    """Enough of Debian's order for Porelo's versions: digits as numbers, and a tilde before everything, even the end."""
    key = []
    for part in re.findall(r"[0-9]+|~|[^0-9~]+", version):
        key.append((0, 0, "") if part == "~" else (2, int(part), "") if part.isdigit() else (1, 0, part))
    return key + [(0.5, 0, "")]


def inventory_of(distribution, forge, room, pins=None):
    """This run's own inventory for one shape, and no person's."""
    return {
        "all": {
            "hosts": {
                "localhost": {
                    "ansible_connection": "local",
                    "porelo_host_inventory_version": 2,
                    "porelo_host_name": "measure",
                    "porelo_host_network": 7,
                    "porelo_host_distribution": distribution,
                    "porelo_host_kvm": False,
                    "porelo_host_forge": forge,
                    "porelo_host_room": room,
                    # A measuring host has no person who could certify a task, so it is in the host's test mode:
                    # its developers' tasks start uncertified, which up says loudly and down takes away.
                    "porelo_host_test_switches": ["start-uncertified"],
                    "porelo_host_test_why": "porelo-host-measure: a measuring host, given back after the run",
                    **(pins or {}),
                }
            }
        }
    }


# The throwaway developer: made by this run, as porelo-host-person makes a person, and removed with everything it has.
DEVELOPER = "porelo-measure"
TASK_FIELDS = ("work", "memory.peak", "disk.growth", "start.time", "work.time", "cpu.time")


def as_developer(machine, uid, arguments, timeout, given=None, name=DEVELOPER):
    """Run as the throwaway developer in its own session's environment, from its home."""
    return machine.command(
        [
            "runuser", "-u", name, "--", "env", "-C", f"/home/{name}", f"HOME=/home/{name}",
            f"XDG_RUNTIME_DIR=/run/user/{uid}", f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
            *arguments,
        ],  # fmt: skip
        timeout,
        given,
    )


# Porelo's stub agent is in no package channel: each version of it in a folder of its own, its SHA-256 beside it.
STUB = "https://fuinorg.jfrog.io/artifactory/porelo-dist-test/porelo-agent-stub/{}/porelo-agent-stub"
STUB_HOME = "/home/{}/.local/lib/porelo-agent-stub/stub"


def stub_agent(machine):
    """The stub of the installed Porelo's version, as its digest names it; the bytes, or why there are none.

    None and no reason where the handed-over packages hold the stub: its package registers it for every account."""
    if getattr(machine, "local_stub", False):
        return None, None
    version = machine.packages().get("porelo")
    if not version or not re.fullmatch(r"[0-9][A-Za-z0-9.+:~_-]*", version):
        return None, "Porelo is not installed, so no stub agent version is known"
    url = STUB.format(version)
    try:
        digest = machine.fetch(url + ".sha256", 120).decode("ascii").split()[0]
        stub = machine.fetch(url, 300)
    except (OSError, http.client.HTTPException, UnicodeDecodeError, IndexError):
        return None, f"the stub agent {version} could not be fetched; its folder keeps the newest versions only"
    if hashlib.sha256(stub).hexdigest() != digest.lower():
        return None, f"the stub agent {version} does not match its SHA-256"
    return stub, None


def place_stub(machine, uid, stub, name=DEVELOPER):
    """The stub put into the developer's own home by the developer, and named in its agents.d, as Porelo finds it."""
    drop = machine.path("/run/porelo-host-measure-stub")
    shutil.rmtree(drop, ignore_errors=True)
    drop.mkdir()
    try:
        drop.chmod(0o755)
        (drop / "stub").write_bytes(stub)
        (drop / "stub").chmod(0o644)
        place = ["install", "-D", "-m", "755", "/run/porelo-host-measure-stub/stub", STUB_HOME.format(name)]
        if as_developer(machine, uid, place, 60, name=name)[0] != 0:
            return "the stub agent could not be placed"
    finally:
        shutil.rmtree(drop, ignore_errors=True)
    register = 'mkdir -p "$HOME/.local/share/porelo/agents.d" && cat > "$HOME/.local/share/porelo/agents.d/stub.yaml"'
    if as_developer(machine, uid, ["sh", "-c", register], 60, f"executable: {STUB_HOME.format(name)}\n", name)[0] != 0:
        return "the stub agent could not be registered"
    return None


def make_developer(machine, stub, name=DEVELOPER):
    """A throwaway developer as a person's account is made, with the stub, a vault and a checkout; uid and why."""
    groups = (machine.read("/etc/group") or "").splitlines()
    member = [g for g in ("porelo-people",) if any(line.startswith(g + ":") for line in groups)]
    made = ["useradd", "--create-home", "--user-group", "--shell", "/bin/bash"]
    if machine.command([*made, *(["--groups", ",".join(member)] if member else []), name], 60)[0] != 0:
        return None, "the developer's account could not be made"
    uid = machine.account(name)
    if uid is None or machine.command(["loginctl", "enable-linger", name], 60)[0] != 0:
        return uid, "the developer's session could not be kept"
    for _ in range(30):
        if machine.path(f"/run/user/{uid}/bus").exists():
            break
        machine.pause(1)
    else:
        return uid, "the developer's session did not start within 30 seconds"
    why = place_stub(machine, uid, stub, name) if stub is not None else None
    if why:
        return uid, why
    # A passphrase made for this run, on standard input only, and gone with the account.
    passphrase = os.urandom(24).hex() + "\n"
    for verb in ("init", "unlock"):
        if as_developer(machine, uid, ["porelo", "vault", verb, "--passphrase-stdin"], 120, passphrase, name)[0] != 0:
            return uid, f"the developer's vault could not {verb}"
    checkout = (
        'git init -q -b main "$HOME/work" && git -C "$HOME/work" -c user.name=measure'
        " -c user.email=measure@example.invalid -c commit.gpgsign=false commit -q --allow-empty -m start"
    )
    if as_developer(machine, uid, ["sh", "-c", checkout], 60, name=name)[0] != 0:
        return uid, "the developer's checkout could not be made"
    return uid, None


def start_task(machine, uid, number, name=DEVELOPER):
    """One stub task started in default from the developer's checkout, uncertified in the test mode; None, or the
    last two lines Porelo said, without colours, after ": " (or "" when it said nothing) if it did not start."""
    start = ["sh", "-c", 'cd "$HOME/work" && exec porelo task start --agent stub --no-input --yes --detach "$1" 2>&1']
    code, output = as_developer(machine, uid, [*start, "sh", f"measure-{number}"], 900, name=name)
    if code == 0:
        return None
    kept = [
        "".join(c for c in COLOURED.sub("", line) if c.isprintable()).strip() for line in (output or "").splitlines()
    ]
    tail = " | ".join([line for line in kept if line][-2:])[:160]
    return f": {tail}" if tail else ""


# With no project naming the host's gate, a developer's conversation is on a homeserver of its own, a user unit; a
# real host has the one gate. So each developer's own is read as its own and stopped before the developer is read.
HOMESERVER = "porelo-matrix-homeserver.service"


def own_homeserver(machine, uid, name=DEVELOPER):
    """The memory of the developer's own homeserver, or None and why; the unit is stopped either way."""
    code, output = as_developer(machine, uid, ["systemctl", "--user", "show", "-p", "MemoryCurrent", HOMESERVER], 60,
                                name=name)  # fmt: skip
    found = re.search(r"(?m)^MemoryCurrent=([0-9]+)$", output or "") if code == 0 else None
    as_developer(machine, uid, ["systemctl", "--user", "stop", HOMESERVER], 120, name=name)
    return (int(found[1]), None) if found else (None, "the developer had no homeserver of its own running")


def developer_tasks(machine, report, sample, count):
    """One developer with a vault and a checkout starts count stub tasks in default; None, or why it could not."""
    stub, why = stub_agent(machine)
    if why:
        return why
    uid, why = make_developer(machine, stub)
    if why:
        return why
    before, disk = machine.slice_reading(uid), machine.disk("/home")
    for number in range(1, count + 1):
        start = machine.clock()
        said = start_task(machine, uid, number)
        if said is not None:
            return f"task {number} of {count} did not start{said}"
        put(report, "start.time", machine.clock() - start, "task", sample=sample, subject=f"task {number}")
    homeserver, why = own_homeserver(machine, uid)
    put(report, "memory.current", homeserver, "task", sample=sample, subject="developer's own homeserver", why=why)
    why = settled(machine)
    after = machine.slice_reading(uid)
    put(report, "work", f"{count} stub tasks in default, one developer", "task", sample=sample)
    put(report, "work.time", None, "task", sample=sample, why="a stub task does no work")
    put(report, "memory.peak", None if why else after["peak"], "task", sample=sample, subject="developer",
        why=why or "cgroup file is unavailable")  # fmt: skip
    put(report, "memory.current", None if why else after["current"], "task", sample=sample, subject="developer",
        why=why or "cgroup file is unavailable")  # fmt: skip
    put(report, "memory.anon", None if why else after["anon"], "task", sample=sample, subject="developer",
        why=why or "cgroup file is unavailable")  # fmt: skip
    cpu = None if None in (before["cpu"], after["cpu"]) else after["cpu"] - before["cpu"]
    put(report, "cpu.time", cpu, "task", sample=sample, subject="developer", why="cgroup file is unavailable")
    growth = machine.disk("/home") - disk
    put(report, "disk.growth", growth if growth >= 0 else None, "task", sample=sample, subject="/home",
        why="the disk shrank while the tasks started")  # fmt: skip
    return None


def developer_gone(machine, count, name=DEVELOPER):
    """The developer and its tasks taken away, the stub agent with its home, whatever got made; each step tried."""
    uid = machine.account(name)
    if uid is not None:
        for number in range(1, count + 1):
            for verb in ("stop", "remove"):
                as_developer(machine, uid, ["porelo", "task", verb, f"measure-{number}"], 300, name=name)
        machine.command(["loginctl", "disable-linger", name], 60)
        machine.command(["loginctl", "terminate-user", name], 60)
        machine.command(["userdel", "--remove", "--force", name], 120)
    # The host keeps each start's record in root's task records, <login>/<project>/<task>.json, which no account
    # removal reaches; an uncertified start's project is default.
    records = machine.path(f"/var/lib/porelo-host/tasks/{name}")
    shutil.rmtree(records, ignore_errors=True)
    if machine.account(name) is not None or os.path.lexists(records):
        raise ValueError("the throwaway developer could not be removed; refusing to measure over leftovers")


# How many developers a host holds: raised 1, 2, 4 and on, five stub tasks each, until a start fails or the memory's or
# the CPU's pressure stays above its line, read twice half a minute apart.
RAISE_LEVELS = (1, 2, 4, 8, 16, 32)
RAISE_TASKS = 5
PRESSURE_LINES = (("memory", 10.0), ("cpu", 80.0))


def pressure(machine):
    """The resource whose pressure stays above its line, or None; the kernel's share of time some task waited."""
    for attempt in range(2):
        if attempt:
            machine.pause(30)
        over = []
        for resource, line in PRESSURE_LINES:
            found = re.search(r"(?m)^some avg10=([0-9.]+)", machine.read(f"/proc/pressure/{resource}") or "")
            if not found:
                return f"the kernel tells no {resource} pressure"
            if float(found[1]) >= line:
                over.append(f"{resource} pressure stayed above {line:g}%")
        if not over:
            return None
    return over[0]


def raise_step(machine, report, inventory, tasks):
    """One up in the room's shape, developers added a level at a time; the count held is a fact, then all go."""
    made, held, why = [], 0, None
    machine.dirty = True
    try:
        try:
            why = settled(machine)
            if not why:
                machine.stand_in_organization()
                code, output = machine.play(inventory, "up")
                state, why = outcome(code, output, tasks)
                stub = None
                if state:
                    stub, why = stub_agent(machine)
                for level in RAISE_LEVELS if not why else ():
                    while len(made) < level and not why:
                        name = f"{DEVELOPER}-{len(made) + 1}"
                        made.append(name)
                        uid, why = make_developer(machine, stub, name)
                        for number in range(1, RAISE_TASKS + 1) if not why else ():
                            said = start_task(machine, uid, number, name)
                            if said is not None:
                                why = f"task {number} of developer {len(made)} did not start{said}"
                                break
                        if not why:
                            own_homeserver(machine, uid, name)
                    why = why or settled(machine) or pressure(machine)
                    if why:
                        break
                    held = level
                else:
                    why = why or f"the last level, {RAISE_LEVELS[-1]} developers, held"
        except PROBLEMS:
            why = "the raising could not run"
        put(report, "developers", held or None, "task", subject="raised", why=f"no level held: {why}")
        text = f"developers raised 1, 2, 4 and on, {RAISE_TASKS} stub tasks each, until {why}"
        put(report, "work", text[:320], "task", subject="raised")
    finally:
        machine.holding = True
        # Each developer is tried and down runs whatever one of them left; a leftover still ends the run after it.
        left = []
        for name in made:
            try:
                developer_gone(machine, RAISE_TASKS, name)
            except PROBLEMS:
                left.append(name)
        code, output = machine.play(inventory, "down")
        state, unused = outcome(code, output, tasks)
        if code != 0 or state != "reached":
            raise ValueError("down failed; refusing to measure over leftovers")
        if left:
            raise ValueError("a throwaway developer could not be removed; refusing to measure over leftovers")
        machine.dirty = False
        machine.holding = False
        if machine.stopping:
            raise KeyboardInterrupt


def task_step(machine, report, inventory, tasks, count):
    """Up in the room's shape, one developer's stub tasks in each sample, and down, as the idle shapes are."""
    stopped = None
    for sample in SAMPLES:
        why = stopped
        machine.dirty = True
        try:
            if not why:
                try:
                    why = settled(machine)
                    if not why:
                        machine.stand_in_organization()
                        code, output = machine.play(inventory, "up")
                        state, why = outcome(code, output, tasks)
                        if state:
                            why = developer_tasks(machine, report, sample, count)
                            stopped = why
                        else:
                            stopped = why
                except PROBLEMS:
                    why = stopped = "the task step could not run"
            if why:
                for field in TASK_FIELDS:
                    if not any(r["step"] == "task" and r.get("sample") == sample and r["field"] == field
                               for r in report["facts"]):  # fmt: skip
                        put(report, field, None, "task", sample=sample, why=why)
        finally:
            machine.holding = True
            developer_gone(machine, count)
            code, output = machine.play(inventory, "down")
            state, unused = outcome(code, output, tasks)
            if code != 0 or state != "reached":
                raise ValueError("down failed; refusing to measure over leftovers")
            machine.dirty = False
            machine.holding = False
            if machine.stopping:
                raise KeyboardInterrupt


# A job's load: porelo-buildtools at a pinned tag, built with Maven in N parallel jobs on the host's own forge, once
# cold and once with the cache, at 1, 2 and 4 jobs and past the half of the host.
JOB_SOURCE = "https://github.com/porelo-ai/porelo-buildtools.git"
JOB_TAG = "v0.5.1"
JOB_TREE = "61d76cd46270b88299b227928d49cfffa6143d45"
JOB_REPOSITORY = "porelo-admin/measure-jobs"
JOB_COUNTS = (("1 job", 1, None), ("2 jobs", 2, None), ("4 jobs", 4, None), ("4 jobs past the half", 4, 90))
JOB_RUNS = ("cold", "with the cache")
JOB_FIELDS = ("work", "work.time", "memory.peak", "cpu.time")
JOB_WAIT = 40 * 60


def job_workflow(count, label, run):
    """N copies of one build; the cache key is the count's own, so its first run is cold and its second is not."""
    key = re.sub(r"[^a-z0-9]+", "-", label)
    parts = ", ".join(str(n) for n in range(1, count + 1))
    return (
        f"# {run}\non: push\njobs:\n  build:\n    runs-on: ubuntu-24.04\n"
        f"    strategy:\n      matrix:\n        part: [{parts}]\n    steps:\n"
        "      - uses: actions/cache@v4\n        with:\n          path: ~/.m2/repository\n"
        f"          key: measure-{key}\n"
        "      - shell: bash\n        env:\n          FORGE_TOKEN: ${{ github.token }}\n        run: |\n"
        "          set -euo pipefail\n          mkdir -p /tmp/tree\n"
        '          printf \'header = "Authorization: token %s"\\n\' "$FORGE_TOKEN" | curl -fsS -K - \\\n'
        '              "$GITHUB_SERVER_URL/api/v1/repos/$GITHUB_REPOSITORY/archive/$GITHUB_SHA.tar.gz" \\\n'
        "              | tar -xz -C /tmp/tree --strip-components=1\n"
        "          cd /tmp/tree && JAVA_HOME=$JAVA_HOME_25_X64 ./mvnw -B -s settings.xml -DskipTests package\n"
    )


# Where the host's forge keeps its data, under its account's home: the rootless volume its container mounts.
FORGE_DATA = ".local/share/containers/storage/volumes/forgejo-data/_data"
TIMED = re.compile(r"^\S+Z ")
COLOURED = re.compile(r"\x1b\[[0-9;]*m")


def job_log_tail(machine, ids, lines=2):
    """The last lines of the first failed job's log the forge kept, without times or colours; "" if none is kept.

    Forgejo writes each job's log as actions_log/<repository>/<id % 256 in hex>/<id>.log and compresses a finished
    one to .log.zst; read as root from the forge's volume before the repository goes."""
    home = next(
        (line.split(":")[5] for line in (machine.read("/etc/passwd") or "").splitlines()
         if line.startswith("porelo-forge:")),
        None,
    )  # fmt: skip
    if not home:
        return ""
    for task in ids:
        if not isinstance(task, int) or isinstance(task, bool):
            continue
        base = machine.path(f"{home}/{FORGE_DATA}/actions_log/{JOB_REPOSITORY}/{task % 256:02x}/{task}.log")
        text = None
        try:
            if base.is_file() and not base.is_symlink():
                text = base.read_text(encoding="utf-8", errors="replace")
            elif base.with_name(base.name + ".zst").is_file():
                code, output = machine.command(["zstd", "-dcq", str(base) + ".zst"], 60)
                text = output if code == 0 else None
        except OSError:
            text = None
        if not text:
            continue
        kept = [COLOURED.sub("", TIMED.sub("", line)).strip() for line in text.splitlines()]
        kept = ["".join(c for c in line if c.isprintable())[:200] for line in kept if line.strip()]
        if kept:
            return " | ".join(kept[-lines:])
    return ""


def job_runs(machine, report, label, count, runner):
    """The pinned tree carried onto the forge, its build run cold and then cached; None, or why it stopped."""
    code, unused = machine.forge("POST", "repos/migrate", {
        "clone_addr": JOB_SOURCE, "repo_owner": "porelo-admin", "repo_name": "measure-jobs", "service": "git",
    })  # fmt: skip
    if code != 201:
        return f"the build's repository could not be carried onto the forge ({code})"
    code, branch = machine.forge("POST", f"repos/{JOB_REPOSITORY}/branches", {
        "new_branch_name": "measure", "old_ref_name": JOB_TAG,
    })  # fmt: skip
    if code != 201 or ((branch or {}).get("commit") or {}).get("id") != JOB_TREE:
        return f"the pinned tag {JOB_TAG} is not the tree it names"
    for run in JOB_RUNS:
        subject = f"{label}, {run}"
        before = machine.slice_reading(runner) if runner is not None else {"cpu": None}
        start = machine.clock()
        content = base64.b64encode(job_workflow(count, label, run).encode()).decode()
        route = f"repos/{JOB_REPOSITORY}/contents/.forgejo/workflows/measure.yml"
        sha = None
        if run != JOB_RUNS[0]:
            sha = (machine.forge("GET", f"{route}?ref=measure")[1] or {}).get("sha")
            if not sha:
                return "the cold run's workflow could not be read back to change it"
        code, made = machine.forge("PUT" if sha else "POST", route, {
            "branch": "measure", "content": content, "message": f"measure: {subject}", **({"sha": sha} if sha else {}),
        })  # fmt: skip
        commit = ((made or {}).get("commit") or {}).get("sha")
        if code not in (200, 201) or not commit:
            return f"the workflow could not be committed ({code})"
        status, rows = None, []
        while machine.clock() - start < JOB_WAIT:
            machine.pause(15)
            runs = (machine.forge("GET", f"repos/{JOB_REPOSITORY}/actions/tasks")[1] or {}).get("workflow_runs") or []
            rows = [r for r in runs if r.get("head_sha") == commit]
            mine = [r.get("status") for r in rows]
            # A job has a row only once the runner took it, so a run is done when all its parts have one and ended.
            if len(mine) >= count and all(state in ("success", "failure", "cancelled", "skipped") for state in mine):
                status = "success" if all(state == "success" for state in mine) else "failure"
                break
        if status != "success":
            failed = [r.get("id") for r in rows if r.get("status") != "success"] if status else []
            tail = job_log_tail(machine, failed)
            return f"the build ended in {status or 'no answer'} within {JOB_WAIT // 60} minutes" + (
                f": {tail}" if tail else ""
            )
        after = machine.slice_reading(runner) if runner is not None else {"peak": None, "cpu": None}
        put(report, "work", f"porelo-buildtools {JOB_TAG} in {count} parallel Maven jobs", "job", subject=subject)
        put(report, "work.time", machine.clock() - start, "job", subject=subject)
        # A slice's peak cannot be set back for all readers, so after the cold run it would still be the cold run's.
        peak, why = (
            (after.get("peak"), "cgroup file is unavailable")
            if run == JOB_RUNS[0]
            else (None, "the runner's peak is still the cold run's")
        )
        put(report, "memory.peak", peak, "job", subject=subject, why=why)
        cpu = None if None in (before.get("cpu"), after.get("cpu")) else after["cpu"] - before["cpu"]
        put(report, "cpu.time", cpu, "job", subject=subject, why="cgroup file is unavailable")
    return None


def job_step(machine, report, tasks, distribution, pins):
    """Each count on a host up in the forge's shape alone, its repository gone and the host down after it."""
    for label, count, share in JOB_COUNTS:
        with tempfile.TemporaryDirectory(prefix="porelo-measure-") as directory:
            inventory = Path(directory) / "inventory.json"
            shape = inventory_of(distribution, True, False, pins)
            host = shape["all"]["hosts"]["localhost"]
            host["forge_runner_capacity"] = count
            if share is not None:
                host["porelo_host_work_share"] = share
            inventory.write_text(json.dumps(shape))
            machine.dirty = True
            made = False
            try:
                try:
                    why = settled(machine)
                    if not why:
                        machine.stand_in_organization()
                        code, output = machine.play(inventory, "up")
                        state, why = outcome(code, output, tasks)
                        if state:
                            made = True
                            why = job_runs(machine, report, label, count, machine.account("porelo-runner"))
                except PROBLEMS:
                    why = "the job step could not run"
                if why:
                    for run in JOB_RUNS:
                        subject = f"{label}, {run}"
                        for field in JOB_FIELDS:
                            if not any(r["step"] == "job" and r.get("subject") == subject and r["field"] == field
                                       for r in report["facts"]):  # fmt: skip
                                put(report, field, None, "job", subject=subject, why=why)
            finally:
                machine.holding = True
                if made:
                    try:
                        machine.forge("DELETE", f"repos/{JOB_REPOSITORY}")
                    except PROBLEMS:
                        pass
                code, output = machine.play(inventory, "down")
                state, unused = outcome(code, output, tasks)
                if code != 0 or state != "reached":
                    raise ValueError("down failed; refusing to measure over leftovers")
                machine.dirty = False
                machine.holding = False
                if machine.stopping:
                    raise KeyboardInterrupt


def stopper(machine):
    """The handler of a run: one stop, at once outside a down and after it inside one, and any later one is the same stop."""

    def stop(_signum, _frame):
        if machine.stopping:
            return
        machine.stopping = True
        if not machine.holding:
            raise KeyboardInterrupt

    return stop


def main(arguments=None, machine=None):
    """Exit 1 on a refusal, 2 when the run cannot complete, 0 only after publishing the result."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--out", required=True)
    parser.add_argument("--given", required=True)
    parser.add_argument("--steps", choices=("idle", "task", "agent", "job"), nargs="+", default=["idle"])
    parser.add_argument("--fresh", action="store_true")
    parser.add_argument("--distribution", choices=("releases", "snapshots"), default="releases")
    parser.add_argument("--tasks", type=int, choices=range(1, 13), default=2, metavar="1-12")
    parser.add_argument("--raise", dest="raised", action="store_true")
    parser.add_argument("--packages", help="a directory of handed-over packages as build/stage-packages.sh stages them")
    options = parser.parse_args(arguments)
    if options.raised and "task" not in options.steps:
        parser.error("--raise raises developers in the task step; give --steps task with it")
    machine = machine or Machine()
    lock = None
    try:
        given = json.loads(options.given)
        if not isinstance(given, dict) or set(given) - {"provider", "offer"}:
            raise ValueError("given must contain only provider and offer")
        for value in given.values():
            if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 ._+()-]{0,79}", value):
                raise ValueError("provider and offer must be short labels")
        obstruction = machine.obstruction(options.fresh)
        if obstruction:
            print(obstruction, file=sys.stderr)
            return 1
        destination = Path(options.out)
        if destination.exists() or destination.is_symlink():
            print("the result file already exists", file=sys.stderr)
            return 1
        # A machine-wide exclusive file prevents two destructive runs; leftovers require inspection.
        if not os.access(destination.parent, os.W_OK):
            raise ValueError("the result file's directory cannot be written")
        previous = {number: signal.signal(number, stopper(machine)) for number in STOPS}
        lock = machine.path("/run/porelo-host-measure.lock")
        finished = False
        try:
            try:
                os.close(os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
            except FileExistsError:
                lock = None
                print("a measuring lock remains; inspect the machine for leftovers", file=sys.stderr)
                return 1
            with tempfile.NamedTemporaryFile(mode="w", dir=destination.parent, encoding="utf-8") as stream:
                report = run(
                    machine, given, options.steps, options.distribution, options.tasks, options.raised, options.packages
                )
                os.chmod(stream.name, 0o600)
                json.dump(report, stream, indent=2, allow_nan=False)
                stream.write("\n")
                stream.flush()
                os.fsync(stream.fileno())
                os.link(stream.name, destination)
                finished = True
        finally:
            for number, handler in previous.items():
                signal.signal(number, handler)
            if lock and (finished or not machine.dirty):
                lock.unlink()
    except (KeyboardInterrupt, *PROBLEMS) as error:
        reason = str(error) if isinstance(error, ValueError) else type(error).__name__
        left = (
            "; inspect the retained /run/porelo-host-measure.lock and unfinished setup"
            if lock and lock.exists()
            else ""
        )
        print(f"measurement could not complete: {reason}{left}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
