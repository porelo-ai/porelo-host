#!/bin/sh
# The tasks step: as the test person, three pi tasks on the project's repository with the openrouter test key. Two run
# on, so the room shows displays that share a start (`Agent <Name>` and `Agent <Name> (<task>)`), and answer what is
# meant for them; the third is stopped, so its account has left the room before the busy-room step.
set -eu
key=${REHEARSAL_PROVIDER_KEYS:-}/openrouter-api.txt
if [ -z "${REHEARSAL_PROVIDER_KEYS:-}" ] || [ ! -r "$key" ]; then echo 'no openrouter test key given'; exit 77; fi
# The model the adapters' own builds run pi with on openrouter: cheap, and known to drive pi's tools.
model=${REHEARSAL_TASK_MODEL:-z-ai/glm-5.3-flash}
# Pi is never woken by Porelo for a message, so a running pair answers only by looking itself, for this long.
answer_minutes=60
left() { echo $((REHEARSAL_DEADLINE - $(date +%s))); }
bounded() { # <seconds at most> <command>...: the bound cut back to what is left before the hard stop
    limit=$1
    shift
    [ "$(left)" -gt 10 ] || { echo "the hard stop is too near for: $*" >&2; exit 1; }
    [ "$limit" -le "$(left)" ] || limit=$(left)
    timeout --kill-after=5 "$limit" "$@"
}

# The key travels on standard input alone; the answer names the entry, never the value.
bounded 120 "$REHEARSAL_PERSON_SSH" porelo vault put openrouter < "$key"
echo "openrouter's test key is in $REHEARSAL_PERSON's vault"


# The image is built once, for pi, before three starts would each build it.
bounded 1800 "$REHEARSAL_PERSON_SSH" porelo task prepare --agent=pi -p "$REHEARSAL_PROJECT" -r "$REHEARSAL_REPOSITORY" \
    < /dev/null
echo "the pi task image of $REHEARSAL_PROJECT/$REHEARSAL_REPOSITORY is prepared"

prompt="For the next $answer_minutes minutes, do only this: read your messages as your Porelo guide says, then run \
'sleep 20' and read them again. To every line meant for you - one that names you, one to All agents or @room, and one \
that names nobody - answer once, in the room it came from, with one line holding the word it asks you to answer \
with; a person's direct chat with you counts too. Never answer a line that names only another agent. Change no file \
and push nothing. After $answer_minutes minutes, stop."
# Each start goes from the person's side, as the product wants: the test identity's porelo here (REHEARSAL_ORG) starts
# the task on the host with --host, its key certified by the person's agent here, never forwarded. A start with --host
# is detached, so the pair's runs go on, each for its --minutes; Porelo ends a run after that time.
# A resumed run repeats this step: tasks an earlier try left are stopped first, so each start below starts its own.
for name in a b c; do
    bounded 300 "$REHEARSAL_PERSON_SSH" porelo task stop "rehearsal-$name" < /dev/null > /dev/null 2>&1 || true
done

# The client starts a task with --host only on a host key it holds: the one the run pinned at its first connection, which
# trust-host records only where the host offers that very key.
pinned=$(printf '%s %s\n' "$REHEARSAL_HOST" "$REHEARSAL_HOST_KEY" | ssh-keygen -lf - | awk '{print $2}')
case $pinned in SHA256:*) ;; *) echo "no fingerprint for the pinned host key"; exit 1 ;; esac
bounded 60 "$REHEARSAL_ORG" credentials trust-host --fingerprint="$pinned" "$REHEARSAL_HOST" < /dev/null \
    > "$REHEARSAL_REPORT/tasks-trust-host.out" 2>&1 \
    || { echo "the person's porelo did not take the host's key:"; cat "$REHEARSAL_REPORT/tasks-trust-host.out"; exit 1; }
echo "the person's porelo holds the host key $pinned"

host_start() { # <task> [<start option>...]
    task=$1
    shift
    bounded 600 "$REHEARSAL_ORG" task start --host "$REHEARSAL_PERSON@$REHEARSAL_HOST" --no-input --agent=pi \
        --provider=openrouter --model="$model" --clearance=deny -p "$REHEARSAL_PROJECT" -r "$REHEARSAL_REPOSITORY" \
        "$@" "rehearsal-$task" < /dev/null > "$REHEARSAL_REPORT/tasks-$task.start" 2>&1 \
        || { echo "rehearsal-$task did not start; its start said:"; cat "$REHEARSAL_REPORT/tasks-$task.start"; exit 1; }
}
# A start with a prompt stays with its run until the run ends, --host or not, so the pair's starts go on in the
# background here, each bound to its run's minutes, and the status below tells when each runs.
# The clients end with this step: a task started with --host runs on without its client, as an ended start showed.
clients=''
end_clients() { for client in $clients; do kill "$client" 2>/dev/null || true; done; }
trap end_clients EXIT
for name in a b; do
    timeout --kill-after=10 $(((answer_minutes + 10) * 60)) "$REHEARSAL_ORG" task start \
        --host "$REHEARSAL_PERSON@$REHEARSAL_HOST" --no-input --agent=pi --provider=openrouter --model="$model" \
        --clearance=deny -p "$REHEARSAL_PROJECT" -r "$REHEARSAL_REPOSITORY" --minutes=$((answer_minutes + 5)) \
        -P "$prompt" "rehearsal-$name" < /dev/null > "$REHEARSAL_REPORT/tasks-$name.start" 2>&1 &
    clients="$clients $!"
done
# The third needs no run of its own: it is started and stopped.
host_start c

state() { # <task>: true or false as porelo's status says it runs; anything else is no answer and fails the step
    # A start still under way has made no task yet: that is "not running", which the caller waits on.
    if ! bounded 60 "$REHEARSAL_PERSON_SSH" porelo task status "rehearsal-$1" --json < /dev/null \
        > "$REHEARSAL_REPORT/tasks.$1.json" 2> "$REHEARSAL_REPORT/tasks.$1.err"; then
        if grep -q "'rehearsal-$1' is not a task of this machine" "$REHEARSAL_REPORT/tasks.$1.err"; then
            echo false
            return 0
        fi
        cat "$REHEARSAL_REPORT/tasks.$1.err" >&2
        echo "porelo task status rehearsal-$1 failed" >&2
        exit 1
    fi
    python3 -I -c 'import json, sys
running = json.load(open(sys.argv[1])).get("running")
if not isinstance(running, bool): sys.exit("no running field in " + sys.argv[1])
print(str(running).lower())' "$REHEARSAL_REPORT/tasks.$1.json" || exit 1
}
start_log() { # <task>: what its start said, for a failure
    echo "its start said:"
    cat "$REHEARSAL_REPORT/tasks-$1.start" || true
}
for name in a b c; do
    since=$(date +%s)
    while :; do
        now=$(state "$name") || exit 1
        [ "$now" != true ] || break
        [ "$name" != c ] || { echo 'rehearsal-c does not run after its detached start'; exit 1; }
        if [ $(($(date +%s) - since)) -ge 600 ] || [ "$(left)" -le 20 ]; then
            echo "rehearsal-$name does not run after $(($(date +%s) - since)) s; its status is in $REHEARSAL_REPORT/tasks.$name.json"
            start_log "$name"
            exit 1
        fi
        sleep 5
    done
    echo "rehearsal-$name runs"
done

bounded 300 "$REHEARSAL_PERSON_SSH" porelo task stop rehearsal-c < /dev/null
now=$(state c) || exit 1
[ "$now" = false ] || { echo 'rehearsal-c still runs after its stop'; exit 1; }
echo 'rehearsal-c is stopped'

bounded 60 "$REHEARSAL_PERSON_SSH" porelo task list < /dev/null > "$REHEARSAL_REPORT/tasks.list"
cat "$REHEARSAL_REPORT/tasks.list"
for name in a b c; do
    grep -q "rehearsal-$name" "$REHEARSAL_REPORT/tasks.list" || { echo "task list does not name rehearsal-$name"; exit 1; }
done
for name in a b; do
    now=$(state "$name") || exit 1
    [ "$now" = true ] || { echo "rehearsal-$name stopped on its own"; start_log "$name"; exit 1; }
done
echo "rehearsal-a and rehearsal-b run and read their messages for $answer_minutes minutes; rehearsal-c is stopped"

# HO170, for porelo's B619: a fourth task reads every repository of the project, read only, and leaves nothing behind.
# Started prompt-less and detached on the host itself: B619 removes a prompt run of a reading task only from its fix on.
all_task=rehearsal-all
container="porelo-${REHEARSAL_PROJECT}_$all_task"
on_host() { bounded 300 "$REHEARSAL_PERSON_SSH" "$@" < /dev/null; }
in_task() { on_host podman exec "$container" "$@"; }
if ! bounded 1800 "$REHEARSAL_PERSON_SSH" porelo task start --all-repositories --detach --no-input --agent=pi \
    --provider=openrouter --model="$model" --clearance=deny -p "$REHEARSAL_PROJECT" "$all_task" < /dev/null \
    > "$REHEARSAL_REPORT/tasks-all.start" 2>&1; then
    if grep -qiE "unknown option.*--all-repositories" "$REHEARSAL_REPORT/tasks-all.start"; then
        echo "SKIP $all_task: the host's porelo does not know the start option; it said:"
        cat "$REHEARSAL_REPORT/tasks-all.start"
        exit 0
    fi
    echo "$all_task did not start; its start said:"
    cat "$REHEARSAL_REPORT/tasks-all.start"
    exit 1
fi
cat "$REHEARSAL_REPORT/tasks-all.start"
# Every repository the project names, and its own, which the start names; one it could not read fails here.
on_host porelo project show --json "$REHEARSAL_PROJECT" > "$REHEARSAL_REPORT/tasks-all.project.json"
own=$(sed -n 's/^repository  *\([^ ]*\) (the project.s own)$/\1/p' "$REHEARSAL_REPORT/tasks-all.start")
[ -n "$own" ] || { echo "the start of $all_task names no own repository of $REHEARSAL_PROJECT"; exit 1; }
expected=$(python3 -I -c 'import json, sys
for each in json.load(open(sys.argv[1]))["repositories"]["names"]:
    print(each["name"])
print(sys.argv[2])' "$REHEARSAL_REPORT/tasks-all.project.json" "$own") || { echo "no repositories in porelo project show"; exit 1; }
[ -n "$expected" ] || { echo "porelo project show names no repository of $REHEARSAL_PROJECT"; exit 1; }
in_task ls -1 /workspace > "$REHEARSAL_REPORT/tasks-all.workspace" \
    || { echo "/workspace of $all_task cannot be listed"; exit 1; }
for repository in $expected; do
    grep -qx "$repository" "$REHEARSAL_REPORT/tasks-all.workspace" \
        || { echo "$all_task has no /workspace/$repository; it has: $(tr '\n' ' ' < "$REHEARSAL_REPORT/tasks-all.workspace")"; exit 1; }
    [ -n "$(in_task ls -A "/workspace/$repository")" ] || { echo "/workspace/$repository is empty"; exit 1; }
    ! in_task test -e "/workspace/$repository/.git" || { echo "/workspace/$repository holds a .git"; exit 1; }
done
echo "$all_task reads $(echo "$expected" | wc -l) repositories under /workspace: $(echo "$expected" | tr '\n' ' ')"
first=$(echo "$expected" | head -n 1)
! in_task touch "/workspace/$first/.rehearsal-write" 2> /dev/null || { echo "a write under /workspace/$first went through"; exit 1; }
echo "a write under /workspace/$first is refused"
# No push target and no gate token: no git remote anywhere under /workspace, no variable named for a gate or token.
# shellcheck disable=SC2016 # expanded in the task's shell
! in_task sh -c 'for d in /workspace/*/; do git -C "$d" remote 2>/dev/null | grep -q . && exit 0; done; exit 1' \
    || { echo "a repository under /workspace has a git remote"; exit 1; }
in_task env | sed 's/=.*//' > "$REHEARSAL_REPORT/tasks-all.env-names"
! grep -qiE 'gate|push' "$REHEARSAL_REPORT/tasks-all.env-names" \
    || { echo "$all_task holds a variable for a gate or a push: $(grep -iE 'gate|push' "$REHEARSAL_REPORT/tasks-all.env-names" | tr '\n' ' ')"; exit 1; }
echo "$all_task has no push target and no gate variable"
on_host porelo task stop "$all_task" > "$REHEARSAL_REPORT/tasks-all.stop" 2>&1 \
    || { echo "$all_task did not stop:"; cat "$REHEARSAL_REPORT/tasks-all.stop"; exit 1; }
on_host porelo task remove "$all_task" > "$REHEARSAL_REPORT/tasks-all.remove" 2>&1 || true
on_host porelo task list > "$REHEARSAL_REPORT/tasks-all.list"
! grep -qw "$all_task" "$REHEARSAL_REPORT/tasks-all.list" || { echo "porelo still lists $all_task"; exit 1; }
left_over=$(on_host sh -c "podman ps -a --format '{{.Names}}'; podman volume ls --format '{{.Name}}'; \
find ~/.local/state/porelo ~/.local/share/porelo -type d -name '*$all_task*' 2>/dev/null" | grep -F "$all_task" || true)
[ -z "$left_over" ] || { echo "$all_task left behind: $(echo "$left_over" | tr '\n' ' ')"; exit 1; }
echo "$all_task is gone: no task, container, volume or workspace of it is left"
