#!/bin/sh
# Stands in for Tresorit's tresorit-cli in the VM test, answering as the real client 3.5.1300.4870 was measured to on
# Ubuntu 26.04: `-p` output tab-separated, the same error codes, a tresor that is indexing, then syncing, then idle
# after `sync --start`. Its state is files beside it; a login is `login` reading one line, or two with a
# second factor, from stdin.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
state=$here/stub-state
mkdir -p "$state"
[ "${1:-}" = -p ] && shift
error() { printf 'Error code:\t%s\nDescription:\t%s\nTrace:\t-\n' "$1" "$2"; exit 1; }
logged_in() { [ -s "$state/login" ]; }
case "${1:-}" in
start)
    if [ ! -s "$state/pid" ] || ! kill -0 "$(cat "$state/pid")" 2>/dev/null; then
        setsid sleep infinity </dev/null >/dev/null 2>&1 &
        echo $! > "$state/pid"
    fi ;;
stop)
    [ -s "$state/pid" ] && kill "$(cat "$state/pid")" 2>/dev/null || true
    rm -f "$state/pid" ;;
status)
    daemon=unreachable
    [ -s "$state/pid" ] && kill -0 "$(cat "$state/pid")" 2>/dev/null && daemon=running
    printf 'Tresorit daemon:\t%s\nDrive mount path:\t-\nLogged in as:\t%s\nRestriction state:\t-\n' \
        "$daemon" "$(cat "$state/login" 2>/dev/null || echo -)" ;;
login)
    [ "${2:-}" = --email ] && [ "${4:-}" = --password-on-stdin ] || error CLIUsage "stub takes --email <a> --password-on-stdin"
    IFS= read -r password || error CLILoginFailed "no password"
    [ -n "$password" ] || error CLILoginFailed "empty password"
    [ "$password" != wrong ] || error CLIBadPasswordOrEmail "Bad password or email"
    echo "$3" > "$state/login" ;;
logout)
    rm -f "$state/login" "$state/sync" "$state/polls"
    [ "${2:-}" = --unlink ] && touch "$state/unlinked" ;;
tresors)
    logged_in || error CLINotLoggedIn "You need to log in first to perform this action"
    for tresor in porelo-test-drive porelo-test-other; do
        path=-
        [ -s "$state/sync" ] && [ "$(cut -f1 "$state/sync")" = "$tresor" ] && path=$(cut -f2 "$state/sync")
        printf '%s\t%s\t%s\n' "$tresor" "$path" "$(cat "$state/login")"
    done ;;
sync)
    logged_in || error CLINotLoggedIn "You need to log in first to perform this action"
    case "${2:-}" in
    --start) [ "${4:-}" = --path ] || error CLIUsage "Missing compulsory argument: --path <path>"
        printf '%s\t%s\n' "$3" "$5" > "$state/sync"; echo 0 > "$state/polls" ;;
    --stop) rm -f "$state/sync" ;;
    esac ;;
transfers)
    logged_in || error CLINotLoggedIn "You need to log in first to perform this action"
    tresor=${3:-}
    [ -s "$state/sync" ] && [ "$(cut -f1 "$state/sync")" = "$tresor" ] || error CLITresorNotSynced "Tresor is not synced"
    # A file never-idle beside the state keeps the tresor syncing, as a sync that does not finish.
    [ -e "$state/never-idle" ] && { printf '%s\tsyncing\t1\t0\n' "$tresor"; exit 0; }
    polls=$(($(cat "$state/polls") + 1)); echo $polls > "$state/polls"
    case $polls in 1) printf '%s\tindexing\t0\t0\n' "$tresor" ;; 2) printf '%s\tsyncing\t1\t0\n' "$tresor" ;;
        *) printf '%s\tidle\t0\t0\n' "$tresor" ;; esac ;;
*) error CLIUsage "stub does not know: $*" ;;
esac
